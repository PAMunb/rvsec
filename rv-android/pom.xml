<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>br.unb.cic</groupId>
		<artifactId>rvsec-parent</artifactId>
		<version>0.9.2</version>
	</parent>

	<groupId>br.unb.cic.rvandroid</groupId>
	<artifactId>rv-android</artifactId>

	<name>RVSec :: rv-android</name>

	<properties>
		<!-- must be in sync with settings.py (pointing to the same dir) -->
		<lib.tmp.dir>lib_tmp</lib.tmp.dir>
	</properties>

	<dependencies>
		<dependency>
			<groupId>br.unb.cic.rvmonitor</groupId>
			<artifactId>rv-monitor-rt</artifactId>
		</dependency>
		<dependency>
			<groupId>br.unb.cic</groupId>
			<artifactId>rvsec-core</artifactId>
		</dependency>
		<dependency>
			<groupId>br.unb.cic</groupId>
			<artifactId>rvsec-logger-logcat</artifactId>
		</dependency>

		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjrt</artifactId>
		</dependency>
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjtools</artifactId>
		</dependency>
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjweaver</artifactId>
		</dependency>

		<dependency>
			<groupId>org.apache.maven.surefire</groupId>
			<artifactId>surefire-booter</artifactId>
			<version>3.0.0-M7</version>
		</dependency>

		<!--
			Kotlin standard library — added for ajc type resolution.
			Without it, ajc fails on APKs containing Kotlin code with
			"Mismatch when building parameterization map" for kotlin.jvm.functions.FunctionN
			because Signature attributes are stripped from APK-extracted .class files
			(R8 release builds remove generic Signature attributes; dex2jar can't recover them).
			Adding the original stdlib jar from Maven gives ajc a well-formed copy of
			Function0..Function22 with correct generic declarations to resolve from.
			Hypothesis derived from JCA-557 2nd-phase failure analysis: 60 APKs failed ajc
			with this exact error pattern (Function3 the most common). Smoke-test pending.
		-->
		<dependency>
			<groupId>org.jetbrains.kotlin</groupId>
			<artifactId>kotlin-stdlib</artifactId>
			<version>2.0.21</version>
		</dependency>
	</dependencies>

	<build>
		<defaultGoal>compile</defaultGoal>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.10.0</version>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${lib.tmp.dir}</outputDirectory>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>false</overWriteSnapshots>
							<overWriteIfNewer>true</overWriteIfNewer>
							<stripVersion>true</stripVersion>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
