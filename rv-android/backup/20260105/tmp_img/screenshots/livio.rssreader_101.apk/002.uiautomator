<?xml version='1.0' encoding='UTF-8' standalone='yes' ?><hierarchy rotation="0"><node index="0" text="" resource-id="" class="android.widget.FrameLayout" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,1794]"><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,1794]"><node index="0" text="" resource-id="" class="android.widget.FrameLayout" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,63][1080,1794]"><node index="0" text="" resource-id="livio.rssreader:id/decor_content_parent" class="android.view.ViewGroup" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,63][1080,1794]"><node index="0" text="" resource-id="livio.rssreader:id/action_bar_container" class="android.widget.FrameLayout" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,63][1080,210]"><node index="0" text="" resource-id="livio.rssreader:id/action_bar" class="android.view.ViewGroup" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,63][1080,210]"><node index="0" text="" resource-id="" class="android.widget.ImageButton" package="livio.rssreader" content-desc="Navigate up" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,63][147,210]" /><node index="1" text="Before my older sister died, I promised her I would live my life fully. That promise helped me find my husband." resource-id="" class="android.widget.TextView" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[189,101][659,172]" /><node index="2" text="" resource-id="" class="androidx.appcompat.widget.LinearLayoutCompat" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[679,63][1080,210]"><node index="0" text="" resource-id="livio.rssreader:id/menu_prev" class="android.widget.Button" package="livio.rssreader" content-desc="Previous item" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[679,73][827,199]" /><node index="1" text="" resource-id="livio.rssreader:id/menu_next" class="android.widget.Button" package="livio.rssreader" content-desc="Next item" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[827,73][975,199]" /><node index="2" text="" resource-id="" class="android.widget.ImageView" package="livio.rssreader" content-desc="More options" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[975,73][1080,199]" /></node></node></node><node index="1" text="" resource-id="android:id/content" class="android.widget.FrameLayout" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,210][1080,1794]"><node index="0" text="" resource-id="" class="android.widget.RelativeLayout" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,210][1080,1794]"><node index="0" text="" resource-id="livio.rssreader:id/smartpager" class="androidx.viewpager.widget.ViewPager" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,210][1080,1794]"><node index="0" text="" resource-id="" class="androidx.recyclerview.widget.RecyclerView" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,210][1080,1794]"><node index="0" text="" resource-id="" class="android.webkit.WebView" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,210][1080,1794]"><node index="0" text="" resource-id="" class="android.webkit.WebView" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="true" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,210][1080,1794]"><node index="0" text="2025-04-26 9:17 AM " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,254][435,307]" /><node index="1" text="Full story" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[433,254][606,307]" /><node index="2" text="&#10;" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,254][1080,1794]" /><node index="3" text="&#10;" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,254][1080,1794]" /><node index="4" text="The author, left, made a promise to her dying sister, right. Courtesy of Courtney Rentzel Photography" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,393][868,1173]"><node index="0" text="naomi carmen and her sister standing back to back" resource-id="" class="android.widget.Image" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,393][868,934]" /><node index="1" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,931][868,1173]"><node index="0" text="The author, left, made a promise to her dying sister, right." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,931][800,1034]" /><node index="1" text="Courtesy of Courtney Rentzel Photography" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1071][868,1173]" /></node></node><node index="5" text="" resource-id="" class="android.widget.ListView" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1212][973,1559]"><node index="0" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1212][973,1362]"><node index="0" text="• " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[115,1212][136,1265]" /><node index="1" text="When my sister was dying of breast cancer, she made me promise I'd live my life to the fullest." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1212][958,1362]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1359][973,1459]"><node index="0" text="• " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[115,1359][136,1412]" /><node index="1" text="At first, I didn't follow through, but eventually I found the courage to act on my promise." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1359][973,1459]" /></node><node index="2" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1456][973,1559]"><node index="0" text="• " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[115,1456][136,1509]" /><node index="1" text="I decided to move on my own to a beach town, where I met my husband." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1456][903,1559]" /></node></node><node index="6" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1596][973,1794]"><node index="0" text="When my older sister called to let me know that the painful lump in her breast was not a clogged milk duct from nursing her newborn, my world shattered. My 31-year-old sister was diagnosed with " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1596][942,1794]" /><node index="1" text="stage 3C breast cancer" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[133,1792][567,1794]" /><node index="2" text="." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[564,1792][580,1794]" /></node><node index="7" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="I immediately purchased a " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][548,1794]" /><node index="1" text="one-way plane ticket" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[546,1792][929,1794]" /><node index="2" text="to stay with her and help with my 2-year-old nephew and newborn niece. Over the next two and a half years, I watched my once strong and bossy sister slowly become bedridden. She then became unable to walk or breathe without oxygen." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][945,1794]" /></node><node index="8" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="In our final conversation, I told her I wished I could take her place. After all, I had no children and was in an " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][916,1794]" /><node index="1" text="unhappy marriage" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[312,1792][651,1794]" /><node index="2" text=". My sister replied that she was glad it was her and not me. She said she wanted me to have children and truly experience life." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][934,1794]" /></node><node index="9" text="She then asked me to promise to live a life for both of us, doing the things she wouldn't be able to do. She encouraged me to create happiness despite whatever difficult decisions I'd have to make. I made her that promise, altering my life forever." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="10" text="At first, I couldn't handle the grief and ignored the promise I made" resource-id="a93e924b-1e92-4cf6-bc65-165d8c55ed46" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="11" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="Her passing, though ultimately expected, rocked my sense of mortality and shattered me. We had always talked about growing old together in a " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][950,1794]" /><node index="1" text="nursing home" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][304,1794]" /><node index="2" text=" and bickering with each other when we were 95, sharing a room like we did when we were kids." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][971,1794]" /></node><node index="12" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="At 27, I was deeply cognizant that I had no guarantee of time. Like everyone else, I thought I had decades before thinking about mortality, let alone a " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][947,1794]" /><node index="1" text="bucket list" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[191,1792][385,1794]" /><node index="2" text="." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[383,1792][396,1794]" /></node><node index="13" text="I was in denial for years. I lacked direction, strength, and self-worth." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="14" text="Running became my outlet for grief. When I'd get tired and wanted to stop, I pictured my sister in her wheelchair, gasping for air, and took another step for her." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="15" text="After my sister died, I had no mental or emotional energy to deal with my failing marraige. Having a baby didn't fix it." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="16" text="I wondered if this was the life my sister envisioned for me as she was dying. Suddenly, I knew it wasn't. At 29, I finally admitted I was anything but happy and knew it was time to make a change." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="17" text="I eventually acted on the promise I made with my sister" resource-id="8c5b86e8-1f94-457d-a2cc-b0311a7488b9" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="18" text='Braving the judgment I knew I&apos;d face, I left my marriage and moved states with my infant and two large dogs to fulfill my dream of living near the beach despite having no family nearby to help. I started saying "yes" to more things and tackling my newly created bucket list.' resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="19" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="An opportunity to visit Hawaii arose, and I jumped on it. In just one week, I skydived, got " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][971,1794]" /><node index="1" text="scuba certified" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][858,1794]" /><node index="2" text=", hiked a mountain at sunrise, and swam with sharks." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][945,1794]" /></node><node index="20" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="Keeping my promise to her — to say yes, to create happiness — changed everything. I gained confidence and " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][968,1794]" /><node index="1" text="self-esteem" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[341,1792][564,1794]" /><node index="2" text=". That transformation led me to my life partner and now-husband, whom I met on the beach. We got engaged and married on that same sand." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][958,1794]" /></node><node index="21" text="Having my second child with him and feeling renewed in my career and personal relationships, I now live a life my 90-year-old self — and my sister — would be proud of." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="22" text="I choose myself daily and remove what doesn't serve me. Every year, I celebrate aging; each birthday I see means I'm still alive, and I will never take that for granted." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="23" text="I still live near the same beach where I rebuilt my life, and my car is covered in sand, dog hair, kids' toys, and sunscreen — just as I had always hoped." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="24" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="Read the original article on " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][556,1794]" /><node index="1" text="Business Insider" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[553,1792][863,1794]" /></node></node></node></node></node><node NAF="true" index="1" text="" resource-id="livio.rssreader:id/backbutton" class="android.widget.ImageButton" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,960][84,1044]" /></node></node></node></node></node><node index="1" text="" resource-id="android:id/statusBarBackground" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,63]" /><node index="2" text="" resource-id="android:id/navigationBarBackground" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /></node></hierarchy>