                                                                        973,
                                                                        1794
                                                                     ]
                                                                  ],
                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "After my sister died, I had no mental or emotional energy to deal with my failing marraige. Having a baby didn't fix it.",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
                                                                  "parent": 17,
