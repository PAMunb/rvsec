                                                                  ],
                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "Having my second child with him and feeling renewed in my career and personal relationships, I now live a life my 90-year-old self \u2014 and my sister \u2014 would be proud of.",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
