                                                                           ]
                                                                        ],
                                                                        "resource_id": null,
                                                                        "checked": false,
                                                                        "text": ". That transformation led me to my life partner and now-husband, whom I met on the beach. We got engaged and married on that same sand.",
                                                                        "class": "android.view.View",
                                                                        "scrollable": false,
                                                                        "selected": false,
