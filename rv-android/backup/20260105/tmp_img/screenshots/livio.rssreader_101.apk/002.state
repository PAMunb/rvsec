                                                                        1794
                                                                     ]
                                                                  ],
                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "I wondered if this was the life my sister envisioned for me as she was dying. Suddenly, I knew it wasn't. At 29, I finally admitted I was anything but happy and knew it was time to make a change.",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
                                                                  "parent": 17,
