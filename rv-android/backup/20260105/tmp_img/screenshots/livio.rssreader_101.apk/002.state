                                                                        973,
                                                                        1794
                                                                     ]
                                                                  ],
                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "I choose myself daily and remove what doesn't serve me. Every year, I celebrate aging; each birthday I see means I'm still alive, and I will never take that for granted.",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
                                                                  "parent": 17,
                                                                  "temp_id": 74,
                                                                  "size": "929*2"
                                                               },
                                                               {
                                                                  "package": "livio.rssreader",
                                                                  "visible": true,
