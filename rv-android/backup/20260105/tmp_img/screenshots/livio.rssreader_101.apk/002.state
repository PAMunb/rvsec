                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "I was in denial for years. I lacked direction, strength, and self-worth.",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
