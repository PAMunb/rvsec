                                                                     ]
                                                                  ],
                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "Running became my outlet for grief. When I'd get tired and wanted to stop, I pictured my sister in her wheelchair, gasping for air, and took another step for her.",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
                                                                  "parent": 17,
