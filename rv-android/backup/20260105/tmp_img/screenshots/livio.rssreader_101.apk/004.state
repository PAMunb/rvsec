                                                                     },
                                                                     {
                                                                        "package": "livio.rssreader",
                                                                        "visible": true,
                                                                        "checkable": false,
                                                                        "child_count": 0,
                                                                        "editable": false,
                                                                        "clickable": false,
                                                                        "is_password": false,
