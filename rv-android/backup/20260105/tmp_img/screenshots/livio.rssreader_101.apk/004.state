                                                                           ]
                                                                        ],
                                                                        "resource_id": null,
                                                                        "checked": false,
                                                                        "text": "over five years before launching his bagless vacuum cleaner in 1993 \u2014 said that embracing failure was essential to life.",
                                                                        "class": "android.view.View",
                                                                        "scrollable": false,
                                                                        "selected": false,
                                                                        "long_clickable": false,
