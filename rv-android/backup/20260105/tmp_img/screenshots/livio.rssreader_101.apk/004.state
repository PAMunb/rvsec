                                                                  ],
                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "A bed with good motion isolation will keep you from feeling your partner toss and turn in the night, so you don't get jostled awake. I test motion isolation by placing a vibrometer on one side of the bed and dropping a 15-pound bowling ball on the other side.",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
                                                                  "parent": 62,
                                                                  "temp_id": 152,
