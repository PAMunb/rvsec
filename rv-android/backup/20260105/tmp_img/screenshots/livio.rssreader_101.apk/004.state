                                                                     ]
                                                                  ],
                                                                  "resource_id": "0454e0a6-ea65-4a36-8fe8-0aaaf1b341e5",
                                                                  "checked": false,
                                                                  "text": "Trial period and warranty",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
                                                                  "parent": 62,
                                                                  "temp_id": 159,
