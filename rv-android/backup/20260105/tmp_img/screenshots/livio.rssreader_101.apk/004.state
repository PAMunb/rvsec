                                                                              968,
                                                                              1794
                                                                           ]
                                                                        ],
                                                                        "resource_id": null,
                                                                        "checked": false,
                                                                        "text": ". My all-time average sleep score is 63 out of 100. On the Naturepedic EOS Classic, my sleep was better than average at 65.",
                                                                        "class": "android.view.View",
                                                                        "scrollable": false,
                                                                        "selected": false,
                                                                        "long_clickable": false,
                                                                        "parent": 136,
