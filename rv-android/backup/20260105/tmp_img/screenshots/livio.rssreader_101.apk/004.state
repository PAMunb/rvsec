                                                                     [
                                                                        -107,
                                                                        1794
                                                                     ]
                                                                  ],
                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "\"It's true for writers and filmmakers and all sorts of people. It's a life of failure. It takes a long time before you find the one that works,\" he said. \"You just have to get used to that.\"",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
                                                                  "parent": 17,
                                                                  "temp_id": 47,
                                                                  "size": "929*2"
                                                               },
                                                               {
                                                                  "package": "livio.rssreader",
                                                                  "visible": false,
                                                                  "checkable": false,
                                                                  "child_count": 0,
                                                                  "editable": false,
                                                                  "clickable": false,
                                                                  "is_password": false,
                                                                  "focusable": false,
                                                                  "enabled": true,
                                                                  "content_description": null,
                                                                  "children": [],
                                                                  "focused": false,
                                                                  "bounds": [
                                                                     [
                                                                        -1036,
                                                                        1792
                                                                     ],
                                                                     [
                                                                        -107,
                                                                        1794
                                                                     ]
                                                                  ],
                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "Dyson, 77, said he enjoyed the misfires and struggles he's had across his career, saying that real wisdom comes from experience.",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
                                                                  "parent": 17,
                                                                  "temp_id": 48,
                                                                  "size": "929*2"
                                                               },
                                                               {
                                                                  "package": "livio.rssreader",
                                                                  "visible": false,
                                                                  "checkable": false,
                                                                  "child_count": 0,
                                                                  "editable": false,
                                                                  "clickable": false,
                                                                  "is_password": false,
                                                                  "focusable": false,
                                                                  "enabled": true,
                                                                  "content_description": null,
                                                                  "children": [],
                                                                  "focused": false,
                                                                  "bounds": [
                                                                     [
                                                                        -1036,
                                                                        1792
                                                                     ],
                                                                     [
                                                                        -107,
                                                                        1794
                                                                     ]
                                                                  ],
                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "\"At school, you're taught to get the answer right the first time,\" he said. While a clever student may get to the answer quickly, he said, they are at a disadvantage to those who take their time getting to an answer, as they haven't \"viscerally experienced failure and overcoming failure.\"",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
                                                                  "parent": 17,
                                                                  "temp_id": 49,
                                                                  "size": "929*2"
                                                               },
                                                               {
                                                                  "package": "livio.rssreader",
                                                                  "visible": false,
                                                                  "checkable": false,
                                                                  "child_count": 0,
                                                                  "editable": false,
                                                                  "clickable": false,
                                                                  "is_password": false,
                                                                  "focusable": false,
                                                                  "enabled": true,
                                                                  "content_description": null,
                                                                  "children": [],
                                                                  "focused": false,
                                                                  "bounds": [
                                                                     [
                                                                        -1036,
                                                                        1792
                                                                     ],
                                                                     [
                                                                        -107,
                                                                        1794
                                                                     ]
                                                                  ],
                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "For Dyson, resilience and adaptability are some of the most important skills someone can learn. \"Life is about making things work,\" he said.",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
                                                                  "parent": 17,
                                                                  "temp_id": 50,
                                                                  "size": "929*2"
                                                               },
                                                               {
                                                                  "package": "livio.rssreader",
                                                                  "visible": false,
                                                                  "checkable": false,
                                                                  "child_count": 0,
                                                                  "editable": false,
                                                                  "clickable": false,
                                                                  "is_password": false,
                                                                  "focusable": false,
                                                                  "enabled": true,
                                                                  "content_description": null,
                                                                  "children": [],
                                                                  "focused": false,
                                                                  "bounds": [
                                                                     [
                                                                        -1036,
                                                                        1792
                                                                     ],
                                                                     [
                                                                        -107,
                                                                        1794
                                                                     ]
                                                                  ],
                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "He continued: \"That's what you have to do. It's trial and error. When something works, it's less challenging, it's less interesting.\"",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
                                                                  "parent": 17,
                                                                  "temp_id": 51,
                                                                  "size": "929*2"
                                                               },
                                                               {
                                                                  "package": "livio.rssreader",
                                                                  "visible": false,
                                                                  "checkable": false,
                                                                  "child_count": 0,
                                                                  "editable": false,
                                                                  "clickable": false,
                                                                  "is_password": false,
                                                                  "focusable": false,
                                                                  "enabled": true,
                                                                  "content_description": null,
                                                                  "children": [],
                                                                  "focused": false,
                                                                  "bounds": [
                                                                     [
                                                                        -1036,
                                                                        1792
                                                                     ],
                                                                     [
                                                                        -107,
                                                                        1794
                                                                     ]
                                                                  ],
                                                                  "resource_id": null,
                                                                  "checked": false,
                                                                  "text": "Aside from the many prototypes it took him to invent the first vacuum with his namesake brand, Dyson famously abandoned plans to enter the electric car market in 2019 after spending more than $600 million on developing a vehicle that he came to realize was not commercially viable.",
                                                                  "class": "android.view.View",
                                                                  "scrollable": false,
                                                                  "selected": false,
                                                                  "long_clickable": false,
                                                                  "parent": 17,
                                                                  "temp_id": 52,
                                                                  "size": "929*2"
                                                               },
                                                               {
                                                                  "package": "livio.rssreader",
                                                                  "visible": false,
                                                                  "checkable": false,
                                                                  "child_count": 0,
                                                                  "editable": false,
                                                                  "clickable": false,
                                                                  "is_password": false,
