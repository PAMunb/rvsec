                                                                  "size": "929*2"
                                                               },
                                                               {
                                                                  "package": "livio.rssreader",
                                                                  "visible": false,
                                                                  "checkable": false,
                                                                  "child_count": 0,
                                                                  "editable": false,
                                                                  "clickable": false,
                                                                  "is_password": false,
                                                                  "focusable": false,
                                                                  "enabled": true,
