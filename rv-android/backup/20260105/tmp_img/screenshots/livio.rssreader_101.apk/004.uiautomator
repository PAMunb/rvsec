WebView" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="true" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,210][1080,1794]"><node index="0" text="2025-04-26 9:00 AM " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,254][435,307]" /><node index="1" text="Full story" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[433,254][606,307]" /><node index="2" text="&#10;" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,254][1080,1794]" /><node index="3" text="&#10;" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,254][1080,1794]" /><node index="4" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,393][973,496]"><node index="0" text="When you buy through our links, Business Insider may earn an affiliate commission. " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,393][958,496]" /><node index="1" text="Learn more" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[682,443][900,496]" /></node><node index="5" text="The best mattresses for couples must have excellent motion isolation, terrific edge support, and comfort that suits both sleepers. Naturepedic is a top option for couples who can't agree on firmness. James Brains/Business Insider" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,535][868,1281]"><node index="0" text="The Naturepedic EOS Classic Organic Mattress is displayed in a bedroom." resource-id="" class="android.widget.Image" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,535][868,895]" /><node index="1" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,892][868,1281]"><node index="0" text="The best mattresses for couples must have excellent motion isolation, terrific edge support, and comfort that suits both sleepers. Naturepedic is a top option for couples who can't agree on firmness." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,892][868,1189]" /><node index="1" text="James Brains/Business Insider" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1228][868,1281]" /></node></node><node index="6" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1320][973,1666]"><node index="0" text='Sharing a bed with someone isn&apos;t easy. They may hog the covers, snore, push you to the edges, or worse, have a different comfort preference than you, meaning neither of you are likely getting a good night&apos;s sleep. That&apos;s why I&apos;ve opted for a "' resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1320][958,1617]" /><node index="1" text="sleep divorce" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,1564][307,1617]" /><node index="2" text='," or sleeping in a separate bed from my wife, but not everyone has that privilege.' resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1564][971,1666]" /></node><node index="7" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1703][973,1794]"><node index="0" text="Naturepedic recognizes that the " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1703][653,1756]" /><node index="1" text="best mattresses for couples" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1703][955,1794]" /><node index="2" text=" must have excellent motion isolation, terrific edge support, and comfort that suits both sleepers. The " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1753][960,1794]" /><node index="3" text="EOS Classic," resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[304,1792][540,1794]" /><node index="4" text=" an organic latex hybrid with customizable firmness,is the perfect example." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /></node><node index="8" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="Naturepedic specializes in organic, eco-friendly mattresses made in the USA and backs them with a 25-year warranty, longer than the industry standard. The EOS Classic exemplifies the company's commitment to producing eco-certified beds that keep couples comfortable. As Business Insider Reviews' sleep expert, I've tested over 100 beds for our " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="1" text="best mattress" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[451,1792][714,1794]" /><node index="2" text=" guide, and the Naturepedic EOS Classic is the " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][916,1794]" /><node index="3" text="best organic mattress" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][934,1794]" /><node index="4" text=" for couples because it offers dual-sided firmness customization, so partners with vastly different comfort preferences can still share a bed." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][963,1794]" /></node><node index="9" text="Below are my experiences after sleeping on the Naturepedic EOS Classic for 30 nights and putting it through my objective testing. I'll cover who it's best for, who should look elsewhere, and alternatives you may want to consider instead." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="10" text="Construction" resource-id="3560a374-fdc0-46e3-b681-db7db839a3f4" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="11" text="The latex layers come in soft, medium, and firm, while the coils are plush or firm. They combine to offer five comfort options on each side of the bed. Naturepedic" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]"><node index="0" text="A graphic of the layers of the Naturepedic EOS Classic Organic Mattress." resource-id="" class="android.widget.Image" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]" /><node index="1" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]"><node index="0" text="The latex layers come in soft, medium, and firm, while the coils are plush or firm. They combine to offer five comfort options on each side of the bed." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]" /><node index="1" text="Naturepedic" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]" /></node></node><node index="12" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="The Naturepedic EOS Classic is made of organic materials and sports an array of eco-friendly certifications, including " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][947,1794]" /><node index="1" text="Greenguard Gold" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[488,1792][805,1794]" /><node index="2" text=", " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[800,1792][824,1794]" /><node index="3" text="Made Safe" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][929,1794]" /><node index="4" text=", " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[128,1792][152,1794]" /><node index="5" text="GOTS" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[147,1792][257,1794]" /><node index="6" text=", and " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[254,1792][357,1794]" /><node index="7" text="Environmental Working Group" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[351,1792][910,1794]" /><node index="8" text="." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[908,1792][921,1794]" /></node><node index="13" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="The mattress features a quilted top layer that zips off, though it's spot-clean only. It's made of organic cotton, fire-retardant wool batting, and PLA, a fiber made from non-GMO sugarcane that adds improved moisture wicking and durability. Below that is a 3-inch " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][971,1794]" /><node index="1" text="GOLS-certified" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[451,1792][724,1794]" /><node index="2" text=" organic latex layer, which responds to your body's contours to provide pressure-point relief. Next is an 8-inch layer of encased coils with added edge support. The base is organic cotton batting." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][950,1794]" /></node><node index="14" text="The defining feature of the Naturepedic EOS Classic is that you can choose how firm you want each side of the bed to be: Plush, Medium, Cushion-Firm, Firm, and Extra-Firm. The firmness of the coils and latex layer will depend on your choice. The mattress is available in the six standard sizes, ranging from twin to California king. For sizes queen and larger, you can pick different firmnesses for each side of the bed. I tested a queen-sized Naturepedic with one side Plush (soft latex, plush coils) and the other Medium (medium latex, plush coils) to best suit my side sleeping." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="15" text="Our review of the Naturepedic EOS Classic Mattress" resource-id="b73bb491-4d44-4d21-8331-c6db50c95838" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="16" text="Setup" resource-id="3d7fcdfe-f35d-4050-b99b-98de0d96a475" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="17" text="The Naturepedic EOS Classic arrives in four boxes. James Brains/Business Insider" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]"><node index="0" text="The Naturepedic EOS Classic Organic Mattress is shown still in the four boxes it arrives in." resource-id="" class="android.widget.Image" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]" /><node index="1" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]"><node index="0" text="The Naturepedic EOS Classic arrives in four boxes." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][832,1794]" /><node index="1" text="James Brains/Business Insider" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]" /></node></node><node index="18" text="Due to the customization of the Naturepedic EOS Classic, the assembly process is more involved than that of most beds. While most come in a single box the size of a mini fridge, the EOS Classic arrived in four smaller boxes, which made it a lot easier to carry up to my third-floor testing room and may enable you to up the bed without extra help." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="19" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="Still, the setup was a lot of work. It took me about 20 minutes, and by the time I was done, I was dripping sweat. Naturepedic has " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][966,1794]" /><node index="1" text="a helpful video" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[656,1792][931,1794]" /><node index="2" text="that explains the process. First, you lay the mattress encasement across your bed frame and unzip it to make room for the internal components. Next, you add the coils, squeezing them into the encasement. Then, put the latex layers on top of those, ensuring your preferred firmness is on your side of the bed. Lastly, you zip the encasement closed and lie down for a rest." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][968,1794]" /></node><node index="20" text="Assembly of the Naturepedic mattress is more involved than most beds in a box. I was sweating by the time I finished. James Brains/Business Insider" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]"><node index="0" text="The Naturepedic EOS Classic Organic Mattress is displayed partially assembled in a bedroom." resource-id="" class="android.widget.Image" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]" /><node index="1" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]"><node index="0" text="Assembly of the Naturepedic mattress is more involved than most beds in a box. I was sweating by the time I finished." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][832,1794]" /><node index="1" text="James Brains/Business Insider" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]" /></node></node><node index="21" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="I liked that it was fully expanded out of the box and lacked the initial odor most beds have. Naturepedic offers in-home setup (i.e., white-glove delivery) for an additional charge that varies depending on location. " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="1" text="Contact customer service" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[480,1792][960,1794]" /><node index="2" text="for rates in your area." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][443,1794]" /></node><node index="22" text="Comfort" resource-id="6086f819-d303-4dd3-80ab-d5c2490fe3fe" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="23" text="During the month I slept on the Naturepedic EOS Classic, I enjoyed outstanding pressure relief on both sides of the bed. I'm on the heavier side, athletically built: 6 feet tall and 225 pounds. I can sleep in any position, but I prefer sleeping on my side. That said, the medium and plush latex comfort layers seemed to be perfectly suited for side sleepers. I felt my spine stayed aligned as it cradled my body, and I didn't wake up sore while sleeping on the EOS Classic." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="24" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="I track my sleep every night using a " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][711,1794]" /><node index="1" text="Garmin watch" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][845,1794]" /><node index="2" text=". My all-time average sleep score is 63 out of 100. On the Naturepedic EOS Classic, my sleep was better than average at 65." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][968,1794]" /></node><node index="25" text="On a scale of 1 to 10, where 10 is the firmest, I'd rate the Plush side a 5. It was soft but maintained good support as I didn't sink in too much. The Medium side was a 6, just slightly firmer. While the Plush side is likely only good for petite individuals and side sleepers, I think the Medium firmness will appeal to a broader range of people, including back and stomach sleepers. Heavier back and stomach sleepers might want to consider one of the firmer options." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="26" text="Heat dissipation" resource-id="dd35e09b-5f7e-4772-aa0b-763c3bc2102a" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="27" text="I use a laser thermometer to measure how cool mattresses stay and how quickly they dissipate heat. I do this by taking temperature readings before bed, when I get up in the morning, and two minutes after getting up." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="28" text="The readings showed that the Naturepedic EOS Classic did not dissipate heat well. When I first got up from the mattress, it was 89.5 degrees Fahrenheit, which is exactly the average across all my mattress testing. However, the heat tended to stay put, only decreasing by about nine degrees in the next two minutes. Most mattresses I've tested drop in temperature by 12 degrees or more in those two minutes." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="29" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="As a hot sleeper, I frequently overheated on the Naturepedic. Consequently, I suggest hot sleepers supplement the bed with " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][918,1794]" /><node index="1" text="cooling products" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][824,1794]" /><node index="2" text=" or look elsewhere. On the other hand, cold sleepers may find it comfortable." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][913,1794]" /></node><node index="30" text="Edge support" resource-id="141b41cb-037b-471d-aa41-2792d782ed41" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="31" text="Edge support is an important feature because it makes getting into and out of bed easier and ensures you feel comfortable across the mattress's surface, even on the periphery. I assess edge support using two tests. First, I use a yardstick to measure how much the edge sinks when I sit on the side. Second, I lie on the very edge and roll until I fall. If I make it beyond a 45-degree angle to the bed, the mattress has pretty good edge support." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="32" text="The Naturepedic EOS Classic's edge support is great. While sitting on it, the edge sinkage was about average, but when lying on the bed, I got pretty far before I fell off. Plus, subjectively, I felt quite comfortable lying on the side. I didn't feel like I might fall." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="33" text="Motion isolation" resource-id="c8979cbe-da8f-49d5-9b90-4665e4d86edd" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="34" text="A bed with good motion isolation will keep you from feeling your partner toss and turn in the night, so you don't get jostled awake. I test motion isolation by placing a vibrometer on one side of the bed and dropping a 15-pound bowling ball on the other side." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="35" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="Through several iterations of the test, the Naturepedic mattress showed impressive motion isolation. The average in my mattress testing is 7.1 on the " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][963,1794]" /><node index="1" text="MMI scale" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[241,1792][438,1794]" /><node index="2" text=", with larger numbers meaning stronger vibrations. The EOS Classic Organic registered 6.4, significantly lower than most beds." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][908,1794]" /></node><node index="36" text="Also, while lying on the bed, I had my wife join me and move around a bit to simulate tossing and turning. I could just barely feel her while she did this. Though I'm a light sleeper, it's doubtful the slight jostling would wake me." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="37" text="The impressive combination of edge support and motion isolation makes the Naturepedic EOS Classic an outstanding choice for couples." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="38" text="Trial period and warranty" resource-id="0454e0a6-ea65-4a36-8fe8-0aaaf1b341e5" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="39" text="Naturepedic offers a 100-night sleep trial with the EOS Classic. If you decide it isn't right for you after 30 nights, you can return it for a full refund. During the trial period, Naturepedic lets you swap out the latex comfort layer for a different firmness for free. If you return your mattress, Naturepedic will donate it to charity or recycle it." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="40" text="Naturepedic backs the EOS Classic Organic with a 25-year warranty. However, there are some catches. You need to use a supportive foundation with the mattress. If it's a slatted base, for example, the slats or supports must not be more than 3 inches apart. Also, the warranty is void if the law label is missing or damage is caused by jumping on the bed. Flaws in workmanship or defects, including the mattress indenting more than 1.5 inches, will be fixed or replaced at Naturepedic's discretion during the first 10 years of the warranty. After that, component repair or replacement will be prorated. Shipping costs for the bed and any replacement are not covered by the warranty." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="41" text="Cons to consider" resource-id="9efad279-39c2-4e99-afee-59d67ee5130d" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="42" text="The biggest negative of the Naturepedic EOS Classic is its heat retention. I don't like waking up sweaty and wet at night, but that happened on the EOS Classic. Hot sleepers might want to consider alternatives, though cold sleepers may welcome the cozy warmth." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="43" text="The setup process was a pain in the butt. It took about four times as long as other mattresses. In a perfect world, Naturepedic would send you the EOS Classic Organic already assembled with your preferred comfort layers installed the way you want them. Of course, there are a few benefits to how they do it now, and if assembling the bed yourself is too off-putting, you can always spring for white-glove delivery." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="44" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="Lastly, at $3,499 for a queen, the Naturepedic EOS Classic is one of the most expensive organic mattresses I've tested. However, when you think about the 25-year warranty, it kind of puts the purchase in perspective. The is a bed made of high-quality organic materials that are meant to last. And, if your comfort preferences change over time, you can adjust the firmness by " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="1" text="buying new coils or a new latex comfort layer" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][942,1794]" /><node index="2" text="." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[750,1792][763,1794]" /></node><node index="45" text="What are your alternatives?" resource-id="93b7df4a-d706-488a-8244-6f764a6f7073" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="46" text="The Bedgear M3 Performance Mattress has a similar dual-sided comfort customization. It costs about $1,000 less and uses memory foam. Erin Brains; James Brains/Business Insider" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]"><node index="0" text="Side by side of a man lying on the Bedgear M3 Performance Mattress and the mattress being assembled." resource-id="" class="android.widget.Image" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]" /><node index="1" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]"><node index="0" text="The Bedgear M3 Performance Mattress has a similar dual-sided comfort customization. It costs about $1,000 less and uses memory foam." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][858,1794]" /><node index="1" text="Erin Brains; James Brains/Business Insider" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]" /></node></node><node index="47" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="If latex sounds unappealing or you have allergies, you might consider the " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][960,1794]" /><node index="1" text="latex-free EOS Classic" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[480,1792][892,1794]" /><node index="2" text=". It features the same customization and price, but instead of latex, it has a 3-inch micro coil layer. The EOS Classic is also available as a " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][939,1794]" /><node index="3" text="PETA-approved" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][871,1794]" /><node index="4" text=" vegan option, where the wool is replaced with organic cotton. Again, the customization options and price are the same." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][910,1794]" /></node><node index="48" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="While we haven't tested them yet, Naturepedic offers two pricier styles in the EOS line with the same array of firmness options. Instead of coils or other metals, the " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][937,1794]" /><node index="1" text="EOS Trilux" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[417,1792][609,1794]" /><node index="2" text=" has three layers of 3-inch latex, all interchangeable. This option is ideal for people who can't get enough of the responsive latex feel. The " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][963,1794]" /><node index="3" text="EOS Pillow Top" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[527,1792][813,1794]" /><node index="4" text=" is a good middle ground between the Classic and Trilux. It has two latex layers and keeps the coils, combining the benefits of each." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][952,1794]" /></node><node index="49" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="I've only tested one mattress like the EOS Classic, the " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][966,1794]" /><node index="1" text="Bedgear M3 Performance Mattress" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[112,1792][774,1794]" /><node index="2" text=". It costs $1,000 less than the Naturepedic and has four firmness options on each side, with a much softer Plush than the EOS Classic. I slept really well on the Bedgear M3 Performance, but it isn't made of organic materials, runs a little hot, has poor edge support, and has a short trial period (just 30 nights). It's a memory foam hybrid, and the coils influence the various firmness. Read my full " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][958,1794]" /><node index="3" text="Bedgear M3 Performance Mattress review" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[112,1792][903,1794]" /><node index="4" text="." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[900,1792][913,1794]" /></node><node index="50" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="If you want to keep it organic and are a hot sleeper, I recommend the " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][837,1794]" /><node index="1" text="PlushBeds Botanical Bliss Organic Latex Mattress" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][910,1794]" /><node index="2" text=", the cooling pick in our " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][939,1794]" /><node index="3" text="best organic mattresses" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[115,1792][572,1794]" /><node index="4" text=" guide. It's $1,350 cheaper than the EOS Classic and offers a dual-firmness, but it's only available in Medium and Medium-Firm options and has poor edge support. Still, I loved the pressure point relief, and it's backed by a lifetime warranty." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][971,1794]" /></node><node index="51" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="For more recommendations, check out our guide to the " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][952,1794]" /><node index="1" text="best mattresses" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[162,1792][467,1794]" /><node index="2" text="." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[464,1792][477,1794]" /></node><node index="52" text="The bottom line" resource-id="4d1ec318-32da-423b-9233-febeced1e513" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="53" text="The Naturepedic EOS Classic Organic Mattress a smart, long-term investment and eco-conscious solution for your relationship — with your partner and your sleep health. Naturepedic" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]"><node index="0" text="naturepedic bed with pillows on top" resource-id="" class="android.widget.Image" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]" /><node index="1" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]"><node index="0" text="The Naturepedic EOS Classic Organic Mattress a smart, long-term investment and eco-conscious solution for your relationship — with your partner and your sleep health." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][850,1794]" /><node index="1" text="Naturepedic" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1792][868,1794]" /></node></node><node index="54" text="Despite sleeping warm, the Naturepedic EOS Classic Organic Mattress is an outstanding option for couples, thanks to its impressive motion isolation and edge support. The dual-sided firmness customization is ideally suited for sleeping partners with different comfort preferences. Its lengthy warranty, eco-credentials, and ability to update the firmness over time make it a smart, long-term, eco-conscious solution." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]" /><node index="55" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][973,1794]"><node index="0" text="Read the original article on " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1792][556,1794]" /><node index="1" text="Business Insider" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[553,1792][863,1794]" /></node></node></node></node></node></node></node></node></node></node><node index="1" text="" resource-id="android:id/statusBarBackground" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,63]" /><node index="2" text="" resource-id="android:id/navigationBarBackground" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /></node></hierarchy>