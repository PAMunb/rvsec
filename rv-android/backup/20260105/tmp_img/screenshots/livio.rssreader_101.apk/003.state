                                                                                             ]
                                                                                          ],
                                                                                          "resource_id": "8c5b86e8-1f94-457d-a2cc-b0311a7488b9",
                                                                                          "checked": false,
                                                                                          "text": "I eventually acted on the promise I made with my sister",
                                                                                          "class": "android.view.View",
                                                                                          "scrollable": false,
                                                                                          "selected": false,
                                                                                          "long_clickable": false,
                                                                                          "parent": 259,
