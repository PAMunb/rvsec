"false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[175,1792][231,1794]" /></node><node index="2" text="Click to download the app" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[296,1792][540,1794]" /></node><node index="3" text="" resource-id="" class="android.widget.ListView" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]"><node index="0" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[112,1792][1021,1794]"><node index="0" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][84,1794]" /><node index="1" text="When my sister was dying of breast cancer, she made me promise I'd live my life to the fullest." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[112,1792][966,1794]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[112,1792][1021,1794]"><node index="0" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][84,1794]" /><node index="1" text="At first, I didn't follow through, but eventually I found the courage to act on my promise." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[112,1792][950,1794]" /></node><node index="2" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[112,1792][1021,1794]"><node index="0" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][84,1794]" /><node index="1" text="I decided to move on my own to a beach town, where I met my husband." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[112,1792][950,1794]" /></node></node><node index="4" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]"><node index="0" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]"><node index="0" text="When my older sister called to let me know that the painful lump in her breast was not a clogged milk duct from nursing her newborn, my world shattered. My 31-year-old sister was diagnosed with " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1008,1794]" /><node index="1" text="stage 3C breast cancer" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[388,1792][850,1794]" /><node index="2" text="." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[845,1792][861,1794]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1792][1080,1794]"><node index="0" text="AD" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[506,1792][574,1794]" /><node index="1" text="" resource-id="gpt-post-health-mobile_in_post_ad-mobile-fluid-1" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[540,1792][540,1794]" /></node><node index="2" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1792][1080,1794]"><node index="0" text="AD" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[506,1792][574,1794]" /><node index="1" text="" resource-id="gpt-post-health-desktop_in_post_ad-desktop-fluid-1" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[540,1792][540,1794]" /></node><node index="3" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]"><node index="0" text="I immediately purchased a " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][627,1794]" /><node index="1" text="one-way plane ticket" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][931,1794]" /><node index="2" text=" to stay with her and help with my 2-year-old nephew and newborn niece. Over the next two and a half years, I watched my once strong and bossy sister slowly become bedridden. She then became unable to walk or breathe without oxygen." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1018,1794]" /></node><node index="4" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]"><node index="0" text="In our final conversation, I told her I wished I could take her place. After all, I had no children and was in an " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][997,1794]" /><node index="1" text="unhappy marriage" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[538,1792][929,1794]" /><node index="2" text=". My sister replied that she was glad it was her and not me. She said she wanted me to have children and truly experience life." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1015,1794]" /></node><node index="5" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]"><node index="0" text="Related video" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /><node index="1" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]"><node index="0" text="" resource-id="player-container-gRaMBwHB" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /></node><node index="2" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1792][1080,1794]" /></node><node index="6" text="She then asked me to promise to live a life for both of us, doing the things she wouldn't be able to do. She encouraged me to create happiness despite whatever difficult decisions I'd have to make. I made her that promise, altering my life forever." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /><node index="7" text="At first, I couldn't handle the grief and ignored the promise I made" resource-id="a93e924b-1e92-4cf6-bc65-165d8c55ed46" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /><node index="8" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]"><node index="0" text="Her passing, though ultimately expected, rocked my sense of mortality and shattered me. We had always talked about growing old together in a " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][981,1794]" /><node index="1" text="nursing home" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[330,1792][624,1794]" /><node index="2" text=" and bickering with each other when we were 95, sharing a room like we did when we were kids." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][958,1794]" /></node><node index="9" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]"><node index="0" text="At 27, I was deeply cognizant that I had no guarantee of time. Like everyone else, I thought I had decades before thinking about mortality, let alone a " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][984,1794]" /><node index="1" text="bucket list" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[498,1792][719,1794]" /><node index="2" text="." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[714,1792][732,1794]" /></node><node index="10" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1792][1080,1794]"><node index="0" text="AD" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[506,1792][574,1794]" /><node index="1" text="" resource-id="gpt-post-health-mobile_in_post_ad-mobile-fluid-2" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[540,1792][540,1794]" /></node><node index="11" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1792][1080,1794]"><node index="0" text="AD" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[506,1792][574,1794]" /><node index="1" text="" resource-id="gpt-post-health-desktop_in_post_ad-desktop-fluid-2" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[540,1792][540,1794]" /></node><node index="12" text="I was in denial for years. I lacked direction, strength, and self-worth." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /><node index="13" text="Running became my outlet for grief. When I'd get tired and wanted to stop, I pictured my sister in her wheelchair, gasping for air, and took another step for her." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /><node index="14" text="After my sister died, I had no mental or emotional energy to deal with my failing marraige. Having a baby didn't fix it." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /><node index="15" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1792][1080,1794]"><node index="0" text="AD" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[506,1792][574,1794]" /><node index="1" text="" resource-id="gpt-post-health-mobile_in_post_ad-mobile-fluid-3" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[540,1792][540,1794]" /></node><node index="16" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1792][1080,1794]"><node index="0" text="AD" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[506,1792][574,1794]" /><node index="1" text="" resource-id="gpt-post-health-desktop_in_post_ad-desktop-fluid-3" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[540,1792][540,1794]" /></node><node index="17" text="I wondered if this was the life my sister envisioned for me as she was dying. Suddenly, I knew it wasn't. At 29, I finally admitted I was anything but happy and knew it was time to make a change." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /><node index="18" text="I eventually acted on the promise I made with my sister" resource-id="8c5b86e8-1f94-457d-a2cc-b0311a7488b9" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /><node index="19" text='Braving the judgment I knew I&apos;d face, I left my marriage and moved states with my infant and two large dogs to fulfill my dream of living near the beach despite having no family nearby to help. I started saying "yes" to more things and tackling my newly created bucket list.' resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /><node index="20" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]"><node index="0" text="An opportunity to visit Hawaii arose, and I jumped on it. In just one week, I skydived, got " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1005,1794]" /><node index="1" text="scuba certified" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][370,1794]" /><node index="2" text=", hiked a mountain at sunrise, and swam with sharks." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][984,1794]" /></node><node index="21" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1792][1080,1794]"><node index="0" text="AD" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[506,1792][574,1794]" /><node index="1" text="" resource-id="gpt-post-health-mobile_in_post_ad-mobile-fluid-4" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[540,1792][540,1794]" /></node><node index="22" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1792][1080,1794]"><node index="0" text="AD" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[506,1792][574,1794]" /><node index="1" text="" resource-id="gpt-post-health-desktop_in_post_ad-desktop-fluid-4" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[540,1792][540,1794]" /></node><node index="23" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]"><node index="0" text="Keeping my promise to her — to say yes, to create happiness — changed everything. I gained confidence and " resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][947,1794]" /><node index="1" text="self-esteem" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[543,1792][784,1794]" /><node index="2" text=". That transformation led me to my life partner and now-husband, whom I met on the beach. We got engaged and married on that same sand." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][989,1794]" /></node><node index="24" text="Having my second child with him and feeling renewed in my career and personal relationships, I now live a life my 90-year-old self — and my sister — would be proud of." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /><node index="25" text="I choose myself daily and remove what doesn't serve me. Every year, I celebrate aging; each birthday I see means I'm still alive, and I will never take that for granted." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /><node index="26" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1792][1080,1794]"><node index="0" text="AD" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[506,1792][574,1794]" /><node index="1" text="" resource-id="gpt-post-health-mobile_in_post_ad-mobile-fluid-5" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[540,1792][540,1794]" /></node><node index="27" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1792][1080,1794]"><node index="0" text="AD" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[506,1792][574,1794]" /><node index="1" text="" resource-id="gpt-post-health-desktop_in_post_ad-desktop-fluid-5" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[540,1792][540,1794]" /></node><node index="28" text="I still live near the same beach where I rebuilt my life, and my car is covered in sand, dog hair, kids' toys, and sunscreen — just as I had always hoped." resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1792][1021,1794]" /></node></node><node index="1" text="" resource-id="" class="android.view.View" package="livio.rssreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1792][1080,1794]"><node index="0" text="" resource-id="" class="android.view.