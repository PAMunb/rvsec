ble="false" password="false" selected="false" bounds="[0,63][1080,1794]"><node index="0" text="Three (or N-) Cups Problem" resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[21,84][1063,283]" /><node index="1" text="" resource-id="" class="android.widget.ListView" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[21,336][1063,1270]"><node index="0" text="" resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,336][1063,438]"><node index="0" text="• " resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[91,336][110,388]" /><node index="1" text="There's some amount (N, traditionally 3) of cups that can be up or down." resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,336][1021,438]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,435][1063,535]"><node index="0" text="• " resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[91,435][110,488]" /><node index="1" text="Every move, (M, traditionally 2) cups must be flipped (no more or less)." resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,435][958,535]" /></node><node index="2" text="" resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,532][1063,585]"><node index="0" text="• " resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[91,532][110,585]" /><node index="1" text="The goal is to get all cups to be up-facing." resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,532][903,585]" /></node><node index="3" text="" resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,582][1063,682]"><node index="0" text="• " resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[91,582][110,635]" /><node index="1" text="Some configurations of this problem are solvable, and some aren't." resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,582][1050,682]" /></node><node index="4" text="" resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,679][1063,1076]"><node index="0" text="• " resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[91,679][110,732]" /><node index="1" text="It may seem evident that it's unsolvable when the amount of down cups is not divisible by the move count, but a proof that this is incorrect can be seen here for N=8 and M=4:" resource-id="" class="android.view.View" package="t20kdc.offlinepuzzlesolver" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" 