heckable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[70,105][1010,223]"><node index="0" text="Introduction" resource-id="android:id/alertTitle" class="android.widget.TextView" package="info.zamojski.soft.towercollector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[133,152][947,223]" /></node></node><node index="1" text="" resource-id="android:id/customPanel" class="android.widget.FrameLayout" package="info.zamojski.soft.towercollector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[70,223][1010,1603]"><node index="0" text="" resource-id="android:id/custom" class="android.widget.FrameLayout" package="info.zamojski.soft.towercollector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[70,223][1010,1603]"><node index="0" text="" resource-id="" class="android.widget.ScrollView" package="info.zamojski.soft.towercollector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[70,223][1010,1603]"><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="info.zamojski.soft.towercollector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[70,223][1010,1603]"><node index="0" text="The purpose&#10;&#10;The app is designed to collect GPS coordinates correlated with information about mobile cell towers. It is designed to help map the extent of mobile phone network coverage.&#10;&#10;How to start&#10;&#10;To start select 'Start collecting' option (record icon) from menu on the top of the screen. Measurements will be collected only when you're in range of mobile network and GPS gives your position with at least 40 meters accuracy.&#10;&#10;Next steps&#10;&#10;Collected data can be uploaded to OpenCellID.org and Mozilla Location Services databases or exported to a file. Before first upload you will need to select databases you want to contribute to. In case of OpenCellID.org you'll additionally need to register for free and enter received access token in Preferences. Measurements will be deleted from your device after successful upload.&#10;&#10;More&#10;&#10;Best practices and additional information available in Information section in Preferences." resource-id="info.zamojski.soft.towercollector:id/html_info_dialog_textview" class="android.widget.TextView" package="info.zamojski.soft.towercollector" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[102,255][978,1603]" /></node></node></node></node><node index="2" text="" resource-id="android:id/buttonPanel" class="android.widget.ScrollView" package="info.zamojski.soft.towercollector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[70,1603][1010,1751]"><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="info.zamojski.soft.towercollector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable=