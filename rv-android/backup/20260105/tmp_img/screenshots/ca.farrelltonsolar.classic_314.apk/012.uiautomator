"false" long-clickable="false" password="false" selected="false" bounds="[301,1145][714,1198]" /></node><node index="4" text="Classic Monitor is a status monitor for Midnite Solar 's, Classic 150, 200, 250 Charge Controller (www.midniteSolar.com)." resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[21,1234][1063,1387]" /><node index="5" text='It is a Read Only Program, it does not write to the Classic.&#10;The software is provided "AS IS", WITHOUT WARRANTY OF ANY KIND, express or implied.&#10;Classic Monitor is NOT a product of Midnite solar, nor do they support this application.' resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[21,1423][1063,1723]" /><node index="6" text="" resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[21,1751][1063,1752]"><node index="0" text="If the app detects a Whizbang Junior current monitor, the State Of Charge Tab will display with a bi-directional current gauge and SOC gauge." resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[21,1751][1055,1752]" /><node index="1" text="&#10;" resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1751][1080,1752]" /><node index="2" text="Basic support for the Tristar MPPT charge controller from Morningstar is also included." resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[21,1751][997,1752]" /><node index="3" text="&#10;" resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1751][1080,1752]" /><node index="4" text="The daily energy recorded logs can be forwarded to " resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[21,1751][976,1752]" /><node index="5" text="pvoutput.org" resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[21,1751][259,1752]" /><node index="6" text=" by supplying an API key and SID# in the settings for each controller." resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[21,1751][1002,1752]" /></node><node index="7" text="This app uses the following open source components." resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[21,1751][1063,1752]" /><node index="8" text="" resource-id="" class="android.widget.ListView" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[21,1751][1063,1752]"><node index="0" text="" resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,1751][1063,1752]"><node index="0" text="• " resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[91,1751][110,1752]" /><node index="1" text="J2MOD modbus library created by Julie Haugh located at " resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,1751][992,1752]" /><node index="2" text="SourceForge" resource-id="" class="android.view.View" package="ca.farrelltonsolar.classic" content-desc="" checkable="false" c