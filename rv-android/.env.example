# RV-Android — canonical environment variable inventory (gh55).
#
# Every name listed here corresponds to an `ENV_*` constant in
# `modules/rv-android-core/src/rv_android_core/constants.py`. The Docker entry
# point (`docker/rvandroid/docker-entrypoint.sh`) validates the runtime
# environment against this allow-list and exits 64 if an unknown `RV_*` (or
# legacy non-`RV_*` L1 cross-layer infra) name is set.
#
# Layer Purity (gh55 INV-EXP-30): the Python layer that reads these is
# `rv-experiment` (L5). The L1 cross-layer infra family — `RV_PYDANTIC*`,
# `RVSEC_HOME`, `ANDROID_HOME`, `TOOLS_DIR`, `RV_EMULATOR_BOOT_TIMEOUT`,
# `RV_ADB_CMD_TIMEOUT`, `RV_APK_INSTALL_TIMEOUT` — is read by `rv-android-core`
# utilities (`util/validation/config.py`, `util/jar_resolver.py`,
# `util/android/android.py`). No other module reads these names directly.
#
# Copy this file to `.env` (gitignored) when running locally without Docker:
#   cp .env.example .env
#   set -a; source .env; set +a
#   uv run rv-experiment run --tools monkey ...
# Or pass selectively: `RV_TOOLS=monkey RV_TIMEOUTS=300 uv run rv-experiment run`.

# =============================================================================
# Inputs (APK source + tool selection)
# =============================================================================

# Directory containing the APKs to instrument and execute.
# CLI flag: --apks-dir
RV_APKS_DIR=./apks_examples

# Tool specification DSL. Format: `name[:variant][@param1=v1,param2=v2]`,
# multiple tools comma-separated. See `rv-experiment list-tools --detailed`.
# CLI flag: --tools
RV_TOOLS=monkey

# Tool variant for instrumentation pipeline (`ajc` legacy, `dexlib2` DEX-native).
# CLI flag: --instrumentation-variant
RV_INSTRUMENTATION_VARIANT=ajc

# Specification set: jca | generic | custom (use --custom-specs-dir with custom).
# Replaces the removed RV_JCA_SPEC.
# CLI flag: --specification-set
RV_SPEC_SET=jca

# Optional file listing APK basenames (one per line) to filter the run.
# CLI flag: --apks-filter
# RV_APKS_FILTER=./filters/jca400.txt

# =============================================================================
# Execution parameters
# =============================================================================

# Timeouts per task in seconds. Comma-separated list; each value is one arm of
# the task matrix (e.g. RV_TIMEOUTS=60,300 runs both timeouts in one invocation).
# CLI flag: --timeouts
RV_TIMEOUTS=300

# Repetitions per (APK, tool, timeout) combination.
# CLI flag: --repetitions
RV_REPETITIONS=1

# Adb device port for parallel execution; each container needs its own.
# CLI flag: --device-port
# RV_DEVICE_PORT=5554

# Headless emulator (true for Docker / CI; false for visual debugging).
# CLI flag: --no-window / --window
RV_NO_WINDOW=true

# Stagger parallel container starts (seconds). Handled by the Docker entry
# point itself before exec; not a CLI flag.
# RV_DELAY=30

# Experiment identity (enables resume via tasks.json).
# CLI flag: --name
# RV_EXPERIMENT_NAME=batch_01

# Explicit resume directory (overrides --name's auto-resume).
# CLI flag: --resume-dir
# RV_RESUME_DIR=./results/batch_01

# =============================================================================
# Skip flags (pre-processing phases + execution)
# =============================================================================

# Skip rv-monitor-generator (when monitors already exist in out/).
# CLI flag: --skip-monitors
# RV_SKIP_MONITORS=true

# Skip APK instrumentation (when instrumented_apks/ already exists).
# CLI flag: --skip-instrument
# RV_SKIP_INSTRUMENT=true

# Skip rv-static-analysis (GATOR/GESDA/REACH).
# CLI flag: --skip-static
# RV_SKIP_STATIC_ANALYSIS=true

# Skip the execution phase entirely (preprocessing-only mode).
# CLI flag: --skip-execution
# RV_SKIP_EXECUTION=true

# Disable the gh50 §22 ajc library-class quarantine phase. ajc-only.
# CLI flag: --no-quarantine
# RV_NO_QUARANTINE=true

# =============================================================================
# Static analysis tuning
# =============================================================================

# Pre-computed static analysis directory mounted into the container; the entry
# point copies the SA files from here to instrumented_apks/.
# (No CLI flag — this is a Docker-only path-resolution input.)
# RV_SA_DIR=/mnt/sa_cache

# Static analysis timeout in seconds (overrides Pydantic default 600).
# Precedence (gh55 INV-EXP-32): CLI > env > default.
# CLI flag: --analysis-timeout
# RV_SA_TIMEOUT=900

# JVM memory for static analysis (e.g. "4g", "6g", "8g").
# Precedence (gh55 INV-EXP-32): CLI > env > default.
# CLI flag: --jvm-memory
# RV_JVM_MEMORY=4g

# Select which package scopes the classes the analysis treats as the app's own.
# Unset or false: App.code_package reports the applicationId declared in the
# manifest, verbatim — no suffix stripping, no prefix repair. True: PackageDetector
# elects the implementation package heuristically, which suits corpora whose
# classes do not live under the declared identifier (Godot games, for example).
# Which answer is right is a property of the corpus, not of the APK, so the tool
# asks rather than infers.
# Read at both entry points — `rv-experiment` and the standalone
# `rv-static-analysis` command — under the same precedence.
# Precedence (gh55 INV-EXP-32): CLI > env > default.
# CLI flag: --package-detector / --no-package-detector
# RV_PACKAGE_DETECTOR=true

# =============================================================================
# Emulator boot and device timeouts
# =============================================================================
#
# Read at the point of use by `util/android/android.py` (L1 cross-layer infra
# exception): the correct value follows from the host and its concurrency
# level, not from the experiment. Every task cold-boots its emulator — the AVD
# runs with `-read-only`, `-no-cache` and `-no-snapshot-save`, so nothing is
# ever cached between tasks — and 8 to 16 containers compete for KVM, CPU and
# RAM. A value that is set but is not a valid integer raises rather than
# silently reverting to the default.

# Total seconds allowed across both boot phases (boot animation, then
# sys.boot_completed). PROVISIONAL: 180 s was exceeded 322 times historically
# (p50 182 s, p90 210 s, max 871 s), so 300 s is an improvement of unknown
# sufficiency. The real distribution is collected by observing the first
# experiment run after gh92 (design D9); if boot timeouts appear, raise this
# value — do not weaken the gate.
# (No CLI flag — an environment property, not an experiment parameter.)
# RV_EMULATOR_BOOT_TIMEOUT=300

# Seconds allowed for each individual ADB probe during the boot wait. A probe
# that exceeds it is killed and retried against the remaining boot budget.
# (No CLI flag — an environment property, not an experiment parameter.)
# RV_ADB_CMD_TIMEOUT=30

# Seconds allowed for `adb install`. Chosen by judgement: no distribution of
# install durations exists, and the worse failure mode is killing a healthy
# slow install, so the value errs long. It bounds a hung install that would
# otherwise hold the emulator session open for the whole task.
# (No CLI flag — an environment property, not an experiment parameter.)
# RV_APK_INSTALL_TIMEOUT=600

# =============================================================================
# Tool-specific overrides
# =============================================================================

# Humanoid inference server URL. When unset, the variant default
# `127.0.0.1:50405` (in `humanoid/tool.py:get_variants`) carries through.
# Set this to point at the SGLang/Humanoid service container in Docker compose.
# (No CLI flag — flows through ToolConfig.parameters at L5.)
# RV_HUMANOID_URL=http://humanoid:50405

# =============================================================================
# Developer toggles
# =============================================================================

# Enable verbose logging.
# CLI flag: --debug
# RV_DEBUG=true

# Pydantic full-validation mode (development only — adds runtime overhead).
# RV_PYDANTIC=true

# Pydantic strict-mode (additionally enforces strict-type coercion).
# RV_PYDANTIC_STRICT=false

# Pydantic per-validation event logging (very verbose).
# RV_PYDANTIC_LOG=false

# Opt-in capture of execution-level diagnostic events (crashes, VerifyError,
# ANR) into the logcat pipeline. When unset, logcat capture stays
# byte-identical to the RVSEC/RVSEC-COV baseline.
# RV_LOGCAT_DIAGNOSTICS=true

# =============================================================================
# L1 cross-layer infra paths (legacy non-RV_* names)
# =============================================================================

# RVSEC workspace root (parent of rv-android/, rvsec/, javamop/).
# Required for monitor generation, instrumentation, and JarResolver.
RVSEC_HOME=/opt/rvsec

# Android SDK root.
# Required for APK build/instrumentation and emulator management.
ANDROID_HOME=/opt/android-sdk

# Optional tool-binary directory (alternative search root for ape, droidmate,
# fastbot, aperv jars). Read once by JarResolver (gh55 D10); never read by L2.
# TOOLS_DIR=/opt/tools
