package mop;

import javax.crypto.Cipher;
import java.security.Key;

OrderProbeSpec(Cipher c) {

   creation event g1 after(String t) returning(Cipher c):
     call(public static Cipher Cipher.getInstance(String)) &&
     args(t) {
        System.out.println("[EV] g1");
   }

   event i2 after(Cipher c, int mode, Key k):
     call(public void Cipher.init(int, java.security.Key)) &&
     args(mode, k) && target(c) {
        System.out.println("[EV] i2");
   }

   event f1 after(Cipher c) returning(byte[] ct):
     call(public byte[] Cipher.doFinal()) &&
     target(c) {
        System.out.println("[EV] f1   <-- declarado PRIMEIRO");
   }

   event f2 after(Cipher c) returning(byte[] ct):
     call(public byte[] Cipher.doFinal(..)) &&
     target(c) {
        System.out.println("[EV] f2   <-- declarado DEPOIS");
   }

   ere : g1 i2 (f1 | f2)*

   @fail  { System.out.println("[FAIL ] ev=" + __EVENTNAME); __RESET; }
}
