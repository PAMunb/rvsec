SPEC java.security.MessageDigest

OBJECTS
  java.lang.String digestAlg;
  byte[] out;
  byte[] inp;

EVENTS
  g1: getInstance(digestAlg);
  g2: getInstance(digestAlg, _);
  Gets := g1 | g2;
  d1: out = digest();
  d2: out = digest(inp);
  Fora := d2;

ORDER
  Gets, d1

ENSURES
  digested[out] after Fora;
