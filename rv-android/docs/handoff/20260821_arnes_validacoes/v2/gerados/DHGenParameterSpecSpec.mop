package mop;

import javax.crypto.spec.DHGenParameterSpec;
import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.ExecutionContext;
import br.unb.cic.mop.Property;

DHGenParameterSpecSpec(DHGenParameterSpec s) {

    DHGenParameterSpec spec;
    creation event c1 after(int primeSize, int exponentSize)returning(DHGenParameterSpec s) :call(public DHGenParameterSpec.new(int, int)) && args(primeSize, exponentSize){
        spec = s;
    }
    ere: c1
    @fail
        {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "DHGenParameterSpecSpec", "" + __LOC, "v=1 code=DHGENPARAMETERSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=DHGenParameterSpec val='' exp='' msg='the observed call sequence is not one DHGenParameterSpecSpec accepts'"));
            __RESET;
        }
    @match
        {
            ExecutionContext.instance().setProperty(Property.PREPARED_DH, spec);
            ExecutionContext.instance().setObjectAsInAcceptingState(spec);
        }
}

