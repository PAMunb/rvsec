@startuml rvdroid_strategy_framework
!theme plain
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam ArrowColor black
skinparam useBetaStyle true

title RVDroid Strategy Framework Architecture

package "Strategy Framework" {
  abstract class Strategy {
    + {abstract} select_action(state: UIState, context: ContextInfo): UIAction
    + {abstract} get_strategy_name(): string
    + {abstract} get_strategy_priority(): number
    + can_handle_state(state: UIState): boolean
    + rate_action_options(actions: UIAction[]): void
    + on_action_result(action: UIAction, result: ActionResult): void
    # _filter_actions(actions: UIAction[]): UIAction[]
    # _rank_actions(actions: UIAction[]): UIAction[]
  }
  
  package "Basic Strategies" {
    class RandomStrategy {
      + select_action(state: UIState, context: ContextInfo): UIAction
      + get_strategy_name(): string
      + get_strategy_priority(): number
      - _get_weighted_random(actions: UIAction[]): UIAction
      - _adjust_weights(action: UIAction, result: ActionResult): void
    }
    
    class SystematicStrategy {
      + select_action(state: UIState, context: ContextInfo): UIAction
      + get_strategy_name(): string
      + get_strategy_priority(): number
      - _get_next_uncovered_element(): UIElement
      - _track_covered_elements(element: UIElement): void
      - _create_traversal_plan(state: UIState): UIElement[]
    }
  }
  
  package "Advanced Strategies" {
    class SpecificationFocusedStrategy {
      + select_action(state: UIState, context: ContextInfo): UIAction
      + get_strategy_name(): string
      + get_strategy_priority(): number
      - _find_path_to_monitored_method(state: UIState): UIAction[]
      - _evaluate_monitored_method_proximity(element: UIElement): number
      - _get_monitored_methods(): MonitoredMethod[]
    }
    
    class FormCompletionStrategy {
      + select_action(state: UIState, context: ContextInfo): UIAction
      + get_strategy_name(): string
      + get_strategy_priority(): number
      - _detect_form(state: UIState): FormStructure
      - _generate_form_inputs(form: FormStructure): Map<UIElement, string>
      - _get_form_submission_element(form: FormStructure): UIElement
    }
  }
  
  package "Adaptive Strategies" {
    class LearningStrategy {
      + select_action(state: UIState, context: ContextInfo): UIAction
      + get_strategy_name(): string
      + get_strategy_priority(): number
      - _update_action_effectiveness(action: UIAction, result: ActionResult): void
      - _get_most_effective_action(state: UIState): UIAction
      - _explore_vs_exploit(): ExplorationMode
    }
    
    class CoverageOptimizedStrategy {
      + select_action(state: UIState, context: ContextInfo): UIAction
      + get_strategy_name(): string
      + get_strategy_priority(): number
      - _calculate_coverage_gain(action: UIAction): number
      - _get_coverage_metrics(): CoverageMetrics
      - _predict_state_transition(action: UIAction): UIState
    }
  }
  
  class VisualAwareStrategy {
    + select_action(state: UIState, context: ContextInfo): UIAction
    + get_strategy_name(): string
    + get_strategy_priority(): number
    - _analyze_screenshot(screenshot: Screenshot): VisualAnalysis
    - _identify_ui_elements_from_visual(visual: VisualAnalysis): UIElement[]
    - _detect_visual_patterns(visual: VisualAnalysis): VisualPattern[]
  }
  
  package "Strategy Selection" {
    class StrategyBalancer {
      + select_strategy(state: UIState, context: ContextInfo): Strategy
      + register_strategy(strategy: Strategy): void
      + update_strategy_weights(strategy: Strategy, success_rate: number): void
      + set_preferred_strategy(strategy_name: string): void
      + get_strategy_stats(): StrategyStats
      - _calculate_weights(): Map<Strategy, number>
      - _select_weighted_strategy(): Strategy
    }
    
    class StrategyStats {
      + strategy_name: string
      + success_rate: number
      + usage_count: number
      + average_execution_time: number
      + coverage_contribution: number
    }
  }
}

' Relationships
Strategy <|-- RandomStrategy
Strategy <|-- SystematicStrategy
Strategy <|-- SpecificationFocusedStrategy
Strategy <|-- FormCompletionStrategy
Strategy <|-- LearningStrategy
Strategy <|-- CoverageOptimizedStrategy
Strategy <|-- VisualAwareStrategy

StrategyBalancer --> Strategy : manages
StrategyBalancer --> StrategyStats : tracks

@enduml