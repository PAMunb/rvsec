@startuml tf_comparative_analysis
!theme plain
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam ArrowColor black
skinparam useBetaStyle true

title Comparative Analysis Process

package "Input Configurations" {
  [Configuration A] as ConfigA
  [Configuration B] as ConfigB
  [Configuration C] as ConfigC
  [Configuration D] as ConfigD
}

package "Execution & Results" {
  [Execution Engine] as Execution
  
  package "Raw Results" {
    [Results A] as ResultsA
    [Results B] as ResultsB
    [Results C] as ResultsC
    [Results D] as ResultsD
  }
}

package "Comparative Analysis" {
  [Metric Standardizer] as Standard
  [Comparative Analyzer] as CompAnalyzer
  [Statistical Processor] as StatProc
  [Ranking Engine] as Ranking
}

package "Outputs" {
  [Comparative Metrics] as CompMetrics
  [Performance Rankings] as Rankings
  [Configuration Insights] as Insights
  [Optimal Configurations] as Optimal
}

ConfigA --> Execution
ConfigB --> Execution
ConfigC --> Execution
ConfigD --> Execution

Execution --> ResultsA
Execution --> ResultsB
Execution --> ResultsC
Execution --> ResultsD

ResultsA --> Standard
ResultsB --> Standard
ResultsC --> Standard
ResultsD --> Standard

Standard --> CompAnalyzer : Normalized metrics
CompAnalyzer --> StatProc : Comparative data
StatProc --> Ranking : Statistical analysis

CompAnalyzer --> CompMetrics
Ranking --> Rankings
StatProc --> Insights
Ranking --> Optimal

note bottom of Optimal
  Identifies the optimal configuration
  for each app or app class
end note

@enduml