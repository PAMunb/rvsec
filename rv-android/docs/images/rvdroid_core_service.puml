@startuml rvdroid_core_service
!theme plain
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam ArrowColor black
skinparam useBetaStyle true

title RVDroid Core Service Architecture

class RVDroidService {
  + constructor(config: Configuration)
  + initialize(): void
  + start_testing(apk_path: string): Promise
  + stop_testing(): void
  + pause_testing(): void
  + resume_testing(): void
  + get_status(): TestingStatus
  - _setup_components(): void
  - _coordinate_testing_cycle(): void
  - _handle_errors(error: Error): void
}

class Configuration {
  + llm_config: LLMConfiguration
  + memory_config: MemoryConfiguration
  + strategy_config: StrategyConfiguration
  + execution_config: ExecutionConfiguration
  + timeout: number
  + static_analysis: boolean
  + screenshot_analysis: boolean
  + validate(): ValidationResult
}

class Runner {
  + start(apk_path: string): Promise
  + stop(): void
  + execute_cycle(): Promise
  - _process_results(results: ActionResult): void
  - _handle_cycle_completion(): void
}

class TestingStatus {
  + current_phase: TestingPhase
  + execution_time: number
  + actions_executed: number
  + unique_screens: number
  + coverage_metrics: CoverageMetrics
  + errors_encountered: number
  + is_completed: boolean
}

enum TestingPhase {
  INITIALIZATION
  EXPLORATION
  CONSULTATION
  ADAPTATION
  RECOVERY
  TERMINATION
}

class CoverageMetrics {
  + activity_coverage: number
  + method_coverage: number
  + ui_coverage: number
  + monitored_methods_coverage: number
  + calculate_overall(): number
}

RVDroidService --> Configuration: uses
RVDroidService --> Runner: manages
RVDroidService --> TestingStatus: provides
TestingStatus --> TestingPhase: tracks
TestingStatus --> CoverageMetrics: includes

note bottom of RVDroidService
  The core service acts as the central
  coordination point for all RVDroid
  subsystems and manages the overall
  testing lifecycle.
end note

@enduml