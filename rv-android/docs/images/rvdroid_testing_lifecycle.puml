@startuml rvdroid_testing_lifecycle
!theme plain
skinparam backgroundColor white
skinparam ArrowColor black
skinparam useBetaStyle true

title RVDroid Testing Lifecycle

|Initialization Phase|
start
:Load configuration;
:Initialize core components;
:Install APK on emulator;
:Load static analysis data;
:Launch application;
:Capture initial state;
:Initialize memory system;

|Exploration Phase|
repeat
  :Capture current UI state;
  :Analyze state;
  :Add to memory system;
  :Generate action candidates;
  
  if (LLM enabled?) then (yes)
    |Consultation Phase|
    :Prepare LLM context;
    :Send state + context to LLM;
    :Receive LLM guidance;
    :Parse directives;
    
    |Adaptation Phase|
    :Adjust strategies based on LLM guidance;
    :Update exploration parameters;
    :Update memory focus;
  endif
  
  |Exploration Phase|
  :Select testing strategy;
  :Strategy selects action;
  :Execute action on device;
  
  if (Action succeeded?) then (yes)
    :Record action success;
    :Update memory with result;
  else (no)
    |Recovery Phase|
    :Identify error type;
    :Select recovery strategy;
    
    if (Simple recovery possible?) then (yes)
      :Perform simple recovery;
    else (no)
      if (Complex recovery needed?) then (yes)
        :Restart application;
      else (no)
        :Restart emulator;
      endif
    endif
    
    :Return to stable state;
    |Exploration Phase|
  endif
  
  :Update progress metrics;
  :Check timeout condition;
repeat while (Timeout not reached && goals not met)

|Termination Phase|
:Aggregate results;
:Generate final report;
:Clean up resources;
stop

@enduml