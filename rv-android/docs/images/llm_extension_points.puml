@startuml llm_extension_points

skinparam handwritten false
skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Verdana"
skinparam defaultFontSize 12

!define PRIMARY_COLOR #3F51B5
!define SECONDARY_COLOR #FF9800
!define ACCENT_COLOR #4CAF50
!define EXTENSION_COLOR #FFCC80

skinparam component {
  BackgroundColor White
  BorderColor PRIMARY_COLOR
  ArrowColor PRIMARY_COLOR
}

' Define core components
package "Core Components" {
  [LLMActionService] as LAS
  [ModelFactory] as MF
  [PromptStrategyFactory] as PSF
  [ParserFactory] as PF
  [VisitorFactory] as VF
  [PromptLibrary] as PL
}

' Define extension points
package "Extension Point: LLM Providers" #EXTENSION_COLOR {
  interface "LanguageModel" as LM {
    + generate_text(prompt): String
    + generate(messages): String
    + cleanup(): void
  }
  
  [OllamaLLM] .up.|> LM
  [DSPyLLM] .up.|> LM
  [FrontierLLM] .up.|> LM
  
  component "New Provider Extension" as NPE #FFEB3B {
    [NewProviderLLM] .up.|> LM
  }
}

' Define strategy extension points
package "Extension Point: Prompt Strategies" #EXTENSION_COLOR {
  interface "PromptStrategy" as PS {
    + generate_system_prompt(): String
    + generate_user_prompt(state): String
    + process_screen(state): ScreenDescription
  }
  
  [BasePromptStrategy] .up.|> PS
  [SingleActionPromptStrategy] .up.-> BasePromptStrategy
  [ComposablePromptStrategy] .up.-> BasePromptStrategy
  
  component "New Strategy Extension" as NSE #FFEB3B {
    [CustomPromptStrategy] .up.-> BasePromptStrategy
  }
}

' Define template extension points
package "Extension Point: Templates" #EXTENSION_COLOR {
  class "PromptTemplate" as PT {
    + template_text: String
    + name: String
    + version: String
    + render(variables): String
    + derive(text, name, version): PromptTemplate
  }
  
  [SystemBaseTemplate] .up.-> PT
  [UserBaseTemplate] .up.-> PT
  
  component "New Template Extension" as NTE #FFEB3B {
    [CustomTemplate] .up.-> PT
    [SpecializedTemplate] .up.-> SystemBaseTemplate
  }
}

' Define visitor extension points
package "Extension Point: Visitors" #EXTENSION_COLOR {
  interface "BaseScreenVisitor" as BSV {
    + visit(node): void
    + get_screen_description(): ScreenDescription
    + get_possible_actions(node): List<ItemAction>
  }
  
  [BasicVisitor] .up.|> BSV
  [EnhancedVisitor] .up.|> BSV
  
  component "New Visitor Extension" as NVE #FFEB3B {
    [CustomVisitor] .up.|> BSV
    [SpecializedHandler] .up.-> [ElementHandler]
  }
}

' Define connections
MF --> LM : creates
PSF --> PS : creates
VF --> BSV : creates
PL --> PT : manages

' Add extension registration methods
note bottom of MF
  <b>ModelFactory Registration</b>
  ```python
  @classmethod
  def create(cls, llm_type: str, model_name: str, **kwargs):
      if llm_type.lower() == "newprovider":
          return NewProviderLLM(model_name, **kwargs)
  ```
end note

note bottom of PSF
  <b>PromptStrategyFactory Registration</b>
  ```python
  @classmethod
  def register_strategy(cls, name: str, 
                       strategy_class, metadata=None):
      ComponentConfigurator.register_strategy(
          name, strategy_class, metadata)
  ```
end note

note bottom of PL
  <b>PromptLibrary Registration</b>
  ```python
  @classmethod
  def register_template(cls, template, category="uncategorized"):
      cls._templates[template.name] = template
      if category not in cls._categories:
          cls._categories[category] = []
      cls._categories[category].append(template.name)
  ```
end note

note bottom of VF
  <b>Visitor Registration</b>
  ```python
  @classmethod
  def create_visitor(cls, visitor_type, static_info, activity):
      if visitor_type == "custom":
          return CustomVisitor(static_info, activity)
  ```
end note

' Add extension points diagram
component [Extension Summary] as ES
note right of ES
  <b>Extension Points</b>
  
  1. <b>New LLM Providers</b>
     Implement LanguageModel interface
  
  2. <b>Custom Prompt Strategies</b>
     Extend BasePromptStrategy
  
  3. <b>Template Extensions</b>
     Create new or derive existing templates
  
  4. <b>Custom Screen Visitors</b>
     Implement BaseScreenVisitor and ElementHandlers
  
  5. <b>New Parser Types</b>
     Extend AbstractScreenParser
  
  6. <b>Tool-specific Extensions</b>
     Extend RVAndroid/RVDroid behavior
end note

@enduml