@startuml tf_high_level_architecture
!theme plain
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam defaultTextAlignment center

package "Test Framework" {
  [Configuration Management] as Config
  [Test Execution] as Exec
  [Analysis and Reporting] as Analysis
  [Advanced Analysis] as AdvAnalysis
  [CLI Interface] as CLI
  [Data Storage] as Storage
  
  CLI --> Config : commands
  CLI --> Exec : run tests
  CLI --> Analysis : analyze results
  
  Config --> Exec : provides config
  Exec --> Storage : writes results
  Exec --> Analysis : sends results
  
  Storage --> Analysis : loads data
  Analysis --> AdvAnalysis : provides data
  AdvAnalysis --> Storage : writes reports
}

@enduml