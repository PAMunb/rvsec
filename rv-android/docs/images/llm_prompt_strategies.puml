@startuml llm_prompt_strategies

skinparam handwritten false
skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Verdana"
skinparam defaultFontSize 12

!define PRIMARY_COLOR #3F51B5
!define SECONDARY_COLOR #FF9800
!define ACCENT_COLOR #4CAF50

skinparam class {
  BackgroundColor White
  BorderColor PRIMARY_COLOR
  ArrowColor PRIMARY_COLOR
}

' Define abstract base strategy
abstract class PromptStrategy {
  +{abstract} generate_system_prompt(): String
  +{abstract} generate_user_prompt(state): String
  +{abstract} process_screen(state): ScreenDescription
}

' Define concrete strategy implementations
class BasePromptStrategy {
  -logger: Logger
  -detailed_static_analysis: Boolean
  -include_screenshots: Boolean
  -system_template: PromptTemplate
  -user_template: PromptTemplate
  
  +generate_system_prompt(): String
  +generate_user_prompt(state): String
  +process_screen(state): ScreenDescription
  -_format_ui_elements(screen_description, state): String
  -_format_action_history(state): String
  -_generate_summary(activity, screen_description, state): String
  -_add_workflow_guidance(screen_description, action_history): String
  -_get_transitions_for_action(activity, widget_id, action): List<String>
}

class SingleActionPromptStrategy {
  +generate_system_prompt(): String
  -_create_action_guidance(): String
}

class ComposablePromptStrategy {
  -components: Map<String, Function>
  -component_order: List<String>
  
  +generate_user_prompt(state): String
  +add_component(name, func): void
  +set_component_order(order): void
  -_generate_header(): String
  -_generate_state_description(state): String
  -_generate_static_analysis(state): String
  -_generate_action_history(state): String
  -_generate_guidance(state): String
}

class ComposableSingleActionStrategy {
  +generate_system_prompt(): String
  +generate_user_prompt(state): String
}

class BasicPromptStrategy001 {
  +generate_system_prompt(): String
  +generate_user_prompt(state): String
}

class DSPyPromptStrategy {
  -dspy_module: Module
  -predictor: Predictor
  
  +generate_system_prompt(): String
  +generate_user_prompt(state): String
  +process_dspy_response(response): List<Dict>
}

class FrontierPromptStrategy {
  -frontier_model: FrontierModel
  -context_builder: ContextBuilder
  
  +generate_system_prompt(): String
  +generate_user_prompt(state): String
  -_build_frontier_context(state): Dict
}

' Define strategy factory
class PromptStrategyFactory {
  +{static} create(strategy_type, static_data, parser): BasePromptStrategy
  +{static} register_strategy(name, strategy_class, metadata): void
  +{static} available_strategies(): List<String>
  +{static} get_default_strategy(): String
}

' Define relationships
PromptStrategy <|-- BasePromptStrategy
BasePromptStrategy <|-- SingleActionPromptStrategy
BasePromptStrategy <|-- ComposablePromptStrategy
ComposablePromptStrategy <|-- ComposableSingleActionStrategy
BasePromptStrategy <|-- BasicPromptStrategy001
BasePromptStrategy <|-- DSPyPromptStrategy
BasePromptStrategy <|-- FrontierPromptStrategy

PromptStrategyFactory --> PromptStrategy : creates

' Define external dependencies
class ComponentConfigurator {
  +register_strategy(name, strategy_class, metadata): void
  +_registries: Map<String, Registry>
}

class StaticAnalysisData {
  +classes: Classes
  +windows: Windows
  +wtg: WindowTransitionGraph
}

class AbstractScreenParser {
  +parse(state, static_data): ScreenDescription
  +get_activity_name(state): String
}

' Define connections to external systems
BasePromptStrategy --> StaticAnalysisData : uses
BasePromptStrategy --> AbstractScreenParser : uses
PromptStrategyFactory --> ComponentConfigurator : uses

' Show usage hierarchy
package "Usage Contexts" {
  class LLMActionService
  class TestFramework
  class RVAndroidTool
  class RVDroidTool
}

LLMActionService --> PromptStrategyFactory : uses
TestFramework ..> PromptStrategyFactory : configures
RVAndroidTool ..> PromptStrategyFactory : configures
RVDroidTool ..> PromptStrategyFactory : configures

@enduml