@startuml llm_tools_integration

skinparam handwritten false
skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Verdana"
skinparam defaultFontSize 12

!define PRIMARY_COLOR #3F51B5
!define SECONDARY_COLOR #FF9800
!define ACCENT_COLOR #4CAF50
!define RVANDROID_COLOR #C5E1A5
!define RVDROID_COLOR #BBDEFB

skinparam component {
  BackgroundColor White
  BorderColor PRIMARY_COLOR
  ArrowColor PRIMARY_COLOR
}

' Define the LLM Integration System
package "LLM Integration System" {
  [LLMActionService] as LAS
  [PromptProcessor] as PP
  [LLMManager] as LM
  [ResponseProcessor] as RP
  [ActionGenerator] as AG
  [StateAnalyzer] as SA
}

' Define the RVAndroid Tool
package "RVAndroid Tool" #RVANDROID_COLOR {
  [RVAndroid Server] as RVAS
  [DroidBot Client] as DBC
  
  component "RVAndroid Workflow" {
    [DroidBot State] as DBS
    [Screen Processing] as SP
    [Action Execution] as AE
  }
}

' Define the RVDroid Tool
package "RVDroid Tool" #RVDROID_COLOR {
  [RVDroidService] as RVDS
  [UIAutomator2] as UIA2
  
  component "RVDroid Workflow" {
    [Memory System] as MS
    [Strategy Framework] as SF
    [Screenshot Analysis] as SA2
  }
}

' Define External Systems
package "External Systems" {
  [Android Emulator] as AE2
  [LLM Provider] as LLMP
}

' Define RVAndroid Flow
RVAS --> DBC : starts
RVAS --> LAS : hosts
DBC --> AE2 : controls
DBC --> DBS : captures
DBS --> RVAS : sends via REST API
RVAS --> LAS : forwards state
LAS --> PP : processes state
PP --> RP : gets response
RP --> AG : generates actions
AG --> RVAS : returns actions
RVAS --> DBC : forwards actions
DBC --> AE : executes actions
AE --> AE2 : on emulator

' Define RVDroid Flow
RVDS --> UIA2 : uses
RVDS --> LAS : integrates
UIA2 --> AE2 : interacts with
RVDS --> MS : manages history
RVDS --> SF : applies strategies
RVDS --> SA2 : analyzes images
LAS --> SF : informs
MS --> LAS : provides context

' Define External Connections
LM --> LLMP : connects to
AE2 --> DBS : produces state
AE2 --> UIA2 : produces XML

' Add explanatory notes
note bottom of RVAS #RVANDROID_COLOR
  RVAndroid uses a client-server architecture:
  - Server hosts LLMActionService
  - Client (DroidBot) sends states via REST API
  - Server processes states and returns actions
  - Client executes actions on the emulator
end note

note bottom of RVDS #RVDROID_COLOR
  RVDroid uses a more integrated approach:
  - Direct integration with UIAutomator2
  - Advanced memory system for history tracking
  - Screenshot analysis for visual understanding
  - Strategy framework for complex decision making
end note

' Add comparison table
component [Tool Comparison] as TC
note right of TC
  <b>Feature Comparison</b>
  
  | Feature | RVAndroid | RVDroid |
  |---------|-----------|---------|
  | Base Tech | DroidBot | UIAutomator2 |
  | Architecture | Client-Server | Integrated |
  | Parser | DroidBot | UIAutomator |
  | Memory | Basic | Advanced |
  | Screenshots | Limited | Comprehensive |
  | Strategy | Basic | Hierarchical |
  | Execution | External | Direct |
end note

@enduml