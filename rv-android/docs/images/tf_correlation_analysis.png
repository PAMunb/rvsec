<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" contentStyleType="text/css" data-diagram-type="ACTIVITY" height="661px" preserveAspectRatio="none" style="width:900px;height:661px;background:#FFFFFF;" version="1.1" viewBox="0 0 900 661" width="900px" zoomAndPan="magnify"><title>App Characteristic - Configuration Correlation Analysis</title><defs/><g><g class="title" data-source-line="8"><text fill="#000000" font-family="Verdana" font-size="22" font-weight="bold" lengthAdjust="spacing" textLength="681.5811" x="107.8972" y="35.4209">App Characteristic - Configuration Correlation Analysis</text></g><ellipse cx="450.1877" cy="61.6094" fill="#FFFFFF" rx="10" ry="10" style="stroke:#000000;stroke-width:1;"/><path d="M621.3372,81.6094 L621.3372,128.0078 L601.3372,132.0078 L621.3372,136.0078 L621.3372,182.4063 A0,0 0 0 0 621.3372,182.4063 L789.9836,182.4063 A0,0 0 0 0 789.9836,182.4063 L789.9836,91.6094 L779.9836,81.6094 L621.3372,81.6094 A0,0 0 0 0 621.3372,81.6094" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M779.9836,81.6094 L779.9836,91.6094 L789.9836,91.6094 L779.9836,81.6094" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="98.0269" x="627.3372" y="98.6763">- UI complexity</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="106.4629" x="627.3372" y="113.8091">- Network usage</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="121.9766" x="627.3372" y="128.9419">- Encryption usage</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="147.6465" x="627.3372" y="144.0747">- View hierarchy depth</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="114.2134" x="627.3372" y="159.2075">- Database usage</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="33.1982" x="627.3372" y="174.3403">- etc.</text><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="302.2988" x="299.0383" y="115.0234"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="282.2988" x="309.0383" y="136.1621">Extract app characteristics from static analysis</text><path d="M648.1584,192.4063 L648.1584,223.6719 L628.1584,227.6719 L648.1584,231.6719 L648.1584,262.9375 A0,0 0 0 0 648.1584,262.9375 L813.0217,262.9375 A0,0 0 0 0 813.0217,262.9375 L813.0217,202.4063 L803.0217,192.4063 L648.1584,192.4063 A0,0 0 0 0 648.1584,192.4063" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M803.0217,192.4063 L803.0217,202.4063 L813.0217,202.4063 L803.0217,192.4063" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="123.8745" x="654.1584" y="209.4731">- Coverage metrics</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="135.5288" x="654.1584" y="224.606">- Exploration metrics</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="143.8633" x="654.1584" y="239.7388">- Error detection rates</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="139.75" x="654.1584" y="254.8716">- Execution efficiency</text><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="355.9414" x="272.217" y="210.6875"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="335.9414" x="282.217" y="231.8262">Analyze test performance metrics across configurations</text><rect fill="#FFFFFF" height="47.9375" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="325.0215" x="287.677" y="282.9375"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="186.6797" x="297.677" y="304.0762">Calculate correlations between</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="305.0215" x="297.677" y="318.0449">app characteristics and configuration performance</text><rect fill="#000000" height="6" rx="2.5" ry="2.5" style="stroke:#000000;stroke-width:1;" width="888.3755" x="6" y="350.875"/><path d="M229.3223,373.7266 L229.3223,389.8594 L209.3223,393.8594 L229.3223,397.8594 L229.3223,413.9922 A0,0 0 0 0 229.3223,413.9922 L423.1436,413.9922 A0,0 0 0 0 423.1436,413.9922 L423.1436,383.7266 L413.1436,373.7266 L229.3223,373.7266 A0,0 0 0 0 229.3223,373.7266" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M413.1436,373.7266 L413.1436,383.7266 L423.1436,383.7266 L413.1436,373.7266" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="172.8213" x="235.3223" y="390.7935">Which configurations work</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="168.1177" x="235.3223" y="405.9263">well with which app types</text><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="191.3223" x="18" y="376.875"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="171.3223" x="28" y="398.0137">Identify positive correlations</text><path d="M667.8799,373.7266 L667.8799,389.8594 L647.8799,393.8594 L667.8799,397.8594 L667.8799,413.9922 A0,0 0 0 0 667.8799,413.9922 L882.3755,413.9922 A0,0 0 0 0 882.3755,413.9922 L882.3755,383.7266 L872.3755,373.7266 L667.8799,373.7266 A0,0 0 0 0 667.8799,373.7266" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M872.3755,373.7266 L872.3755,383.7266 L882.3755,383.7266 L872.3755,373.7266" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="193.4956" x="673.8799" y="390.7935">Which configurations perform</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="183.0728" x="673.8799" y="405.9263">poorly with which app types</text><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="196.7363" x="451.1436" y="376.875"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="176.7363" x="461.1436" y="398.0137">Identify negative correlations</text><rect fill="#000000" height="6" rx="2.5" ry="2.5" style="stroke:#000000;stroke-width:1;" width="888.3755" x="6" y="433.9922"/><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="343.3965" x="278.4895" y="459.9922"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="323.3965" x="288.4895" y="481.1309">Validate correlations with statistical significance tests</text><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="449.0586" x="225.6584" y="513.9609"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="429.0586" x="235.6584" y="535.0996">Generate configuration recommendations based on app characteristics</text><path d="M577.1047,557.9297 L577.1047,581.6289 L557.1047,585.6289 L577.1047,589.6289 L577.1047,613.3281 A0,0 0 0 0 577.1047,613.3281 L765.7336,613.3281 A0,0 0 0 0 765.7336,613.3281 L765.7336,567.9297 L755.7336,557.9297 L577.1047,557.9297 A0,0 0 0 0 577.1047,557.9297" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M755.7336,557.9297 L755.7336,567.9297 L765.7336,567.9297 L755.7336,557.9297" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="1