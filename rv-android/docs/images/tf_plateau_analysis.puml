@startuml tf_plateau_analysis
!theme plain
skinparam backgroundColor white
skinparam activityDiamondBackgroundColor white
skinparam activityBackgroundColor white
skinparam activityBorderColor black
skinparam activityDiamondBorderColor black

start

:Configure tests with multiple timeouts;
note right
  e.g., 60s, 120s, 180s,
  300s, 600s
end note

:Execute test suite with all timeouts;

:Collect metrics at each timeout point;

:Calculate metrics progression;
note right
  Track how metrics improve
  as timeout increases
end note

repeat
  :Analyze improvement rate between
  consecutive timeout intervals;
  
  if (Improvement rate < threshold?) then (yes)
    :Mark plateau point;
    note right
      Typically when improvement 
      is less than 2-5%
    end note
    :Calculate metrics stability;
  else (no)
    :Continue analysis;
  endif
repeat while (All metrics analyzed?) is (no)

:Generate plateau report with:
- Optimal timeout points
- Cost-benefit analysis
- Stability indicators;

:Create plateau visualizations:
- Coverage vs Time curves
- Rate-of-improvement graphs
- Diminishing returns indicators;

stop

@enduml