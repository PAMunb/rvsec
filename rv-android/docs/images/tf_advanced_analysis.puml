@startuml tf_advanced_analysis
!theme plain
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam ArrowColor black

package "Advanced Analysis Components" {
  component [Anomaly Detector] as Anomaly {
    port "in" as anomaly_in
    port "out" as anomaly_out
  }
  
  component [Correlation Analyzer] as Correlation {
    port "in" as corr_in
    port "out" as corr_out
  }
  
  component [Spreadsheet Exporter] as Spreadsheet {
    port "in" as spread_in
    port "out" as spread_out
  }
  
  component [Dashboard] as Dashboard {
    port "in" as dash_in
    port "out" as dash_out
  }
  
  database "Test Results" as Results
  database "App Characteristics" as AppChar
  
  file "Anomaly Report" as AnomalyReport
  file "Correlation Report" as CorrReport
  file "Excel Report" as ExcelReport
  file "HTML Dashboard" as HTMLDash
  
  Results --> anomaly_in : test metrics
  Results --> corr_in : test results
  AppChar --> corr_in : app features
  
  anomaly_in --> Anomaly
  corr_in --> Correlation
  
  Anomaly --> anomaly_out : anomalies
  Correlation --> corr_out : correlations
  
  anomaly_out --> AnomalyReport : generates
  corr_out --> CorrReport : generates
  
  Results --> spread_in : analysis data
  anomaly_out --> spread_in : anomaly data
  corr_out --> spread_in : correlation data
  
  spread_in --> Spreadsheet
  Spreadsheet --> spread_out : formatted data
  
  spread_out --> ExcelReport : generates
  
  Results --> dash_in : metrics
  anomaly_out --> dash_in : anomaly data
  corr_out --> dash_in : correlation data
  
  dash_in --> Dashboard
  Dashboard --> dash_out : interactive dashboard
  
  dash_out --> HTMLDash : generates
}

@enduml