<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" contentStyleType="text/css" data-diagram-type="ACTIVITY" height="821px" preserveAspectRatio="none" style="width:610px;height:821px;background:#FFFFFF;" version="1.1" viewBox="0 0 610 821" width="610px" zoomAndPan="magnify"><defs/><g><ellipse cx="285.8105" cy="15" fill="#FFFFFF" rx="10" ry="10" style="stroke:#000000;stroke-width:1;"/><path d="M431.0381,41.8516 L431.0381,57.9844 L411.0381,61.9844 L431.0381,65.9844 L431.0381,82.1172 A0,0 0 0 0 431.0381,82.1172 L591.9658,82.1172 A0,0 0 0 0 591.9658,82.1172 L591.9658,51.8516 L581.9658,41.8516 L431.0381,41.8516 A0,0 0 0 0 431.0381,41.8516" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M581.9658,41.8516 L581.9658,51.8516 L591.9658,51.8516 L581.9658,41.8516" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="139.9277" x="437.0381" y="58.9185">e.g., 60s, 120s, 180s,</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="71.4365" x="437.0381" y="74.0513">300s, 600s</text><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="250.4551" x="160.583" y="45"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="230.4551" x="170.583" y="66.1387">Configure tests with multiple timeouts</text><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="232.25" x="169.6855" y="102.1172"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="212.25" x="179.6855" y="123.2559">Execute test suite with all timeouts</text><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="243.4063" x="164.1074" y="156.0859"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="223.4063" x="174.1074" y="177.2246">Collect metrics at each timeout point</text><path d="M405.4004,206.9063 L405.4004,223.0391 L385.4004,227.0391 L405.4004,231.0391 L405.4004,247.1719 A0,0 0 0 0 405.4004,247.1719 L603.7031,247.1719 A0,0 0 0 0 603.7031,247.1719 L603.7031,216.9063 L593.7031,206.9063 L405.4004,206.9063 A0,0 0 0 0 405.4004,206.9063" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M593.7031,206.9063 L593.7031,216.9063 L603.7031,216.9063 L593.7031,206.9063" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="177.3027" x="411.4004" y="223.9731">Track how metrics improve</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="135.5161" x="411.4004" y="239.106">as timeout increases</text><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="199.1797" x="186.2207" y="210.0547"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="179.1797" x="196.2207" y="231.1934">Calculate metrics progression</text><rect fill="#FFFFFF" height="47.9375" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="235.7773" x="167.9219" y="311.1719"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="215.7773" x="177.9219" y="332.3105">Analyze improvement rate between</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="178.3008" x="177.9219" y="346.2793">consecutive timeout intervals</text><polygon fill="#FFFFFF" points="198.7236,379.1094,372.8975,379.1094,384.8975,391.1094,372.8975,403.1094,198.7236,403.1094,186.7236,391.1094,198.7236,379.1094" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="174.1738" x="198.7236" y="394.9175">Improvement rate &lt; threshold?</text><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="19.0083" x="167.7153" y="388.5151">yes</text><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="13.7017" x="384.8975" y="388.5151">no</text><path d="M180.7393,413.1094 L180.7393,429.2422 L160.7393,433.2422 L180.7393,437.2422 L180.7393,453.375 A0,0 0 0 0 180.7393,453.375 L394.2891,453.375 A0,0 0 0 0 394.2891,453.375 L394.2891,423.1094 L384.2891,413.1094 L180.7393,413.1094 A0,0 0 0 0 180.7393,413.1094" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M384.2891,413.1094 L384.2891,423.1094 L394.2891,423.1094 L384.2891,413.1094" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="188.4175" x="186.7393" y="430.1763">Typically when improvement</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="111.0649" x="186.7393" y="445.3091">is less than 2-5%</text><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="133.1738" x="27.5654" y="416.2578"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="113.1738" x="37.5654" y="437.3965">Mark plateau point</text><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="176.3047" x="6" y="473.375"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="156.3047" x="16" y="494.5137">Calculate metrics stability</text><rect fill="#FFFFFF" height="33.9688" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="126.3594" x="414.2891" y="413.1094"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="106.3594" x="424.2891" y="434.248">Continue analysis</text><polygon fill="#FFFFFF" points="285.8105,513.3438,297.8105,525.3438,285.8105,537.3438,273.8105,525.3438,285.8105,513.3438" style="stroke:#000000;stroke-width:1;"/><polygon fill="#FFFFFF" points="285.8105,267.1719,297.8105,279.1719,285.8105,291.1719,273.8105,279.1719,285.8105,267.1719" style="stroke:#000000;stroke-width:1;"/><polygon fill="#FFFFFF" points="227.228,557.3438,344.3931,557.3438,356.3931,569.3438,344.3931,581.3438,227.228,581.3438,215.228,569.3438,227.228,557.3438" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="117.165" x="227.228" y="573.1519">All metrics analyzed?</text><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="13.7017" x="356.3931" y="566.7495">no</text><rect fill="#FFFFFF" height="75.875" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="199.2559" x="186.1826" y="601.3438"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="179.2559" x="196.1826" y="622.4824">Generate plateau report with:</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="146.8711" x="196.1826" y="636.4512">- Optimal timeout points</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="133.8047" x="196.1826" y="650.4199">- Cost-benefit analysis</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="120.1348" x="196.1826" y="664.3887">- Stability indicators</text><rect fill="#FFFFFF" height="75.875" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="209.2168" x="181.2021" y="697.2188"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="178.3652" x="191.2021" y="718.3574">Create plateau visualizations:</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="160.043" x="191.2021" y="732.3262">- Coverage vs Time curves</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="182.127" x="191.2021" y="746.2949">- Rate-of-improvement graphs</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="189.2168" x="191.2021" y="760.2637">- Diminishing returns indicators</text><ellipse cx="285.8105" cy="804.0938" fill="none" rx="11" ry="11" style="stroke:#000000;stroke-width:1;"/><ellipse cx="285.8105" cy="804.0938" fill="#FFFFFF" rx="6" ry="6" style="stroke:#000000;stroke-width:1;"/><line style="stroke:#000000;stroke-width:1;" x1="285.8105" x2="285.8105" y1="25" y2="45"/><polygon fill="#000000" points="281.8105,35,285.8105,45,289.8105,35,285.8105,39" style="stroke:#000000;stroke-width:1;"/><line style="stroke:#000000;stroke-width:1;" x1="285.8105" x2="285.8105" y1="78.9688" y2="102.1172"/><polygon fill="#000000" points="281.8105,92.1172,285.8105,102.1172,289.8105,92.1172,285.8105,96.1172" style="stroke:#000000;stroke-width:1;"/><line style="stroke:#000000;stroke-width:1;" x1="285.8105" x2="285.8105" y1="136.0859" y2="156.0859"/><polygon fill="#000000" points="281.8105,146.0859,285.8105,156.0859,289.8105,146.0859,285.8105,150.0859" style="stroke:#000000;stroke-width:1;"/><line style="stroke:#000000;stroke-width:1;" x1="285.8105" x2="285.8105" y1="190.0547" y2="210.0547"/><polygon fill="#000000" points="281.8105,200.0547,285.8105,210.0547,289.8105,200.0547,285.8105,204.0547" style="stroke:#000000;stroke-width:1;"/><line style="stroke:#000000;stroke-width:1;" x1="94.1523" x2="94.1523" y1="450.2266" y2="473.375"/><polygon fill="#000000" points="90.1523,463.375,94.1523,473.375,98.1523,463.375,94.1523,467.375" style="stroke:#000000;stroke-width:1;"/><line style="stroke:#000000;stroke-width:1;" x1="186.7236" x2="94.1523" y1="391.1094" y2="391.1094"/><line style="stroke:#000000;stroke-width:1;" x1="94.1523" x2="94.1523" y1="391.1094" y2="416.2578"/><polygon fill="#000000" points="90.1523,406.2578,94.1523,416.25