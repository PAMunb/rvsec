@startuml tf_data_flow
!theme plain
skinparam backgroundColor white
skinparam ArrowColor black
skinparam useBetaStyle true

rectangle "Configuration Phase" as config {
  [Test Suite JSON] as json
  [Configuration Validator] as validator
  [Configuration Generator] as generator
  database "Configuration Store" as cfgstore
}

rectangle "Execution Phase" as exec {
  [Test Framework] as framework
  [Test Runner] as runner
  [Test Executor] as executor
  database "Raw Results" as results
}

rectangle "Analysis Phase" as analysis {
  [Result Analyzer] as analyzer
  [Plateau Analyzer] as plateau
  [Anomaly Detector] as anomaly
  [Correlation Analyzer] as correlation
  database "Processed Results" as processed
}

rectangle "Reporting Phase" as report {
  [Visualization] as vis
  [Dashboard] as dash
  [Excel Exporter] as excel
  [CSV Exporter] as csv
  database "Reports" as reports
}

' Configuration flow
json --> validator : validate
validator --> generator : if needed
generator --> cfgstore : store
cfgstore --> framework : load

' Execution flow
framework --> runner : orchestrate
runner --> executor : run tests
executor --> results : save results

' Analysis flow
results --> analyzer : process
analyzer --> plateau : analyze plateaus
analyzer --> anomaly : detect anomalies 
analyzer --> correlation : find correlations
plateau --> processed : store
anomaly --> processed : store
correlation --> processed : store

' Reporting flow
processed --> vis : visualize
processed --> dash : create dashboard
processed --> excel : export spreadsheets
processed --> csv : export CSV
vis --> reports : save
dash --> reports : save
excel --> reports : save
csv --> reports : save

@enduml