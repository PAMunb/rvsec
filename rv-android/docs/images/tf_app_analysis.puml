@startuml tf_app_analysis
!theme plain
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam ArrowColor black
skinparam useBetaStyle true

title App Characteristic Analysis Process

package "App Input" {
  [APK Files] as APK
}

package "Static Analysis" {
  [APK Parser] as Parser
  [Feature Extractor] as Extractor
  [Complexity Analyzer] as Complexity
  [UI Structure Analyzer] as UI
}

package "Characteristic Extraction" {
  [App Size Metrics] as Size
  [UI Complexity Metrics] as UIComplexity
  [Activity Count] as Activities
  [Special Features] as Features
  [Permission Set] as Permissions
  [App Category] as Category
}

package "Performance Data" {
  [Historical Test Results] as Historical
  [Configuration Performance] as ConfigPerf
}

package "Correlation Analysis" {
  [Feature-Performance Correlator] as Correlator
  [Pattern Recognizer] as Patterns
  [Cluster Analysis] as Clusters
  [Regression Models] as Regression
}

package "Recommendation Engine" {
  [Configuration Recommender] as Recommender
  [Performance Predictor] as Predictor
  [Rule Generator] as Rules
}

APK --> Parser
Parser --> Extractor
Extractor --> Size
Extractor --> Activities
Extractor --> Permissions
Extractor --> Category

Parser --> Complexity
Complexity --> UIComplexity
Complexity --> Features

Parser --> UI
UI --> UIComplexity : UI tree depth
UI --> Activities : Activity transitions

Size --> Correlator
UIComplexity --> Correlator
Activities --> Correlator
Features --> Correlator
Permissions --> Correlator
Category --> Correlator

Historical --> Correlator
ConfigPerf --> Correlator

Correlator --> Patterns
Correlator --> Clusters
Correlator --> Regression

Patterns --> Recommender
Clusters --> Recommender
Regression --> Recommender

Recommender --> Predictor
Predictor --> Rules

note bottom of Rules
  Rules are used to automatically
  select optimal configurations
  for new apps based on characteristics
end note

@enduml