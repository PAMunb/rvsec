@startuml rvdroid_recovery_process
!theme plain
skinparam backgroundColor white
skinparam ArrowColor black
skinparam useBetaStyle true

title RVDroid Recovery Process

start

:Error detected during action execution;

:Enter recovery phase;

:Classify error type;

if (Error type?) then (UI_ELEMENT_NOT_FOUND)
  :UI element not found;
  :Check element existence;
  if (UI changed?) then (yes)
    :Update UI state;
    :Retry with updated element;
  else (no)
    :Try nearby elements;
  endif
  
else if (UI_INTERACTION_FAILED)
  :UI interaction failed;
  :Adjust interaction parameters;
  :Retry with modified parameters;
  
else if (APP_CRASH)
  :Application crashed;
  :Record crash details;
  :Restart application;
  :Navigate back to previous state;
  
else if (APP_ANR)
  :Application not responding;
  :Force close application;
  :Restart application;
  :Navigate back to previous state;
  
else if (EMULATOR_ISSUE)
  :Emulator issue detected;
  :Check emulator status;
  if (Emulator responsive?) then (yes)
    :Restart application;
  else (no)
    :Restart emulator;
    :Reinstall application;
  endif
  
else if (CONNECTION_ISSUE)
  :Connection to device lost;
  :Attempt reconnection;
  if (Reconnection successful?) then (yes)
    :Resume testing;
  else (no)
    :Restart emulator;
  endif
  
else (OTHER_ERROR)
  :Unknown error;
  :Apply generic recovery;
endif

:Select recovery strategy;

:Execute recovery strategy;

if (Recovery successful?) then (yes)
  :Update memory with recovery information;
  :Return to testing;
else (no)
  if (Retry count < max?) then (yes)
    :Increment retry count;
    :Escalate to more impactful strategy;
    :Retry recovery;
  else (no)
    :Log unrecoverable error;
    :Terminate testing session;
  endif
endif

stop

@enduml