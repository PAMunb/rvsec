@startuml llm_monitored_operations

skinparam handwritten false
skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Verdana"
skinparam defaultFontSize 12

!define PRIMARY_COLOR #3F51B5
!define SECONDARY_COLOR #FF9800
!define ACCENT_COLOR #4CAF50
!define ERROR_COLOR #F44336

skinparam class {
  BackgroundColor White
  BorderColor PRIMARY_COLOR
  ArrowColor PRIMARY_COLOR
}

' Define the monitored operations structure
package "JavaMOP Specifications" {
  class "Iterator Specification" as IteratorSpec {
    + Before calling next(), must call hasNext()
    + hasNext() must return true before next()
  }
  
  class "Crypto API Specification" as CryptoSpec {
    + Must use secure random number generator
    + Must use proper key sizes
    + Must use secure modes of operation
  }
  
  class "Other Specifications" as OtherSpecs {
    + Domain-specific rules
    + General programming patterns
  }
}

package "Static Analysis" {
  class Classes {
    + get_classes(): List<Clazz>
    + add_clazz(name, is_activity, is_main_activity): Clazz
    + get_clazz(name): Optional<Clazz>
    + add_method(method): boolean
  }
  
  class Clazz {
    + name: String
    + is_activity: boolean
    + is_main_activity: boolean
    + methods: Set<Method>
    + fields: Set<String>
    
    + add_method(method): boolean
    + add_field(field): void
  }
  
  class Method {
    + class_name: String
    + name: String
    + params: List<String>
    + signature: String
    + reachable: boolean
    + reaches_mop: boolean
    + directly_reaches_mop: boolean
    + reached: boolean
  }
  
  class StaticAnalysisData {
    + classes: Classes
    + windows: Windows
    + wtg: WindowTransitionGraph
  }
}

package "UI Processing" {
  class BaseScreenVisitor {
    + static_info: StaticAnalysisData
    + _update_action_monitored_op_info(action, node): void
    + _check_method_reaches_mop(signature): boolean
    + _check_method_directly_reaches_mop(signature): boolean
  }
  
  class ItemAction {
    + id: int
    + text: String
    + event: WidgetEventType
    + reaches_mop: boolean
    + directly_reaches_mop: boolean
    + target_view: Dict
    + coordinates: Tuple
  }
  
  class ScreenDescription {
    + activity: String
    + items: List<ScreenItem>
    + events_by_id: Map<Integer, ItemAction>
  }
}

package "Prompt Generation" {
  class BasePromptStrategy {
    + static_data: StaticAnalysisData
    + _format_ui_elements(screen_description, state): String
  }
  
  class SystemPrompt {
    + exploration_goal: String
    + prioritize testing of methods of interest
    + response_format: String
  }
  
  class UserPrompt {
    + activity: String
    + ui_elements: String (includes MOP indicators)
    + static_context: String
    + action_history: String
    + summary: String
  }
}

package "Android Testing" {
  class "Instrumented App" as InstrumentedApp {
    + JavaMOP Monitors
    + Method Call Logging
  }
  
  class "Logcat Output" as LogcatOutput {
    + Method calls
    + Monitor violations
  }
}

' Define the flow between components
InstrumentedApp --> LogcatOutput : generates

JavaMOP Specifications --> Method : defines monitored operations

Classes o--> Clazz : contains
Clazz o--> Method : contains
StaticAnalysisData o--> Classes : contains

BaseScreenVisitor --> StaticAnalysisData : references
BaseScreenVisitor --> ItemAction : enriches

BasePromptStrategy --> ScreenDescription : processes
BasePromptStrategy --> SystemPrompt : generates
BasePromptStrategy --> UserPrompt : generates

IteratorSpec --> Method : marks for monitoring
CryptoSpec --> Method : marks for monitoring
OtherSpecs --> Method : marks for monitoring

' Define the flow of monitored operations information
Method --> BaseScreenVisitor : informs about MOPs
BaseScreenVisitor --> ItemAction : adds MOP flags
ItemAction --> UserPrompt : includes MOP indicators
UserPrompt --> "LLM" as LLM : guides

' Add a sequence for MOP flow
note bottom of Method #ACCENT_COLOR
  Methods are marked with:
  - reaches_mop = true (if they can reach a monitored operation)
  - directly_reaches_mop = true (if they directly reach a monitored operation)
end note

note bottom of ItemAction #ACCENT_COLOR
  Actions are marked with MOP flags to indicate:
  - [CRITICAL] for directly_reaches_mop = true
  - [IMPORTANT] for reaches_mop = true
end note

note bottom of UserPrompt #ACCENT_COLOR
  LLM prompts include these indicators to guide
  the model to prioritize testing operations that 
  are monitored by formal specifications
end note

@enduml