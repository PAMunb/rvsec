@startuml llm_test_framework

skinparam handwritten false
skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Verdana"
skinparam defaultFontSize 12

!define PRIMARY_COLOR #3F51B5
!define SECONDARY_COLOR #FF9800
!define ACCENT_COLOR #4CAF50
!define TF_COLOR #E1BEE7

skinparam component {
  BackgroundColor White
  BorderColor PRIMARY_COLOR
  ArrowColor PRIMARY_COLOR
}

' Define the Test Framework
package "Test Framework" #TF_COLOR {
  [TestFramework] as TF
  [TestRunner] as TR
  [TestExecutor] as TE
  [ResultAnalyzer] as RA
  [PlateauAnalyzer] as PA
  [CorrelationAnalyzer] as CA
  [ConfigGenerator] as CG
  
  component "Configuration System" {
    [TestSuite] as TS
    [ToolConfiguration] as TC
    [ConfigValidator] as CV
  }
  
  component "Analysis System" {
    [ResultsLoader] as RL
    [Visualization] as VIZ
    [SpreadsheetExporter] as SE
    [Dashboard] as DASH
  }
}

' Define the LLM Integration System
package "LLM Integration System" {
  [LLMActionService] as LAS
  [PromptProcessor] as PP
  [LLMManager] as LM
  [ResponseProcessor] as RP
  [ActionGenerator] as AG
  
  component "Strategy System" {
    [PromptStrategyFactory] as PSF
    [BasePromptStrategy] as BPS
    [PromptLibrary] as PL
  }
}

' Define the Tools
package "Testing Tools" {
  [RVAndroid] as RVAT
  [RVDroid] as RVD
  [ToolFactory] as TFAC
}

' Define External Systems
package "External Systems" {
  [Android Emulator] as AE
  [LLM Providers] as LLMP
}

' Define Test Framework Flow
TF --> TR : delegates execution
TR --> TE : runs tests
TE --> TFAC : creates tools
TFAC --> RVAT : creates
TFAC --> RVD : creates
RVAT --> LAS : uses
RVD --> LAS : uses
TE --> AE : controls
TR --> RA : analyzes results
RA --> PA : detects plateaus
RA --> CA : analyzes correlations
TF --> CG : generates configs

CG --> TS : creates
TR --> TS : executes
TS --> TC : contains
CV --> TC : validates

RA --> RL : loads results
RA --> VIZ : generates charts
RA --> SE : exports data
RA --> DASH : creates dashboard

' Define LLM Integration Flow
TC --> LAS : configures
TC --> PSF : selects strategy
TC --> LM : selects model
PSF --> BPS : creates
BPS --> PL : uses templates
LM --> LLMP : connects to

' Add explanatory notes
note bottom of TC #TF_COLOR
  ToolConfiguration contains LLM parameters:
  - llm_type: "ollama", "dspy", etc.
  - llm_model: "llama3.2:3b", "gpt-4", etc.
  - temperature: 0.2
  - max_tokens: 800
  - strategy_type: "single_action", "composable", etc.
  - parser_type: "uiautomator", "droidbot", etc.
  - visitor_type: "enhanced", "basic", etc.
end note

note bottom of TR #TF_COLOR
  TestRunner executes tests with different:
  - LLM models
  - Prompt strategies
  - Parsers and visitors
  - Temperature and token settings
  - Timeouts and repetitions
end note

note bottom of RA #TF_COLOR
  ResultAnalyzer evaluates:
  - Coverage metrics
  - Error detection
  - Execution efficiency
  - MOP violations
  
  It identifies the best performing
  LLM configurations for each app.
end note

' Add key use cases
component [Test Framework Use Cases] as TFUC
note right of TFUC
  <b>Key Use Cases</b>
  
  - Comparing LLM models
  - Evaluating prompt strategies
  - Testing parser/visitor combinations
  - Identifying optimal parameters
  - Measuring impact of static analysis
  - Testing screenshot analysis value
  - Determining best configurations for each app type
end note

@enduml