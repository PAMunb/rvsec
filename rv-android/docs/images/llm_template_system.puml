@startuml llm_template_system

skinparam handwritten false
skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Verdana"
skinparam defaultFontSize 12

!define PRIMARY_COLOR #3F51B5
!define SECONDARY_COLOR #FF9800
!define ACCENT_COLOR #4CAF50

skinparam class {
  BackgroundColor White
  BorderColor PRIMARY_COLOR
  ArrowColor PRIMARY_COLOR
}

' Define the main template classes
class PromptTemplate {
  +String template_text
  +String name
  +String version
  +List<String> required_variables
  +PromptTemplate parent
  +Map<String, Any> metadata
  +Map<String, Callable> transformers
  +Map<String, TemplateFragment> fragments
  
  +add_transformer(variable, transform_func)
  +add_fragment(name, fragment)
  +derive(template_text, name, version)
  +render(variables)
  +render_with_parent(variables, inherit_mode)
  +render_fragment(fragment_name, variables)
  +to_json()
  +save_to_file(file_path)
  +load_from_file(file_path)
}

class TemplateFragment {
  +String name
  +String content
  +String version
  
  +render(variables)
}

class PromptLibrary {
  +{static} Map<String, PromptTemplate> _templates
  +{static} Map<String, List<String>> _categories
  
  +{static} register_template(template, category)
  +{static} get_template(name)
  +{static} list_templates(category)
  +{static} get_categories()
  +{static} validate_template(template)
  +{static} system_base_template()
  +{static} user_base_template()
  +{static} single_action_format()
  +{static} multi_action_format()
  +{static} create_specialized(name, template_text, parent_name)
}

' Define relationships
PromptTemplate o--> "0..*" TemplateFragment : contains
PromptTemplate o--> "0..1" PromptTemplate : inherits from
PromptLibrary o--> "0..*" PromptTemplate : manages

' Define template categories
package "Standard Templates" {
  class SystemBaseTemplate
  class UserBaseTemplate
  class SingleActionFormatTemplate
  class MultiActionFormatTemplate
  class DropdownGuidelinesTemplate
  class FormGuidelinesTemplate
  class AdvancedGuidelinesTemplate
}

' Define template features
class TemplateFeatures {
  + Variable Substitution
  + Conditional Sections
  + Fragment Inclusion
  + Inheritance
  + Versioning
  + Transformers
}

' Connect standard templates to PromptLibrary
PromptLibrary --> SystemBaseTemplate : provides
PromptLibrary --> UserBaseTemplate : provides
PromptLibrary --> SingleActionFormatTemplate : provides
PromptLibrary --> MultiActionFormatTemplate : provides
PromptLibrary --> DropdownGuidelinesTemplate : provides
PromptLibrary --> FormGuidelinesTemplate : provides
PromptLibrary --> AdvancedGuidelinesTemplate : provides

' Show template usage in prompt strategies
package "Prompt Strategies" {
  class BasePromptStrategy
  class SingleActionPromptStrategy
  class ComposablePromptStrategy
}

BasePromptStrategy --> SystemBaseTemplate : uses
BasePromptStrategy --> UserBaseTemplate : uses
SingleActionPromptStrategy --> SingleActionFormatTemplate : uses
ComposablePromptStrategy --> MultiActionFormatTemplate : uses

' Connect template features to PromptTemplate
PromptTemplate ..> TemplateFeatures : implements

@enduml