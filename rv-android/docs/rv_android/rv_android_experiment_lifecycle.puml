@startuml rv_android_experiment_lifecycle

!theme aws-orange
title RV-Android - Experiment Lifecycle (Macro)

|System|
start
:System startup;
:Load configuration;
:Initialize components;

|Event System|
:EventBus initialized;
:Event channels created;
note right
  Channels:
  * LIFECYCLE_CHANNEL
  * ANALYSIS_CHANNEL  
  * ERROR_CHANNEL
  * SYSTEM_CHANNEL
end note

|Experiment Controller|
:ExperimentController created;
:Publish EXPERIMENT_STARTED;

|Pre-Processing|
fork
  :Monitor generation;
  :Publish monitor events;
fork again
  :APK instrumentation;
  :Publish instrumentation events;
fork again
  :Static analysis;
  :Publish STATIC_ANALYSIS_COMPLETED;
end fork

|Task Management|
:Create task combinations;
note right
  APK × Repetition × Timeout × Tool
end note

:Initialize TaskStorage;

|Execution Phase|
repeat
  |Task Executor|
  :Select next task;
  :Publish TASK_STARTED;
  
  fork
    :Set up emulator;
    :Publish EMULATOR_STARTED;
  fork again
    :Start logcat capture;
  fork again
    :Initialize coverage tracking;
  end fork
  
  :Execute testing tool;
  :Publish TOOL_STARTED/STOPPED;
  
  fork
    :Stop logcat capture;
  fork again
    :Process coverage data;
    :Publish COVERAGE_UPDATED;
  fork again
    :Clean up resources;
  end fork
  
  if (Task successful?) then (yes)
    :Publish TASK_COMPLETED;
  else (no)
    :Publish TASK_FAILED;
  endif
  
repeat while (More tasks?)

|Post-Processing|
:Analyze results;
:Generate reports;
:Create dashboards;

|Finalization|
:Publish EXPERIMENT_COMPLETED;
:Clean up system resources;

stop

note right
  Events flow through EventBus
  to interested subscribers:
  * Loggers
  * Performance monitors  
  * Result processors
  * Error handlers
end note

@enduml