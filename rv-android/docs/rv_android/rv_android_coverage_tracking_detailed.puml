@startuml rv_android_coverage_tracking_detailed

!theme aws-orange
title RV-Android - Coverage Tracking Process (Detailed)

start

:CoverageComponent.initialize_tracker();
note right: Set up coverage tracking for task

:Create LogcatRepository;
note right
  Repository for:
  * Method call logs (RVSEC-COV)
  * Runtime verification errors (RVSEC)
  * Coverage metrics calculation
end note

:Load static analysis data;
note right
  From static analysis files:
  * .methods (method metadata)
  * .reach (reachability info)
  * Total methods count
  * MOP method indicators
end note

partition "Runtime Data Collection" {
  
  :Start logcat capture;
  note right
    Filter for tags:
    * RVSEC (RV errors)
    * RVSEC-COV (method coverage)
  end note
  
  :Execute testing tool;
  note right
    Tool exercises application:
    * Triggers method calls
    * May cause property violations
  end note
  
  :Application generates logs;
  note right
    Instrumented app logs:
    * Every method call (AspectJ)
    * RV monitor violations
    * Timestamps and context
  end note
  
  :Stop logcat capture;
}

partition "Log Processing & Analysis" {
  
  :Parse logcat file;
  note right: Extract relevant log entries
  
  repeat
    :Process log entry;
    
    if (RVSEC-COV entry?) then (yes)
      :Create RvCoverageLog;
      note right
        Method call data:
        * Class name
        * Method signature
        * Parameters
        * Timestamp
      end note
      
      :Register method call in repository;
      
    elseif (RVSEC entry?) then (yes)
      :Create RvErrorLog;
      note right
        RV error data:
        * Specification violated
        * Error type
        * Context information
        * Timestamp
      end note
      
      :Register RV error in repository;
      
    else (ignore)
      :Skip non-relevant entry;
    endif
    
  repeat while (More log entries?)
  
}

partition "Metrics Calculation" {
  
  :Calculate coverage metrics;
  note right
    Using LogcatRepository.calculate_metrics():
  end note
  
  :Count unique methods called;
  note right: From RVSEC-COV entries
  
  :Calculate method coverage %;
  note right: (called_methods / total_methods) * 100
  
  :Count unique activities reached;
  note right: Based on method signatures
  
  :Calculate activity coverage %;
  note right: (reached_activities / total_activities) * 100
  
  :Count MOP methods reached;
  note right: Methods that reach MOP specifications
  
  :Calculate MOP coverage %;
  note right: (mop_methods_reached / total_mop_methods) * 100
  
  :Count unique RV errors;
  note right: From RVSEC entries
  
}

:Update task result with metrics;
note right
  Store in TaskResult:
  * method_coverage
  * activities_coverage  
  * methods_jca_reachable_coverage
  * total_errors
  * total_method_calls
end note

if (Export to CSV enabled?) then (yes)
  :Export coverage data to CSV;
  note right
    Files:
    * coverage_data.csv
    * error_data.csv
  end note
else (no)
endif

:Publish COVERAGE_UPDATED event;

stop

@enduml