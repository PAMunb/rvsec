[tool.poetry]
name = "rv-screen-parser"
version = "0.1.0"
description = "Android screen parsing for DroidBot and UIAutomator with visitor pattern"
authors = ["RV-Android Team"]
readme = "README.md"
packages = [{include = "rv_screen_parser", from = "src"}]

[tool.poetry.dependencies]
python = ">=3.12,<4.0"
rv-android-core = {path = "../rv-android-core", develop = true}
pydantic = "^2.9.0"
# Screen parsing dependencies
lxml = "^5.3.0"  # Para parsing XML
beautifulsoup4 = "^4.12.0"  # Para parsing HTML/XML alternativo
uiautomator2 = "^3.3.1"

# Screenshot analysis dependencies
pytesseract = "^0.3.0"  # OCR functionality
opencv-python = "^4.10.0"  # Computer vision and image processing
pillow = "^10.4.0"  # Image manipulation
numpy = "^2.1.0"  # Numerical operations

[tool.poetry.group.dev.dependencies]
pytest = "^8.0.0"
pytest-cov = "^5.0.0"

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
addopts = [
    "--strict-markers",
    "--strict-config",
    "--verbose",
]
markers = [
    "integration: Integration tests that require external dependencies",
    "slow: Slow running tests",
]

[tool.coverage.run]
source = ["src"]
omit = [
    "*/tests/*",
    "*/test_*.py",
]

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "def __repr__",
    "raise AssertionError",
    "raise NotImplementedError",
]

[build-system]
requires = ["poetry-core"]
build-backend = "poetry.core.masonry.api"
