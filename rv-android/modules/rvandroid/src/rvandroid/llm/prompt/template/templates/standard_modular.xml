<?xml version="1.0" encoding="UTF-8"?>
<template name="standard_modular" version="1.0" extends="system_base">
  <metadata>
    <description>Standard template for Android testing (modular version)</description>
    <created>2023-05-04</created>
    <author>RV-Android Team</author>
    <updated>2023-05-06</updated>
  </metadata>
  <variables>
    <required>ui_elements</required>
    <optional>additional_guidelines</optional>
    <optional>ui_patterns</optional>
    <optional>monitored_operations</optional>
  </variables>
  <roles>
    <system>
      <variable name="strategy_specific_instructions">
        <![CDATA[{% include "standard_instructions" %}]]>
      </variable>
      <variable name="response_format_instructions">
        <![CDATA[{% include "standard_format" %}]]>
      </variable>
      <variable name="additional_guidelines">
        <![CDATA[{% include "standard_guidelines" %}]]>
      </variable>
    </system>
    <user><![CDATA[
I'm testing an Android application and need your guidance on the next action to take.

{% include "user_base" %}

{% if additional_guidelines %}
GUIDELINES:
{{ additional_guidelines }}
{% endif %}
    ]]></user>
  </roles>
</template>
