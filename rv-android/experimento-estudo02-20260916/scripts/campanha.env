# Constantes da re-execução da estudo02 — a ÚNICA fonte dos valores da campanha.
# Lido pelo bash (`source`) e pelos scripts Python (scripts/campanha.py). Formato: KEY=VALUE,
# sem espaços em volta do `=`, aspas duplas só quando o valor tem espaço ou vírgula.

# Prefixo dos containers e dos resultados: containers `estudo02-20260916_NN`, resultados em
# data/results/estudo02-20260916_NN/. O hífen é de propósito: nenhum filtro ou glob da
# estudo02 (`estudo02_`, `estudo02_*`) casa com este nome, e `estudo02-20260916_` não casa
# com o smoke (`estudo02-20260916-smoke_NN`).
NAME=estudo02-20260916
SMOKE_NAME=estudo02-20260916-smoke

# Desenho: idêntico ao da estudo02 (11 braços × corpus × 3 reps × 3 orçamentos).
# O monkey leva as duas flags com `=true` em cada uma: flag nua é lida como ferramenta nova.
TOOLS="monkey@ignore_crashes=true,ignore_timeouts=true,droidbot:dfs_greedy,droidbot:bfs_greedy,droidbot:dfs_naive,droidbot:bfs_naive,ape,droidmate,humanoid,ares,fastbot,qtesting"
TIMEOUTS=60,180,300
REPS=3
SPEC_SET=jca_android

# Recursos (docs/20260916_plano.md §4): 12 containers × 10 g com a máquina dedicada à campanha. A
# soma dos tetos (120 g) cabe na RAM; o OOM do container é rotina e o Docker religa. O limite de
# religamentos é 50: na estudo02, com 10 g, cada container teve 3–9 religamentos no meio da corrida
# e mais 11–15 no laço da exportação final, o que passa de 20.
CONTAINERS=12
CPUS=4
MEMORY=10g
RESTART=on-failure:50

# Smoke: 12 containers, um APK por container, 1 rep, 60 s — mede a contenção com a mesma
# concorrência da campanha e exercita os consertos da gh114 (plano §7).
SMOKE_CONTAINERS=12
SMOKE_TIMEOUT=60
SMOKE_REPS=1
SMOKE_APKS="com.beemdevelopment.aegis_81.apk,dev.leonlatsch.photok_62.apk,com.craxiom.networksurvey_114.apk,com.tananaev.passportreader_22.apk,app.michaelwuensch.bitbanana_79.apk,com.nononsenseapps.feeder.play_4025.apk,org.quantumbadger.redreader_117.apk,org.totschnig.myexpenses_858.apk,github.paroj.dsub2000_217.apk,rocks.poopjournal.metadataremover_20020.apk,org.glpi.inventory.agent_39469.apk,com.gelakinetic.mtgfam_99.apk"

# Imagem: a cadeia 0.9.4 da gh115, com a gh114 dentro. RVSEC_MIN_COMMIT fica VAZIO até a gh115
# ser comitada e empurrada; o preflight reprova enquanto estiver vazio.
IMAGE=phtcosta/rvandroid:0.9.4
RVSEC_MIN_COMMIT=
DROIDBOT_COMMIT=52aeea4
HUMANOID_IMAGE=phtcosta/humanoid:1.0

# Corpus. A fonte é o rvsec-dataset (change reinstrument-jca-android); a pasta montada no
# container é uma CÓPIA feita por scripts/exportar_corpus.py, porque o rvsec-dataset apaga e
# regrava instrumented_apks/ a cada reinstrumentação.
DATASET_SRC=/home/pedro/desenvolvimento/workspaces/workspaces-doutorado/workspace-rv/rvsec-dataset/jca_android
DATASET=/home/pedro/desenvolvimento/RV_ANDROID_DATASET_FINAL/APKS_INSTRUMENTED_jca_android_dexlib2_094
ESTUDO02_DATASET=/home/pedro/desenvolvimento/RV_ANDROID_DATASET_FINAL/APKS_INSTRUMENTED_jca_android_dexlib2
ESTUDO02_CORPUS=data/estudo02_filters/corpus.txt
