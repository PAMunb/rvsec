package mop;

import java.security.Key;
import java.security.spec.AlgorithmParameterSpec;
import javax.crypto.Cipher;
import javax.crypto.spec.IvParameterSpec;

/** Consumidor isolado: observa wrap e uso, sem ver o produtor. */
IvWrapUseSpec(IvParameterSpec spec, Cipher c) {
    creation event mk after() returning(IvParameterSpec spec):
      call(public IvParameterSpec.new(byte[])) { }

    event use before(IvParameterSpec spec, Cipher c):
      call(public void Cipher.init(int, Key, AlgorithmParameterSpec)) &&
      args(*, *, spec) &&
      target(c) { }

    fsm :
      start   [ mk -> wrapped ]
      wrapped [ use -> ok ]
      ok      [ use -> ok ]

    alias match = ok

    @match {
      System.out.println("[IvWrapUseSpec] MATCH spec=" + "?" + " (nao sabe se o iv era randomizado)");
    }
    @fail {
      System.out.println("[IvWrapUseSpec] FAIL");
    }
}
