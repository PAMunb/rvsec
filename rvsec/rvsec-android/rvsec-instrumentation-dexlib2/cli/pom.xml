<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.unb.cic</groupId>
        <artifactId>rvsec-instrumentation-dexlib2</artifactId>
        <version>0.9.0-SNAPSHOT</version>
    </parent>

    <artifactId>cli</artifactId>
    <name>RVSec :: Android :: Instrumentation (dexlib2) :: cli</name>
    <description>Picocli entry point that orchestrates the weaving pipeline: descriptor-reader → pointcut-engine → advice-emitter + coverage-weaver → dex-mutator → monitor-builder → multidex-merger. Built as a fat jar and auto-copied to the Python wrapper's lib/ by the Maven build (design D9).</description>

    <dependencies>
        <dependency>
            <groupId>br.unb.cic</groupId>
            <artifactId>descriptor-reader</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.unb.cic</groupId>
            <artifactId>pointcut-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.unb.cic</groupId>
            <artifactId>advice-emitter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.unb.cic</groupId>
            <artifactId>dex-mutator</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.unb.cic</groupId>
            <artifactId>coverage-weaver</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.unb.cic</groupId>
            <artifactId>monitor-builder</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.unb.cic</groupId>
            <artifactId>multidex-merger</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>instr-cli</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>br.unb.cic.rv.cli.InstrumentationCli</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- D9: copy the fat jar into rv-android/modules/rv-instrumentation-dexlib2/lib/
                 so the Python wrapper can locate it via relative path. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-jar-to-python-lib</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${main.basedir}/rv-android/modules/rv-instrumentation-dexlib2/lib</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>instr-cli.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
