    <artifactId>multidex-merger</artifactId>
    <name>RVSec :: Android :: Instrumentation (dexlib2) :: multidex-merger</name>
    <description>Repacks woven DEX files into the target APK, runs zipalign for 4-byte alignment, and signs with apksigner v3. Preserves multidex split decisions (INV-INS-52).</description>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

