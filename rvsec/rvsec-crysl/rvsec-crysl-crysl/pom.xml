<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>br.unb.cic</groupId>
		<artifactId>rvsec-crysl</artifactId>
		<version>0.9.3-SNAPSHOT</version>
	</parent>

	<artifactId>rvsec-crysl-crysl</artifactId>
	<name>RVSec :: CrySL conformance :: crysl</name>

	<properties>
		<!-- The CLI lives in this module (G05 5.1), so this is the only module of the component that
		     has an entry point to package. -core and -mop stay library jars. -->
		<main.class>br.unb.cic.rvsec.crysl.crysl.cli.ConformanceCli</main.class>
		<final.jar.name>rvsec-conformance</final.jar.name>
	</properties>

	<dependencies>
		<dependency>
			<groupId>br.unb.cic</groupId>
			<artifactId>rvsec-crysl-core</artifactId>
		</dependency>

		<!-- The CLI lives in this module and needs the MOP lift as well as the CrySL lift, which is
		     why this dependency exists; the reason it is this module rather than -mop or a fourth
		     -cli module is recorded in br.unb.cic.rvsec.crysl.crysl.cli.package-info. The direction
		     matters: javamop pulls no Guava, so adding it here changes nothing about the classpath
		     the single-JVM probe measured, whereas adding CrySLParser to -mop would put Guava on the
		     module whose DependencyDisciplineTest asserts Guava is absent from it. -->
		<dependency>
			<groupId>br.unb.cic</groupId>
			<artifactId>rvsec-crysl-mop</artifactId>
		</dependency>

		<!-- Argument parsing for the CLI, following the shape of rvsec-mop-extractor (D-15). The
		     version is the reactor's; jcommander already arrives transitively through javamop, and
		     declaring it makes the CLI's dependency on it explicit rather than borrowed. -->
		<dependency>
			<groupId>com.beust</groupId>
			<artifactId>jcommander</artifactId>
		</dependency>
		<dependency>
			<groupId>de.darmstadt.tu.crossing.CrySL</groupId>
			<artifactId>CrySLParser</artifactId>
			<exclusions>
				<!-- CrySLParser declares slf4j-simple in compile scope, so without this exclusion a
				     logging backend is bound for every consumer of this module and the reactor ends
				     up with two bindings on the same classpath. Only slf4j-api is wanted. -->
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-simple</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>br.unb.cic</groupId>
			<artifactId>rvsec-crysl-core</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Packages the CLI as a self-contained jar, following the shape of rvsec-mop-extractor
			     (D-15). Until this existed the only caller of ConformanceCli was its own test suite,
			     which runs with a surefire-assembled classpath; a researcher wanting to re-run the
			     comparison outside the build had to reconstruct that classpath by hand, which is a
			     poor footing for a component whose whole argument is that a published number must be
			     reproducible from a declared commit.

			     The descriptor is local rather than the stock descriptorRef because of Xtext's
			     service files — see src/main/assembly/fat-jar.xml for the reason.

			     Note what is deliberately NOT here: no maven-resources-plugin execution copying the
			     jar into rv-android/lib/. The other rvsec modules do that because the Python pipeline
			     invokes them; this component does not enter the instrumentation pipeline, the
			     platform or any experiment path, and the change's Impact section records that it adds
			     no cross-module interface. Dropping a jar into rv-android/lib/ would create the very
			     coupling that section says does not exist. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<mainClass>${main.class}</mainClass>
						</manifest>
					</archive>
					<descriptors>
						<descriptor>src/main/assembly/fat-jar.xml</descriptor>
					</descriptors>
					<finalName>${final.jar.name}</finalName>
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
