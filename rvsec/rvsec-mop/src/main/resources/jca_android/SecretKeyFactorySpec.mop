package mop;

import javax.crypto.SecretKey;
import javax.crypto.SecretKeyFactory;
import java.security.spec.KeySpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * SecretKeyFactorySpec
 *
 * Monitors javax.crypto.SecretKeyFactory against the CrySL rule SecretKeyFactory.crysl.
 *
 * The rule's ORDER is `Get, Gen`: obtain a factory with `getInstance`, then use it once,
 * either with `generateSecret(keySpec)` or with `translateKey(otherKey)`. There is no `*` and
 * no `?` in that ordering, so a factory used twice draws the ordering code. The specification
 * checks the rule's one CONSTRAINTS clause, the twelve-name list of password-based derivation
 * algorithms, at `getInstance`; it REQUIRES `speccedKey[keySpec, _]` at `generateSecret`; and
 * it ENSURES `generatedKey[key, algorithm]` at both generating events, which is what lets a
 * Cipher or a Mac downstream tell a key this instrumentation watched being made from one it
 * did not.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/SecretKeyFactory.crysl
 */
SecretKeyFactorySpec(SecretKeyFactory f) {

   // The envelope's quoting rule: a null value is the empty string, a single quote is escaped
   // so it cannot close the field early, and the value is capped.
   private String q(String str) {
       if (str == null) {
           return "";
       }
       String value = str.length() > 512 ? str.substring(0, 512) : str;
       return value.replace("'", "\\'");
   }

   // The rule's one CONSTRAINTS clause, `algorithm in {...}`, transcribed. The clause names
   // `PBEWithHmacSHA384AndAES_128` twice and the duplicate is not carried here: a list is a set,
   // and `ConscryptAliasTable.matches` answers the same for one copy or two.
   //
   // Twelve distinct entries: four `PBKDF2WithHmacSHA*` and eight `PBEWithHmacSHA*AndAES_*`.
   List<String> safeAlgorithms = Arrays.asList(
       "PBKDF2WithHmacSHA512", "PBKDF2WithHmacSHA384", "PBKDF2WithHmacSHA256",
       "PBKDF2WithHmacSHA224",
       "PBEWithHmacSHA512AndAES_128", "PBEWithHmacSHA384AndAES_128",
       "PBEWithHmacSHA224AndAES_128", "PBEWithHmacSHA256AndAES_128",
       "PBEWithHmacSHA224AndAES_256", "PBEWithHmacSHA256AndAES_256",
       "PBEWithHmacSHA384AndAES_256", "PBEWithHmacSHA512AndAES_256");

   // The canonical algorithm the factory was obtained for, kept from `get` for the
   // `generatedKey` writes at the two generating events.
   String algorithm = null;

   // The `exp=` text of the three reports at `gen`, in one place so the three say the same.
   String expectedSpeccedKey = "a key spec this instrumentation observed being built from key material";

   // Set by `get` and read by `@fail` (SECRETKEYFACTORY-ORDER-01). The generated `reset()`
   // clears the state and not this field.
   boolean creationObserved = false;

   // `Get := g1 | g2`: `g1: getInstance(algorithm)` and `g2: getInstance(algorithm, _)`, fused
   // on the zeroth position. The rule leaves `g2`'s second position anonymous, so every overload
   // the platform declares is that event: it declares `(String)`, `(String, String)` and
   // `(String, Provider)`, and all three are named here. Naming a proper subset would narrow the
   // rule's alphabet without saying so -- the unnamed route would take no event at all, so its
   // value clause could not accuse, and the factory would reach its next event with the monitor
   // still in the initial state, where every row is `fail`.
   //
   // CONSTRAINTS `algorithm in {...}`, checked in the body against the list above through
   // `ConscryptAliasTable.matches`, which compares case-insensitively and resolves a provider
   // alias to the name the rule writes. A name outside the list draws the unsafe-algorithm code
   // registered in `codes.csv` for this site. The check sits in the body and not in a
   // `condition(...)` guard: a guard compiles to an early return ahead of both the body and the
   // transition, so a factory obtained for an algorithm the rule refuses would leave the
   // automaton in its initial state and the `generateSecret` that followed would be reported as
   // a wrong call sequence instead of as the unsafe algorithm it is.
   event get after(String alg) returning(SecretKeyFactory f):
     ( call(public static SecretKeyFactory SecretKeyFactory.getInstance(String)) ||
       call(public static SecretKeyFactory SecretKeyFactory.getInstance(String, String)) ||
       call(public static SecretKeyFactory SecretKeyFactory.getInstance(String, java.security.Provider))
     ) && args(alg, ..) {
       creationObserved = true;
       algorithm = ConscryptAliasTable.canonical("SecretKeyFactory", alg);
       if (!ConscryptAliasTable.matches("SecretKeyFactory", alg, safeAlgorithms)) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SecretKeyFactorySpec", "" + __LOC,
               "v=1 code=SECRETKEYFACTORY-ALG-00 ev=" + __EVENTNAME + " obj=SecretKeyFactory val='" + q(alg) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + alg + "'"));
       }
   }

   // `Gen`: `gS: key = generateSecret(keySpec)`, one alternative of `Gen := gS | tK`, and the
   // password-to-key route.
   //
   // REQUIRES `speccedKey[keySpec, _]`: the key spec was constructed by a call the
   // instrumentation observed and the rule admitted. The clause leaves its second position
   // anonymous, which is what `validateAny` reads -- does this object carry the predicate at
   // all. Reading it with `validate` and no value would compare against the empty argument list,
   // which no producer of a wider clause records, so every conforming key spec would come back
   // VIOLATED. The producers are the constructors of `PBEKeySpecSpec`, which records a key
   // length in the anonymous place, `SecretKeySpecSpec` and `X509EncodedKeySpecSpec`, which
   // record none; an anonymous read answers to all three alike.
   //
   // The read is three-valued. SATISFIED is silent. VIOLATED is positive evidence about this
   // spec -- an entry exists and is not what the clause demands, which for this predicate means
   // a `PBEKeySpec` whose `clearPassword()` was observed, since that is the one place the rule
   // set negates it -- and draws the constraint code. NOT_OBSERVED means no entry at all: no
   // construction of the spec was ever seen, which on this platform is as often a limit of what
   // the weaving reaches as a misuse. A spec that carries REPORTED_UPSTREAM was already reported
   // by the specification that watched its construction -- a `PBEKeySpec` over a salt nobody saw
   // being randomised, for example -- so this site is looking at a refusal upstream and not at a
   // gap in instrumentation reach; that branch is taken ahead of the plain not-observed one and
   // reports under its own code.
   //
   // The read sits in the body and not in a `condition(...)` guard: a guard compiles to an early
   // return ahead of both the body and the transition, so a call over an unobserved key spec
   // would leave the automaton in the state before it and the next call would be reported as a
   // wrong call sequence instead of as the unsatisfied REQUIRES it is.
   //
   // ENSURES `generatedKey[key, algorithm]`: the key was produced by a call the instrumentation
   // observed, for the algorithm recorded with it. It is written here in the body and not in a
   // handler, because the clause names the key this call returned and a handler receives no
   // event arguments. The value place carries the canonical name `getInstance` resolved, because
   // the readers of this predicate ask with a canonical name: the store compares String value
   // positions case-insensitively, but an unresolved provider alias is a different string and
   // not a different case, so it would not meet the reader's value and the chain would break in
   // silence. The write is on the conforming branch only -- a key spec whose origin was refused
   // does not go on to make a key the rule vouches for.
   //
   // Whichever report this body makes, the key this call returns is marked REPORTED_UPSTREAM in
   // turn, and the `getEncoded()` bridges of this set carry the mark on to its encoding.
   event gen after(KeySpec keySpec, SecretKeyFactory f) returning(SecretKey key):
     call(public SecretKey SecretKeyFactory.generateSecret(KeySpec)) &&
     args(keySpec) && target(f) {
       boolean conforms = true;
       boolean reported = false;
       PredicateVerdict specced = PredicateStore.instance().validateAny(Property.SPECCED_KEY, keySpec);
       if (specced == PredicateVerdict.VIOLATED) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeyFactorySpec", "" + __LOC,
               "v=1 code=SECRETKEYFACTORY-CONSTR-00 ev=" + __EVENTNAME + " obj=SecretKeyFactory val='" + q(algorithm) + "' exp='" + q(expectedSpeccedKey) + "' msg='the key spec carries a specification predicate the rule does not admit'"));
           reported = true;
       }
       else if (specced == PredicateVerdict.NOT_OBSERVED && PredicateStore.instance().validateAny(Property.REPORTED_UPSTREAM, keySpec) == PredicateVerdict.SATISFIED) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeyFactorySpec", "" + __LOC,
               "v=1 code=SECRETKEYFACTORY-NOBS-01 ev=" + __EVENTNAME + " obj=SecretKeyFactory val='" + q(algorithm) + "' exp='" + q(expectedSpeccedKey) + "' msg='the key spec was already reported when it was constructed'" + Evidence.keysFor(keySpec)));
           reported = true;
       }
       else if (specced == PredicateVerdict.NOT_OBSERVED) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeyFactorySpec", "" + __LOC,
               "v=1 code=SECRETKEYFACTORY-NOBS-00 ev=" + __EVENTNAME + " obj=SecretKeyFactory val='" + q(algorithm) + "' exp='" + q(expectedSpeccedKey) + "' msg='no construction of the key spec was observed'" + Evidence.keysFor(keySpec)));
           reported = true;
       }
       if (conforms) {
           PredicateStore.instance().ensure(Property.GENERATED_KEY, key, algorithm);
       }
       if (reported) {
           PredicateStore.instance().ensure(Property.REPORTED_UPSTREAM, key);
       }
   }

   // `Gen`: `tK: key = translateKey(otherKey)`, the other alternative of `Gen`. The rule's one
   // REQUIRES names `keySpec`, which this overload does not bind, so there is no predicate read
   // here; that is the rule speaking rather than an omission.
   //
   // ENSURES `generatedKey[key, algorithm]`: the key was produced by a call the instrumentation
   // observed, for the algorithm recorded with it. The clause names the returned key whatever
   // the route, so the write is unconditional here -- nothing in this call could have failed a
   // clause. It is written in the body because a handler receives no event arguments and could
   // not see the key the call returned; the value place carries the canonical algorithm the
   // `getInstance` event resolved, as at the other generating event.
   event translate after(SecretKey otherKey, SecretKeyFactory f) returning(SecretKey key):
     call(public SecretKey SecretKeyFactory.translateKey(SecretKey)) &&
     args(otherKey) && target(f) {
       PredicateStore.instance().ensure(Property.GENERATED_KEY, key, algorithm);
   }

   // The rule's ORDER, `Get, Gen`. One `getInstance`, then one generating call; a factory used
   // twice draws the ordering code, which is what the rule states -- there is no `*` and no `?`
   // in it. The `@fail` handler below can therefore fire, and its two branches are two different
   // claims about the failure: a factory this specification never saw being obtained, or a plain
   // wrong call sequence. Each carries its own code in `codes.csv`.
   ere : get (gen | translate)

   @fail {
      if (!creationObserved) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SecretKeyFactorySpec", "" + __LOC,
              "v=1 code=SECRETKEYFACTORY-ORDER-01 ev=" + __EVENTNAME + " obj=SecretKeyFactory val='' exp='' msg='the observed call sequence is not one SecretKeyFactorySpec accepts, and no getInstance of this SecretKeyFactory was observed'"));
      }
      else {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SecretKeyFactorySpec", "" + __LOC,
              "v=1 code=SECRETKEYFACTORY-ORDER-00 ev=" + __EVENTNAME + " obj=SecretKeyFactory val='' exp='' msg='the observed call sequence is not one SecretKeyFactorySpec accepts'"));
      }
      __RESET;
   }

   // The rule's one ENSURES names the returned key, so it is written in the two `Gen`
   // bodies; see them. The handler stages nothing.
   @match {
   }

}
