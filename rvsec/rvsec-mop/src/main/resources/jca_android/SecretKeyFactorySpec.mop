package mop;

import javax.crypto.SecretKey;
import javax.crypto.SecretKeyFactory;
import java.security.spec.KeySpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * SecretKeyFactory
 *
 * A JavaMOP specification of the correct usage of the
 * javax.crypto.SecretKeyFactory.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/SecretKeyFactory.crysl
 */
SecretKeyFactorySpec(SecretKeyFactory f) {

   // The envelope's quoting rule (design D-3).
   private String q(String str) {
       if (str == null) {
           return "";
       }
       String value = str.length() > 512 ? str.substring(0, 512) : str;
       return value.replace("'", "\\'");
   }

   // SecretKeyFactory.crysl:22-25, transcribed. The rule lists
   // `PBEWithHmacSHA384AndAES_128` TWICE (:23) and the duplicate is dropped here rather than
   // carried: a list is a set, `contains` answers the same for one copy or two, and
   // transcribing the repetition would put a defect of the oracle into a data structure
   // where no reader could see it. The duplication itself is recorded as an `oracle-wart`
   // row against `tools/rules/SecretKeyFactory.crysl` -- the oracle is never edited (D-21).
   //
   // Twelve distinct entries: four PBKDF2WithHmacSHA* and eight PBEWithHmacSHA*AndAES_*.
   List<String> safeAlgorithms = Arrays.asList(
       "PBKDF2WithHmacSHA512", "PBKDF2WithHmacSHA384", "PBKDF2WithHmacSHA256",
       "PBKDF2WithHmacSHA224",
       "PBEWithHmacSHA512AndAES_128", "PBEWithHmacSHA384AndAES_128",
       "PBEWithHmacSHA224AndAES_128", "PBEWithHmacSHA256AndAES_128",
       "PBEWithHmacSHA224AndAES_256", "PBEWithHmacSHA256AndAES_256",
       "PBEWithHmacSHA384AndAES_256", "PBEWithHmacSHA512AndAES_256");

   String algorithm = null;

   String expectedSpeccedKey = "a key spec this instrumentation observed being built from key material";

   // `Get := g1 | g2` (:10-12), fused on the zeroth position. The rule leaves `g2`'s second
   // position anonymous (`getInstance(algorithm, _)`), so every overload the platform
   // declares is that event: api30 declares three -- `(String)`, `(String, String)` and
   // `(String, Provider)` -- and all three are named here. Naming a proper subset narrows
   // the rule's alphabet without saying so (INV-INS-157): the unnamed route takes no event
   // at all, so its value clause cannot accuse, and the object reaches its next event with
   // the monitor at state 0, where every row is `fail`. Idiom: `KeyFactorySpec.mop:50-52`.
   event get after(String alg) returning(SecretKeyFactory f):
     ( call(public static SecretKeyFactory SecretKeyFactory.getInstance(String)) ||
       call(public static SecretKeyFactory SecretKeyFactory.getInstance(String, String)) ||
       call(public static SecretKeyFactory SecretKeyFactory.getInstance(String, java.security.Provider))
     ) && args(alg, ..) {
       algorithm = ConscryptAliasTable.canonical("SecretKeyFactory", alg);
       if (!ConscryptAliasTable.matches("SecretKeyFactory", alg, safeAlgorithms)) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SecretKeyFactorySpec", "" + __LOC,
               "v=1 code=SECRETKEYFACTORY-ALG-00 ev=" + __EVENTNAME + " obj=SecretKeyFactory val='" + q(alg) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + alg + "'"));
       }
   }

   // `gS: key = generateSecret(keySpec)` (:14), one alternative of `Gen := gS | tK`.
   //
   // This is the password-to-key route, and it is the site of `speccedKey[keySpec, _]`
   // (:28). The clause leaves its second position ANONYMOUS, which is what
   // `PredicateStore.validateAny` reads: a positive REQUIRES whose remaining positions the
   // rule itself does not name. Reading it at arity 1 instead would demand a one-place entry
   // and answer VIOLATED for every key spec whose producer wrote the value the rule allows
   // it to ignore.
   //
   // The producers are the existing `PBEKeySpecSpec` and `SecretKeySpecSpec`, and
   // `X509EncodedKeySpecSpec` from task 2.13.
   //
   // The ENSURES, `generatedKey[key, algorithm]` (:31), is written HERE and not in `@match`,
   // because the clause names the RETURNED key and a handler sees no parameter of the event
   // it follows -- the placement `KeyManagerFactorySpec.gkm1` records (INV-INS-134). The
   // value position carries the canonical algorithm (D-20.3, INV-INS-153): `CipherSpec` and
   // `MacSpec` read this predicate against a canonical name, and a raw alias would break the
   // chain silently.
   //
   // The write is on the conforming branch only. A key spec whose origin was refused does
   // not go on to make a key the rule vouches for.
   event gen after(KeySpec keySpec, SecretKeyFactory f) returning(SecretKey key):
     call(public SecretKey SecretKeyFactory.generateSecret(KeySpec)) &&
     args(keySpec) && target(f) {
       boolean conforms = true;
       PredicateVerdict specced = PredicateStore.instance().validateAny(Property.SPECCED_KEY, keySpec);
       if (specced == PredicateVerdict.VIOLATED) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeyFactorySpec", "" + __LOC,
               "v=1 code=SECRETKEYFACTORY-CONSTR-00 ev=" + __EVENTNAME + " obj=SecretKeyFactory val='" + q(algorithm) + "' exp='" + q(expectedSpeccedKey) + "' msg='the key spec carries a specification predicate the rule does not admit'"));
       }
       else if (specced == PredicateVerdict.NOT_OBSERVED) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeyFactorySpec", "" + __LOC,
               "v=1 code=SECRETKEYFACTORY-NOBS-00 ev=" + __EVENTNAME + " obj=SecretKeyFactory val='" + q(algorithm) + "' exp='" + q(expectedSpeccedKey) + "' msg='no construction of the key spec was observed'"));
       }
       if (conforms) {
           PredicateStore.instance().ensure(Property.GENERATED_KEY, key, algorithm);
       }
   }

   // `tK: key = translateKey(otherKey)` (:15), the other alternative of `Gen`. The rule's
   // one REQUIRES names `keySpec`, which this overload does not bind, so there is no read
   // here and that is the rule speaking rather than an omission -- the same shape
   // `PKIXParametersSpec.c2` records for its anonymous argument.
   //
   // The ENSURES names the returned key whatever the route, so the write is unconditional
   // here: nothing in this call could have failed a clause.
   event translate after(SecretKey otherKey, SecretKeyFactory f) returning(SecretKey key):
     call(public SecretKey SecretKeyFactory.translateKey(SecretKey)) &&
     args(otherKey) && target(f) {
       PredicateStore.instance().ensure(Property.GENERATED_KEY, key, algorithm);
   }

   // The rule's ORDER, `Get, Gen` (:19). One Get, then one Gen; a factory used twice draws
   // the ORDER code, which is what the rule states -- there is no `*` and no `?` in it.
   ere : get (gen | translate)

   @fail {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SecretKeyFactorySpec", "" + __LOC,
          "v=1 code=SECRETKEYFACTORY-ORDER-00 ev=" + __EVENTNAME + " obj=SecretKeyFactory val='' exp='' msg='the observed call sequence is not one SecretKeyFactorySpec accepts'"));
      __RESET;
   }

   // The rule's one ENSURES names the returned key, so it is written in the two `Gen`
   // bodies; see them. The handler stages nothing.
   @match {
   }

}
