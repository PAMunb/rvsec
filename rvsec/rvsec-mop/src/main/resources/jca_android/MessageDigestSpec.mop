package mop;

import java.security.Provider;
import java.security.MessageDigest;
import java.util.List;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

// The MessageDigestSpec specifies
// the correct usage of the MessageDigest
// class (from the JCA specification).
MessageDigestSpec(MessageDigest digest) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    // D-15: the value oracle is the expert-validated rule, not the api30 catalogue.
    // MessageDigest.crysl states `algorithm in {"SHA-256", "SHA-384", "SHA-512"}`; the three
    // unhyphenated entries are the frozen jca's spelling variants of the same three, kept
    // because comparison folds case and resolves aliases, so they change no verdict.
    // `SHA-224` is NOT here: the platform offers it and the experts omit it (oracle-wart).
    List<String> algorithms = Arrays.asList("SHA-256", "SHA-384", "SHA-512", "SHA256", "SHA384", "SHA512");
    // MessageDigest.crysl:47-48 state `digested[output, _]` and `digested[output, input]`
    // over the array the digest events produce, and a handler sees no event parameter, so
    // the three events stage the array and the acceptance handler consumes it. Cleared on
    // consumption, so an event whose digest the automaton did not accept leaves no
    // marking behind for the next one.
    byte[] stagedDigested = null;

	/*
	getInstance events should not, by themselves, trigger UnsalfeAlgorithm errors. The reason is because the algorithm
	is only actually executed during the encryption phase (i.e., in calls to digest() and update(), in the case of MD.)
	Therefore, during the getInstance sub-graph, we only need to keep track of what is the latest algorithm that has
	been instantiated.
	 */
	// `MessageDigest.crysl:46` states `generatedMessageDigest[this] after Get`, and the
	// `after Get` is what fixes the site: the acceptance point is this transition, not the
	// accepting state, which is the same reading -- inverted -- that puts `digested` in
	// `@match` below (INV-INS-134). The predicate is what `DigestInputStream.crysl:33` and
	// `DigestOutputStream.crysl:34` require, so without this write their reads could answer
	// only NOT_OBSERVED, for every program, forever.
	//
	// It is written by `g1`, `g2` and `g3` and not by `g4`. The three are the conforming
	// route -- each guarded on `ConscryptAliasTable.matches` -- while `g4` is the
	// complementary event over the same pointcut, whose body has just accused
	// MESSAGEDIGEST-ALG-02. Writing there would hand the stream rules a digest this
	// specification refused, and CrySL ensures a predicate for a use that satisfied the
	// rule.
	//
	// The `condition(...)` on these three is not the mistake INV-INS-133 names. That rule
	// is about a clause whose violated side is silence; here the violated side is `g4`,
	// which reports. The guard partitions the calls, it does not hide them.
	event g1 after(String alg) returning(MessageDigest digest):
	  call(public static MessageDigest MessageDigest.getInstance(String))
	  && args(alg) && condition(ConscryptAliasTable.matches("MessageDigest", alg, algorithms)) {
	  PredicateStore.instance().ensure(Property.GENERATED_MESSAGE_DIGEST, digest);
	}

	event g2 after(String alg, String provider) returning(MessageDigest digest):
      call(public static MessageDigest MessageDigest.getInstance(String, String))
      && args(alg, provider) && condition(ConscryptAliasTable.matches("MessageDigest", alg, algorithms)) {
	  PredicateStore.instance().ensure(Property.GENERATED_MESSAGE_DIGEST, digest);
    }

    event g3 after(String alg, Provider provider) returning(MessageDigest digest):
      call(public static MessageDigest MessageDigest.getInstance(String, Provider))
      && args(alg, provider) && condition(ConscryptAliasTable.matches("MessageDigest", alg, algorithms)) {
    	PredicateStore.instance().ensure(Property.GENERATED_MESSAGE_DIGEST, digest);
    }

	/*
	We no longer throw errors after unsafe instantiation events, otherwise we would throw InvalidSequenceOfMethodCalls
	in cases like (g3* g1 | g3* g2).
	Not throwing here eliminates the InvalidSequenceOfMethodCalls false positive in bench02.BrokenHashABPSCase1
	 */
	// The guard reads the bound argument, not the monitor field. The field is
	// initialised `""` and only `g1`/`g2` write it, so this guard held on a fresh
	// monitor only because the generator emits `g1Event` ahead of `g4Event` on the
	// shared pointcut, an order nothing in the tree asserts. Were it to invert, this
	// body -- which does accuse, unlike its KeyGenerator twin -- would report every
	// safe `getInstance` with the self-contradicting envelope `expecting one of
	// SHA-256,... but found SHA-256`: the `but found .` signature task 8.16 repaired
	// in the body `if` guards and did not reach inside a `condition()` clause.
	event g4 after(String alg) returning(MessageDigest digest):
	  call(public static MessageDigest MessageDigest.getInstance(String))
    	  && args(alg) && condition(!ConscryptAliasTable.matches("MessageDigest", alg, algorithms))
        {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MessageDigestSpec", "" + __LOC,
              "v=1 code=MESSAGEDIGEST-ALG-02 ev=" + __EVENTNAME + " obj=MessageDigest val='" + q(alg) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + alg + "'"));
        }

	/*
	It's inside the events that actually consume the algorithm that we catch UnsafeAlgorithm
	 */
	event update after(MessageDigest digest):
	  call(void MessageDigest.update(..)) &&
	  target(digest) {
		if (!ConscryptAliasTable.matches("MessageDigest", digest.getAlgorithm(), algorithms)) {
			ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MessageDigestSpec", "" +
		__LOC,
       "v=1 code=MESSAGEDIGEST-ALG-00 ev=" + __EVENTNAME + " obj=MessageDigest val='" + q(digest.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + digest.getAlgorithm() + "'"));
		}
	  }

	/*
	`digested[output, _]` (MessageDigest.crysl:47) and `digested[output, input]` (:48).
	Neither clause carries an `after L`, so the acceptance point of both is the accepting
	state, which in an `ere` is what `@match` names (INV-INS-134). Read off the generated
	monitor, the three digest events all land in state 2 and the match category is
	`nextstate == 2`, so the three sites share one acceptance point.

	The first clause is two-place with the second place anonymous, and a projection onto
	`out` is exactly what it asks -- the same reading `MACED` carries for `macced[M, D]`.
	The second clause names both places, and this site writes one. The arity stays where
	the seed had it, with the reason recorded in `predicate_graph.csv`: no rule of the
	oracle requires `digested`, so there is no consumer whose arity this write has to meet.
	 */
	// Same case as `update` and `d2`: this event consumes the algorithm, so this is where
	// an unsafe one is caught. Without the check the two-argument route was silent on
	// value -- `getInstance("MD5", provider)` followed by a direct `digest()` matches `g2`
	// and `d1`, neither of which looked at the algorithm, and the only report the sequence
	// could draw was an ordering one it did not deserve.
	event d1 after(MessageDigest digest) returning(byte[] out):
	 call(public byte[] MessageDigest.digest()) &&
	 target(digest) {
		if (!ConscryptAliasTable.matches("MessageDigest", digest.getAlgorithm(), algorithms)) {
			ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MessageDigestSpec", "" +
		__LOC,
       "v=1 code=MESSAGEDIGEST-ALG-03 ev=" + __EVENTNAME + " obj=MessageDigest val='" + q(digest.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + digest.getAlgorithm() + "'"));
		}
	    stagedDigested = out;
	}

	/*
	Same case as update
	 */
	event d2 after(MessageDigest digest) returning(byte[] out):
     call(public byte[] MessageDigest.digest(byte[])) &&
     target(digest) {
		if (!ConscryptAliasTable.matches("MessageDigest", digest.getAlgorithm(), algorithms)) {
			ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MessageDigestSpec", "" +
		     __LOC,
       "v=1 code=MESSAGEDIGEST-ALG-01 ev=" + __EVENTNAME + " obj=MessageDigest val='" + q(digest.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + digest.getAlgorithm() + "'"));
		}
    	stagedDigested = out;
    }

    // The third consumption route, and the same check for the same reason. The code is a
    // site's and not a clause's: one CONSTRAINTS clause read at four events is four codes,
    // because the report has to say which call it is about.
    event d3 after(byte[] out, int offset, int len, MessageDigest digest):
     call(public int MessageDigest.digest(byte[], int, int)) &&
     args(out, offset, len) &&
     target(digest) {
		if (!ConscryptAliasTable.matches("MessageDigest", digest.getAlgorithm(), algorithms)) {
			ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MessageDigestSpec", "" +
		__LOC,
       "v=1 code=MESSAGEDIGEST-ALG-04 ev=" + __EVENTNAME + " obj=MessageDigest val='" + q(digest.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + digest.getAlgorithm() + "'"));
		}
       stagedDigested = out;
    }

	/*
	Allowing g3 followed by g1 or g2 will eliminate the Invalid SequenceOfMethodCalls false positive in
	bench02.BrokenHashABPSCase1
	*/
	/*
	`digested` is required by no rule of the oracle -- it appears there only as this
	rule's own ENSURES, and the `digestedInputStream`/`digestedOutputStream` the stream
	rules ensure are different predicates -- so it is one of the dead ends this change
	disposes of by recording the omission rather than by fabricating a consumer
	(INV-INS-137).

	What leaves the two handlers besides is the accepting-state bookkeeping: the new store
	does not offer it and the set never read it back (INV-INS-147). That is also why the
	`MessageDigest md` field is gone -- those two calls were the only things that read it.
	 */
	ere : (g4* g1 | g4* g2 | g4* g3) (d2 | (update+ (d1 | d2 | d3)))+

	@fail {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "MessageDigestSpec", "" + __LOC,
               "v=1 code=MESSAGEDIGEST-ORDER-00 ev=" + __EVENTNAME + " obj=MessageDigest val='' exp='' msg='the observed call sequence is not one MessageDigestSpec accepts'"));
           stagedDigested = null;
           __RESET;
	}

	@match {
           if (stagedDigested != null) {
               PredicateStore.instance().ensure(Property.DIGESTED, stagedDigested);
               stagedDigested = null;
           }
	}
}
