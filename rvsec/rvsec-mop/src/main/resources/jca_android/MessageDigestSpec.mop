package mop;

import java.security.Provider;
import java.security.MessageDigest;
import java.util.List;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * MessageDigestSpec
 *
 * Monitors java.security.MessageDigest against the CrySL rule MessageDigest.crysl.
 *
 * The rule's ORDER is `Get, (DWOU | (Update+, Digest))+`: a digest is obtained, then fed and
 * finalised, possibly several times over, and a `digest(input)` may stand alone because it
 * brings its own data. The clause this specification enforces is the algorithm one,
 * `algorithm in {"SHA-256", "SHA-384", "SHA-512"}`, checked at every event that consumes the
 * algorithm and reported there.
 *
 * It ENSURES `generatedMessageDigest[this] after Get`, written in the bodies of the three
 * `getInstance` events whose algorithm the clause admits, and `digested[output, _]` at the
 * acceptance point over the array a digest call produced. DigestInputStreamSpec and
 * DigestOutputStreamSpec read the first at their constructors, where their own rule REQUIRES
 * it; nothing in this set reads the second.
 *
 * What it does not check: the rule's remaining CONSTRAINTS are the array-window clauses
 * `length[preInput] >= preLen + preOffset`, `preOffset >= 0`, `preLen > 0`,
 * `length[output] >= len + offset`, `offset >= 0` and `len > 0`, and no event of this file
 * compares them. The rule's four `update` events are observed through one aggregate pointcut
 * that binds no argument, so the arrays and windows those clauses speak about never reach a
 * body that could compare them.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/MessageDigest.crysl
 */
MessageDigestSpec(MessageDigest digest) {
    // The envelope's quoting rule: a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    // CONSTRAINTS of MessageDigest.crysl: `algorithm in {"SHA-256", "SHA-384", "SHA-512"}`.
    // Those three are the whole of what the clause admits, so a digest obtained for `MD5`,
    // `SHA-1` or `SHA-224` is refused here, whatever the platform offers.
    //
    // The list carries three spellings the clause does not write -- `SHA256`, `SHA384` and
    // `SHA512` -- and they admit nothing the clause refuses. The comparison runs through
    // `ConscryptAliasTable.matches`, which folds case and resolves the provider's alias names
    // before comparing: the table holds a `MessageDigest` row taking `SHA256` to `SHA-256`, and
    // the same for 384 and 512, so a program that asks for an unhyphenated spelling resolves to
    // the canonical name the clause states and is admitted either way.
    List<String> algorithms = Arrays.asList("SHA-256", "SHA-384", "SHA-512", "SHA256", "SHA384", "SHA512");
    // ENSURES `digested[output, _]` and `digested[output, input]` of MessageDigest.crysl, over
    // the array a digest call produced. A handler sees no event parameter and runs after the
    // transition is decided, so the three digest events stage the array here and the acceptance
    // handler consumes it. Cleared on consumption, so an event whose digest the automaton did
    // not accept leaves no marking behind for the next one.
    byte[] stagedDigested = null;

    // Set by the five creation events, `g1` to `g5`, the refused `g4` and `g5` included, and
    // never cleared: the generated `reset()` restores the automaton state and leaves this
    // field, so the fact survives a failure. `@fail` reads it to report a digest whose creation
    // no event of this specification observed -- one obtained through `clone()` is such a
    // digest -- under `MESSAGEDIGEST-ORDER-01` (`creation-unobserved`) instead of the
    // wrong-sequence code. A `getInstance` of an algorithm the list refuses runs `g4` (one
    // argument) or `g5` (two arguments), so a digest created in woven code is never counted
    // as unobserved.
    boolean creationObserved = false;

    // Set by the refused creation events `g4` and `g5`, and never cleared, for the same reason
    // as `creationObserved`. `@fail` reads it after `creationObserved` to report the failure of
    // a digest whose algorithm the list refused under `MESSAGEDIGEST-ORDER-02`
    // (`creation-refused`): the automaton admits no use of such a digest, so its ordering
    // failure is the consequence of the refusal and not a wrong order the program chose.
    boolean creationRefused = false;

	// `Get` of MessageDigest.crysl: `g1: getInstance(algorithm)`, the one-argument overload,
	// under a guard that admits only an algorithm the CONSTRAINTS clause allows.
	//
	// The body writes the rule's ENSURES `generatedMessageDigest[this] after Get`: the
	// MessageDigest was obtained for an algorithm the rule admits. The `after Get` is what fixes
	// the site -- the acceptance point of that clause is this transition and not the accepting
	// state of the ORDER -- so the write sits in the event body and not in a handler. Two
	// specifications read it, DigestInputStreamSpec and DigestOutputStreamSpec, each at its
	// constructor, where `generatedMessageDigest[digest]` is what their own rule REQUIRES;
	// without this write both of those reads could answer only NOT_OBSERVED, for every program.
	//
	// The write is made by `g1`, `g2` and `g3` and by neither `g4` nor `g5`. Those three are the
	// admitted route, each guarded on `ConscryptAliasTable.matches`, and `g4` and `g5` are their
	// complements over the same pointcuts. Writing there would hand the two stream
	// specifications a digest this one refused, and a CrySL ENSURES speaks for a use that
	// satisfied the rule.
	//
	// A `condition(...)` guard is the right shape at this event, unlike at the events below that
	// check the algorithm in their body: the guard does not hide a call, it chooses between two
	// events over the same call. Whichever way it goes the call is observed -- when `g1` declines
	// it, `g4` takes it and reports -- so nothing drops out of the automaton silently.
	event g1 after(String alg) returning(MessageDigest digest):
	  call(public static MessageDigest MessageDigest.getInstance(String))
	  && args(alg) && condition(ConscryptAliasTable.matches("MessageDigest", alg, algorithms)) {
	  creationObserved = true;
	  PredicateStore.instance().ensure(Property.GENERATED_MESSAGE_DIGEST, digest);
	}

	// `Get` of MessageDigest.crysl: `g2: getInstance(algorithm, _)`, bound here to the
	// `(String, String)` overload that names the provider. The same guard and the same write as
	// `g1`: the body records the creation and establishes `generatedMessageDigest[this] after
	// Get`, that the MessageDigest was obtained for an algorithm the rule admits.
	event g2 after(String alg, String provider) returning(MessageDigest digest):
      call(public static MessageDigest MessageDigest.getInstance(String, String))
      && args(alg, provider) && condition(ConscryptAliasTable.matches("MessageDigest", alg, algorithms)) {
	  creationObserved = true;
	  PredicateStore.instance().ensure(Property.GENERATED_MESSAGE_DIGEST, digest);
    }

    // `Get` of MessageDigest.crysl: `g2: getInstance(algorithm, _)` again, bound to the
    // `(String, Provider)` overload the platform declares beside the `(String, String)` one.
    // The rule writes that second argument as `_` and does not tell the two apart, so this
    // event carries the same guard and the same write as `g2`: `generatedMessageDigest[this]
    // after Get`, that the MessageDigest was obtained for an algorithm the rule admits.
    event g3 after(String alg, Provider provider) returning(MessageDigest digest):
      call(public static MessageDigest MessageDigest.getInstance(String, Provider))
      && args(alg, provider) && condition(ConscryptAliasTable.matches("MessageDigest", alg, algorithms)) {
    	creationObserved = true;
    	PredicateStore.instance().ensure(Property.GENERATED_MESSAGE_DIGEST, digest);
    }

	// The complement of `g1` over the same one-argument pointcut, under the negated guard, so
	// exactly one of the two events runs for any `getInstance(String)` the weaving reaches.
	//
	// The body reports the algorithm clause at once, under the code registered in `codes.csv`
	// for this site, and records the creation as a refused one so the failure handler can tell
	// it apart from a digest it never saw created. It writes no `generatedMessageDigest`: the
	// digest it returns is one the clause does not admit, and the two stream specifications
	// must not receive it as one the rule accepts.
	event g4 after(String alg) returning(MessageDigest digest):
	  call(public static MessageDigest MessageDigest.getInstance(String))
    	  && args(alg) && condition(!ConscryptAliasTable.matches("MessageDigest", alg, algorithms))
        {
          creationObserved = true;
          creationRefused = true;
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MessageDigestSpec", "" + __LOC,
              "v=1 code=MESSAGEDIGEST-ALG-02 ev=" + __EVENTNAME + " obj=MessageDigest val='" + q(alg) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + alg + "'"));
        }

	// The complement of `g2` and `g3`: `Object+` covers `(String, String)` and
	// `(String, Provider)` in one pointcut, and the guard is the negation of theirs. Without it
	// a refused algorithm requested with a provider would run no body at all, and the digest's
	// failure would read `creation-unobserved` although its creation ran in woven code.
	//
	// The body only records the creation. It does not report: the algorithm is accused where
	// the digest is used, at `update`, `d1`, `d2` or `d3`, and the prefix `(g4 | g5)*` sends
	// that first use to `@fail` exactly as a digest no event saw would go, so no reported site
	// changes and only the handler's code does. It writes no field another event reads.
	event g5 after(String alg, Object provider) returning(MessageDigest digest):
	  call(public static MessageDigest MessageDigest.getInstance(String, Object+))
	  && args(alg, provider) && condition(!ConscryptAliasTable.matches("MessageDigest", alg, algorithms)) {
	  creationObserved = true;
	  creationRefused = true;
	}

	// `Update` of MessageDigest.crysl -- `u1: update(preInputByte)`, `u2: update(preInput)`,
	// `u3: update(preInput, preOffset, preLen)` and `u4: update(preInputByteBuffer)` -- observed
	// through one aggregate pointcut that binds no argument. The rule's window clauses over
	// `preInput`, `preOffset` and `preLen` have no bound value to compare here and are not
	// checked.
	//
	// What the body does check is the algorithm clause, `algorithm in {"SHA-256", "SHA-384",
	// "SHA-512"}`, read off the digest itself. This is an event that consumes the algorithm --
	// obtaining a digest computes nothing -- so this is where an algorithm outside the clause is
	// reported, under the code registered in `codes.csv` for this site.
	//
	// The check sits in the event body and not in a `condition(...)` guard, and the difference
	// is what the report says: a guard compiles to an early return ahead of both the body and
	// the transition, so a call on an `MD5` digest would leave the automaton in the state it was
	// in before the call, and the next call would be reported as a wrong call sequence instead
	// of as the weak digest it is.
	event update after(MessageDigest digest):
	  call(void MessageDigest.update(..)) &&
	  target(digest) {
		if (!ConscryptAliasTable.matches("MessageDigest", digest.getAlgorithm(), algorithms)) {
			ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MessageDigestSpec", "" +
		__LOC,
       "v=1 code=MESSAGEDIGEST-ALG-00 ev=" + __EVENTNAME + " obj=MessageDigest val='" + q(digest.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + digest.getAlgorithm() + "'"));
		}
	  }

	// `DWU` of MessageDigest.crysl: `d1: output = digest()`, the overload that finalises what
	// `update` contributed. It consumes the algorithm, so it carries the same clause check as
	// `update`, under a code of its own: one CONSTRAINTS clause read at four events is four
	// codes, because the report has to say which call it is about.
	//
	// The check sits in the body and not in a `condition(...)` guard for the reason it does at
	// `update`: a guard compiles to an early return ahead of both the body and the transition,
	// so a `digest()` on an `MD5` digest would leave the automaton in the state before the call
	// and the next call would be reported as a wrong call sequence instead of as the weak digest
	// it is. A guard would also lose the array -- `stagedDigested` is assigned below, and the
	// ENSURES the acceptance point writes is about exactly that array.
	//
	// Without the check a value failure on this route would reach the report only as an ordering
	// one: `getInstance("MD5", provider)` followed by a direct `digest()` runs `g5` and this
	// event, a sequence the `ere` below refuses, so what the program would be told is that its
	// call order is wrong rather than that its digest algorithm is.
	event d1 after(MessageDigest digest) returning(byte[] out):
	 call(public byte[] MessageDigest.digest()) &&
	 target(digest) {
		if (!ConscryptAliasTable.matches("MessageDigest", digest.getAlgorithm(), algorithms)) {
			ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MessageDigestSpec", "" +
		__LOC,
       "v=1 code=MESSAGEDIGEST-ALG-03 ev=" + __EVENTNAME + " obj=MessageDigest val='" + q(digest.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + digest.getAlgorithm() + "'"));
		}
	    stagedDigested = out;
	}

	// `DWOU` of MessageDigest.crysl: `d2: output = digest(input)`, the overload that brings its
	// own data and the one the ORDER admits with no `update` before it. It consumes the
	// algorithm, so it carries the same clause check as `update` and `d1`, in the body and not
	// in a `condition(...)` guard: a guard compiles to an early return ahead of both the body
	// and the transition, so a call on an `MD5` digest would leave the automaton in the state
	// before the call and the next call would be reported as a wrong call sequence instead of as
	// the weak digest it is. The array the call returns is staged for the acceptance point.
	event d2 after(MessageDigest digest) returning(byte[] out):
     call(public byte[] MessageDigest.digest(byte[])) &&
     target(digest) {
		if (!ConscryptAliasTable.matches("MessageDigest", digest.getAlgorithm(), algorithms)) {
			ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MessageDigestSpec", "" +
		     __LOC,
       "v=1 code=MESSAGEDIGEST-ALG-01 ev=" + __EVENTNAME + " obj=MessageDigest val='" + q(digest.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + digest.getAlgorithm() + "'"));
		}
    	stagedDigested = out;
    }

    // The third consumption route, and the same check for the same reason. The code is a
    // site's and not a clause's: one CONSTRAINTS clause read at four events is four codes,
    // because the report has to say which call it is about.
    //
    // The rule names it `d3: digest(output, offset, len)`, inside `DWU`, and it is the one
    // digest overload that writes into a buffer the caller owns. The rule constrains that
    // window -- `length[output] >= len + offset`, `offset >= 0` and `len > 0` -- and this event
    // compares none of the three: the two int positions are bound and unread. The array it
    // stages for the acceptance point is the caller's buffer, which is what the rule's
    // `digested[output, _]` names.
    event d3 after(byte[] out, int offset, int len, MessageDigest digest):
     call(public int MessageDigest.digest(byte[], int, int)) &&
     args(out, offset, len) &&
     target(digest) {
		if (!ConscryptAliasTable.matches("MessageDigest", digest.getAlgorithm(), algorithms)) {
			ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MessageDigestSpec", "" +
		__LOC,
       "v=1 code=MESSAGEDIGEST-ALG-04 ev=" + __EVENTNAME + " obj=MessageDigest val='" + q(digest.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + digest.getAlgorithm() + "'"));
		}
       stagedDigested = out;
    }

	// The rule's ORDER, `Get, (DWOU | (Update+, Digest))+`, with the refused creations allowed to
	// precede an admitted one: `(g4 | g5)*` before `g1`, `g2` or `g3` lets a program ask for a
	// digest the clause refuses and then ask again for one it admits, and the second request is
	// the one the automaton runs on.
	//
	// `d2` stands alone on the left, as `DWOU` does in the rule, because it is the one digest
	// call that brings its own data; `d1` and `d3` finalise what `update` contributed, so they
	// require the `update+` the rule requires. The whole tail repeats, which is what the rule's
	// trailing `+` says: one digest object may be used for several digests in turn.
	//
	// A program that only ever asks for a refused algorithm never leaves the prefix, so its first
	// use of the digest fails the ordering. `@fail` separates that case by code rather than
	// reporting it as a call order the program chose.
	ere : ((g4 | g5)* g1 | (g4 | g5)* g2 | (g4 | g5)* g3) (d2 | (update+ (d1 | d2 | d3)))+

	// Reached whenever the sequence observed so far is not a word of the `ere` above. Three
	// codes, all registered in `codes.csv`, told apart by the two creation fields: a digest
	// whose creation no event of this specification saw -- one obtained through `clone()` is
	// such a digest -- is reported as an unobserved creation; a digest whose algorithm the
	// clause refused is reported as a refused creation, because its ordering failure follows
	// from that refusal and is not an order the program chose; anything else is reported as a
	// call sequence the specification does not accept. The staged array is dropped here, so a
	// digest call the automaton refused marks nothing.
	@fail {
           if (!creationObserved) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "MessageDigestSpec", "" + __LOC,
                   "v=1 code=MESSAGEDIGEST-ORDER-01 ev=" + __EVENTNAME + " obj=MessageDigest val='' exp='' msg='the observed call sequence is not one MessageDigestSpec accepts and no creation of the digest was observed'"));
           }
           else if (creationRefused) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "MessageDigestSpec", "" + __LOC,
                   "v=1 code=MESSAGEDIGEST-ORDER-02 ev=" + __EVENTNAME + " obj=MessageDigest val='' exp='' msg='the observed call sequence is not one MessageDigestSpec accepts, after a creation the specification refused'"));
           }
           else {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "MessageDigestSpec", "" + __LOC,
                   "v=1 code=MESSAGEDIGEST-ORDER-00 ev=" + __EVENTNAME + " obj=MessageDigest val='' exp='' msg='the observed call sequence is not one MessageDigestSpec accepts'"));
           }
           stagedDigested = null;
           __RESET;
	}

	// ENSURES `digested[output, _]` and `digested[output, input]` of MessageDigest.crysl.
	// Neither clause carries an `after L`, so the acceptance point of both is an accepting state
	// of the ORDER, which in an `ere` is where this handler runs. The write establishes that the
	// bytes are the digest a monitored MessageDigest produced.
	//
	// It takes the array `d1`, `d2` or `d3` staged, because a handler receives no event
	// parameter and runs after the transition is decided. Writing here and not in the event
	// bodies is what keeps a digest call the automaton refused from marking anything.
	//
	// One place is recorded, the output, and the second is left off: no rule of this set
	// REQUIRES `digested`, so there is no reader whose arity this write has to meet, and nothing
	// consumes what it records.
	@match {
           if (stagedDigested != null) {
               PredicateStore.instance().ensure(Property.DIGESTED, stagedDigested);
               stagedDigested = null;
           }
	}
}
