package mop;

import javax.net.ssl.SSLParameters;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * SSLParametersSpec
 *
 * Monitors javax.net.ssl.SSLParameters against the CrySL rule SSLParameters.crysl.
 * The rule orders `(Con1, ((CipherSuite , SetProtocol) | (SetProtocol , CipherSuite))) |
 * (Con2, SetProtocol) | Con3`: the three constructor profiles open three routes, and the
 * protocols and the cipher suites must both be settled, by the constructor or by the setters.
 * Its CONSTRAINTS are three: `elements(protocols) in {"TLSv1.2", "TLSv1.3"}` over the
 * protocols, and two implications whose antecedent is the protocol selection and whose
 * consequent is the list of cipher suites admitted beside it. It ENSURES
 * `generatedSSLParameters[this]`, which this specification writes at its acceptance point.
 *
 * Every clause of the rule has a site here. The reach of the monitor is narrower than the
 * rule's subject, though: an `SSLParameters` the application obtains from a socket, an engine
 * or a context instead of constructing reaches no creation event, so its first setter call is
 * a sequence this automaton refuses and is reported under the `creation-unobserved` code.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/SSLParameters.crysl
 */
SSLParametersSpec(SSLParameters s) {

   // The report envelope's quoting rule.
   private String q(String str) {
       if (str == null) {
           return "";
       }
       String value = str.length() > 512 ? str.substring(0, 512) : str;
       return value.replace("'", "\\'");
   }

   // `elements(x) in {...}` quantifies over every element, so a report has to carry the
   // element that broke the clause and not the array. Null when the clause holds; an empty
   // array satisfies it vacuously. The twin of `SSLEngineSpec.firstRejected`, and the two
   // files transcribe the same three CONSTRAINTS clauses from two rules that state them in
   // identical text.
   //
   // The comparison goes through `ConscryptAliasTable.matches` for the case folding it applies
   // to every allow-list of this set. The table carries no row under the `SSLParameters`
   // service, so nothing is resolved here: an element matches a list entry, or it does not.
   private String firstRejected(String[] values, List<String> allowList) {
       if (values == null) {
           return null;
       }
       for (String value : values) {
           if (!ConscryptAliasTable.matches("SSLParameters", value, allowList)) {
               return value;
           }
       }
       return null;
   }

   // The ANTECEDENT of the two suite implications: `elements(protocols) in {"TLSv1.2"}`, and
   // likewise for `"TLSv1.3"`, hold when every protocol is that one protocol. An empty array
   // selects no protocol and satisfies neither antecedent: read vacuously it would satisfy
   // both at once and one suite list would be accused of failing two mutually exclusive
   // consequents. Parameters with no protocol negotiate nothing, so neither implication is
   // about them.
   private boolean allProtocolsAre(String[] values, String only) {
       if (values == null || values.length == 0) {
           return false;
       }
       for (String value : values) {
           if (!only.equalsIgnoreCase(value)) {
               return false;
           }
       }
       return true;
   }

   // CONSTRAINTS of SSLParameters.crysl: `elements(protocols) in {"TLSv1.2", "TLSv1.3"}`,
   // transcribed. These are wire protocol names, the ones `setProtocols` takes.
   List<String> safeProtocols = Arrays.asList("TLSv1.2", "TLSv1.3");

   // The consequent of the first CONSTRAINTS implication of SSLParameters.crysl,
   // `elements(protocols) in {"TLSv1.2"} => elements(cipherSuites) in {...}`: the suites the
   // rule admits beside TLSv1.2, transcribed literally and in the rule's own order.
   List<String> tls12Suites = Arrays.asList(
       "TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384",
       "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256",
       "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
       "TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256",
       "TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA384",
       "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
       "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
       "TLS_DHE_DSS_WITH_AES_128_CBC_SHA256",
       "TLS_DHE_DSS_WITH_AES_256_CBC_SHA256",
       "TLS_DHE_DSS_WITH_AES_128_GCM_SHA256",
       "TLS_DHE_DSS_WITH_AES_256_GCM_SHA384",
       "TLS_DHE_RSA_WITH_AES_128_CBC_SHA256",
       "TLS_DHE_RSA_WITH_AES_256_CBC_SHA256",
       "TLS_DHE_RSA_WITH_AES_128_GCM_SHA256",
       "TLS_DHE_RSA_WITH_AES_256_GCM_SHA384",
       "TLS_ECDH_ECDSA_WITH_AES_128_CBC_SHA256",
       "TLS_ECDH_ECDSA_WITH_AES_256_CBC_SHA384",
       "TLS_ECDH_ECDSA_WITH_AES_128_GCM_SHA256",
       "TLS_ECDH_ECDSA_WITH_AES_256_GCM_SHA384",
       "TLS_ECDH_RSA_WITH_AES_128_CBC_SHA256",
       "TLS_ECDH_RSA_WITH_AES_256_CBC_SHA384",
       "TLS_ECDH_RSA_WITH_AES_128_GCM_SHA256",
       "TLS_ECDH_RSA_WITH_AES_256_GCM_SHA384");

   // The consequent of the second CONSTRAINTS implication of SSLParameters.crysl,
   // `elements(protocols) in {"TLSv1.3"} => elements(cipherSuites) in {"TLS_AES_128_GCM_SHA256",
   // "TLS_AES_256_GCM_SHA384"}`. The rule names no others, so a third suite enabled beside
   // TLSv1.3 -- the ChaCha20-Poly1305 one the platform offers -- is accused here.
   List<String> tls13Suites = Arrays.asList("TLS_AES_128_GCM_SHA256", "TLS_AES_256_GCM_SHA384");

   // The two arrays, staged, because the implications name both of them and this rule --
   // unlike `SSLEngine` -- offers THREE routes on which they can arrive: `Con3` binds both
   // at once, `Con2` binds the suites and `SetProtocol` the protocols, and `Con1` leaves
   // both to the two setters in either order. The implications are therefore evaluated at
   // every event that can complete a pair, and at no event that cannot.
   String[] protocolList = null;
   String[] cipherSuiteList = null;

   // Bound at every constructor and consumed by the acceptance handler, which sees no event
   // parameter. As in `SSLEngineSpec` the binding is not confined to a conforming branch,
   // because no single event of this rule decides conformance: `conforms` carries the
   // verdict of clauses that span two calls, and the handler gates the write on it.
   SSLParameters constructed = null;
   boolean conforms = true;

   // Set by the three creation events, `c1`, `c2` and `c3`, and never cleared: the generated
   // `reset()` restores the automaton state and leaves this field, so the fact survives a
   // failure. `@fail` reads it to report parameters whose construction no event of this
   // specification observed under `SSLPARAMETERS-ORDER-01` (`creation-unobserved`) instead of
   // the wrong-sequence code.
   boolean creationObserved = false;

   String expectedTls12Suites = "a cipher suite the expert SSLParameters.crysl admits beside TLSv1.2";

   String expectedTls13Suites = "a cipher suite the expert SSLParameters.crysl admits beside TLSv1.3";

   // `Con1: SSLParameters()` of SSLParameters.crysl, the no-argument constructor. It binds
   // neither array, so no clause of the rule has anything to say here; the body binds the
   // object for the acceptance handler and records that a creation was observed. The event
   // exists because the ORDER names it: an alternative of the ORDER with no event would leave
   // the rule accepting a sequence this specification rejects.
   event c1 after() returning(SSLParameters s):
     call(public SSLParameters.new()) {
       creationObserved = true;
       constructed = s;
   }

   // `Con2: SSLParameters(cipherSuites)` of SSLParameters.crysl. It stages the suites; the two
   // implications about them cannot be decided yet, because on this route the ORDER puts the
   // `SetProtocol` that binds the other half after this call.
   event c2 after(String[] cipherSuites) returning(SSLParameters s):
     call(public SSLParameters.new(String[])) &&
     args(cipherSuites) {
       creationObserved = true;
       constructed = s;
       cipherSuiteList = cipherSuites;
   }

   // `Con3: SSLParameters(cipherSuites, protocols)` of SSLParameters.crysl, the one event of
   // this rule that binds BOTH arrays and therefore the only one where all three CONSTRAINTS
   // clauses can be read at once. It is also a complete trace on its own: `Con3` is the third
   // alternative of the ORDER and reaches the accepting state unaided.
   //
   // The clauses are checked in the event body and not in a `condition(...)` guard: a guard
   // compiles to an early return ahead of both the body and the transition, so a construction
   // the rule refuses would leave the automaton in its initial state and the next call on the
   // object would be reported as a wrong call sequence instead of as the misuse it is.
   //
   // The protocol clause and the implications ACCUMULATE -- they are independent, and a
   // construction that narrows to TLSv1 with a suite the rule refuses draws both reports --
   // while the two implications are `if`/`else if`, because their antecedents are mutually
   // exclusive by construction.
   event c3 after(String[] cipherSuites, String[] protocols) returning(SSLParameters s):
     call(public SSLParameters.new(String[], String[])) &&
     args(cipherSuites, protocols) {
       creationObserved = true;
       constructed = s;
       cipherSuiteList = cipherSuites;
       protocolList = protocols;
       String rejectedProtocol = firstRejected(protocolList, safeProtocols);
       if (rejectedProtocol != null) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeProtocol, "SSLParametersSpec", "" + __LOC,
               "v=1 code=SSLPARAMETERS-PROTO-00 ev=" + __EVENTNAME + " obj=SSLParameters val='" + q(rejectedProtocol) + "' exp='" + q(String.join(",", safeProtocols)) + "' msg='expecting one of " + String.join(",", safeProtocols) + " but found " + rejectedProtocol + "'"));
       }
       if (allProtocolsAre(protocolList, "TLSv1.2")) {
           String rejected = firstRejected(cipherSuiteList, tls12Suites);
           if (rejected != null) {
               conforms = false;
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SSLParametersSpec", "" + __LOC,
                   "v=1 code=SSLPARAMETERS-ALG-00 ev=" + __EVENTNAME + " obj=SSLParameters val='" + q(rejected) + "' exp='" + q(expectedTls12Suites) + "' msg='the cipher suites are not ones the expert SSLParameters.crysl admits beside that protocol'"));
           }
       }
       else if (allProtocolsAre(protocolList, "TLSv1.3")) {
           String rejected = firstRejected(cipherSuiteList, tls13Suites);
           if (rejected != null) {
               conforms = false;
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SSLParametersSpec", "" + __LOC,
                   "v=1 code=SSLPARAMETERS-ALG-01 ev=" + __EVENTNAME + " obj=SSLParameters val='" + q(rejected) + "' exp='" + q(expectedTls13Suites) + "' msg='the cipher suites are not ones the expert SSLParameters.crysl admits beside that protocol'"));
           }
       }
   }

   // `CipherSuite: setCipherSuites(cipherSuites)` of SSLParameters.crysl. It is reached only
   // after `Con1`, and it may be either half of that alternative's unordered pair, so it
   // stages its array and evaluates the implications if -- and only if -- the protocols are
   // already known. When this is the first of the pair the guard is false and the
   // `SetProtocol` that follows carries the same block. As at `Con3`, the check is in the body
   // and not in a `condition(...)` guard, which would return ahead of the transition and turn
   // a refused suite list into a wrong-call-sequence report at the next call.
   event cs after(String[] cipherSuites, SSLParameters s):
     call(public void SSLParameters.setCipherSuites(String[])) &&
     args(cipherSuites) && target(s) {
       cipherSuiteList = cipherSuites;
       if (protocolList != null) {
           if (allProtocolsAre(protocolList, "TLSv1.2")) {
               String rejected = firstRejected(cipherSuiteList, tls12Suites);
               if (rejected != null) {
                   conforms = false;
                   ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SSLParametersSpec", "" + __LOC,
                       "v=1 code=SSLPARAMETERS-ALG-02 ev=" + __EVENTNAME + " obj=SSLParameters val='" + q(rejected) + "' exp='" + q(expectedTls12Suites) + "' msg='the cipher suites are not ones the expert SSLParameters.crysl admits beside that protocol'"));
               }
           }
           else if (allProtocolsAre(protocolList, "TLSv1.3")) {
               String rejected = firstRejected(cipherSuiteList, tls13Suites);
               if (rejected != null) {
                   conforms = false;
                   ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SSLParametersSpec", "" + __LOC,
                       "v=1 code=SSLPARAMETERS-ALG-03 ev=" + __EVENTNAME + " obj=SSLParameters val='" + q(rejected) + "' exp='" + q(expectedTls13Suites) + "' msg='the cipher suites are not ones the expert SSLParameters.crysl admits beside that protocol'"));
               }
           }
       }
   }

   // `SetProtocol: setProtocols(protocols)` of SSLParameters.crysl. It binds the array the
   // unconditional protocol clause is about, so that clause is accused here as it is at
   // `Con3` -- two sites for one clause and therefore two codes in `codes.csv`, because a
   // report has to say which call it is about. The implication block is the twin of `cs`'s:
   // this event closes the `Con2` route as well as the second half of the `Con1` pair. The
   // checks are in the body, for the reason given at `Con3`.
   event sp after(String[] protocols, SSLParameters s):
     call(public void SSLParameters.setProtocols(String[])) &&
     args(protocols) && target(s) {
       protocolList = protocols;
       String rejectedProtocol = firstRejected(protocolList, safeProtocols);
       if (rejectedProtocol != null) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeProtocol, "SSLParametersSpec", "" + __LOC,
               "v=1 code=SSLPARAMETERS-PROTO-01 ev=" + __EVENTNAME + " obj=SSLParameters val='" + q(rejectedProtocol) + "' exp='" + q(String.join(",", safeProtocols)) + "' msg='expecting one of " + String.join(",", safeProtocols) + " but found " + rejectedProtocol + "'"));
       }
       if (cipherSuiteList != null) {
           if (allProtocolsAre(protocolList, "TLSv1.2")) {
               String rejected = firstRejected(cipherSuiteList, tls12Suites);
               if (rejected != null) {
                   conforms = false;
                   ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SSLParametersSpec", "" + __LOC,
                       "v=1 code=SSLPARAMETERS-ALG-04 ev=" + __EVENTNAME + " obj=SSLParameters val='" + q(rejected) + "' exp='" + q(expectedTls12Suites) + "' msg='the cipher suites are not ones the expert SSLParameters.crysl admits beside that protocol'"));
               }
           }
           else if (allProtocolsAre(protocolList, "TLSv1.3")) {
               String rejected = firstRejected(cipherSuiteList, tls13Suites);
               if (rejected != null) {
                   conforms = false;
                   ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SSLParametersSpec", "" + __LOC,
                       "v=1 code=SSLPARAMETERS-ALG-05 ev=" + __EVENTNAME + " obj=SSLParameters val='" + q(rejected) + "' exp='" + q(expectedTls13Suites) + "' msg='the cipher suites are not ones the expert SSLParameters.crysl admits beside that protocol'"));
               }
           }
       }
   }

   // The rule's ORDER, `(Con1, ((CipherSuite , SetProtocol) | (SetProtocol , CipherSuite))) |
   // (Con2, SetProtocol) | Con3`, transcribed. The three constructor profiles are three events
   // and not one fused event, because the rule names them apart -- `Con1`, `Con2` and `Con3`
   // are three labels, not one alternation -- and because they bind different arguments, which
   // is what lets each event evaluate exactly the clauses its own arguments support.
   ere : (c1 ((cs sp) | (sp cs))) | (c2 sp) | c3

   // A call sequence none of the three routes of the ORDER accepts. A monitor that saw a
   // constructor reports it under the plain wrong-sequence code; one that saw none reports it
   // under the `creation-unobserved` code, which is what an `SSLParameters` the application
   // obtained from a socket, an engine or a context draws at its first setter call. The staged
   // arrays and the verdict are discarded here, so nothing an event of the refused sequence
   // staged can reach the acceptance handler after the reset.
   @fail {
      if (!creationObserved) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SSLParametersSpec", "" + __LOC,
             "v=1 code=SSLPARAMETERS-ORDER-01 ev=" + __EVENTNAME + " obj=SSLParameters val='' exp='' msg='the observed call sequence is not one SSLParametersSpec accepts and no creation of the parameters was observed'"));
      }
      else {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SSLParametersSpec", "" + __LOC,
             "v=1 code=SSLPARAMETERS-ORDER-00 ev=" + __EVENTNAME + " obj=SSLParameters val='' exp='' msg='the observed call sequence is not one SSLParametersSpec accepts'"));
      }
      constructed = null;
      protocolList = null;
      cipherSuiteList = null;
      conforms = true;
      __RESET;
   }

   // ENSURES `generatedSSLParameters[this]`: the `SSLParameters` object carries protocols and
   // cipher suites the rule admits. The clause carries no `after L`, so its acceptance point
   // is an accepting state of the ORDER, which in an `ere` is where this handler runs.
   //
   // The object reaches the handler through the monitor field because a handler receives no
   // event arguments and runs after the transition is decided, and the write is gated on the
   // verdict the events accumulated: no single event decides conformance, since the
   // implications span two calls on three routes.
   //
   // No rule of the set REQUIRES this predicate, so the write stands for coverage of the rule
   // and no reader consumes it.
   @match {
      if (conforms && constructed != null) {
          PredicateStore.instance().ensure(Property.GENERATED_SSL_PARAMETERS, constructed);
      }
   }

}
