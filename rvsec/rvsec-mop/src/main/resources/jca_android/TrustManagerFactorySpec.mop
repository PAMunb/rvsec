package mop;

import javax.net.ssl.TrustManagerFactory;
import javax.net.ssl.TrustManager;
import javax.net.ssl.ManagerFactoryParameters;
import java.security.KeyStore;
import javax.net.ssl.KeyManager;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * TrustManagerFactorySpec
 *
 * A JavaMOP specification of the correct usage of the
 * javax.net.ssl.TrustManagerFactory class.
 *
 * https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/TrustManagerFactory.crysl
 */
TrustManagerFactorySpec(TrustManagerFactory mf) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    // D-15: TrustManagerFactory.crysl states `algorithm in {"PKIX", "SunX509"}`. Same
    // disposition as KeyManagerFactorySpec: `SunX509` is inert on Android, not removable.
    List<String> algorithms = Arrays.asList("PKIX", "SunX509");
    String currentAlgorithmInstance = "";

    // Staged by `init` for the acceptance-point handler, which sees no event parameter,
    // and cleared the moment it is used or the sequence is rejected.
    TrustManagerFactory initialisedFactory = null;

    String expectedGeneratedKeyStore = "a KeyStore this instrumentation observed being loaded";

    // One event over `getInstance(String)`, where there used to be two split by the
    // sign of a guard. The negated twin `g3` matched the same call and named no
    // state, and the generator gives an event absent from the automaton a
    // transition row that moves every state to `fail`: a factory built with an
    // algorithm the rule rejects was reported as a wrong call sequence, and then
    // reported again at the `init` that followed it, because `g3`'s `__RESET` had
    // dropped the monitor back to `start`, which does not declare `init`. That is
    // the co-emission the published campaign measured -- 9,015 ordering reports
    // against 9,014 algorithm reports, near one for one.
    //
    // Worse than noise: the orphan suppressed the finding. `TrustManagerFactory
    // .getInstance("SunX509")` followed by an `init` drew two
    // TRUSTMANAGERFACTORY-ORDER-00 and no algorithm report at all, because the
    // failing `init` transition takes the `@fail` path instead of the event body
    // that carries the algorithm check
    // (data/gh105/evidence/harness/f1-TrustManagerFactorySpec.md).
    //
    // The rule orders `Get, Init, GetTrustMng?` (TrustManagerFactory.crysl:22) with
    // `Get := g1 | g2` and puts the
    // algorithm in CONSTRAINTS, so the algorithm must not govern the transition:
    // `getInstance` is a `Gets` whatever it was asked for. Dropping the guard lets
    // the rejected factory reach `final` like any other, where the `init` body
    // accuses it exactly once, with `TRUSTMANAGERFACTORY-ALG-00`. `g3`'s body
    // accused nothing of its own -- it only rebound `currentAlgorithmInstance` --
    // so nothing it reported is lost; what leaves is the pair of ordering reports
    // about an ordering the rule accepts, and what arrives is the constraint
    // report the rule states.
    //
    // Residue, recorded and not repaired (divergence_record.csv): a rejected
    // algorithm whose factory is never `init`ed is now accused by nothing, because
    // the accusation lives in the `init` body. Moving it up into this event would
    // create a report where none exists today and would need deduplicating against
    // the `init` one -- a behavioural change, deliberately deferred.
    event g1 after(String alg) returning(TrustManagerFactory mf):
      call(public static TrustManagerFactory TrustManagerFactory.getInstance(String))
      && args(alg) {
        currentAlgorithmInstance = alg;
    }

    event g2 after(String alg) returning(TrustManagerFactory mf):
      call(public static TrustManagerFactory TrustManagerFactory.getInstance(String, ..))
      && args(alg, *)
      && condition(ConscryptAliasTable.matches("TrustManagerFactory", alg, algorithms)) {
        currentAlgorithmInstance = alg;
    }

    // `generatedKeyStore[keyStore]` (TrustManagerFactory.crysl:28, ledger clause #36) is read
    // here, in the only event of this file a key store ever reaches. The sibling
    // `KeyManagerFactorySpec` reads the same clause of the neighbouring rule at the same shape,
    // and the reasoning is stated there once for both files.
    //
    // Here the fusion is cheaper than there: the rule declares `i1: init(keyStore)` and
    // `i2: init(params)`, and both overloads have arity one, so `args(arg)` binds the argument
    // exactly rather than by a shared prefix. The body discriminates by runtime type.
    //
    // The null argument is read rather than exempted, and this file is where that costs the
    // most: measured on Temurin 21, `tmf.init((KeyStore) null)` runs and is the documented
    // default-truststore route, which is a conforming program under every reading except the
    // rule's own. The rule requires a key store this instrumentation saw loaded, and a null is not
    // one, so the read reports NOT_OBSERVED there. What the report says is exactly that -- no
    // loading was observed -- and not that the program is broken; the distinction between a
    // reach limit and a violation is the distinction the two codes below carry. Measured too,
    // and it is why the read discriminates something rather than nothing:
    // `tmf.init(unloadedStore)` runs on this platform, unlike its `KeyManagerFactory`
    // counterpart, so a key store that was never loaded reaches a trust manager factory and
    // nothing but this read says so (researcher decision, 2026-08-22).
    //
    // VIOLATED has no program that produces it today -- `GENERATED_KEY_STORE` is written at
    // arity 1 and withdrawn nowhere -- and the branch is written anyway, for the reason the
    // sibling file records: a read that folded VIOLATED into NOT_OBSERVED would misreport a
    // withdrawn key store the day some rule's NEGATES clause reaches this predicate.
    event init before(Object arg, TrustManagerFactory mf):
       ( call(public void TrustManagerFactory.init(KeyStore)) ||
         call(public void TrustManagerFactory.init(ManagerFactoryParameters))
       ) && args(arg) && target(mf) {
        if (!ConscryptAliasTable.matches("TrustManagerFactory", mf.getAlgorithm(), algorithms)) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "TrustManagerFactorySpec", "" + __LOC,
                "v=1 code=TRUSTMANAGERFACTORY-ALG-00 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='" + q(mf.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + mf.getAlgorithm() + "'"));
        }
        // The rule's other REQUIRES, `generatedManagerFactoryParameters[params]`
        // (TrustManagerFactory.crysl:29, ledger clause #56), is about the argument of the
        // `i2: init(params)` overload -- which is the branch this `if` leaves empty. It is
        // RECORDED AND NOT READ, by the researcher's decision of 2026-08-26 (task
        // 11.5(c)), and the disposition is derived: the predicate is ENSURED by exactly two
        // rules of the oracle, `CertPathTrustManagerParameters.crysl:17` and
        // `KeyStoreBuilderParameters.crysl:14` (ledger #61 and #98), and neither has a
        // `.mop` in this set. `unmonitored-producer`.
        //
        // The cheapness of the site is the reason the conclusion had to be derived rather
        // than assumed: the event already binds `arg` and already discriminates by runtime
        // type, so an `else if (arg instanceof ManagerFactoryParameters)` would cost three
        // lines. What it would buy is an accuser that can answer NOT_OBSERVED and nothing
        // else, for every program in the world -- the shape of the seventeen orphan
        // accusers group 3 removed. The twin clause at `KeyManagerFactory.crysl:32`
        // (#29) carries the same disposition on the same two producing rules.
        if (arg == null || arg instanceof KeyStore) {
            PredicateVerdict generated = PredicateStore.instance().validate(Property.GENERATED_KEY_STORE, arg);
            if (generated == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "TrustManagerFactorySpec", "" + __LOC,
                    "v=1 code=TRUSTMANAGERFACTORY-CONSTR-00 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='" + q(mf.getAlgorithm()) + "' exp='" + q(expectedGeneratedKeyStore) + "' msg='the KeyStore given to TrustManagerFactory.init carries a generation predicate the rule does not admit'"));
            }
            else if (generated == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "TrustManagerFactorySpec", "" + __LOC,
                    "v=1 code=TRUSTMANAGERFACTORY-NOBS-00 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='" + q(mf.getAlgorithm()) + "' exp='" + q(expectedGeneratedKeyStore) + "' msg='no loading of the KeyStore given to TrustManagerFactory.init was observed'"));
            }
        }
       initialisedFactory = mf;
    }

    // `generatedTrustManagers[trustManager] after GetTrustMng` (TrustManagerFactory.crysl:33),
    // and the write this rule's single consumer reads: `SSLContext.init` asks for the predicate
    // over the TrustManager[] array, as `generatedTrustManagers[tm]` (SSLContext.crysl:33,
    // ledger clause #29). The oracle names the predicate in the plural and qualifies it with an
    // `after L` the generated rule did not carry; neither moves this site, because
    // `GetTrustMng` is the aggregate `gtm1` belongs to and the write is already in its body.
    //
    // Three defects of this event are repaired here, and they were three faces of one: the
    // advice had no execution path at all. The pointcut declared `getTrustManagers()` returning
    // `KeyManager[]` where the API returns `TrustManager[]`, and both weavers match a return
    // type exactly; the event parameter was declared `TrustManager[][]`, one dimension too
    // many; and the target was bound to `k` where this specification declares `mf`, which sends
    // the event to the empty parameter slice. The harness showed the same thing from the trace
    // side -- `tmf.getTrustManagers()` resolved to no pointcut at all. That is gh104 8.7, and
    // it had to be repaired in this commit rather than deferred, because the consumer wired in
    // the same commit would otherwise have measured a clause against a producer that never
    // runs, and every read would have answered NOT_OBSERVED for a reason that had nothing to do
    // with the wiring.
    //
    // What the repair makes live, stated in full rather than discovered later. The write
    // happens, so a `SSLContext.init` that receives this array reads SATISFIED. And a second
    // `getTrustManagers()` on one factory draws TRUSTMANAGERFACTORY-ORDER-00, because the
    // transition below leads to a state where the event is not declared. That accusation is
    // faithful: the rule orders `Get, Init, GetTrustMng?` and the `?` refuses the repetition too. It is
    // also symmetric -- `KeyManagerFactorySpec.gkm1` declares the right return type, has always
    // been live, and has always behaved this way -- so the repair restores two mirror
    // specifications to being mirrors (researcher decision, 2026-08-22).
    //
    // Measured on Temurin 21 before the write was relied on: `getTrustManagers()` raises
    // `IllegalStateException` before an `init`, so this event can only fire after one; and it
    // allocates a fresh array on every call, so the predicate travels only with the array this
    // call returned. A program that copies the array into another before handing it to
    // `SSLContext.init` reaches the read with nothing written, which is a reach limit and is
    // reported as one.
    //
    // The placement. The clause carries no `after L`, so INV-INS-134 sends it to the accepting
    // state, and that is where it runs: the transition row for `gtm1` is {4, 2, 4, 4, 4}, which
    // lands on state 2 -- `@match2` -- so this body executes on the transition that accepts.
    // What keeps it out of the `@match2` handler is the array -- a handler sees no parameter of
    // the event it follows -- and the reason is in predicate_graph.csv.
    event gtm1 after(TrustManagerFactory mf) returning(TrustManager[] trustManager):
      call(public TrustManager[] TrustManagerFactory.getTrustManagers())
      && target(mf) {
        PredicateStore.instance().ensure(Property.GENERATED_TRUST_MANAGER, trustManager);
    }

    fsm :
      start [
        g1 -> waitingInit
        g2 -> waitingInit
      ]
      waitingInit [
        init -> final
      ]
      final [
        gtm1 -> taken
      ]
      taken [
      ]

    alias match1 = final
    alias match2 = taken

    @fail {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "TrustManagerFactorySpec", "" + __LOC,
            "v=1 code=TRUSTMANAGERFACTORY-ORDER-00 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='' exp='' msg='the observed call sequence is not one TrustManagerFactorySpec accepts'"));
        initialisedFactory = null;

        __RESET;
    }

    // The acceptance point of `generatedTrustManager[this] after Init`, where the two
    // routes INV-INS-134 admits are the same handler: `init` has the transition row
    // {4, 4, 4, 1, 4} and the match category is `nextstate == 1`, so the state the Init leads
    // to and the accepting state are one state, and `init` is the only event reaching it.
    //
    // No rule of the oracle requires this half of the clause -- `SSLContext.crysl:33` asks for
    // `generatedTrustManagers[tm]`, over the array, never over the factory -- so the site
    // carries a deliberate-omission record (INV-INS-137) and no read is fabricated for it.
    @match1 {
       if (initialisedFactory != null) {
           PredicateStore.instance().ensure(Property.GENERATED_TRUST_MANAGER, initialisedFactory);
           initialisedFactory = null;
       }
    }

    // The second accepting state, the mirror of `KeyManagerFactorySpec.taken`: the rule orders
    // `Get, Init, GetTrustMng?`, so a factory whose trust managers were taken accepts and a second
    // taking is refused. An alias is how this file says a state accepts, and G-ORDER reads it
    // to decide equivalence. The handler is empty because there is nothing left to write --
    // the write over the factory is `@match1`'s and the one over the array is in the `gtm1`
    // body, the only place the array is visible.
    @match2 {
    }
    
}
