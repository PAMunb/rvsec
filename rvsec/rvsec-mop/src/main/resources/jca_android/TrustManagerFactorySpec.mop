package mop;

import javax.net.ssl.TrustManagerFactory;
import javax.net.ssl.TrustManager;
import javax.net.ssl.ManagerFactoryParameters;
import java.security.KeyStore;
import javax.net.ssl.KeyManager;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * TrustManagerFactorySpec
 *
 * Monitors javax.net.ssl.TrustManagerFactory against the CrySL rule TrustManagerFactory.crysl.
 *
 * The rule's ORDER is `Get, Init, GetTrustMng?`: a factory is obtained from `getInstance`,
 * initialised once, and its trust managers taken at most once. Its CONSTRAINTS clause,
 * `algorithm in {"PKIX", "SunX509"}`, is enforced over the algorithm the factory reports, in the
 * body of the `init` event. Its two REQUIRES clauses, `generatedKeyStore[keyStore]` and
 * `generatedManagerFactoryParameters[params]`, are read at that same event, one per branch of the
 * runtime type of its single argument. Its two ENSURES clauses,
 * `generatedTrustManager[this] after Init` and
 * `generatedTrustManagers[trustManager] after GetTrustMng`, are written at the state `init` leads
 * to and in the body of `getTrustManagers` respectively.
 *
 * Divergences from the rule and reach limits of this monitor:
 *
 * - At the one-argument `getInstance` the algorithm governs no transition, because the rule
 *   states it in CONSTRAINTS and not in ORDER, and the accusation therefore lives in the `init`
 *   body. A factory obtained there for a refused algorithm and never initialised is accused of
 *   nothing. At the two-argument overload the split described below does make the algorithm
 *   decide the transition.
 * - `SunX509` is an entry of the rule's clause and stays in the list, and no provider of this
 *   platform registers it: `getInstance("SunX509")` cannot return a factory here, so the entry
 *   admits nothing that can run.
 * - The two-argument `getInstance` is split into an admitted event and a refused twin, so that a
 *   factory whose creation ran in woven code is never reported as one whose creation was never
 *   seen. The refused twin leads to a state with no transitions, which the rule does not have.
 * - `generatedTrustManager[this] after Init` is written over the factory and no specification of
 *   this set reads a mark bound to a `TrustManagerFactory`; the write records the initialisation
 *   and nothing consumes it.
 * - `init(null)` is read rather than exempted. It is the documented request for the platform's
 *   own trust store, so no loading of a key store was observed for it and it is reported under a
 *   code of its own, apart from a key store whose loading merely went unseen.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/TrustManagerFactory.crysl
 */
TrustManagerFactorySpec(TrustManagerFactory mf) {
    // The envelope's quoting rule: a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    // The allow-list this specification enforces, and it is the CONSTRAINTS clause of
    // TrustManagerFactory.crysl word for word: `algorithm in {"PKIX", "SunX509"}`.
    //
    // A value spelled otherwise can still reach an entry: every comparison goes through
    // `ConscryptAliasTable.matches`, which folds case and resolves the alias rows the table
    // carries for this service. For `TrustManagerFactory` it carries one, `X509` to `PKIX`, so a
    // factory asked for `X509` or `x509` is admitted by the entry `PKIX`.
    //
    // `SunX509` is inert on this platform, stated as behaviour: it is the name of an algorithm a
    // JSE provider registers and no provider here does, so `getInstance("SunX509")` cannot return
    // a factory and no program running here can present this entry to the check. It stays in the
    // list because it is an entry of the rule's clause.
    List<String> algorithms = Arrays.asList("PKIX", "SunX509");

    // Staged by `init` for the acceptance-point handler, which sees no event parameter,
    // and cleared the moment it is used or the sequence is rejected.
    TrustManagerFactory initialisedFactory = null;

    // Set by the creation events `g1`, `g2` and `g3`. `@fail` reads it to tell a call sequence the
    // rule refuses from a factory whose creation this monitor never saw; the generated
    // `reset()` leaves user fields alone, so the fact survives a failure.
    boolean creationObserved = false;

    // Set by the refused creation `g3` and never cleared. `@fail` reads it to report a failure of
    // a factory whose two-argument `getInstance` asked for an algorithm the rule refuses under the
    // `creation-refused` code: the automaton admits no use of such a factory, so its ordering
    // failure is the consequence of the refusal and not an order the program chose. The
    // one-argument `g1` accepts every algorithm and does not set it. The generated `reset()`
    // leaves it alone, so the fact survives a failure.
    boolean creationRefused = false;

    String expectedGeneratedKeyStore = "a KeyStore this instrumentation observed being loaded";

    String expectedGeneratedManagerFactoryParameters =
        "a ManagerFactoryParameters this instrumentation observed being constructed";

    // `Get` of TrustManagerFactory.crysl: `g1: getInstance(algorithm);`, the one-argument
    // overload, one alternative of `Get := g1 | g2`.
    //
    // The event carries no guard, and that is the rule speaking. The rule puts the algorithm in
    // CONSTRAINTS and not in ORDER, so this overload is a creation whatever it was asked for: a
    // factory obtained here for an algorithm outside `algorithm in {"PKIX", "SunX509"}` reaches
    // the state where `init` is declared like any other, and the `init` body accuses it exactly
    // once, under the code registered in `codes.csv` for that site. The two-argument overload
    // below is split instead, and a refused algorithm requested there reaches a state that
    // declares no `init`, so it is reported through the ordering code. Guarding the transition
    // here instead
    // would make the automaton refuse an ordering the rule accepts, and would then hide the
    // algorithm accusation as well, because a failing transition runs `@fail` rather than the
    // event body that carries the check.
    //
    // The behaviour that follows from the placement, stated because a reader will look for it: a
    // factory obtained here for a refused algorithm and never initialised is accused by nothing,
    // since the only site that accuses an algorithm is the `init` body.
    //
    // The body records that a creation was observed. `@fail` reads that field to tell a wrong
    // call sequence on a factory this monitor saw created from one created where it cannot see.
    event g1 after(String alg) returning(TrustManagerFactory mf):
      call(public static TrustManagerFactory TrustManagerFactory.getInstance(String))
      && args(alg) {
        creationObserved = true;
    }

    // `Get` of TrustManagerFactory.crysl: `g2: getInstance(algorithm, _);`, the overload that
    // also names a provider. `args(alg, *)` binds the algorithm and leaves the provider free, and
    // the `..` in the `call(...)` signature covers the `(String, String)` and `(String, Provider)`
    // shapes of the platform in one pointcut.
    //
    // Unlike `g1`, this event does carry the allow-list guard, and the reason is not the clause
    // but the twin below: `g3` matches the same call under the negated guard so that a factory
    // asked for a refused algorithm is still recorded as created, and the two events must not
    // both fire for one call. The guard is `ConscryptAliasTable.matches`, so an algorithm spelled
    // as an alias the table carries -- `X509` for `PKIX` -- reaches the list entry and is
    // admitted here. The algorithm accusation itself is not made here; it stays in the `init`
    // body, where the factories of both overloads are accused alike.
    event g2 after(String alg) returning(TrustManagerFactory mf):
      call(public static TrustManagerFactory TrustManagerFactory.getInstance(String, ..))
      && args(alg, *)
      && condition(ConscryptAliasTable.matches("TrustManagerFactory", alg, algorithms)) {
        creationObserved = true;
    }

    // The refused twin of `g2`: the two-argument `getInstance` with `g2`'s pointcut and `args`,
    // under the negated allow-list guard. A false `condition(...)` runs no body, so without this
    // event a refused algorithm requested with a provider matches no event, and the first use of
    // the factory reads `creation-unobserved` although its creation ran in woven code. The body
    // only records the creation: it reports nothing and writes no field another event reads.
    // The transition leads to `refused`, a state with no transitions, so the first use of the
    // factory fails at the same event it fails at when no creation event fires. No reported site
    // changes; only the code `@fail` chooses does, which is `creation-refused`.
    event g3 after(String alg) returning(TrustManagerFactory mf):
      call(public static TrustManagerFactory TrustManagerFactory.getInstance(String, ..))
      && args(alg, *)
      && condition(!ConscryptAliasTable.matches("TrustManagerFactory", alg, algorithms)) {
        creationObserved = true;
        creationRefused = true;
    }

    // `Init` of TrustManagerFactory.crysl: `i1: init(keyStore);` and `i2: init(params);`, joined
    // by `Init := i1 | i2`, realised here as one event. Both overloads have arity one, so
    // `args(arg)` binds the argument of either exactly rather than by a shared prefix, and the
    // body discriminates on its runtime type.
    //
    // CONSTRAINTS of TrustManagerFactory.crysl: `algorithm in {"PKIX", "SunX509"}`. The check
    // runs over the algorithm the factory reports, and it sits in the event body rather than in a
    // `condition(...)` guard: a guard compiles to an early return ahead of both the body and the
    // transition, so a factory built for a refused algorithm would leave the automaton in the
    // state before `init`, and the next call on it would be reported as a wrong call sequence
    // instead of as the refused algorithm it is. A value outside the list is reported under the
    // code registered in `codes.csv` for this site. The comparison folds case and resolves the
    // alias rows `ConscryptAliasTable` carries for this service, so a factory reporting `X509`
    // reaches the entry `PKIX` and is admitted.
    //
    // REQUIRES of TrustManagerFactory.crysl: `generatedKeyStore[keyStore];`. The predicate says
    // that the `KeyStore` was loaded by a call the instrumentation observed; its producer in this
    // set is `KeyStoreSpec`, which writes the mark at the acceptance point its `load` event leads
    // to. This is the only event of this file a key store ever reaches.
    //
    // The read is three-valued and the three are not two. SATISFIED reports nothing. VIOLATED is
    // positive evidence about this store -- an entry exists whose values differ, or the predicate
    // was revoked by a `negate` -- and goes out under a constraint code. NOT_OBSERVED says only that no entry
    // exists: no loading of this store was ever seen, which happens when the loading ran before
    // the monitor attached or inside a library the weaving does not reach, and that is a reach
    // limit rather than a misuse, so it goes out under a code of its own. No site of this set
    // revokes this predicate, so VIOLATED has no program that produces it today; the branch is
    // written so that a revocation would be reported as one rather than as an unobserved store.
    //
    // The null argument is read rather than exempted, and this file is where that matters most.
    // `tmf.init((KeyStore) null)` is the documented request for the platform's own trust store: a
    // null is not a key store this instrumentation saw loaded, so the read answers NOT_OBSERVED,
    // and it takes a code of its own so that an analysis can separate the platform-default route
    // from a key store whose loading merely went unseen. Neither report says the program is
    // broken. And the read does discriminate something here that its `KeyManagerFactory`
    // counterpart cannot: `TrustManagerFactory.init` accepts a store that was never loaded, where
    // `KeyManagerFactory.init` raises `KeyStoreException` on one, so an unloaded store does reach
    // a trust manager factory on this platform and nothing but this read says so.
    event init before(Object arg, TrustManagerFactory mf):
       ( call(public void TrustManagerFactory.init(KeyStore)) ||
         call(public void TrustManagerFactory.init(ManagerFactoryParameters))
       ) && args(arg) && target(mf) {
        if (!ConscryptAliasTable.matches("TrustManagerFactory", mf.getAlgorithm(), algorithms)) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "TrustManagerFactorySpec", "" + __LOC,
                "v=1 code=TRUSTMANAGERFACTORY-ALG-00 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='" + q(mf.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + mf.getAlgorithm() + "'"));
        }
        // The key-store branch of the discrimination, which is where `generatedKeyStore` is
        // read. It takes the `KeyStore` argument of the rule's `i1` and the null argument of
        // either overload; the rule's other REQUIRES,
        // `generatedManagerFactoryParameters[params];`, is about the argument of `i2` and is
        // read on the sibling branch below.
        if (arg == null || arg instanceof KeyStore) {
            PredicateVerdict generated = PredicateStore.instance().validate(Property.GENERATED_KEY_STORE, arg);
            if (generated == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "TrustManagerFactorySpec", "" + __LOC,
                    "v=1 code=TRUSTMANAGERFACTORY-CONSTR-00 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='" + q(mf.getAlgorithm()) + "' exp='" + q(expectedGeneratedKeyStore) + "' msg='the KeyStore given to TrustManagerFactory.init carries a generation predicate the rule does not admit'"));
            }
            else if (generated == PredicateVerdict.NOT_OBSERVED && arg == null) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "TrustManagerFactorySpec", "" + __LOC,
                    "v=1 code=TRUSTMANAGERFACTORY-NOBS-02 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='" + q(mf.getAlgorithm()) + "' exp='" + q(expectedGeneratedKeyStore) + "' msg='a null KeyStore given to TrustManagerFactory.init requests the platform default trust store, whose loading was not observed'" + Evidence.keysFor(arg)));
            }
            else if (generated == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "TrustManagerFactorySpec", "" + __LOC,
                    "v=1 code=TRUSTMANAGERFACTORY-NOBS-00 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='" + q(mf.getAlgorithm()) + "' exp='" + q(expectedGeneratedKeyStore) + "' msg='no loading of the KeyStore given to TrustManagerFactory.init was observed'" + Evidence.keysFor(arg)));
            }
        }
        // REQUIRES of TrustManagerFactory.crysl: `generatedManagerFactoryParameters[params];`,
        // on the branch a `ManagerFactoryParameters` is the one to reach -- the argument of the
        // rule's `i2: init(params)`. The predicate says that the parameter object was
        // constructed by a call the instrumentation observed, so a key or trust manager factory
        // may be initialised from it. Its producers in this set are
        // `CertPathTrustManagerParametersSpec` and `KeyStoreBuilderParametersSpec`, each of
        // which writes the mark when its constructor completes and, for the first of the two,
        // only when the cert path parameters it was handed were themselves observed being built.
        //
        // The read is three-valued exactly as the key-store read above, and its two accusing
        // outcomes carry different codes: VIOLATED is positive evidence about this object,
        // NOT_OBSERVED says only that no construction of it was seen -- a program that builds
        // its parameters through some other implementation of the interface, or in code the
        // weaving does not reach.
        //
        // No new event and no new pointcut pays for this read: it is the same runtime-type test
        // the key-store branch already makes. The `null` case belongs to that branch and not to
        // this one, for the reason stated there: null is the documented default-truststore route
        // and carries no runtime type to discriminate on.
        else if (arg instanceof ManagerFactoryParameters) {
            PredicateVerdict prepared = PredicateStore.instance().validate(Property.GENERATED_MANAGER_FACTORY_PARAMETERS, arg);
            if (prepared == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "TrustManagerFactorySpec", "" + __LOC,
                    "v=1 code=TRUSTMANAGERFACTORY-CONSTR-01 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='" + q(mf.getAlgorithm()) + "' exp='" + q(expectedGeneratedManagerFactoryParameters) + "' msg='the ManagerFactoryParameters given to TrustManagerFactory.init carries a generation predicate the rule does not admit'"));
            }
            else if (prepared == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "TrustManagerFactorySpec", "" + __LOC,
                    "v=1 code=TRUSTMANAGERFACTORY-NOBS-01 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='" + q(mf.getAlgorithm()) + "' exp='" + q(expectedGeneratedManagerFactoryParameters) + "' msg='no construction of the ManagerFactoryParameters given to TrustManagerFactory.init was observed'" + Evidence.keysFor(arg)));
            }
        }
       initialisedFactory = mf;
    }

    // `GetTrustMng` of TrustManagerFactory.crysl: `gtm1: trustManager = getTrustManagers();`.
    //
    // ENSURES of TrustManagerFactory.crysl:
    // `generatedTrustManagers[trustManager] after GetTrustMng;`. The predicate says that the
    // object came out of a `TrustManagerFactory` the instrumentation observed being initialised
    // -- here the trust-manager array it issued. `GetTrustMng` is the aggregate this event
    // belongs to, so the acceptance point the clause names is the state this transition leads
    // to, and the write runs in the event body: the array is an event parameter, and the handler
    // for that state receives no event arguments, so the body is the only place the array is
    // visible.
    //
    // Beside the array, the body marks every non-null element of it with the per-element
    // refinement of the same clause: the individual trust manager was issued by a
    // `TrustManagerFactory` the instrumentation observed. That is what makes the mark survive a
    // program that repacks the managers, and the platform forces the question -- every call to
    // `getTrustManagers()` allocates a fresh array around the same manager instances, so a mark
    // bound to the array travels only with the array this very call returned. The consumer,
    // `SSLContextSpec`, reads the array mark first and, for an array it has never seen, credits
    // it when the array is non-empty and every element carries the element mark, because the
    // rule constrains the managers and an application that copies an issued manager into an
    // array of its own is passing exactly the manager this factory issued. An array that mixes
    // an issued manager with any other is not credited.
    //
    // The platform raises `IllegalStateException` from `getTrustManagers()` before an `init`, so
    // this event can only fire after one. A second `getTrustManagers()` on one factory is
    // reported as a wrong call sequence, because the transition below leads to a state that
    // declares no event -- which is what the rule's `GetTrustMng?` says.
    event gtm1 after(TrustManagerFactory mf) returning(TrustManager[] trustManager):
      call(public TrustManager[] TrustManagerFactory.getTrustManagers())
      && target(mf) {
        PredicateStore.instance().ensure(Property.GENERATED_TRUST_MANAGER, trustManager);
        if (trustManager != null) {
            for (TrustManager manager : trustManager) {
                PredicateStore.instance().ensure(Property.GENERATED_TRUST_MANAGERS, manager);
            }
        }
    }

    // The rule's ORDER, `Get, Init, GetTrustMng?`, with one state this file adds: `refused`,
    // where the refused creation `g3` leads. It declares no transition, so the first use of such
    // a factory fails there, which is how a creation the allow-list refused is told apart from a
    // creation this monitor never saw. `final` and `taken` both accept, and the two aliases
    // below are how this file says so: `final` is the state `init` leads to, `taken` the state
    // `gtm1` leads to, and the rule's `?` is the absence of any transition out of `taken`.
    fsm :
      start [
        g1 -> waitingInit
        g2 -> waitingInit
        g3 -> refused
      ]
      refused [
      ]
      waitingInit [
        init -> final
      ]
      final [
        gtm1 -> taken
      ]
      taken [
      ]

    alias match1 = final
    alias match2 = taken

    // A monitor that never observed `getInstance` reports every failure as
    // `creation-unobserved`: the factory was created where this monitor cannot see, and after a
    // reset no creation event can arrive for it. A monitor whose creation was the refused `g3`
    // reports every failure as `creation-refused`, because `refused` admits no use.
    @fail {
        if (!creationObserved) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "TrustManagerFactorySpec", "" + __LOC,
                "v=1 code=TRUSTMANAGERFACTORY-ORDER-01 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='' exp='' msg='" + __EVENTNAME + "() before getInstance()'"));
        }
        else if (creationRefused) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "TrustManagerFactorySpec", "" + __LOC,
                "v=1 code=TRUSTMANAGERFACTORY-ORDER-02 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='' exp='' msg='the observed call sequence is not one TrustManagerFactorySpec accepts, after a creation the specification refused'"));
        }
        else {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "TrustManagerFactorySpec", "" + __LOC,
                "v=1 code=TRUSTMANAGERFACTORY-ORDER-00 ev=" + __EVENTNAME + " obj=TrustManagerFactory val='' exp='' msg='the observed call sequence is not one TrustManagerFactorySpec accepts'"));
        }
        initialisedFactory = null;

        __RESET;
    }

    // ENSURES of TrustManagerFactory.crysl: `generatedTrustManager[this] after Init;`. The
    // predicate says that the object came out of a `TrustManagerFactory` the instrumentation
    // observed being initialised -- here the factory itself. The state `Init` leads to, `final`,
    // is also this automaton's accepting state, and `init` is the only event that reaches it, so
    // the handler for that state is the acceptance point the clause names.
    //
    // The factory travels here in a field because a handler receives no event arguments and runs
    // after the transition has been decided: the `init` event stages `mf`, this handler writes
    // the predicate and clears the field, and `@fail` discards it, so a factory whose call
    // sequence the automaton refused is never marked.
    //
    // Stated as behaviour: no specification of this set reads a mark bound to a
    // `TrustManagerFactory`. The consumer of the rule's other ENSURES, `SSLContextSpec`, asks
    // for the predicate over the trust-manager array and never over the factory. This write
    // therefore records the initialisation and nothing consumes it; no read is fabricated for
    // it.
    @match1 {
       if (initialisedFactory != null) {
           PredicateStore.instance().ensure(Property.GENERATED_TRUST_MANAGER, initialisedFactory);
           initialisedFactory = null;
       }
    }

    // The second accepting state, which is what makes the rule's `GetTrustMng?` optional and
    // terminal at once: the ORDER `Get, Init, GetTrustMng?` accepts a factory whose trust
    // managers were taken, and the `?` refuses a second taking, so `taken` accepts and declares
    // no event of its own. An alias is how this file says a state accepts. The handler is empty
    // because there is nothing left to write -- the write over the factory is `@match1`'s, and
    // the one over the array is in the `gtm1` body, the only place the array is visible.
    @match2 {
    }
    
}
