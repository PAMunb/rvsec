package mop;

import javax.net.ssl.TrustManagerFactory;
import javax.net.ssl.TrustManager;
import javax.net.ssl.ManagerFactoryParameters;
import java.security.KeyStore;
import javax.net.ssl.KeyManager;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.ExecutionContext;
import br.unb.cic.mop.Property;

/**
 * KeyManagerFactory
 *
 * A JavaMOP specification of the correct usage of the
 * javax.net.ssl.TrustManagerFactory class.
 *
 * https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/TrustManagerFactory.crysl
 */
TrustManagerFactorySpec(TrustManagerFactory mf) {

    List<String> algorithms = Arrays.asList("PKIX");
    String currentAlgorithmInstance = "";

    TrustManagerFactory trustManagerFactory = null;

    // The trust managers this monitor's factory handed out. They are held in a field because
    // @fail has to withdraw the mark from that array and the value is a local of the event
    // that wrote it. The one-argument remove(Property) that used to stand there deleted the
    // whole set for the predicate, so one failing factory erased every other factory's mark --
    // and since task 3.2 made SSLContextSpec.init read generatedTrustManagers, that is a false
    // UnsatisfiedConstraint for every other context in the process.
    TrustManager[] trustManagers;

    event g1 after(String alg) returning(TrustManagerFactory mf):
      call(public static TrustManagerFactory TrustManagerFactory.getInstance(String))
      && args(alg)
      && condition(algorithms.contains(alg)) {
        trustManagerFactory = mf;
        currentAlgorithmInstance = alg;
    }

    event g2 after(String alg) returning(TrustManagerFactory mf):
      call(public static TrustManagerFactory TrustManagerFactory.getInstance(String, ..))
      && args(alg, *)
      && condition(algorithms.contains(alg)) {
        trustManagerFactory = mf;
        currentAlgorithmInstance = alg;
    }

    event g3 after(String alg) returning(TrustManagerFactory mf):
      call(public static TrustManagerFactory TrustManagerFactory.getInstance(String))
      && args(alg)
      && condition(!algorithms.contains(alg))  {
        currentAlgorithmInstance = alg;
    }

    // CrySL states two events here -- i1: init(keyStore) and i2: init(params) -- each with a
    // REQUIRES over its own argument. The translation fused them into one disjunctive
    // pointcut, so neither argument was bound and neither clause could be read.
    // The two overloads happen to share an arity and take reference types, so binding the
    // argument as Object and discriminating with instanceof would work here. It is not what
    // this set does: the rule's events are transcribed 1:1, so the distinction the pointcut
    // already makes statically is not rebuilt at runtime, the set carries one shape rather
    // than two, and Group 5's generatedManagerFactoryParameters gets an argument it can bind.
    // Both take exactly the transition the fused event had, waitingInit -> final. The read is
    // in the event body rather than in a condition(...) guard, because a failing guard takes
    // no transition and would turn the getTrustManagers() that follows into a sequence
    // violation.
    event i1 before(KeyStore keyStore, TrustManagerFactory mf):
       call(public void TrustManagerFactory.init(KeyStore)) &&
       args(keyStore) &&
       target(mf) {
        if (!algorithms.contains(currentAlgorithmInstance)) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "TrustManagerFactorySpec", "" + __LOC,
              "expecting one of " + String.join(",", algorithms) + " but found " + currentAlgorithmInstance + "."));
        }
        if (keyStore != null && !ExecutionContext.instance().validate(Property.GENERATED_KEY_STORE, keyStore)) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "TrustManagerFactorySpec", "" + __LOC,
              "init() requires a key store established by a monitored KeyStore sequence."));
        }
       ExecutionContext.instance().setProperty(Property.GENERATED_TRUST_MANAGER, trustManagerFactory);
    }

    event i2 before(ManagerFactoryParameters params, TrustManagerFactory mf):
       call(public void TrustManagerFactory.init(ManagerFactoryParameters)) &&
       args(params) &&
       target(mf) {
        if (!algorithms.contains(currentAlgorithmInstance)) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "TrustManagerFactorySpec", "" + __LOC,
              "expecting one of " + String.join(",", algorithms) + " but found " + currentAlgorithmInstance + "."));
        }
       ExecutionContext.instance().setProperty(Property.GENERATED_TRUST_MANAGER, trustManagerFactory);
    }

    // Four defects, all copied from KeyManagerFactorySpec, where the same lines
    // are correct because its specification parameter is named k. Here the
    // parameter is mf, so binding k put this event in the empty parameter slice:
    // the generated monitor dispatched it on TrustManagerFactorySpec__Map, a
    // single global monitor, rather than on the factory that produced the trust
    // managers. The return type was TrustManager[][], the pointcut declared a
    // KeyManager[] return that getTrustManagers() never has, and the constant
    // written was the key-manager one.
    event gtm1 after(TrustManagerFactory mf) returning(TrustManager[] trustManager):
      call(public TrustManager[] TrustManagerFactory.getTrustManagers())
      && target(mf) {
        trustManagers = trustManager;
        ExecutionContext.instance().setProperty(Property.GENERATED_TRUST_MANAGERS, trustManager);
    }

    // g3 was absent from this automaton, so the generator gave it a row sending
    // every state to fail. That was inert while its binding kept it out of the
    // monitored object's slice; repairing the binding without this would have
    // made every algorithm outside the allow-list an immediate
    // InvalidSequenceOfMethodCalls. The unsafeAlg state is the shape
    // KeyManagerFactorySpec already uses for the same event.
    fsm :
      start [
        g1 -> waitingInit
        g2 -> waitingInit
        g3 -> unsafeAlg
      ]
      unsafeAlg [
        g1 -> waitingInit
        g2 -> waitingInit
        g3 -> unsafeAlg
      ]
      waitingInit [
        i1 -> final
        i2 -> final
      ]
      final [
        g1   -> waitingInit
        g2   -> waitingInit
        gtm1 -> start
      ]

    alias match1 = final

    @fail {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "TrustManagerFactorySpec", "" + __LOC));
        ExecutionContext.instance().unsetObjectAsInAcceptingState(trustManagerFactory);
        ExecutionContext.instance().remove(Property.GENERATED_TRUST_MANAGER, trustManagerFactory);
        ExecutionContext.instance().remove(Property.GENERATED_TRUST_MANAGERS, trustManagers);

        __RESET;
    }

    @match1 {
       ExecutionContext.instance().setObjectAsInAcceptingState(trustManagerFactory);
    }
    
}
