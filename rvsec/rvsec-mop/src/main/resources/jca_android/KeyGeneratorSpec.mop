package mop;

import javax.crypto.KeyGenerator;
import javax.crypto.SecretKey;
import java.security.SecureRandom;
import java.security.spec.AlgorithmParameterSpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * KeyGeneratorSpec
 *
 * A JavaMOP specification of the correct usage of the
 * javax.crypto.KeyGenerator class.
 *
 * https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/KeyGenerator.crysl
 */
KeyGeneratorSpec(KeyGenerator k) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    List<String> safeAlgorithms = Arrays.asList("ChaCha20", "ARC4", "HmacSHA224", "DESede", "HmacSHA256",
        "HmacMD5", "HmacSHA1", "HmacSHA512", "AES", "BLOWFISH", "HmacSHA384");
    String currentAlgorithmInstance = "";

    // Staged by `gk1` for the acceptance-point handler, which sees no event parameter, and
    // cleared the moment it is used or the sequence is rejected. Declared `SecretKey`,
    // which is what `gk: key = generateKey()` binds and what the pointcut returns.
    SecretKey generatedKey = null;

    event g1 after(String alg) returning(KeyGenerator k):
      call(public static KeyGenerator KeyGenerator.getInstance(String))
      && args(alg)
      && condition(ConscryptAliasTable.matches("KeyGenerator", alg, safeAlgorithms)) {
        currentAlgorithmInstance = alg;
    }

    event g2 after(String alg, Object provider) returning(KeyGenerator k):
      call(public static KeyGenerator KeyGenerator.getInstance(String, Object+))
      && args(alg, provider)
      && condition(ConscryptAliasTable.matches("KeyGenerator", alg, safeAlgorithms)) {
        currentAlgorithmInstance = alg;
    }

    event g3 after(String alg) returning(KeyGenerator k):
      call(public static KeyGenerator KeyGenerator.getInstance(String))
      && args(alg)
      && condition(!ConscryptAliasTable.matches("KeyGenerator", currentAlgorithmInstance, safeAlgorithms))  {
        currentAlgorithmInstance = alg;
    }

    // The two `init` overloads the rule's `Inits` names that take no SecureRandom --
    // i1 and i3. The three that do take one moved to the `initRandom*` events below,
    // `randomized[ranGen]` needs the argument bound and this event bound nothing.
    // Both symbols stand for the same thing in the rule's ORDER (`Gets, Inits?, gk`
    // puts i1 to i5 in one alternation), so splitting the event splits no ordering
    // claim: the `ere` accepts either symbol wherever it accepted the merged one.
    event init before(KeyGenerator k):
       ( call(public void KeyGenerator.init(int)) ||
         call(public void KeyGenerator.init(AlgorithmParameterSpec))
       ) && target(k) {  }

    // `randomized[ranGen]` (KeyGenerator.cryptsl:60, ledger clause #13) at the three `init`
    // overloads that bind a SecureRandom -- the rule's i2, i4 and i5 -- one event each. The
    // shorter statements were measured and all fail: a disjunction of the three signatures
    // makes javamop emit no aspect at all; `args(.., ranGen)` generates but matches every
    // `init` whatever the last argument, binding no SecureRandom and answering NOT_OBSERVED
    // for all of them; and a middle wildcard, `init(*, SecureRandom)`, generates a correct
    // aspect but defeats the trace harness's resolver, which accepts any call from the first
    // wildcard onward. `IvChainJunction.mop` carries the same three measurements at length.
    //
    // The reads are in the bodies and not in a `condition(...)`: a false guard would suppress
    // the transition and turn "this generator's randomness source was never observed" into a
    // wrong-call-sequence report (INV-INS-133). The producer is `SecureRandomSpec.@match1`,
    // `randomized[this] after Ins`; measured, `KeyGenerator.init(128, sr)` and
    // `KeyGenerator.init(sr)` both run to completion over an observed SecureRandom. The
    // verdict is three-valued because VIOLATED is positive evidence of a withdrawn
    // randomisation while NOT_OBSERVED is as often a reach limit as a misuse.

    // the rule's i5.
    event initRandom before(KeyGenerator k, SecureRandom ranGen):
      call(public void KeyGenerator.init(SecureRandom)) &&
      args(ranGen) &&
      target(k) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, ranGen);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyGeneratorSpec", "" + __LOC,
                "v=1 code=KEYGENERATOR-CONSTR-00 ev=" + __EVENTNAME + " obj=KeyGenerator val='" + q(k.getAlgorithm()) + "' exp='" + q("a SecureRandom this instrumentation observed being constructed") + "' msg='the SecureRandom given to init() carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyGeneratorSpec", "" + __LOC,
                "v=1 code=KEYGENERATOR-NOBS-00 ev=" + __EVENTNAME + " obj=KeyGenerator val='" + q(k.getAlgorithm()) + "' exp='" + q("a SecureRandom this instrumentation observed being constructed") + "' msg='init() expects a SecureRandom observed to come from an observed construction'"));
        }
    }

    // the rule's i2.
    event initRandomSize before(KeyGenerator k, SecureRandom ranGen):
      call(public void KeyGenerator.init(int, SecureRandom)) &&
      args(*, ranGen) &&
      target(k) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, ranGen);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyGeneratorSpec", "" + __LOC,
                "v=1 code=KEYGENERATOR-CONSTR-01 ev=" + __EVENTNAME + " obj=KeyGenerator val='" + q(k.getAlgorithm()) + "' exp='" + q("a SecureRandom this instrumentation observed being constructed") + "' msg='the SecureRandom given to init() carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyGeneratorSpec", "" + __LOC,
                "v=1 code=KEYGENERATOR-NOBS-01 ev=" + __EVENTNAME + " obj=KeyGenerator val='" + q(k.getAlgorithm()) + "' exp='" + q("a SecureRandom this instrumentation observed being constructed") + "' msg='init() expects a SecureRandom observed to come from an observed construction'"));
        }
    }

    // the rule's i4.
    event initRandomSpec before(KeyGenerator k, SecureRandom ranGen):
      call(public void KeyGenerator.init(AlgorithmParameterSpec, SecureRandom)) &&
      args(*, ranGen) &&
      target(k) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, ranGen);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyGeneratorSpec", "" + __LOC,
                "v=1 code=KEYGENERATOR-CONSTR-02 ev=" + __EVENTNAME + " obj=KeyGenerator val='" + q(k.getAlgorithm()) + "' exp='" + q("a SecureRandom this instrumentation observed being constructed") + "' msg='the SecureRandom given to init() carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyGeneratorSpec", "" + __LOC,
                "v=1 code=KEYGENERATOR-NOBS-02 ev=" + __EVENTNAME + " obj=KeyGenerator val='" + q(k.getAlgorithm()) + "' exp='" + q("a SecureRandom this instrumentation observed being constructed") + "' msg='init() expects a SecureRandom observed to come from an observed construction'"));
        }
    }

    event gk1 after(KeyGenerator k) returning(SecretKey key):
      call(public SecretKey KeyGenerator.generateKey())
      && target(k) {
        if (!ConscryptAliasTable.matches("KeyGenerator", k.getAlgorithm(), safeAlgorithms)) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "KeyGeneratorSpec", "" + __LOC,
                "v=1 code=KEYGENERATOR-ALG-00 ev=" + __EVENTNAME + " obj=KeyGenerator val='" + q(k.getAlgorithm()) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + k.getAlgorithm() + "'"));
        }
        generatedKey = key;
    }

    ere : (g3* g1+ | g3* g2+) (((init | initRandom | initRandomSize | initRandomSpec) gk1) | gk1)

    @fail {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyGeneratorSpec", "" + __LOC,
            "v=1 code=KEYGENERATOR-ORDER-00 ev=" + __EVENTNAME + " obj=KeyGenerator val='' exp='' msg='the observed call sequence is not one KeyGeneratorSpec accepts'"));
        generatedKey = null;

        __RESET;
    }

    // The acceptance point of `generatedKey[key, alg]`. The clause carries no `after L`,
    // so it is established at the accepting state; read off the generated monitor, `gk1`
    // has the transition row {5, 5, 1, 1, 1, 5} and the match category is
    // `nextstate == 1`, so `gk1` is the only event that reaches this handler and the
    // staged key is always the one the accepted sequence produced.
    //
    // What the acceptance point buys over the event body is measurable and is the reason
    // the default of INV-INS-134 is kept here: a program that calls `generateKey()` twice
    // on one generator writes a sequence both the rule (`Gets, Inits?, gk`) and the
    // automaton reject, and a body write would still mark the second key as having an
    // observed origin. Here it does not, and the consumer says so.
    //
    // The arity stays at one place where api30 writes `generatedKey[key, alg]`, under
    // INV-INS-134's arity exception: both migrated readers still read one place, and
    // `validate` compares the value tuple, so a two-place write alone would answer
    // VIOLATED about a conforming program. Task 5.6 raises producer and consumer together.
    @match {
       if (generatedKey != null) {
           PredicateStore.instance().ensure(Property.GENERATED_KEY, generatedKey);
           generatedKey = null;
       }
    }
}