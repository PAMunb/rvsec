package mop;

import java.security.Key;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * KeySpec
 *
 * Monitors java.security.Key against the CrySL rule Key.crysl. The specification is named
 * after the rule and not after a type: java.security.spec.KeySpec is a different interface
 * and this file has nothing to do with it.
 *
 * The rule's ORDER is `GetEnc*`, so every sequence of `getEncoded()` calls is accepted and
 * there is no call sequence for this specification to refuse. The rule states no CONSTRAINTS
 * and no REQUIRES, and it ENSURES `preparedKeyMaterial[keyMaterial] after GetEnc`, which the
 * key-spec constructors of this set read before they accept bytes as key material.
 *
 * `getEncoded()` returns a fresh copy on every call and the predicate store compares bound
 * objects by identity, so without this specification nothing established about a key would
 * ever reach a reader of the bytes it handed out. Bridging that copy is the whole of what
 * this file does: it checks no clause, reports nothing, and has no row in `codes.csv`.
 *
 * The write carries a guard the rule does not state -- the material is prepared only when the
 * key's own origin was observed. Written to the letter of a rule that states no REQUIRES, this
 * specification would prepare material for a key built from hard-coded bytes, and a second key
 * spec constructed from that copy would pass in silence, cancelling the report the first
 * construction drew. At this one point the specification is therefore stricter than the rule.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/Key.crysl
 */
KeySpec(Key k) {

   // The bytes `getEncoded()` returned, staged from the event that observed them to the
   // handler that writes about them: a handler receives no event arguments and runs after the
   // transition is decided, so the array a call returned has to travel in a field.
   byte[] stagedKeyMaterial;

   // `GetEnc`: `ge1: keyMaterial = getEncoded();`, the rule's one event and the whole of its
   // ORDER. The rule states no CONSTRAINTS and no REQUIRES, so this body checks no clause and
   // reports nothing. What it does is bridge a copy: `getEncoded()` returns a fresh clone on
   // every call and the store is keyed on object identity, so without this event no reader of
   // the returned bytes could see what was established about the key they came out of.
   //
   // The owner carries the subtype operator, and it has to. `Key` is the supertype of
   // `SecretKey`, `PublicKey` and `PrivateKey`, and where the source declares the variable as
   // the concrete class the compiler emits the concrete owner, which an exact-match pointcut on
   // the interface never sees. `Key+.getEncoded()` therefore also matches every receiver
   // `SecretKeySpec.mop`'s `SecretKey+.getEncoded()` matches, and a secret key's encoding is
   // observed twice, once by each specification. The double observation costs nothing at the
   // store: `ensure` is idempotent per property, bound identity and value tuple, so the second
   // write of the same tuple adds nothing.
   //
   // Because the two pointcuts overlap, the two specifications have to agree about what the
   // call means, or the looser of them decides. `SecretKeySpec.mop` stages the material only
   // when the key's own origin was observed, and that guard is what refuses to launder key
   // material through a copy: hard-coded bytes, reported at their own `SecretKeySpec`
   // construction, handing their encoding on as prepared material for a second construction
   // that would then be silent. The guard is mirrored here, generalised to the shape `Key` has.
   // A key's origin is observed when the store carries GENERATED_KEY for it under its own
   // algorithm -- the key was produced by a call the instrumentation observed, for the algorithm
   // recorded with it -- or GENERATED_PUBLIC_KEY or GENERATED_PRIVATE_KEY, the public or private
   // key was produced by a call the instrumentation observed. Any one of the three answering
   // SATISFIED is an origin. That makes this specification stricter than `Key.crysl`, which
   // states no REQUIRES at all.
   //
   // Each of the three reads is three-valued, and here the three collapse into two, because the
   // read governs a write and not a report: SATISFIED stages the array, VIOLATED and
   // NOT_OBSERVED both stage nothing, and no site downstream can tell which of the two it was.
   //
   // The copy also carries REPORTED_UPSTREAM: the object's producer already reported it, so a
   // later site that finds no predicate for it is looking at a refusal upstream and not at a gap
   // in instrumentation reach. A key carrying the mark hands it to the array it returns, so a
   // consumer of those bytes reports them as refused upstream. Every subtype of `Key` passes
   // through here, so a marked public or private key bridges too. The mark is not a CrySL
   // predicate and has no acceptance point, so it is written in the body, where the returned
   // array is visible.
   event ge1 after(Key k) returning(byte[] material):
      call(public byte[] Key+.getEncoded()) &&
      target(k) {
        boolean originObserved =
            PredicateStore.instance().validate(Property.GENERATED_KEY, k, k.getAlgorithm()) == PredicateVerdict.SATISFIED
            || PredicateStore.instance().validate(Property.GENERATED_PUBLIC_KEY, k) == PredicateVerdict.SATISFIED
            || PredicateStore.instance().validate(Property.GENERATED_PRIVATE_KEY, k) == PredicateVerdict.SATISFIED;
        if (originObserved) {
            stagedKeyMaterial = material;
        }
        if (PredicateStore.instance().validateAny(Property.REPORTED_UPSTREAM, k) == PredicateVerdict.SATISFIED) {
            PredicateStore.instance().ensure(Property.REPORTED_UPSTREAM, material);
        }
   }

   // `ORDER GetEnc*` is the whole of the rule's ordering, so every sequence of `getEncoded()`
   // calls is accepted and no `@fail` handler is written: there is no sequence to refuse, which
   // is why this specification has no row in `codes.csv`.
   //
   // The ENSURES clause carries `after GetEnc`, so it holds at the states `ge1` leads to; the
   // `ere` is `ge1*`, whose only alias is `match`, over its accepting states. Here the two are
   // the same single state, so the handler below is the acceptance point under either reading.
   ere : ge1*

   // ENSURES `preparedKeyMaterial[keyMaterial] after GetEnc`: the bytes are key material a
   // monitored key or key agreement handed out.
   //
   // The handler runs after every `ge1`, which is what the clause needs: each call returns its
   // own copy and each copy has to be marked separately. The staged array is consumed here or
   // discarded, so a call whose key origin was not observed never leaves a marking behind for
   // the next one.
   @match {
     if (stagedKeyMaterial != null) {
         PredicateStore.instance().ensure(Property.PREPARED_KEY_MATERIAL, stagedKeyMaterial);
         stagedKeyMaterial = null;
     }
   }

}
