package mop;

import javax.crypto.KeyGenerator;
import javax.crypto.SecretKey;
import javax.crypto.spec.SecretKeySpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.ExecutionContext;
import br.unb.cic.mop.Property;

/**
 * SecretKeySpec
 *
 * A JavaMOP specification of the correct usage of the
 * javax.crypto.spec.SecretKey.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/SecretKey.crysl
 */
SecretKeySpec(SecretKey secretKey) {


   event e1 after(SecretKey secretKey) returning(byte[] key):
      call(public byte[] SecretKey.getEncoded()) &&
      target(secretKey) &&
      condition(ExecutionContext.instance().validate(Property.GENERATED_KEY, secretKey)) {
        ExecutionContext.instance().setProperty(Property.RANDOMIZED, key);
   }

   // CrySL states two events over a SecretKey: ge, which this specification carries as e1,
   // and d: destroy(), which the translation left out entirely. The rule's NEGATES clause,
   // generatedKey[this, _] after d, is what withdraws the key's mark once the application
   // destroys it. Without the event a destroyed key went on satisfying every generatedKey
   // REQUIRES downstream -- Cipher.init and Mac.init among them.
   // The event is added and given its place in the automaton in the same edit. An event with
   // no place is the defect Group 3b removed sixteen times over: the generator hands it a row
   // sending every state to fail, so a legitimate destroy() would be reported as a sequence
   // violation.
   event d after(SecretKey secretKey):
      call(public void SecretKey.destroy()) &&
      target(secretKey) {
        ExecutionContext.instance().remove(Property.GENERATED_KEY, secretKey);
   }

   // The rule's ORDER is `ge*, d?`: any number of getEncoded, then at most one destroy. The
   // ERE grammar of rv-monitor has no `?` operator, so the optional tail is written as a
   // union with epsilon, which is the same language.
   ere : e1* (d | epsilon)

   @match {
     // __RESET;
   }

}