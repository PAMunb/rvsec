package mop;

import javax.crypto.spec.SecretKeySpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * SecretKeySpecSpec
 *
 * Monitors javax.crypto.spec.SecretKeySpec against the CrySL rule SecretKeySpec.crysl. The
 * interface javax.crypto.SecretKey is monitored by a different specification of this set,
 * SecretKeySpec.mop, which transcribes SecretKey.crysl and watches `getEncoded()`.
 *
 * The rule's ORDER is the single label `Con`, with `Con := c1 | c2` over the two constructors,
 * so the only sequence this specification accepts is one construction. Of the rule's three
 * CONSTRAINTS clauses it checks two: the algorithm clause
 * `keyAlgorithm in {"AES", "HmacSHA256", "HmacSHA384", "HmacSHA512"}`, at both constructors,
 * and the bounds clause `length[keyMaterial] >= offset + len`, at the four-argument one.
 * `neverTypeOf[keyMaterial, java.lang.String]` is not checked: it constrains the expression
 * that produced the `byte[]` handed to the constructor, and an event body sees the array and
 * not the expression that built it. The rule REQUIRES `preparedKeyMaterial[keyMaterial]`, read
 * at both constructors because the rule binds that object in both events, and ENSURES
 * `speccedKey[this, _]` and `generatedKey[this, keyAlgorithm]`, both written at the acceptance
 * point.
 *
 * Behaviour that departs from the rule: beside the four names the algorithm clause admits, the
 * allow-list carries the spellings `HMAC-SHA256`, `HMAC/SHA256`, `HMAC-SHA384`, `HMAC/SHA384`,
 * `HMAC-SHA512` and `HMAC/SHA512`, so a program that writes one of those is accepted here and
 * refused by the clause as written.
 *
 * Five of the codes this file emits have no execution path -- the two ordering codes, the
 * bounds code, and the two that answer a VIOLATED verdict on the key-material predicate -- and
 * each is explained where it is emitted.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/SecretKeySpec.crysl
 */
SecretKeySpecSpec(SecretKeySpec secretKeySpec) {

   // The envelope's quoting rule: a null value is the empty string, a single quote is escaped
   // so it cannot close the field early, and the value is capped so a pathological argument
   // cannot push the record past the logcat payload limit.
   private String q(String s) {
       if (s == null) {
           return "";
       }
       String value = s.length() > 512 ? s.substring(0, 512) : s;
       return value.replace("'", "\\'");
   }

   // The rule's CONSTRAINTS clause
   // `keyAlgorithm in {"AES", "HmacSHA256", "HmacSHA384", "HmacSHA512"}`, transcribed, plus six
   // further spellings of the three HMAC names. `ConscryptAliasTable.matches` compares
   // case-insensitively, so `HMACSHA256` and the clause's `HmacSHA256` are one entry; the
   // hyphenated and slashed forms are spellings the clause itself does not admit, and carrying
   // them here makes this specification accept algorithm strings the rule refuses.
   List<String> algorithms = Arrays.asList("AES", "HMACSHA256", "HMACSHA384", "HMACSHA512",
           "HMAC-SHA256", "HMAC/SHA256", "HMAC-SHA384", "HMAC/SHA384", "HMAC/SHA512", "HMAC-SHA512");

   // The constructed spec, staged by the conforming branch of either constructor for the two
   // ENSURES writes at `@match`: a handler receives no event arguments.
   SecretKeySpec spec;

   // The value place of `generatedKey[this, keyAlgorithm]`. The rule binds the algorithm in
   // both constructors, so both events stage it beside the object and the handler writes the
   // pair. It travels in a field for the same reason `spec` does: a handler receives no event
   // arguments and runs after the transition is decided.
   String specAlgorithm;

   // Set by both constructor events, and read by `@fail` to tell a sequence failure from a
   // monitor that never saw this object being constructed (SECRETKEYSPEC-ORDER-01). The
   // generated `reset()` clears the state and not this field.
   boolean creationObserved = false;

   // `Con`: `c1: SecretKeySpec(keyMaterial, keyAlgorithm)`, one of the two alternatives of the
   // rule's only ordering label.
   //
   // CONSTRAINTS `keyAlgorithm in {"AES", "HmacSHA256", "HmacSHA384", "HmacSHA512"}`, checked
   // first in the body against the allow-list field above, which carries six further spellings
   // of the HMAC names. A name outside the list draws the unsafe-algorithm code registered in
   // `codes.csv` for this site and clears `conforms`, so a spec built under an algorithm the
   // rule refuses does not go on to carry `generatedKey`.
   //
   // REQUIRES `preparedKeyMaterial[keyMaterial]`: the bytes are key material a monitored key or
   // key agreement handed out. The read is three-valued and the three verdicts are different
   // claims. SATISFIED is silent and lets the construction stand. VIOLATED is positive evidence
   // about this array -- an entry exists and is not what the clause demands -- and draws the
   // constraint code; no site of this set negates `preparedKeyMaterial` and the clause names no
   // value position, so that branch has no execution path, and it is written because every
   // branch of a site carries its own code in `codes.csv`. NOT_OBSERVED means no entry at all:
   // no preparation of this array was ever seen, which on this platform is as often a limit of
   // what the weaving reaches as a misuse.
   //
   // What satisfies the clause is narrow, and saying so here saves the reader the search:
   // `preparedKeyMaterial` is established by `getEncoded()` on a key and by the shared-secret
   // buffer a key agreement hands out, and by nothing else. Filling a byte array from a
   // SecureRandom and constructing a SecretKeySpec from it does not satisfy it; generating a
   // key, taking its encoding and constructing from that does.
   //
   // NOT_OBSERVED is split by what else the store knows about the array, in this order. An array
   // that carries REPORTED_UPSTREAM came from an object whose producer already reported it, so
   // this site is looking at a refusal upstream and not at a gap in instrumentation reach, and
   // it draws the upstream-refused code. An array a monitored SecureRandom filled carries
   // RANDOMIZED -- the object came from a SecureRandom the instrumentation observed -- and draws
   // a code of its own, which keeps random-but-unprepared material apart from an array nobody
   // saw being made. Any other array keeps the plain not-observed code.
   //
   // `spec` and `specAlgorithm` are staged only where every clause held, because `@match` turns
   // them into the rule's two ENSURES clauses and CrySL establishes a predicate only for a use
   // that satisfied the rule. A construction that broke a clause reaches the handler with
   // nothing staged and both writes are no-ops; it is marked REPORTED_UPSTREAM instead, so the
   // sites that consume the spec report it as refused upstream rather than as not observed.
   event c1 after(byte[] keyMaterial, String keyAlgorithm) returning(SecretKeySpec secretKeySpec):
    call(public SecretKeySpec.new(byte[], String))
    && args(keyMaterial, keyAlgorithm) {
      creationObserved = true;
      boolean conforms = true;
      boolean reported = false;
      // The algorithm clause is read here, in the body, and not in `condition(...)`: a guard
      // compiles to an early return ahead of both the body and the transition, so a call naming
      // an algorithm the rule refuses would leave the automaton in the state before the
      // constructor and the next call would be reported as a wrong call sequence instead of as
      // the unsafe algorithm it is. It sets `conforms` on the same footing as the predicate
      // read below, so a bad algorithm also stops the `generatedKey` write at `@match`.
      if (!ConscryptAliasTable.matches("SecretKeySpec", keyAlgorithm, algorithms)) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-ALG-00 ev=" + __EVENTNAME + " obj=SecretKeySpec val='" + q(keyAlgorithm) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + keyAlgorithm + "'"));
          conforms = false;
          reported = true;
      }
      PredicateVerdict preparedMaterial = PredicateStore.instance().validate(Property.PREPARED_KEY_MATERIAL, keyMaterial);
      if (preparedMaterial == PredicateVerdict.VIOLATED) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-CONSTR-00 ev=" + __EVENTNAME + " obj=SecretKeySpec val='' exp='prepared key material' msg='the keyMaterial given to SecretKeySpec(byte[], String) carries a preparation predicate the rule does not admit'"));
          conforms = false;
          reported = true;
      }
      else if (preparedMaterial == PredicateVerdict.NOT_OBSERVED && PredicateStore.instance().validateAny(Property.REPORTED_UPSTREAM, keyMaterial) == PredicateVerdict.SATISFIED) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-NOBS-02 ev=" + __EVENTNAME + " obj=SecretKeySpec val='' exp='prepared key material' msg='the keyMaterial given to SecretKeySpec(byte[], String) comes from an object that was already reported upstream'" + Evidence.keysFor(keyMaterial)));
          conforms = false;
          reported = true;
      }
      else if (preparedMaterial == PredicateVerdict.NOT_OBSERVED && PredicateStore.instance().validate(Property.RANDOMIZED, keyMaterial) == PredicateVerdict.SATISFIED) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-NOBS-03 ev=" + __EVENTNAME + " obj=SecretKeySpec val='' exp='prepared key material' msg='the keyMaterial given to SecretKeySpec(byte[], String) was filled by a SecureRandom and not prepared by a Key.getEncoded()'" + Evidence.keysFor(keyMaterial)));
          conforms = false;
          reported = true;
      }
      else if (preparedMaterial == PredicateVerdict.NOT_OBSERVED) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-NOBS-00 ev=" + __EVENTNAME + " obj=SecretKeySpec val='' exp='prepared key material' msg='the keyMaterial given to SecretKeySpec(byte[], String) was not observed to have been prepared by a Key.getEncoded()'" + Evidence.keysFor(keyMaterial)));
          conforms = false;
          reported = true;
      }
      if (conforms) {
          spec = secretKeySpec;
          specAlgorithm = keyAlgorithm;
      }
      if (reported) {
          PredicateStore.instance().ensure(Property.REPORTED_UPSTREAM, secretKeySpec);
      }
    }

   // `Con`: `c2: SecretKeySpec(keyMaterial, offset, len, keyAlgorithm)`, the other alternative
   // of the same label. It checks the same algorithm clause and the same REQUIRES as the
   // two-argument constructor, under codes of its own because a code names a site, and one
   // clause more.
   //
   // CONSTRAINTS `length[keyMaterial] >= offset + len`, the rule's bounds clause, which only
   // this overload can break. Its accusing branch has no execution path: this is an
   // `after ... returning` advice and the constructor rejects the combination with an exception
   // before it can return, so no execution reaches the report. It is written because it is the
   // literal transcription of the clause the rule states, and the platform enforcing a rule's
   // constraint itself is a fact about the platform, not a reason for the specification to stop
   // stating it.
   //
   // REQUIRES `preparedKeyMaterial[keyMaterial]` is read here too: the rule states a single
   // REQUIRES over `keyMaterial` and binds that object in both events of `Con := c1 | c2`, so
   // the obligation is the constructor's and not one overload's. The bytes are key material a
   // monitored key or key agreement handed out. SATISFIED is silent; VIOLATED is positive
   // evidence about this array -- an entry exists and is not what the clause demands -- and has
   // no execution path, since no site of this set negates the predicate; NOT_OBSERVED means no
   // entry at all, and is split as at the two-argument constructor: upstream-refused when the
   // array carries REPORTED_UPSTREAM, random-but-unprepared when it carries RANDOMIZED, and the
   // plain not-observed code otherwise.
   //
   // Every check sits in the body and not in a `condition(...)` guard: a guard compiles to an
   // early return ahead of both the body and the transition, so a violating construction would
   // leave the automaton in the state before the call and the next call would be reported as a
   // wrong call sequence instead of as the misuse it is. The staging and the marking of the
   // constructed spec are as at the two-argument constructor.
   event c2 after(byte[] keyMaterial, int offset, int len, String keyAlgorithm) returning(SecretKeySpec secretKeySpec):
    call(public SecretKeySpec.new(byte[], int, int, String))
    && args(keyMaterial, offset, len, keyAlgorithm) {
      creationObserved = true;
      boolean conforms = true;
      boolean reported = false;
      // The rule binds `keyAlgorithm` in both constructors, so the clause is the
      // constructor's and not one overload's; the code is a new number because a code names
      // a site.
      if (!ConscryptAliasTable.matches("SecretKeySpec", keyAlgorithm, algorithms)) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-ALG-01 ev=" + __EVENTNAME + " obj=SecretKeySpec val='" + q(keyAlgorithm) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + keyAlgorithm + "'"));
          conforms = false;
          reported = true;
      }
      if (keyMaterial.length < offset + len) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-CONSTR-01 ev=" + __EVENTNAME + " obj=SecretKeySpec val='" + keyMaterial.length + "' exp='at least offset + len' msg='keyMaterial.length is smaller than offset + len'"));
          conforms = false;
          reported = true;
      }
      PredicateVerdict preparedMaterial = PredicateStore.instance().validate(Property.PREPARED_KEY_MATERIAL, keyMaterial);
      if (preparedMaterial == PredicateVerdict.VIOLATED) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-CONSTR-02 ev=" + __EVENTNAME + " obj=SecretKeySpec val='' exp='prepared key material' msg='the keyMaterial given to SecretKeySpec(byte[], int, int, String) carries a preparation predicate the rule does not admit'"));
          conforms = false;
          reported = true;
      }
      else if (preparedMaterial == PredicateVerdict.NOT_OBSERVED && PredicateStore.instance().validateAny(Property.REPORTED_UPSTREAM, keyMaterial) == PredicateVerdict.SATISFIED) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-NOBS-04 ev=" + __EVENTNAME + " obj=SecretKeySpec val='' exp='prepared key material' msg='the keyMaterial given to SecretKeySpec(byte[], int, int, String) comes from an object that was already reported upstream'" + Evidence.keysFor(keyMaterial)));
          conforms = false;
          reported = true;
      }
      else if (preparedMaterial == PredicateVerdict.NOT_OBSERVED && PredicateStore.instance().validate(Property.RANDOMIZED, keyMaterial) == PredicateVerdict.SATISFIED) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-NOBS-05 ev=" + __EVENTNAME + " obj=SecretKeySpec val='' exp='prepared key material' msg='the keyMaterial given to SecretKeySpec(byte[], int, int, String) was filled by a SecureRandom and not prepared by a Key.getEncoded()'" + Evidence.keysFor(keyMaterial)));
          conforms = false;
          reported = true;
      }
      else if (preparedMaterial == PredicateVerdict.NOT_OBSERVED) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-NOBS-01 ev=" + __EVENTNAME + " obj=SecretKeySpec val='' exp='prepared key material' msg='the keyMaterial given to SecretKeySpec(byte[], int, int, String) was not observed to have been prepared by a Key.getEncoded()'" + Evidence.keysFor(keyMaterial)));
          conforms = false;
          reported = true;
      }
      if (conforms) {
          spec = secretKeySpec;
          specAlgorithm = keyAlgorithm;
      }
      if (reported) {
          PredicateStore.instance().ensure(Property.REPORTED_UPSTREAM, secretKeySpec);
      }
    }

   // `ORDER Con` with `Con := c1 | c2`: constructing a SecretKeySpec is the entire ordering
   // this specification observes, so the `@fail` handler below cannot fire. Both events lead
   // from the initial state to the accepting one, and a monitor of this specification is keyed
   // on the constructed object, so it never sees a second event. Its two codes are therefore
   // codes with no execution path; the handler is written because the generator expects one and
   // each of its branches carries its own code in `codes.csv`.
   ere : c1 | c2

   @fail {
      if (!creationObserved) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-ORDER-01 ev=" + __EVENTNAME + " obj=SecretKeySpec val='' exp='' msg='the observed call sequence is not one SecretKeySpecSpec accepts, and no construction of this SecretKeySpec was observed'"));
      }
      else {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SecretKeySpecSpec", "" + __LOC,
              "v=1 code=SECRETKEYSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=SecretKeySpec val='' exp='' msg='the observed call sequence is not one SecretKeySpecSpec accepts'"));
      }
      __RESET;
   }

   // ENSURES `generatedKey[this, keyAlgorithm]`: the key was produced by a call the
   // instrumentation observed, for the algorithm recorded with it. And ENSURES
   // `speccedKey[this, _]`: the key spec was constructed by a call the instrumentation observed
   // and the rule admitted. Neither clause carries an `after L`, and the rule's ORDER is the
   // single `Con`, so both hold wherever the object's use so far is a complete conforming call
   // sequence -- the accepting state, which in an `ere` is exactly what `@match` names. One
   // handler writes both.
   //
   // Both values are staged: a handler receives no event arguments and runs after the transition
   // is decided, so the constructor event put the spec and the algorithm it was built with in
   // fields, and put them there only on its conforming branch. A construction that broke a
   // clause reaches this handler with nothing staged, and `ensure` treats a null binding as a
   // no-op.
   //
   // `generatedKey` is written at the rule's arity, two places, the object and its algorithm,
   // and its readers ask at that arity: `validate` compares the whole value tuple, so a
   // two-place entry read with no value would answer VIOLATED for every spec this file observes
   // being built. `CipherSpec` reads it with the algorithm token it splits out of the
   // transformation and `SecretKeySpec.mop` with the key's own `getAlgorithm()`; the store
   // compares String positions case-insensitively, which is what lets those spellings meet.
   //
   // `speccedKey` is written at arity 1, because the rule leaves its second position anonymous.
   // The readers -- `generateSecret` in `SecretKeyFactorySpec` and `generatePrivate` and
   // `generatePublic` in `KeyFactorySpec` -- read it with `validateAny`, which asks only whether
   // the object carries the predicate at all, so a one-place write answers them.
   @match {
      PredicateStore.instance().ensure(Property.GENERATED_KEY, spec, specAlgorithm);
      PredicateStore.instance().ensure(Property.SPECCED_KEY, spec);
   }

}
