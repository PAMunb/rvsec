package mop;

import java.security.Provider;
import java.security.Key;
import javax.crypto.Cipher;
import java.security.SecureRandom;
import java.security.spec.AlgorithmParameterSpec;
import java.security.cert.Certificate;

import java.nio.ByteBuffer;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
// D-15: the value oracle is the expert-validated Cipher.crysl, and CipherTransformationUtil
// is the transcription of it the published numbers were measured with. The freeze on that
// class (INV-INS-109/118) forbids editing it, not calling it: it stays byte-identical and
// gains a second caller, so no verdict of the frozen jca moves.
//
// What the withdrawn api30 anchor cost here is the sharpest case for the reversal, and it is
// recorded because no published number shows it: Api30CipherTransformationUtil admits
// AES/ECB/PKCS5Padding -- ECB is a member of the transcribed AES mode clause and no
// transcribed padding clause covers ECB, so isValid falls through to `return true` -- and
// likewise DESede, BLOWFISH, ARC4 and ChaCha20 under any mode. Every one of those is accused
// by the class named below. ECB is the misuse this line of work exists to detect.
//
// Api30CipherTransformationUtil is deliberately not deleted: it keeps no caller and stays as
// the record of what the withdrawn anchor said, which is what makes the two comparable.
//
// Only the static import is written, and the one call that used to qualify the class name is
// bare below. The generator dedupes imports by class name and keeps the first: written both
// ways it drops the static one, and the monitor then fails to compile on `isValid` -- caught
// by the harness, not by a grep of the lists. The frozen jca imports the same class the same
// single way.
import static br.unb.cic.mop.jca.util.CipherTransformationUtil.*;

// The normaliser is named in full and imported plainly, where the frozen
// `CipherTransformationUtil` above is imported statically. That is not inconsistency: the two
// classes declare methods of the same names, so a second static-* import would make every bare
// `mode(...)` and `isValid(...)` of the merged monitor ambiguous and the monitor would not
// compile. Naming this one at each call site is also what tells a reader which of the two a
// given line asks -- and there are lines of both kinds in these files, on purpose.
import br.unb.cic.mop.jca.util.CipherTransformationNormalizer;


/**
 * CipherSpec
 *
 * A JavaMOP specification of the correct usage of the
 * javax.crypto.Cipher class.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/Cipher.crysl
 */
CipherSpec(Cipher c) {

    String expectedTransformations = "a transformation admitted by CipherTransformationUtil (expert Cipher.crysl)";
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

   String currentTransformation = "";

   // api30 Cipher.cryptsl ensures `encrypted` over a *pair* -- the ciphertext and
   // the plaintext it came from -- in three clauses: one `after updates`, and two
   // at the accepting state. A handler sees no event parameter (it is generated as
   // a no-argument method), so the pair travels in these fields: the event body
   // stages it, and the handler that runs immediately after the transition writes
   // it and clears the field. Staging rather than writing in the body is the point
   // of the placement: an event body runs *before* the transition is decided, so a
   // write there marks a ciphertext the automaton was about to reject.
   //
   // A staged pair is consumed by exactly one handler or discarded by @fail, so it
   // is never written for a sequence the automaton did not accept, and never
   // written twice: the generated dispatcher evaluates the state categories after
   // every event, so each update runs its own handler with its own pair.
   Object updatedCipherText = null;
   Object updatedPlainText = null;
   Object finalCipherText = null;
   Object finalPlainText = null;

   event g1 after(String transformation) returning(Cipher c):
     call(public static Cipher Cipher.getInstance(String)) &&
     args(transformation) &&
     condition(CipherTransformationNormalizer.isValid(transformation)) {
       currentTransformation = transformation;
   }

   event g2 after(String transformation, Object provider) returning(Cipher c):
      call(public static Cipher Cipher.getInstance(String, Object+)) &&
      args(transformation, provider) &&
      condition(CipherTransformationNormalizer.isValid(transformation)) {
        currentTransformation = transformation;
   }


   event g3 after(String transformation) returning(Cipher c):
     call(public static Cipher Cipher.getInstance(String)) &&
     args(transformation) &&
     condition(!CipherTransformationNormalizer.isValid(transformation)) {
        currentTransformation = transformation;
   }

   event i1 before(int mode, Certificate cert, Cipher c):
     call(public void Cipher.init(int, Certificate, ..)) &&
     args(mode, cert, ..) &&
     target(c) {
       if (!CipherTransformationNormalizer.isValid(c.getAlgorithm())) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "CipherSpec", "" + __LOC,
                "v=1 code=CIPHER-ALG-00 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedTransformations) + "' msg='expecting " + expectedTransformations + " but found " + c.getAlgorithm() + "'"));
        }
    }

   // The key-origin clause of the rule -- `generatedKey[key, part(0,"/",transformation)]`
   // at Cipher.cryptsl:174 -- is one clause, and the set models the origin of a key
   // as three producing predicates, so the three probes below are one composite
   // read that emits at most one report (INV-INS-133), not three reads that could
   // each accuse.
   //
   // The read is in the body and not in `condition(...)`, which is where it used to
   // sit: a condition compiles to `if (!(guard)) return false;` ahead of the body
   // and ahead of the transition, so a key whose origin the monitor never saw
   // silently dropped this `init` out of the automaton and the following call was
   // accused of a wrong call sequence -- a defect the program does not have. A
   // failed REQUIRES is not a typestate failure; the transition is taken either way
   // and the clause accuses on its own.
   //
   // The verdict is three-valued and the two outcomes are told apart in the report.
   // VIOLATED is positive evidence -- the key carries a key-origin predicate that
   // was withdrawn, or recorded with values the clause does not admit -- while
   // NOT_OBSERVED says only that no producer of this key was ever observed, which
   // on Android is as often a reach limit of the instrumentation as it is a misuse.
   // Folding the two into one code would make the second unreadable as what it is.
   //
   // The `generatedKey` probe reads the clause at the arity the rule states, with the
   // splitter applied here rather than in the store: api30 writes
   // `generatedKey[key, part(0,"/",transformation)]`, and the oracle's splitters are the
   // caller's to apply, because the caller is the side that holds the clause. The
   // transformation is read off `c.getAlgorithm()`, which returns verbatim what
   // `getInstance` was given; `alg` is total on it -- a transformation with no `/` is its
   // own algorithm -- so unlike `mode` it cannot fail on a malformed string, and
   // `getInstance` had already rejected one before any Cipher existed.
   //
   // The three producers rise to two places in this same commit (`KeyGeneratorSpec`,
   // `SecretKeySpecSpec`, `KeyStoreSpec`); the two key-half probes stay at one, because
   // `generatedPrivkey[key]` and `generatedPubkey[key]` are one-place in every rule that
   // ensures them. Measured on the platform, the second place protects the SATISFIED
   // answer rather than producing new accusations: the JCA refuses a key whose algorithm
   // differs from the Cipher's, with `InvalidKeyException`, before this program can go
   // wrong in any way this clause would name -- so the VIOLATED branch has no execution
   // path the platform admits, and it is written for the reason its siblings are, that a
   // read which folded VIOLATED into NOT_OBSERVED would misreport the day some rule's
   // NEGATES clause withdraws a key origin.
   event i2 before(int mode, Key key, Cipher c):
     call(public void Cipher.init(int, Key,..)) &&
     args(mode, key, ..) &&
     target(c) {
        PredicateVerdict asSecretKey = PredicateStore.instance().validate(Property.GENERATED_KEY, key,
            alg(c.getAlgorithm()));
        PredicateVerdict asPublicKey = PredicateStore.instance().validate(Property.GENERATED_PUBLIC_KEY, key);
        PredicateVerdict asPrivateKey = PredicateStore.instance().validate(Property.GENERATED_PRIVATE_KEY, key);
        PredicateVerdict origin = PredicateVerdict.NOT_OBSERVED;
        if (asSecretKey == PredicateVerdict.SATISFIED
         || asPublicKey == PredicateVerdict.SATISFIED
         || asPrivateKey == PredicateVerdict.SATISFIED) {
            origin = PredicateVerdict.SATISFIED;
        }
        else if (asSecretKey == PredicateVerdict.VIOLATED
              || asPublicKey == PredicateVerdict.VIOLATED
              || asPrivateKey == PredicateVerdict.VIOLATED) {
            origin = PredicateVerdict.VIOLATED;
        }
        if (origin == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "CipherSpec", "" + __LOC,
                "v=1 code=CIPHER-CONSTR-00 ev=" + __EVENTNAME + " obj=Cipher val='' exp='a key produced by one of the generators the rule names' msg='the key given to Cipher.init carries a key-origin predicate the rule does not admit'"));
        }
        else if (origin == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "CipherSpec", "" + __LOC,
                "v=1 code=CIPHER-NOBS-00 ev=" + __EVENTNAME + " obj=Cipher val='' exp='a key produced by one of the generators the rule names' msg='no generator of the key given to Cipher.init was observed'"));
        }
        if (!CipherTransformationNormalizer.isValid(c.getAlgorithm())) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "CipherSpec", "" + __LOC,
            "v=1 code=CIPHER-ALG-01 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedTransformations) + "' msg='expecting " + expectedTransformations + " but found " + c.getAlgorithm() + "'"));
        }
    }

   event u1 after (byte[] plainText, Cipher c) returning(byte[] cipherText):
     call(public byte[] Cipher.update(byte[])) &&
     args(plainText) &&
     target(c) {
        updatedCipherText = cipherText;
        updatedPlainText = plainText;
   }

   event u2 after (byte[] plainText, int prePlainTextOffset, int prePlainTextLen, Cipher c) returning(byte[] cipherText):
     call(public byte[] Cipher.update(byte[], int, int)) &&
     args(plainText, prePlainTextOffset, prePlainTextLen) &&
     target(c) {
        updatedCipherText = cipherText;
        updatedPlainText = plainText;
   }

   event u3 after (byte[] plainText, int prePlainTextOffset, int prePlainTextLen, byte[] cipherText, Cipher c):
     call(public int Cipher.update(byte[], int, int, byte[])) &&
     args(plainText, prePlainTextOffset, prePlainTextLen, cipherText) &&
     target(c) {
        updatedCipherText = cipherText;
        updatedPlainText = plainText;
   }

   event u4 after (byte[] plainText, int prePlainTextOffset, int prePlainTextLen, byte[] cipherText, int outputOffset, Cipher c):
     call(public int Cipher.update(byte[], int, int, byte[], int)) &&
     args(plainText, prePlainTextOffset, prePlainTextLen, cipherText, outputOffset) &&
     target(c) {
        updatedCipherText = cipherText;
        updatedPlainText = plainText;
   }

   event u5 after (ByteBuffer plainBuffer, ByteBuffer cipherBuffer, Cipher c):
     call(public int Cipher.update(ByteBuffer, ByteBuffer)) &&
     args(plainBuffer, cipherBuffer) &&
     target(c) {
        updatedCipherText = cipherBuffer;
        updatedPlainText = plainBuffer;
   }

   // api30 Cipher.cryptsl declares `w: wrap(wrappedKey)` at :111 and names it in no
   // ENSURES clause, so the rule ensures nothing here and this event stages no pair.
   event wkb1 after(Cipher c) returning(byte[] wrappedKeyBytes):
     call(byte[] Cipher.wrap(Key)) &&
     target(c) {
   }

   // The three `doFinal` events below return the ciphertext without binding the
   // plaintext -- `doFinal()` has none, and the pointcuts of `f2` and `f3` do not
   // name it. The clause is arity 2, so the pair is staged with the position the
   // pointcut does not observe left null rather than the write being dropped or
   // silently narrowed to arity 1.
   //
   // `f1` and `f2` are disjoint by signature, and they have to be: `(..)` matches an
   // empty argument list too, so a single `doFinal()` used to take two transitions.
   // Measured over the corpus, the duplication was silent on the update path -- `f1`
   // runs first and `s3 -> end -> end` is accepted at both steps -- and audible on the
   // path without one, where a single call drew CIPHER-ORDER-00 twice against a rule
   // that turns it down once. `doFinal(byte[], ..)` leaves the argument-less signature
   // to `f1` and keeps the two overloads api30 binds `plainText` in, which is what
   // `order_alphabet_map.csv` already attributes to each event: `f1` to the rule's `f1`
   // (Cipher.cryptsl:93) and `f2` to its `f2` and `f4` (:95 and :99). What the narrowing
   // takes away from `s2` is a transition the ORDER never granted -- `FINWOU` is
   // `f2 | f4 | f5 | f6 | f7` and excludes the rule's `f1` -- so `doFinal()` straight
   // after an init stays a sequence this automaton is right to reject, and now says so
   // once instead of twice.
   event f1 after(Cipher c) returning(byte[] cipherText):
     call(public byte[] Cipher.doFinal()) &&
     target(c) {
      finalCipherText = cipherText;
      finalPlainText = null;
   }

   event f2 after(Cipher c) returning(byte[] cipherText):
     call(public byte[] Cipher.doFinal(byte[], ..)) &&
     target(c) {
       finalCipherText = cipherText;
       finalPlainText = null;
   }

   event f3 after(byte[] cipherText, int offset, Cipher c):
     call(public int Cipher.doFinal(byte[], int)) &&
     args(cipherText, offset) &&
     target(c) {
       finalCipherText = cipherText;
       finalPlainText = null;
   }

    // The two `doFinal` overloads of this file that bind the rule's `plainText`, and
    // therefore the two sites of `!macced[_, plainText]` (Cipher.cryptsl:180, ledger
    // clause #8) that `CipherSpec` can carry. The rule forbids encrypting data that was
    // already authenticated -- mac-then-encrypt -- and the read is `validateAbsent`,
    // whose table is inverted: absence is the conforming case, so it never answers
    // NOT_OBSERVED and there is no NOBS code beside these two (INV-INS-146). Reading a
    // negated clause through `validate` would report *not observed* on every conforming
    // `doFinal` in the world, which is backwards.
    //
    // The rule's own `f2` and `f4` bind `plainText` too, and this file does not: its
    // `f2` is `doFinal(byte[], ..)` over those two overloads at once and binds no
    // argument of its own. Since the pointcut stopped covering `doFinal()` the two share
    // a `byte[]` in the first position, so an `args(plainText, ..)` here would bind it:
    // the placement of those two reads is a choice from now on and not an impossibility.
    // The choice is to leave them where they are -- moving them would retire two
    // accusers and change which specification reports a misuse that neither placement
    // stops reporting -- and splitting `f2` into one event per overload is still
    // unavailable at 17 of 17 events (INV-INS-145, n=18 raises StackOverflowError in the
    // enable-set parser at any heap). So those two overloads -- the dominant way a
    // program encrypts -- are read in `IvChainJunction.mop`, which is the file that
    // exists for exactly this: binding an argument of a `Cipher` call that `CipherSpec`
    // has no room to bind.
    //
    // `f7` binds a `ByteBuffer` plaintext and gains no read. No site of the set can mark
    // a `ByteBuffer` under this predicate -- api30's `Mac` declares no `ByteBuffer`
    // event, so the producer has nothing to write about one -- and `validateAbsent` never
    // answers NOT_OBSERVED, so a read there could answer only SATISFIED. It would be a
    // site with no path to an accusation, which decision 19 records rather than writes.
    //
    // The read does not guard the staging below it. A failed REQUIRES is not a typestate
    // failure and it is not a reason to stop recording what this call encrypted: the
    // `encrypted` clause is the rule's ENSURES and it holds whatever the answer here is.
    event f5 after(byte[] plainText, int offset, int len, byte[] cipherText, Cipher c):
      call(public int Cipher.doFinal(byte[], int, int, byte[])) &&
      args(plainText, offset, len, cipherText) &&
      target(c) {
         if (PredicateStore.instance().validateAbsent(Property.MACED, plainText) == PredicateVerdict.VIOLATED) {
             ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "CipherSpec", "" + __LOC,
                 "v=1 code=CIPHER-CONSTR-01 ev=" + __EVENTNAME + " obj=Cipher val='macced' exp='not macced' msg='the plaintext given to doFinal was already authenticated by a Mac'"));
         }
         finalCipherText = cipherText;
         finalPlainText = plainText;
    }

    event f6 after(byte[] plainText, int offset, int len, byte[] cipherText, int cipherOffset, Cipher c):
      call(public int Cipher.doFinal(byte[], int, int, byte[], int)) &&
      args(plainText, offset, len, cipherText, cipherOffset) &&
      target(c) {
        if (PredicateStore.instance().validateAbsent(Property.MACED, plainText) == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "CipherSpec", "" + __LOC,
                "v=1 code=CIPHER-CONSTR-02 ev=" + __EVENTNAME + " obj=Cipher val='macced' exp='not macced' msg='the plaintext given to doFinal was already authenticated by a Mac'"));
        }
        finalCipherText = cipherText;
        finalPlainText = plainText;
    }

    event f7 after(ByteBuffer plainTextBuffer, ByteBuffer cipherTextBuffer, Cipher c):
       call(public int Cipher.doFinal(ByteBuffer, ByteBuffer)) &&
       args(plainTextBuffer, cipherTextBuffer) &&
       target(c) {
         finalCipherText = cipherTextBuffer;
         finalPlainText = plainTextBuffer;
    }

   // Two transitions both oracles license, added over events that already exist -- the `fsm`
   // gains no event and the 17-event ceiling is untouched, which corrects the remark of
   // conformance_record.csv item (e) that repairing this "would need new events".
   //
   // `s3` had no `update` loop, so `init; update; update` failed where api30's `updates+`
   // (Cipher.cryptsl:117) and the expert's `Update+` (Cipher.crysl:85) both admit it. `s2` had
   // no `init` loop, so `init; init` failed where both state `Inits+`/`Init+`.
   //
   // What is deliberately NOT here is a re-`init` at `end` -- the "reused Cipher". Neither
   // ORDER returns from the finals group to `Inits`, so that transition would make this
   // specification more permissive than both oracles; it was refused as a conformance repair
   // by the researcher's decision of 2026-08-25 and would need a divergence row of its own if
   // it is ever wanted as a project decision.
   fsm :
     start [
        g3 -> unsafeAlg
        g1 -> s1
        g2 -> s1
     ]
     unsafeAlg [
        g3 -> unsafeAlg
        g1 -> s1
        g2 -> s1
     ]
     s1 [
       i1 -> s2
       i2 -> s2
     ]
     s2 [
       i1   -> s2
       i2   -> s2
       wkb1 -> end
       f2   -> end
       f5   -> end
       f6   -> end
       f7   -> end
       u1   -> s3
       u2   -> s3
       u3   -> s3
       u4   -> s3
       u5   -> s3
     ]
     s3 [
       u1 -> s3
       u2 -> s3
       u3 -> s3
       u4 -> s3
       u5 -> s3
       f1 -> end
       f2 -> end
       f3 -> end
       f5 -> end
       f6 -> end
       f7 -> end
     ]
     end [
        wkb1 -> end
        f2   -> end
        f5   -> end
        f6   -> end
        f7   -> end
        u1   -> s3
        u2   -> s3
        u3   -> s3
        u4   -> s3
        u5   -> s3
     ]

   alias match1 = end
   // The acceptance point of `encrypted[pre_ciphertext, pre_plaintext] after updates`
   // (Cipher.cryptsl:189). An `after L` clause is ensured at the states L leads to,
   // which for this automaton is s3, and that is as much an acceptance point as the
   // accepting state is for the two unqualified clauses (INV-INS-134).
   alias match2 = s3

   @fail {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "CipherSpec", "" + __LOC,
            "v=1 code=CIPHER-ORDER-00 ev=" + __EVENTNAME + " obj=Cipher val='' exp='' msg='the observed call sequence is not one CipherSpec accepts'"));
        updatedCipherText = null;
        updatedPlainText = null;
        finalCipherText = null;
        finalPlainText = null;
	    __RESET;
   }

   @match1 {
        if (finalCipherText != null) {
            PredicateStore.instance().ensure(Property.ENCRYPTED, finalCipherText, finalPlainText);
            finalCipherText = null;
            finalPlainText = null;
        }
   }

   @match2 {
        if (updatedCipherText != null) {
            PredicateStore.instance().ensure(Property.ENCRYPTED, updatedCipherText, updatedPlainText);
            updatedCipherText = null;
            updatedPlainText = null;
        }
   }
}
