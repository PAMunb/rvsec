package mop;

import java.io.InputStream;
import java.security.Key;
import java.security.KeyStore;
import java.security.PrivateKey;
import java.security.KeyStore.ProtectionParameter;
import java.security.KeyStore.Entry;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * KeyStoreSpec
 *
 * Monitors java.security.KeyStore against the CrySL rule KeyStore.crysl.
 *
 * The rule's ORDER is `Get, Load, ((GetEntry?, GetKey) | (SetEntry, Store))*`: a store is
 * obtained from `getInstance`, loaded, and then either read -- an optional `getEntry` followed by
 * `getKey` -- or written -- `setEntry` followed by `store` -- any number of times. Of its five
 * CONSTRAINTS clauses this specification enforces one, `type in {"JCEKS", "JKS", "DKS", "PKCS11",
 * "PKCS12"}`, over the type the store reports. The rule states no REQUIRES. Of its four ENSURES
 * clauses three are written: `generatedKeyStore[this] after Load` over the store, and
 * `generatedKey[key, _]` and `generatedPrivkey[key]` over the key `getKey` returned.
 *
 * Divergences from the rule and reach limits of this monitor:
 *
 * - The three `neverTypeOf[..., java.lang.String]` clauses and `notHardCoded[passwordIn]` are not
 *   checked. All four constrain the expression that produced a `char[]`, and an event body sees
 *   the array and not the expression that built it.
 * - The admitted-type list carries entries beyond the rule's clause and entries the platform does
 *   not offer; the list's own comment states what each does at run time.
 * - The type is accused at `getKey` and nowhere else, so a store obtained for a refused type and
 *   only written to is reported through the creation-refused ordering code alone.
 * - `generatedKey[key, _]` leaves its second place anonymous in the rule and is written here with
 *   the key's own algorithm, because the store compares whole value tuples and has no wildcard;
 *   the write site states what that costs and what it buys.
 * - `generatedPubkey[key]` has no site. `getKey` returns a secret or a private key and never a
 *   `PublicKey` -- a certificate's public half comes out of `getCertificate`, a call this
 *   specification does not observe -- so a write for it would have no execution path.
 * - The automaton admits a refused creation as a prefix and admits the whole accepted sequence
 *   repeatedly, neither of which the rule's ORDER has; the expression's own comment says what
 *   each is for.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/KeyStore.crysl
 */
// The declared parameter is the name every event of this file binds -- `returning(KeyStore k)`
// at the four `getInstance` events and `target(k)` at the other five. That is what makes the
// specification parametric: the generator indexes one monitor per key store. Declaring a name
// no event binds does not make the file non-parametric in any way the reader can see, and it
// does not fail to compile either -- it silently yields one process-wide monitor, on which a
// second `getInstance` before the first `load` is a wrong call sequence. The name has to agree
// with the events; it is not cosmetic.
KeyStoreSpec(KeyStore k) {
    // The envelope's quoting rule: a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    // The admitted-type list. Its first five entries are the CONSTRAINTS clause of
    // KeyStore.crysl word for word: `type in {"JCEKS", "JKS", "DKS", "PKCS11", "PKCS12"}`.
    //
    // A value spelled otherwise can still reach an entry: every comparison goes through
    // `ConscryptAliasTable.matches`, which folds case and resolves the alias rows the table
    // carries for the service it is called with. For `KeyStore` the table carries no rows -- the
    // Android store types are registered by providers that file does not transcribe -- so here
    // the comparison is case folding alone, and `pkcs12` reaches the entry `PKCS12`.
    //
    // What the entries do at run time, stated as behaviour:
    //
    // `JCEKS`, `JKS`, `DKS` and `PKCS11` are entries of the rule's clause that this platform does
    // not offer. No provider here registers them, so `KeyStore.getInstance` cannot return a store
    // of one of those types and no program running here can present them to this check; they are
    // inert, and they stay because they are entries of the rule's clause.
    //
    // `AndroidKeyStore`, `AndroidCAStore`, `BKS` and `BouncyCastle` go beyond the rule's clause,
    // and what the code admits with them is the key storage the platform itself provides and
    // recommends: `AndroidKeyStore` is the hardware-backed store an application is told to keep
    // its keys in, `AndroidCAStore` is the platform's certificate store, and `BKS` and
    // `BouncyCastle` are the file-backed store types its bundled provider registers. The rule's
    // list names none of them, because it is written for the types a JSE installation offers, so
    // enforcing that list alone would accuse a program for using the platform's own key storage.
    List<String> types = Arrays.asList("JCEKS", "JKS", "DKS", "PKCS11", "PKCS12",
        "AndroidKeyStore", "AndroidCAStore", "BKS", "BouncyCastle");

    // The two staged values the acceptance-point handler consumes. A handler sees no
    // event parameter, so a write about a value only the event knows has to travel in a
    // field, and each is cleared the moment it is used or the sequence is rejected -- a
    // value the automaton refused must not be carried into the next accepting state.
    KeyStore loadedKeyStore = null;

    Key generatedKey = null;

    // Set by the four creation events, `g1` to `g4`, the refused `g2` and `g4` included, and
    // never cleared: the generated `reset()` restores the automaton state and leaves this
    // field, so the fact survives a failure. `@fail` reads it to report a store whose creation
    // no event of this specification observed under `KEYSTORE-ORDER-01`
    // (`creation-unobserved`) instead of the wrong-sequence code. A `getInstance` of a type
    // the rule refuses runs `g2` (one argument) or `g4` (two arguments), so a store created in
    // woven code is never counted as unobserved.
    boolean creationObserved = false;

    // Set by the refused creation events `g2` and `g4`, and never cleared, for the same reason
    // as `creationObserved`. `@fail` reads it after `creationObserved` to report the failure of
    // a store whose type the rule refused under `KEYSTORE-ORDER-02` (`creation-refused`). The
    // type is accused only at `gk1`, so for a refused store never read by `getKey` this code
    // is the only report the store draws.
    boolean creationRefused = false;

    // `Get` of KeyStore.crysl: `g1: getInstance(type);`, the one-argument overload, one
    // alternative of `Get := g1 | g2`. The guard is the CONSTRAINTS clause
    // `type in {"JCEKS", "JKS", "DKS", "PKCS11", "PKCS12"}` as this file admits it, read through
    // `ConscryptAliasTable.matches`, so the requested type reaches an entry under case folding.
    //
    // The guard governs the transition: only a store whose type the list admits reaches the
    // state where `load` is declared, and a refused type takes the twin `g2` below. The body
    // only records that a creation was observed, which `@fail` reads to tell a store this
    // monitor saw created from one created where it cannot see. The accusation about the type
    // itself is not made here; it lives in the `gk1` body, over the type the store reports.
    event g1 after(String ksType) returning(KeyStore k):
      call(public static KeyStore KeyStore.getInstance(String))
      && args(ksType)
      && condition(ConscryptAliasTable.matches("KeyStore", ksType, types)) {
        creationObserved = true;
      }

    // The refused twin of `g1`: the one-argument `getInstance` pointcut under the negated guard.
    // A false `condition(...)` runs no body, so without this event a store asked for a refused
    // type would match no event at all, and its first use would read `creation-unobserved`
    // although its creation ran in woven code.
    //
    // The body only records the creation; it reports nothing and writes no field another event
    // reads. In the expression below a refused creation is a prefix, so the store's first use
    // fails exactly where it fails for a store no event saw, and the difference is the code
    // `@fail` chooses -- `creation-refused`.
    event g2 after(String ksType) returning(KeyStore k):
      call(public static KeyStore KeyStore.getInstance(String))
      && args(ksType)
      && condition(!ConscryptAliasTable.matches("KeyStore", ksType, types))  {
        creationObserved = true;
        creationRefused = true;
      }

    // `Get` of KeyStore.crysl: `g2: getInstance(type, _);`, the overload that also names a
    // provider. With this event and its refused twin `g4` the file declares nine events, within
    // the ceiling of seventeen the monitor generator admits.
    //
    // `Object+` covers the platform's `(String, String)` and `(String, Provider)` shapes in one
    // pointcut. Its other two overloads, `getInstance(File, char[])` and
    // `getInstance(File, KeyStore$LoadStoreParameter)`, open on a file rather than on a type
    // name: they are a creation this rule does not name, and they do not fit this pointcut
    // either, whose first position is declared `String`. The second position is `Object+` and not
    // `..` on purpose -- a matcher resolves a pointcut by walking the declared parameter types of
    // the call and stops at the first wildcard, so a wildcard here would widen the pointcut past
    // the two shapes it is meant to cover.
    //
    // It carries `g1`'s guard and takes `g1`'s place in the expression below as an alternative
    // rather than a second prefix. A store obtained for a refused type through this overload runs
    // `g4` instead, and the type accusation stays where it lives, in the `gk1` body.
    event g3 after(String ksType, Object provider) returning(KeyStore k):
      call(public static KeyStore KeyStore.getInstance(String, Object+))
      && args(ksType, provider)
      && condition(ConscryptAliasTable.matches("KeyStore", ksType, types)) {
        creationObserved = true;
      }

    // The refused twin of `g3`: the same two-argument pointcut under the negated guard, the
    // two-argument half of what `g2` is for the one-argument overload. Without it a type the
    // rule refuses, requested with a provider, runs no body, and the store's failure would read
    // `creation-unobserved` although its creation ran in woven code.
    //
    // The body only records the creation. It does not report and writes no field another event
    // reads: the prefix `(g2 | g4)*` sends the store's first use to `@fail` exactly as a store
    // no event saw would go, so no reported site changes and only the handler's code does.
    event g4 after(String ksType, Object provider) returning(KeyStore k):
      call(public static KeyStore KeyStore.getInstance(String, Object+))
      && args(ksType, provider)
      && condition(!ConscryptAliasTable.matches("KeyStore", ksType, types)) {
        creationObserved = true;
        creationRefused = true;
      }

    // `Load` of KeyStore.crysl: `l1: load(fileInput, passwordIn);` and `l2: load(paramLoad);`,
    // joined by `Load := l1 | l2` and realised here as one event. The `..` covers both
    // signatures, and neither argument is bound: the rule's clauses over the password are the
    // two this specification does not check, and the one clause the event does carry binds
    // `this`.
    //
    // The body stages the store for the acceptance-point handler, which is where
    // `generatedKeyStore[this] after Load` is written. The value travels in a field because a
    // handler receives no event arguments and runs after the transition has been decided, so a
    // store whose `load` the automaton refuses is never marked.
    event load before(KeyStore k):
      call(public void KeyStore.load(..))
      && target(k) {
        loadedKeyStore = k;
      }

    // `Store` of KeyStore.crysl: `s1: store(paramStore);` and `s2: store(fileOutput,
    // passwordOut);`, joined by `Store := s1 | s2` and realised here as one event, the `..`
    // covering both signatures. It exists for the ORDER alone -- it closes the rule's
    // `(SetEntry, Store)` alternative -- and its body is empty because the rule states no clause
    // over it: no value of this call is constrained and no predicate is written or read here.
    // The state it leads to accepts, and the handler there writes nothing for this event,
    // because it stages nothing.
    event store before(KeyStore k):
      call(public void KeyStore.store(..))
      && target(k) { }

    // `GetEntry` of KeyStore.crysl: `ge1: getEntry(aliasGet, protParamGet);`. It exists for the
    // ORDER alone -- the optional read that may precede `getKey` -- and its body is empty
    // because the rule states no clause over it. The arguments the rule names are not bound,
    // since no clause of the rule reads them.
    event ge1 before(KeyStore k):
      call(public Entry KeyStore.getEntry(String, ProtectionParameter))
      && target(k) { }

    // `SetEntry` of KeyStore.crysl: `se1: setEntry(aliasSet, entry, protParamSet);`. It exists
    // for the ORDER alone -- the write that the rule requires to be followed by a `store` -- and
    // its body is empty because the rule states no clause over it. The key an application puts
    // in here carries no mark out of this specification; the mark is written over the key
    // `getKey` returns, which is a different object.
    event se1 before(KeyStore k):
      call(public void KeyStore.setEntry(String, Entry, ProtectionParameter))
      && target(k) { }

    // `GetKey` of KeyStore.crysl: `gk1: key = getKey(alias, passwordKey);`, the only event of
    // this file that both accuses and produces.
    //
    // CONSTRAINTS of KeyStore.crysl: `type in {"JCEKS", "JKS", "DKS", "PKCS11", "PKCS12"}`,
    // checked here over the type the store reports, against the list this file admits. The check
    // sits in the event body rather than in a `condition(...)` guard: a guard compiles to an
    // early return ahead of both the body and the transition, so a store of a refused type would
    // leave the automaton in the state before `getKey` and the next call on it would be reported
    // as a wrong call sequence instead of as the refused store type it is. A type outside the
    // list is reported under the code registered in `codes.csv` for this site.
    //
    // This is the only site that accuses a type, which is a reach limit worth stating: a store
    // obtained for a refused type and then only written to -- `setEntry` and `store` -- passes
    // through this specification without a type accusation, and draws the creation-refused
    // ordering code alone.
    //
    // The body then stages the returned key for the acceptance-point handler, where the two key
    // predicates are written. The key travels in a field because a handler receives no event
    // arguments and runs after the transition has been decided.
    event gk1 after(KeyStore k) returning(Key key):
      call(public Key KeyStore.getKey(String, char[]))
      && target(k) {
        if (!ConscryptAliasTable.matches("KeyStore", k.getType(), types)) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidKeyStoreType, "KeyStoreSpec", "" + __LOC,
                "v=1 code=KEYSTORE-KSTYPE-00 ev=" + __EVENTNAME + " obj=KeyStore val='" + q(k.getType()) + "' exp='" + q(String.join(",", types)) + "' msg='expecting one of " + String.join(",", types) + " but found " + k.getType() + "'"));
        }
        generatedKey = key;
    }

    // The rule's ORDER, `Get, Load, ((GetEntry?, GetKey) | (SetEntry, Store))*`, with two
    // additions this file makes and the rule does not have.
    //
    // `(g2 | g4)*` is the refused-creation prefix: a `getInstance` for a type the list refuses
    // matches an event, so the creation is recorded, and the store's first real use then fails
    // just as it would for a store no event saw -- what differs is the code `@fail` chooses. The
    // trailing `+` lets one monitor take a whole accepted sequence again, so a program that
    // obtains and loads a store more than once is not accused of an ordering the rule's `Get,
    // Load` prefix would refuse on the second round.
    //
    // Everything inside is the rule: `(g1 | g3)` is `Get`, `load` is `Load`, `((ge1 gk1) | gk1)`
    // is `GetEntry?, GetKey`, and `(se1 store)` is `SetEntry, Store`.
    ere : ((g2 | g4)* (g1 | g3) load (((ge1 gk1) | gk1) | (se1 store))*)+

    // A monitor that never observed a `getInstance` reports every failure as
    // `creation-unobserved`: the store was created where this monitor cannot see. A monitor
    // whose creation was a refused one reports every failure as `creation-refused`. Both fields
    // survive the reset, which restores the automaton state and leaves user fields alone. The
    // staged values do not survive it: a store or a key the automaton refused must not be
    // carried into the next accepting state, so both are cleared here.
    @fail {
        if (!creationObserved) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyStoreSpec", "" + __LOC,
                "v=1 code=KEYSTORE-ORDER-01 ev=" + __EVENTNAME + " obj=KeyStore val='' exp='' msg='the observed call sequence is not one KeyStoreSpec accepts and no creation of the store was observed'"));
        }
        else if (creationRefused) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyStoreSpec", "" + __LOC,
                "v=1 code=KEYSTORE-ORDER-02 ev=" + __EVENTNAME + " obj=KeyStore val='' exp='' msg='the observed call sequence is not one KeyStoreSpec accepts, after a creation the specification refused'"));
        }
        else {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyStoreSpec", "" + __LOC,
                "v=1 code=KEYSTORE-ORDER-00 ev=" + __EVENTNAME + " obj=KeyStore val='' exp='' msg='the observed call sequence is not one KeyStoreSpec accepts'"));
        }
        loadedKeyStore = null;
        generatedKey = null;

        __RESET;
    }

    // The acceptance point of every write this specification makes. In a specification written
    // as an `ere`, the `@match` handler fires whenever the trace so far is a word of the
    // expression, so it is the accepting state: that is where a clause carrying no `after L`
    // belongs, and here it is also the state `load` leads to, so the clause that does carry
    // `after Load` lands on the same handler.
    //
    // Both values travel in fields because a handler receives no event arguments and runs after
    // the transition has been decided. `store` reaches this state as well and stages nothing,
    // which is why each write is guarded by its own staged value rather than by the handler
    // being reached at all.
    //
    // ENSURES of KeyStore.crysl: `generatedKeyStore[this] after Load;`. The predicate says that
    // the `KeyStore` was loaded by a call the instrumentation observed. The clause binds `this`,
    // the store `load` was called on, so the staged object is that event's own target and not a
    // store bound at `getInstance`; the only routes that reach this handler are an admitted
    // creation followed by a `load`, on which the two are the same object anyway. Four
    // specifications read this mark -- `KeyManagerFactorySpec` and `TrustManagerFactorySpec` at
    // their `init`, `PKIXParametersSpec` and `PKIXBuilderParametersSpec` at their key-store
    // constructor -- and all four report a store carrying no mark as one whose loading was not
    // observed.
    //
    // ENSURES of KeyStore.crysl: `generatedKey[key, _];`. The predicate says that the key was
    // produced by a call the instrumentation observed, for the algorithm recorded with it. The
    // rule leaves the second place anonymous -- a key store produces a key, and the rule states
    // nothing about which algorithm -- and this site writes the one value it has, the key's own
    // `getAlgorithm()`.
    //
    // That departure is what the store's comparison makes necessary, stated as behaviour.
    // `PredicateStore` has no wildcard: a write compares as the whole tuple it recorded. Writing
    // at arity one would record the empty tuple, and the sites that read this predicate naming
    // the algorithm -- `CipherSpec` at its `init`, `SecretKeySpec` and `KeySpec` at their
    // `getEncoded` -- would then find the entry, fail to match the tuple and answer VIOLATED for
    // every key that came out of a key store. A read that follows the rule's `_` literally is
    // served by `validateAny`, which asks only whether the object carries the predicate at all,
    // and that answers SATISFIED against the write as it stands.
    //
    // What the extra value could cost is a program that hands a key store's key to a `Cipher` of
    // another algorithm, and the platform refuses exactly that: an HmacSHA256 key passed to
    // `AES/CBC/PKCS5Padding` raises `InvalidKeyException: Wrong algorithm: AES or Rijndael
    // required`, a DESede key the same, an RSA private key `No installed provider supports this
    // key`, and an AES key passed to `RSA/ECB/PKCS1Padding` likewise. So no execution
    // distinguishes the anonymous second place from the concrete one.
    //
    // The write has to be here and cannot be inherited from whatever put the key in:
    // `KeyStore.getKey` returns a fresh key object rather than the one `setKeyEntry` was given
    // -- for a PKCS12 store, a new `javax.crypto.spec.SecretKeySpec` over the same material --
    // and the store compares bound objects by identity, so no mark travels through a key store.
    //
    // ENSURES of KeyStore.crysl: `generatedPrivkey[key];`. The predicate says that the private
    // key was produced by a call the instrumentation observed. The write is guarded by the
    // runtime type because `getKey` returns a secret key or a private key, and the guard is what
    // keeps a secret key from answering the private-key clause that `SignatureSpec` reads at
    // `initSign` and `KeyPairSpec` reads at its constructor.
    //
    // ENSURES of KeyStore.crysl: `generatedPubkey[key];`. Stated as behaviour: this clause has
    // no site. `getKey` never returns a `PublicKey` -- a certificate's public half comes out of
    // `getCertificate`, a call this specification does not observe -- so a write for it would
    // have no execution path.
    @match {
       if (loadedKeyStore != null) {
           PredicateStore.instance().ensure(Property.GENERATED_KEY_STORE, loadedKeyStore);
           loadedKeyStore = null;
       }
       if (generatedKey != null) {
           PredicateStore.instance().ensure(Property.GENERATED_KEY, generatedKey, generatedKey.getAlgorithm());
           if (generatedKey instanceof PrivateKey) {
               PredicateStore.instance().ensure(Property.GENERATED_PRIVATE_KEY, generatedKey);
           }
           generatedKey = null;
       }
    }
}