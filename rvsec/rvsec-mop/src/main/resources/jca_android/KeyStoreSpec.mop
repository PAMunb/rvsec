package mop;

import java.io.InputStream;
import java.security.Key;
import java.security.KeyStore;
import java.security.PrivateKey;
import java.security.KeyStore.ProtectionParameter;
import java.security.KeyStore.Entry;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * KeyStoreSpec
 *
 * A JavaMOP specification of the correct usage of the
 * java.security.KeyStore class.
 *
 * https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/KeyStore.crysl
 */
// The declared parameter is the name every event of this file binds -- `returning(KeyStore k)`
// at the two `getInstance` events and `target(k)` at the other five. That is what makes the
// specification parametric: the generator indexes one monitor per key store. Declaring a name
// no event binds does not make the file non-parametric in any way the reader can see, and it
// does not fail to compile either -- it silently yields one process-wide monitor, on which a
// second `getInstance` before the first `load` is a wrong call sequence. The name has to agree
// with the events; it is not cosmetic.
KeyStoreSpec(KeyStore k) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    // D-15: the five types of KeyStore.crysl, plus the four platform-value entries -- the
    // expert list is JSE-only and names no Android store, so rejecting them would accuse the
    // stores the platform itself documents. Each of the four carries a citation in
    // divergence_record.csv; a candidate without one is dropped and stays accused. The four
    // JSE types Android does not offer stay in the list, inert (no-narrowing rule).
    List<String> types = Arrays.asList("JCEKS", "JKS", "DKS", "PKCS11", "PKCS12",
        "AndroidKeyStore", "AndroidCAStore", "BKS", "BouncyCastle");

    // The two staged values the acceptance-point handler consumes. A handler sees no
    // event parameter, so a write about a value only the event knows has to travel in a
    // field, and each is cleared the moment it is used or the sequence is rejected -- a
    // value the automaton refused must not be carried into the next accepting state.
    KeyStore loadedKeyStore = null;

    Key generatedKey = null;

    event g1 after(String ksType) returning(KeyStore k):
      call(public static KeyStore KeyStore.getInstance(String))
      && args(ksType)
      && condition(ConscryptAliasTable.matches("KeyStore", ksType, types)) {
      }

    event g2 after(String ksType) returning(KeyStore k):
      call(public static KeyStore KeyStore.getInstance(String))
      && args(ksType)
      && condition(!ConscryptAliasTable.matches("KeyStore", ksType, types))  {
      }

    // The only one of the five specifications this repair reaches that had no two-argument
    // `getInstance` at all, so this is the one event it costs -- the file goes from 7 to 8 of
    // the 17 the ceiling allows, and stays under it.
    //
    // `Object+` covers `(String, String)` and `(String, Provider)` in one pointcut, both
    // confirmed on android-30 by `javap`. The platform's other two overloads,
    // `getInstance(File, char[])` and `getInstance(File, KeyStore$LoadStoreParameter)`, open on
    // a file rather than on a type name; they are a `Gets` this rule does not name, and they do
    // not fit this pointcut either, whose first position is declared `String`. It is `Object+`
    // and not `..` on purpose: the trace harness's resolver walks the declared parameter types
    // of a `call(...)` signature and stops at the first wildcard (KeyManagerFactorySpec.mop:87-90).
    // Precedent: `KeyGeneratorSpec.g2`.
    //
    // It carries `g1`'s guard and not `g2`'s, and takes `g1`'s place in the `ere` as an
    // alternative rather than a second prefix. That is the shape `KeyGeneratorSpec` already
    // has -- there the negated twin `g3` is declared over the one-argument form only -- so a
    // store built for a type the rule rejects through the two-argument overload keeps whatever
    // this file did with it before the overload was pointcut at all, and the type accusation
    // stays where it lives, in `gk1`'s body.
    event g3 after(String ksType, Object provider) returning(KeyStore k):
      call(public static KeyStore KeyStore.getInstance(String, Object+))
      && args(ksType, provider)
      && condition(ConscryptAliasTable.matches("KeyStore", ksType, types)) {
      }

    event load before(KeyStore k):
      call(public void KeyStore.load(..))
      && target(k) {
        loadedKeyStore = k;
      }

    event store before(KeyStore k):
      call(public void KeyStore.store(..))
      && target(k) { }

    event ge1 before(KeyStore k):
      call(public Entry KeyStore.getEntry(String, ProtectionParameter))
      && target(k) { }

    event se1 before(KeyStore k):
      call(public void KeyStore.setEntry(String, Entry, ProtectionParameter))
      && target(k) { }

    event gk1 after(KeyStore k) returning(Key key):
      call(public Key KeyStore.getKey(String, char[]))
      && target(k) {
        if (!ConscryptAliasTable.matches("KeyStore", k.getType(), types)) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidKeyStoreType, "KeyStoreSpec", "" + __LOC,
                "v=1 code=KEYSTORE-KSTYPE-00 ev=" + __EVENTNAME + " obj=KeyStore val='" + q(k.getType()) + "' exp='" + q(String.join(",", types)) + "' msg='expecting one of " + String.join(",", types) + " but found " + k.getType() + "'"));
        }
        generatedKey = key;
    }

    ere : (g2* (g1 | g3) load (((ge1 gk1) | gk1) | (se1 store))*)+

    @fail {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyStoreSpec", "" + __LOC,
            "v=1 code=KEYSTORE-ORDER-00 ev=" + __EVENTNAME + " obj=KeyStore val='' exp='' msg='the observed call sequence is not one KeyStoreSpec accepts'"));
        loadedKeyStore = null;
        generatedKey = null;

        __RESET;
    }

    // The acceptance point of both of this rule's writes, and for `generatedKeyStore`
    // the two routes INV-INS-134 admits are the same handler: the clause carries
    // `after Loads`, and read off the generated monitor the transition row for `load` is
    // {5, 5, 5, 2, 5, 5} while the match category is `Prop_1_state == 2` -- the state the
    // load leads to and the accepting state are one state. `generatedKey[key, _]` carries
    // no `after`, so its acceptance point is the accepting state itself, which `gk1`
    // reaches by the row {5, 5, 2, 5, 2, 5}.
    //
    // The clause binds `this`, the key store the load was called on, so the staged object
    // is the event's own target and not a field bound at `getInstance`. Measured, the two
    // never differ where it matters: the only route that reaches this handler is
    // `g1 load`, on which they are the same object, and a store built through `g2` -- a
    // type the rule's CONSTRAINTS reject -- sends `load` to `fail` and never arrives here.
    //
    // `store` also reaches this state and stages nothing, which is why each write is
    // guarded by its own staged value rather than by the handler being reached.
    //
    // `generatedKeyStore[this]` is one-place in the rule and one-place here.
    // `generatedKey[key, _]` is two-place, and its second place is the oracle's anonymous
    // variable: the rule says a key store produces a key and states nothing about which
    // algorithm. The store has no wildcard -- `validate` compares the value tuple -- so
    // this site writes the one value it has, the key's own algorithm, and the departure
    // from `_` is recorded rather than hidden (researcher decision, 2026-08-22).
    //
    // What licenses the departure is a measurement, not a convenience. The two would
    // differ only for a program that hands a key store's key to a Cipher of another
    // algorithm, and the JCA refuses exactly that: measured on Temurin 21, an HmacSHA256
    // key into `AES/CBC/PKCS5Padding` raises `InvalidKeyException: Wrong algorithm: AES
    // or Rijndael required`, a DESede key the same, an RSA private key `No installed
    // provider supports this key`, and an AES key into `RSA/ECB/PKCS1Padding` likewise.
    // So no execution distinguishes the anonymous second place from the concrete one,
    // and writing the concrete one costs a substrate change the set would carry for a
    // single site.
    //
    // Measured too: `KeyStore.getKey` returns a *fresh* key object, not the one
    // `setKeyEntry` was given -- on PKCS12 a new `javax.crypto.spec.SecretKeySpec` over
    // the same material -- so an identity-keyed store cannot carry a predicate through a
    // key store at all. This write is the only thing that marks the key that comes out,
    // which is why it is here and not inherited from the producer that put it in.
    //
    // `generatedPrivkey[key]` (KeyStore.crysl:61) is the rule's third ENSURES and had
    // no site in this set. It gains one here, guarded by the type: `getKey` returns a
    // `SecretKey` or a `PrivateKey` and the guard is what keeps a secret key from
    // answering the private-key clause of `Signature.initSign` (task 5.7) and of the
    // `KeyPair` constructor. The rule's fourth, `generatedPubkey[key]` (:101), gains no
    // site: `getKey` never returns a `PublicKey` -- a certificate's public half comes out
    // of `getCertificate`, a call this specification does not observe -- so a write here
    // would have no execution path, which decision 19 records rather than writes.
    @match {
       if (loadedKeyStore != null) {
           PredicateStore.instance().ensure(Property.GENERATED_KEY_STORE, loadedKeyStore);
           loadedKeyStore = null;
       }
       if (generatedKey != null) {
           PredicateStore.instance().ensure(Property.GENERATED_KEY, generatedKey, generatedKey.getAlgorithm());
           if (generatedKey instanceof PrivateKey) {
               PredicateStore.instance().ensure(Property.GENERATED_PRIVATE_KEY, generatedKey);
           }
           generatedKey = null;
       }
    }
}