package mop;

import java.security.AlgorithmParameters;
import java.security.Key;
import java.security.cert.Certificate;
import java.security.SecureRandom;
import java.security.spec.AlgorithmParameterSpec;
import java.util.Arrays;
import java.util.List;
import javax.crypto.Cipher;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
// The static form, and bare calls below. The generator merges every specification of the set
// into one monitor and dedupes imports by class name, keeping the first: if this file and
// CipherSpec.mop import the same class in different forms, one of them loses and the monitor
// does not compile. Both name it statically (task 11.3/11.9; caught by the harness, which is
// the only instrument in the set that compiles what the gates only read as text).
import static br.unb.cic.mop.jca.util.CipherTransformationUtil.*;

// The normaliser is named in full and imported plainly, where the frozen
// `CipherTransformationUtil` above is imported statically. That is not inconsistency: the two
// classes declare methods of the same names, so a second static-* import would make every bare
// `mode(...)` and `isValid(...)` of the merged monitor ambiguous and the monitor would not
// compile. Naming this one at each call site is also what tells a reader which of the two a
// given line asks -- and there are lines of both kinds in these files, on purpose.
import br.unb.cic.mop.jca.util.CipherTransformationNormalizer;

/**
 * IvChainJunctionSpec
 *
 * The three REQUIRES clauses of the oracle's `Cipher` whose argument `CipherSpec` cannot
 * bind, each read here against the store:
 *
 *   #9  `mode(transformation) in {CBC, PCBC, CTR, CTS, CFB, OFB} && encmode == 1
 *        => preparedIV[paramSpec]`  (Cipher.crysl:138, task 5.1)
 *   #10 `mode(transformation) in {GCM} => preparedGCM[paramSpec]`
 *                                  (Cipher.crysl:139, task 5.8)
 *   #6  `randomized[random]`      (Cipher.crysl:135, task 5.5, one site per overload)
 *   #8  `!macced[_, plainText]`   (Cipher.crysl:137, task 5.7, the two `doFinal`
 *                                  overloads `CipherSpec.f2` merges without binding)
 *
 * The name is the one task 5.1 gave the file when it held only the IV chain, and it is
 * kept deliberately now that it holds three clauses over two of `Cipher.init`'s
 * arguments. Renaming would rewrite three committed traces, the published harness
 * report `data/gh105/evidence/harness/f2-IvChainJunctionSpec.md` and the evidence of
 * task 5.1 -- twenty-three files, several of them measurements already published --
 * and a file name is not what those measurements are about (researcher decision,
 * 2026-08-22). What the file is, is stated here.
 *
 * This file exists because `CipherSpec` cannot hold the reads. The clause binds
 * `params`, and `CipherSpec.i2` is declared `call(public void Cipher.init(int, Key, ..))
 * && args(mode, key, ..)` -- one event standing for the rule's i3 to i8, which does not
 * bind the third argument. Narrowing `i2` to bind it would drop the two-argument
 * initialisations out of the automaton, and adding an event is not available either:
 * `CipherSpec` declares exactly 17, which is the generator's ceiling (INV-INS-145,
 * n=18 raises StackOverflowError in the enable-set parser at any heap). A separate
 * specification is the only site left where the third and fourth arguments can be
 * bound.
 *
 * It is not a chain junction in the sense of INV-INS-136, and the name is kept because
 * the chain may yet become one. Mechanism B carries identity through the runtime's own
 * parametric slicing, which is worth its cost when the chain's links are otherwise
 * unobservable -- but this chain's first link is already carried by the store: task 4.4
 * put `randomized[iv]` (clause #12) in `IvParameterSpec.c1/c2` and task 4.5 put its
 * producer in `SecureRandomSpec.@match2`. A junction over `gen`/`mk` here would be a
 * second accuser of a clause that already has one, which the ledger forbids. So this
 * file wires the one link that has no reader, and clause #12 stays where Group 4 put it.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/Cipher.crysl
 */
IvChainJunctionSpec(Cipher c) {

    // `mode(transformation) in {...}` of the clause's antecedent, transcribed
    // from Cipher.crysl:138. It is a list here and not a call into
    // Api30CipherTransformationUtil because that class answers a different question:
    // whether the whole transformation is one the rule admits. This clause asks only
    // which mode was named, and admits modes the CONSTRAINTS may reject -- an
    // unsupported mode is a separate report from `CipherSpec`, not a reason to stop
    // requiring an IV.
    List<String> ivModes = Arrays.asList("CBC", "CTS", "CTR", "CFB", "PCBC", "OFB");

    String expectedPreparedIv = "an IvParameterSpec built over an observed randomized iv";

    String expectedPreparedGcm = "a GCMParameterSpec built over an observed randomized source";

    String expectedRandomGen = "a SecureRandom this instrumentation observed being constructed";

    String expectedUnmacced = "a plaintext no observed Mac has authenticated";

    // The envelope's quoting rule (gh104 design D-3), the same three lines every
    // reporting specification of the set carries.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    // The clause is an implication, so the antecedent decides whether anything is
    // required at all, and it is evaluated in the body before the read (INV-INS-133,
    // design D-4: the 8 guarded clauses evaluate their guard in the body). A false
    // antecedent must leave no trace -- not a silent verdict, not a suppressed
    // transition -- because the rule asks nothing of `params` there.
    //
    // `part(1,"/",transformation)` is read off `c.getAlgorithm()`, which returns the
    // transformation string `getInstance` was given, verbatim. Two things make that
    // safe to split: `getInstance` rejects a malformed transformation before any
    // Cipher exists (`Cipher.getInstance("AES/")` raises NoSuchAlgorithmException,
    // "Invalid transformation format"), so what reaches `init` was already accepted;
    // and the advice is `before`, on an object `getInstance` returned. The comparison
    // folds case because the rule's own value comparisons do.
    //
    // The read is three-valued and the two accusing outcomes carry different codes,
    // as they do at the thirteen other reads of the set. What differs here is that
    // VIOLATED has no program that can produce it *today*: `PREPARED_IV` is written
    // at arity 1 by `IvParameterSpec.@match` and negated nowhere, so `validate` can
    // only answer SATISFIED or NOT_OBSERVED for it. The branch is written anyway,
    // and this is the record of why rather than a claim that it fires: a predicate
    // gains a `negate` the day some rule's NEGATES clause is wired to it, and a read
    // that had silently folded VIOLATED into NOT_OBSERVED would then report a
    // withdrawn preparation as an unobserved one.
    //
    // What this read costs is a cascade, and it is the question `IvParameterSpec.mop`
    // left open at task 4.4 in as many words -- "whoever gives it a reader through the
    // store owns that question". `@match` there writes `preparedIV[this]` only for a
    // construction whose own `randomized[iv]` read answered SATISFIED, so an iv the
    // instrumentation never saw randomised produces no preparation, and the same reach
    // limit is now reported twice: IVPARAMETERSPEC-NOBS-00 at the construction and
    // IVCHAINJUNCTION-NOBS-00 here. Measured on the pair: the unprepared trace goes
    // from one report to two, and the conforming trace stays silent. The alternative --
    // preparing on NOT_OBSERVED so the limit costs one report instead of two -- would
    // make an IvParameterSpec of unknown origin satisfy this clause, which is a
    // behavioural change to a ratified decision and not this task's to make.
    event use before(int encmode, AlgorithmParameterSpec params, Cipher c):
      call(public void Cipher.init(int, Key, AlgorithmParameterSpec, ..)) &&
      args(encmode, *, params, ..) &&
      target(c) {
        String transformation = c.getAlgorithm();
        // The alias is resolved before the split, and the result comes back folded. Reading the
        // mode off the raw string is the second exposure of the defect the five `isValid` sites
        // of `CipherSpec` carry: an alias spelling written as one word --
        // `PBEWithHmacSHA1AndAES_128`, canonical `AES_128/CBC/PKCS5PADDING` (alias_table.csv,
        // OpenSSLProvider :394-398) -- has no `/`, so `mode(...)` answered the empty string and
        // both clauses below fell through in silence: no IV was required of a CBC
        // transformation and no GCM parameter spec of a GCM one. That is a false negative, not
        // a false positive, which is why this half of task 9.10 adds accusations where the
        // `isValid` half removes them.
        //
        // The two case folds that stood at the tests below are gone with it: the normaliser
        // folds what it returns, and folding twice only hides where the rule lives.
        String operationMode = CipherTransformationNormalizer.mode(transformation);
        boolean ivRequired = encmode == 1
            && operationMode != null
            && ivModes.contains(operationMode);
        if (ivRequired) {
            PredicateVerdict prepared = PredicateStore.instance().validate(Property.PREPARED_IV, params);
            if (prepared == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                    "v=1 code=IVCHAINJUNCTION-CONSTR-00 ev=" + __EVENTNAME + " obj=Cipher val='" + q(transformation) + "' exp='" + q(expectedPreparedIv) + "' msg='the AlgorithmParameterSpec given to Cipher.init carries a preparation predicate the rule does not admit'"));
            }
            else if (prepared == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                    "v=1 code=IVCHAINJUNCTION-NOBS-00 ev=" + __EVENTNAME + " obj=Cipher val='" + q(transformation) + "' exp='" + q(expectedPreparedIv) + "' msg='no preparation of the AlgorithmParameterSpec given to Cipher.init was observed'"));
            }
        }

        // The rule's second guarded clause over the same argument:
        // `mode(transformation) in {GCM} => preparedGCM[paramSpec]`
        // (Cipher.crysl:139, ledger clause #10). It reads the same argument at the
        // same join point as the clause above, which is why it is a second read in
        // this body and not a file of its own: the two clauses share the pointcut
        // exactly, and a second specification over the same call would put a second
        // monitor on it to ask about the same object.
        //
        // The antecedent is narrower than the IV one -- no `encmode` conjunct -- so a
        // GCM decrypt is required to carry a prepared spec just as an encrypt is,
        // which is what the rule states and is not this file's inference. The mode is
        // split off `c.getAlgorithm()` a second time rather than shared with the read
        // above, because the two antecedents are two claims and folding them into one
        // local would make a future edit to either silently move the other.
        //
        // Measured before this read was written: the chain composes.
        // `Cipher.getInstance("AES/GCM/NoPadding").init(1, key, new GCMParameterSpec(128, iv))`
        // followed by `doFinal` runs to completion on a JVM, so a program can put the
        // producer (`GCMParameterSpecSpec.@match`, arity 1) and this consumer end to
        // end -- which is the measurement clause #21 failed and #17 failed with it.
        boolean gcmRequired = operationMode != null
            && "GCM".equals(operationMode);
        if (gcmRequired) {
            PredicateVerdict prepared = PredicateStore.instance().validate(Property.PREPARED_GCM, params);
            if (prepared == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                    "v=1 code=IVCHAINJUNCTION-CONSTR-01 ev=" + __EVENTNAME + " obj=Cipher val='" + q(transformation) + "' exp='" + q(expectedPreparedGcm) + "' msg='the AlgorithmParameterSpec given to Cipher.init carries a preparation predicate the rule does not admit'"));
            }
            else if (prepared == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                    "v=1 code=IVCHAINJUNCTION-NOBS-01 ev=" + __EVENTNAME + " obj=Cipher val='" + q(transformation) + "' exp='" + q(expectedPreparedGcm) + "' msg='no preparation of the AlgorithmParameterSpec given to Cipher.init was observed'"));
            }
        }
    }

    // `randomized[random]` (Cipher.crysl:135, ledger clause #6) -- the rule's only
    // unguarded REQUIRES over an argument `CipherSpec` cannot bind. The rule binds the
    // random source in four `init` overloads, and this file writes one event per overload,
    // which is more events
    // than the clause looks like it needs. Three shorter statements were measured first and
    // all three are worse:
    //
    //   * a disjunction of the four signatures, `(call(A) && args(..) || call(B) && args(..))`,
    //     makes javamop write `null` to stderr and emit no aspect at all -- every `.rvm` of
    //     the set generates first, so the failure reads as an environment fault and is not
    //     one. Bisected against the HEAD set and the pre-image, which generate clean;
    //   * the one-event form `call(...init(..)) && args(.., ranGen)` generates, and is worse
    //     than wrong: on three probe traces it matched every `init` whatever the last
    //     argument's type, bound no SecureRandom, and answered NOT_OBSERVED for all of them
    //     -- including an `init` whose SecureRandom had just been observed. That is an
    //     accuser of everything that passes through it, the defect achado 74 names;
    //   * a wildcard in a middle position, `init(int, *, SecureRandom)`, generates a correct
    //     aspect -- AspectJ resolves the signature statically -- but the trace harness's
    //     resolver accepts any call from the first wildcard onward, so the conforming traces
    //     of task 5.1 drew a report they must not draw. Measured on the corpus. A wildcard is
    //     safe only after every discriminating type, which is why `use` above may keep its
    //     trailing `..`.
    //
    // So the argument positions are written out, one event each, and the four bodies are the
    // same read. Two sites for one clause is the shape `IvParameterSpec.c1/c2` and
    // `GCMParameterSpecSpec.c1/c2` already carry; four is that shape and the rule's own
    // event list, which names four.
    //
    // These events overlap with `use` on i6 -- one call matching both -- and that is
    // harmless: each asks about a different argument, and this file's `ere` accuses no
    // ordering. The producer is `SecureRandomSpec.@match1`, `randomized[this] after Ins`, so
    // the object carries the predicate by identity from its own construction; measured,
    // `init(mode, key, sr)` and `init(mode, key, params, sr)` both run to completion.
    // NOT_OBSERVED is the reach limit and not a misuse: an application whose SecureRandom
    // comes from a framework the instrumentation never wove reaches the read with nothing
    // written, and that is a different claim from VIOLATED.

    // the rule's i8.
    event useRandomKey before(SecureRandom ranGen, Cipher c):
      call(public void Cipher.init(int, Key, SecureRandom)) &&
      args(*, *, ranGen) &&
      target(c) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, ranGen);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-CONSTR-02 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-NOBS-02 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init was not observed to come from an observed construction'"));
        }
    }

    // the rule's i2, over a Certificate.
    event useRandomCert before(SecureRandom ranGen, Cipher c):
      call(public void Cipher.init(int, Certificate, SecureRandom)) &&
      args(*, *, ranGen) &&
      target(c) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, ranGen);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-CONSTR-03 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-NOBS-03 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init was not observed to come from an observed construction'"));
        }
    }

    // the rule's i6.
    event useRandomSpec before(SecureRandom ranGen, Cipher c):
      call(public void Cipher.init(int, Key, AlgorithmParameterSpec, SecureRandom)) &&
      args(*, *, *, ranGen) &&
      target(c) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, ranGen);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-CONSTR-04 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-NOBS-04 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init was not observed to come from an observed construction'"));
        }
    }

    // the rule's i7.
    event useRandomParams before(SecureRandom ranGen, Cipher c):
      call(public void Cipher.init(int, Key, AlgorithmParameters, SecureRandom)) &&
      args(*, *, *, ranGen) &&
      target(c) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, ranGen);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-CONSTR-05 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-NOBS-05 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init was not observed to come from an observed construction'"));
        }
    }

    // The `ere` accepts every sequence of the seven events this file declares, which
    // is the whole claim this file makes about ordering: none. The ordering of `Cipher`
    // is `CipherSpec`'s, stated against the rule's own ORDER, and a second automaton over
    // a subset of the same calls could only accuse the same program twice. The `fail`
    // state is therefore unreachable by construction -- measured on the generated
    // monitor, whose transition rows send state 0 to state 0 for all seven symbols -- and the
    // file carries no ORDER code, because there is no site that could emit one. G-ORDER skips this
    // file declaredly, for want of a row in `order_alphabet_map_expert.csv`, and the skip is
    // right here rather than concealing: no rule of the oracle states an ORDER this file
    // translates, so there is nothing for the gate to compare against.
    //
    // The `@match` below is empty on purpose, and it is there because JavaMOP requires
    // at least one handler -- a specification whose `ere` is followed directly by the
    // closing brace does not parse. Nor may a brace be written unmatched in prose here:
    // the lint balances them over the whole file, comments included, so the sentence
    // above says "closing brace" where it wants to show one. The accusation belongs in
    // the event body, where `params` is in
    // scope: a handler is generated as a no-argument method and sees no event parameter
    // (INV-INS-136(d)). And there is nothing for the accepting state to ensure, because
    // the rule states no ENSURES clause this file could translate.
    //
    // Nothing may be written between the `ere` line and the first `@handler`: the lint
    // reads whatever sits there as part of the expression, and a comment block becomes
    // sixty undeclared symbols and one unbalanced brace.
    // `!macced[_, plainText]` (Cipher.crysl:137, ledger clause #8) at the two `doFinal`
    // overloads the rule binds `plainText` in and `CipherSpec` does not: its `f2` is declared
    // `call(public byte[] Cipher.doFinal(byte[], ..))` and stands for the rule's `f2` and
    // `f4` at once, binding no argument, and splitting it into one event per overload is
    // not available at 17 of 17 events (INV-INS-145). Those two overloads share a `byte[]`
    // in the first position, so since the pointcut was made disjoint from `f1` an
    // `args(plainText, ..)` over there would bind the plaintext: these two sites live
    // here by choice and no longer by impossibility. The choice is that moving them would
    // retire IVCHAINJUNCTION-CONSTR-06 and -07 and change which specification reports a
    // misuse that neither placement stops reporting.
    // `f5`, `f6` and `f7` do bind it, so `CipherSpec` carries those sites itself; these
    // two are the ones with nowhere else to go, and they are the ones almost every
    // program uses.
    //
    // One event per overload with every type written out, which is this file's own
    // discipline and the measurement behind it is in the `useRandom*` block above: a
    // disjunction of the signatures makes javamop emit no aspect at all, a trailing
    // `args(.., x)` binds nothing and accuses everything that passes through it, and a
    // wildcard before a discriminating type defeats the trace harness's resolver. The
    // trailing wildcards in `finalRange` sit after the discriminating `byte[]`, which is
    // where a wildcard is safe.
    //
    // `validateAbsent` and not `validate`: the clause is negated, so absence is the
    // conforming case and the read never answers NOT_OBSERVED (INV-INS-146). There is no
    // NOBS code for either site, and that absence is not an omission.
    //
    // Measured before the reads were written -- the composition is real, and it is the
    // misuse the clause names rather than an artefact: `mac.doFinal(data)` followed by
    // `cipher.doFinal(data)` over the same array object runs to completion on Temurin 21.
    // The producer is `MacSpec.@match`, wired in this same commit at the arity the
    // consumer asks for, over the data rather than over the tag.
    event finalInput after(byte[] plainText, Cipher c):
      call(public byte[] Cipher.doFinal(byte[])) &&
      args(plainText) &&
      target(c) {
        if (PredicateStore.instance().validateAbsent(Property.MACED, plainText) == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-CONSTR-06 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedUnmacced) + "' msg='the plaintext given to Cipher.doFinal was already authenticated by a Mac'"));
        }
    }

    event finalRange after(byte[] plainText, Cipher c):
      call(public byte[] Cipher.doFinal(byte[], int, int)) &&
      args(plainText, *, *) &&
      target(c) {
        if (PredicateStore.instance().validateAbsent(Property.MACED, plainText) == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-CONSTR-07 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedUnmacced) + "' msg='the plaintext given to Cipher.doFinal was already authenticated by a Mac'"));
        }
    }

    ere : (use | useRandomKey | useRandomCert | useRandomSpec | useRandomParams | finalInput | finalRange)*

    @match {
    }
}
