package mop;

import java.security.AlgorithmParameters;
import java.security.Key;
import java.security.cert.Certificate;
import java.security.SecureRandom;
import java.security.spec.AlgorithmParameterSpec;
import java.util.Arrays;
import java.util.List;
import javax.crypto.Cipher;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
// The static form, and bare calls below. The generator merges every specification of the set
// into one monitor and dedupes imports by class name, keeping the first: if this file and
// CipherSpec.mop import the same class in different forms, one of them loses and the monitor
// does not compile. Both name it statically.
import static br.unb.cic.mop.jca.util.CipherTransformationUtil.*;

// The normaliser is named in full and imported plainly, where
// `CipherTransformationUtil` above is imported statically. That is not inconsistency: the two
// classes declare methods of the same names, so a second static-* import would make every bare
// `mode(...)` and `isValid(...)` of the merged monitor ambiguous and the monitor would not
// compile. Naming this one at each call site is also what tells a reader which of the two a
// given line asks -- and there are lines of both kinds in these files, on purpose.
import br.unb.cic.mop.jca.util.CipherTransformationNormalizer;

/**
 * IvChainJunctionSpec
 *
 * Monitors javax.crypto.Cipher against the CrySL rule Cipher.crysl, and carries four of that
 * rule's REQUIRES clauses -- the ones whose argument the set's own `CipherSpec` does not bind.
 * Each is read here against the predicate store:
 *
 *   `randomized[random];`
 *   `!macced[_, plainText];`
 *   `mode(transformation) in {"CBC", "PCBC", "CTR", "CTS", "CFB", "OFB"} && encmode == 1
 *    => preparedIV[paramSpec];`
 *   `mode(transformation) in {"GCM"} => preparedGCM[paramSpec];`
 *
 * It makes no claim about ordering: its `ere` accepts every sequence of the seven events it
 * declares, because the ORDER of `Cipher` is `CipherSpec`'s and a second automaton over a
 * subset of the same calls could only accuse the same program twice. It writes no predicate
 * either: `CipherSpec` writes the ENSURES clauses of the rule, at its acceptance states and
 * from values its own events stage, and the one clause neither file writes is
 * `wrappedKey[wrappedKeyBytes, wrappedKey]`, which no rule of this set requires.
 *
 * It exists beside `CipherSpec.mop` because `CipherSpec` cannot hold these reads. The
 * parameter-spec and `SecureRandom` arguments of `Cipher.init` are bound by no event there:
 * its key-route `init` is declared `call(public void Cipher.init(int, Key,..)) &&
 * args(mode, key, ..)` and stands for the rule's `i3` to `i8` at once, and its certificate
 * route stops at the certificate. The plaintext of `Cipher.doFinal` is bound there at the two
 * output-array overloads, the rule's `f5` and `f6`, which read `!macced[_, plainText]`
 * themselves; what has no site there is the plaintext of the rule's `f2` and `f4`, which one
 * event of `CipherSpec` covers at once and which therefore binds no argument of its own.
 * Narrowing any of them to bind a missing argument would drop the other overloads out of the
 * automaton, and adding an event is not available: `CipherSpec` declares exactly 17 events,
 * which is the ceiling the monitor generator can build -- an eighteenth raises
 * StackOverflowError in the enable-set parser at any heap. A
 * separate specification over the same calls is the only site left where those arguments can
 * be bound.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/Cipher.crysl
 */
IvChainJunctionSpec(Cipher c) {

    // The mode list of the IV clause's antecedent, transcribed from the REQUIRES clause
    // `mode(transformation) in {"CBC", "PCBC", "CTR", "CTS", "CFB", "OFB"} && encmode == 1
    // => preparedIV[paramSpec];` of Cipher.crysl. It is a list here and not a call into
    // `CipherTransformationNormalizer.isValid(...)`, because that method answers a different
    // question: whether the transformation as a whole -- algorithm, mode and padding together
    // -- is one the rule's value clauses admit. This clause asks only which mode was named, and
    // admits modes those value clauses may reject: an unsupported mode is a separate report
    // from `CipherSpec`, not a reason to stop requiring an IV.
    List<String> ivModes = Arrays.asList("CBC", "CTS", "CTR", "CFB", "PCBC", "OFB");

    // The `exp=` texts of the report sites below, each as a field so the sites that share one
    // cannot drift apart.
    String expectedPreparedIv = "an IvParameterSpec built over an observed randomized iv";

    String expectedPreparedGcm = "a GCMParameterSpec built over an observed randomized source";

    String expectedRandomGen = "a SecureRandom this instrumentation observed being constructed";

    String expectedUnmacced = "a plaintext no observed Mac has authenticated";

    // The envelope's quoting rule, the same three lines every
    // reporting specification of the set carries.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    // REQUIRES `mode(transformation) in {"CBC", "PCBC", "CTR", "CTS", "CFB", "OFB"} &&
    // encmode == 1 => preparedIV[paramSpec];` of Cipher.crysl, read over the third argument of
    // `Cipher.init`. The clause is an implication, so the antecedent decides whether anything
    // is required at all, and it is evaluated in the body before the read. A false antecedent
    // must leave no trace -- not a silent verdict, not a suppressed transition -- because the
    // rule asks nothing of the parameter spec there.
    //
    // The mode is read off `c.getAlgorithm()`, which returns the transformation string
    // `getInstance` was given, verbatim. Two things make that safe to split: `getInstance`
    // rejects a malformed transformation before any Cipher exists (`Cipher.getInstance("AES/")`
    // raises NoSuchAlgorithmException, "Invalid transformation format"), so what reaches `init`
    // was already accepted; and the advice is `before`, on an object `getInstance` returned.
    // The comparison folds case because the rule's own value comparisons do.
    //
    // `preparedIV[paramSpec]` says the IvParameterSpec was built from bytes that came from a
    // source the instrumentation observed; the producing site is the acceptance handler of
    // `IvParameterSpec`, over the object either of its constructors staged.
    //
    // The read is three-valued and the two accusing outcomes carry different codes. What
    // differs here is that no program can produce VIOLATED: `PREPARED_IV` is written at arity 1
    // by the acceptance handler of `IvParameterSpec` and negated nowhere, so `validate` can
    // only answer SATISFIED or NOT_OBSERVED for it. The branch is written anyway, because a
    // predicate gains a `negate` the day some rule's NEGATES clause is wired to it, and a read
    // that had silently folded VIOLATED into NOT_OBSERVED would then report a negated
    // preparation as an unobserved one.
    //
    // NOT_OBSERVED here costs a second report for one reach limit. The acceptance handler of
    // `IvParameterSpec` writes `preparedIV[this]` only for a construction whose own
    // `randomized[iv]` read answered SATISFIED, so an iv the instrumentation never saw
    // randomised produces no preparation, and the same limit is reported twice: once where the
    // spec was constructed and once here.
    //
    // The second report says which of the two situations it is. A spec whose construction
    // was reported carries `REPORTED_UPSTREAM` (`IvParameterSpec.c1/c2`,
    // `GCMParameterSpecSpec.c1/c2`), and a NOT_OBSERVED read over such a spec emits the
    // `upstream-refused` code; a spec with no mark, one this instrumentation never saw
    // constructed, emits the `not-observed` code. Both branches are the same site and the
    // same verdict, so the label moves no report.
    event use before(int encmode, AlgorithmParameterSpec params, Cipher c):
      call(public void Cipher.init(int, Key, AlgorithmParameterSpec, ..)) &&
      args(encmode, *, params, ..) &&
      target(c) {
        String transformation = c.getAlgorithm();
        // `CipherTransformationNormalizer.mode(...)` sends the transformation through
        // `ConscryptAliasTable` for the `Cipher` service, splits the resolved string on `/` and
        // folds the mode to upper case. Resolving before the split is what this call is for. An
        // alias spelling written as one word -- `PBEWithHmacSHA1AndAES_128`, whose pinned
        // Conscrypt canonical form is `AES_128/CBC/PKCS5PADDING` -- has no `/`, so a split of
        // the raw string answers the empty string and both clauses below fall through in
        // silence: no IV required of a CBC transformation and no GCM parameter spec of a GCM
        // one. That is a false negative, and this call is what closes it.
        //
        // The tests below fold no case of their own: the normaliser folds what it returns, and
        // folding twice only hides where the rule lives.
        String operationMode = CipherTransformationNormalizer.mode(transformation);
        boolean ivRequired = encmode == 1
            && operationMode != null
            && ivModes.contains(operationMode);
        if (ivRequired) {
            PredicateVerdict prepared = PredicateStore.instance().validate(Property.PREPARED_IV, params);
            if (prepared == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                    "v=1 code=IVCHAINJUNCTION-CONSTR-00 ev=" + __EVENTNAME + " obj=Cipher val='" + q(transformation) + "' exp='" + q(expectedPreparedIv) + "' msg='the AlgorithmParameterSpec given to Cipher.init carries a preparation predicate the rule does not admit'"));
            }
            else if (prepared == PredicateVerdict.NOT_OBSERVED && PredicateStore.instance().validateAny(Property.REPORTED_UPSTREAM, params) == PredicateVerdict.SATISFIED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                    "v=1 code=IVCHAINJUNCTION-NOBS-06 ev=" + __EVENTNAME + " obj=Cipher val='" + q(transformation) + "' exp='" + q(expectedPreparedIv) + "' msg='the AlgorithmParameterSpec given to Cipher.init was already reported where it was constructed'" + Evidence.keysFor(params)));
            }
            else if (prepared == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                    "v=1 code=IVCHAINJUNCTION-NOBS-00 ev=" + __EVENTNAME + " obj=Cipher val='" + q(transformation) + "' exp='" + q(expectedPreparedIv) + "' msg='no preparation of the AlgorithmParameterSpec given to Cipher.init was observed'" + Evidence.keysFor(params)));
            }
        }

        // The rule's second guarded clause over the same argument: REQUIRES
        // `mode(transformation) in {"GCM"} => preparedGCM[paramSpec];` of Cipher.crysl. It
        // reads the same argument at the same join point as the clause above, which is why it
        // is a second read in this body and not a file of its own: the two clauses share the
        // pointcut exactly, and a second specification over the same call would put a second
        // monitor on it to ask about the same object.
        //
        // The antecedent is narrower than the IV one -- no `encmode` conjunct -- so a GCM
        // decrypt is required to carry a prepared spec just as an encrypt is, which is what the
        // rule states and is not this file's inference. It is evaluated over the same
        // `operationMode` local the IV clause computed, so one alias resolution and one split
        // serve both reads.
        //
        // `preparedGCM[paramSpec]` says the GCMParameterSpec carries a tag length and a nonce
        // the rule admits, and that its nonce came from a source the instrumentation observed;
        // the producing site is the acceptance handler of `GCMParameterSpecSpec`, over the
        // object either of its constructors staged. The three verdicts are read exactly as in
        // the IV branch above, under this branch's own codes.
        boolean gcmRequired = operationMode != null
            && "GCM".equals(operationMode);
        if (gcmRequired) {
            PredicateVerdict prepared = PredicateStore.instance().validate(Property.PREPARED_GCM, params);
            if (prepared == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                    "v=1 code=IVCHAINJUNCTION-CONSTR-01 ev=" + __EVENTNAME + " obj=Cipher val='" + q(transformation) + "' exp='" + q(expectedPreparedGcm) + "' msg='the AlgorithmParameterSpec given to Cipher.init carries a preparation predicate the rule does not admit'"));
            }
            else if (prepared == PredicateVerdict.NOT_OBSERVED && PredicateStore.instance().validateAny(Property.REPORTED_UPSTREAM, params) == PredicateVerdict.SATISFIED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                    "v=1 code=IVCHAINJUNCTION-NOBS-07 ev=" + __EVENTNAME + " obj=Cipher val='" + q(transformation) + "' exp='" + q(expectedPreparedGcm) + "' msg='the AlgorithmParameterSpec given to Cipher.init was already reported where it was constructed'" + Evidence.keysFor(params)));
            }
            else if (prepared == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                    "v=1 code=IVCHAINJUNCTION-NOBS-01 ev=" + __EVENTNAME + " obj=Cipher val='" + q(transformation) + "' exp='" + q(expectedPreparedGcm) + "' msg='no preparation of the AlgorithmParameterSpec given to Cipher.init was observed'" + Evidence.keysFor(params)));
            }
        }
    }

    // REQUIRES `randomized[random];` of Cipher.crysl -- the rule's only unguarded REQUIRES over
    // an argument `CipherSpec` does not bind. The rule binds the random source in four `init`
    // overloads, and this file writes one event per overload with every argument position
    // written out, which is more events than the clause looks like it needs. Three shorter
    // forms are worse:
    //
    //   * a disjunction of the four signatures, `(call(A) && args(..) || call(B) && args(..))`,
    //     makes javamop write `null` to stderr and emit no aspect at all;
    //   * the one-event form `call(...init(..)) && args(.., ranGen)` generates, and is worse
    //     than wrong: it matches every `init` whatever the last argument's type, binds no
    //     SecureRandom, and answers NOT_OBSERVED for all of them -- including an `init` whose
    //     SecureRandom the instrumentation had just observed. That is an accuser of everything
    //     that passes through it;
    //   * a wildcard in a middle position, `init(int, *, SecureRandom)`, generates a correct
    //     aspect -- AspectJ resolves the signature statically -- but the trace harness's
    //     resolver accepts any call from the first wildcard onward, so conforming traces draw a
    //     report they must not draw. A wildcard is safe only after every discriminating type,
    //     which is why `use` above may keep its trailing `..`.
    //
    // So the argument positions are written out, one event each, and the four bodies are the
    // same read, each under its own pair of codes because a code names a site and not a clause.
    //
    // These events overlap with `use` on the rule's `i6` -- one call matching both -- and that
    // is harmless: each asks about a different argument, and this file's `ere` accuses no
    // ordering.
    //
    // `randomized[random]` says the object came from a `SecureRandom` the instrumentation
    // observed -- the generator itself, or bytes it produced. The producing site here is the
    // handler of `SecureRandomSpec` at the state its creation events lead to, which realises
    // the rule's `randomized[this] after Ins;` over the generator itself, so the object carries
    // the predicate by identity from its own construction. VIOLATED is positive evidence that
    // the store holds an entry for this generator that the clause does not admit; NOT_OBSERVED
    // means the store holds no entry for it at all -- an application whose SecureRandom comes
    // from a framework the instrumentation never wove reaches the read with nothing written --
    // and that is a reach limit rather than a misuse, so it keeps a code of its own.

    // `i8` of Cipher.crysl: `init(encmode, key, random)`, the three-argument overload over a
    // Key. The body is the shared read of `randomized[random];`, under this site's own codes.
    event useRandomKey before(SecureRandom ranGen, Cipher c):
      call(public void Cipher.init(int, Key, SecureRandom)) &&
      args(*, *, ranGen) &&
      target(c) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, ranGen);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-CONSTR-02 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-NOBS-02 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init was not observed to come from an observed construction'" + Evidence.keysFor(ranGen)));
        }
    }

    // `i2` of Cipher.crysl: `init(encmode, certificate, random)`, the overload that takes a
    // Certificate in place of a Key. The same read, under this site's own codes.
    event useRandomCert before(SecureRandom ranGen, Cipher c):
      call(public void Cipher.init(int, Certificate, SecureRandom)) &&
      args(*, *, ranGen) &&
      target(c) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, ranGen);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-CONSTR-03 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-NOBS-03 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init was not observed to come from an observed construction'" + Evidence.keysFor(ranGen)));
        }
    }

    // `i6` of Cipher.crysl: `init(encmode, key, paramSpec, random)`. The same read, under this
    // site's own codes. This is the overload `use` above also matches, for its third argument:
    // one call, two events, two different arguments asked about.
    event useRandomSpec before(SecureRandom ranGen, Cipher c):
      call(public void Cipher.init(int, Key, AlgorithmParameterSpec, SecureRandom)) &&
      args(*, *, *, ranGen) &&
      target(c) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, ranGen);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-CONSTR-04 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-NOBS-04 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init was not observed to come from an observed construction'" + Evidence.keysFor(ranGen)));
        }
    }

    // `i7` of Cipher.crysl: `init(encmode, key, params, random)`, the overload whose third
    // argument is an `AlgorithmParameters` rather than a spec. The same read, under this site's
    // own codes.
    event useRandomParams before(SecureRandom ranGen, Cipher c):
      call(public void Cipher.init(int, Key, AlgorithmParameters, SecureRandom)) &&
      args(*, *, *, ranGen) &&
      target(c) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, ranGen);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-CONSTR-05 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-NOBS-05 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedRandomGen) + "' msg='the SecureRandom given to Cipher.init was not observed to come from an observed construction'" + Evidence.keysFor(ranGen)));
        }
    }

    // The `ere` at the end of this file accepts every sequence of the seven events it
    // declares, which is the whole claim this file makes about ordering: none. The ordering of
    // `Cipher` is `CipherSpec`'s, stated against the rule's own ORDER, and a second automaton
    // over a subset of the same calls could only accuse the same program twice. The fail state
    // is therefore unreachable by construction -- the generated transition rows send state 0 to
    // state 0 for all seven symbols -- and the file declares no `@fail` handler and no ordering
    // code, because there is no site that could emit one.
    //
    // The `@match` below is empty on purpose, and it is there because JavaMOP requires
    // at least one handler -- a specification whose `ere` is followed directly by the
    // closing brace does not parse. Nor may a brace be written unmatched in prose here:
    // the lint balances them over the whole file, comments included, so the sentence
    // above says "closing brace" where it wants to show one. The accusations belong in
    // the event bodies, where the arguments are in
    // scope: a handler is generated as a no-argument method and sees no event parameter.
    // And there is nothing for the accepting state to ensure, because no ENSURES clause of
    // the rule is over an argument this file binds.
    //
    // Nothing may be written between the `ere` line and the first `@handler`: the lint
    // reads whatever sits there as part of the expression, and a comment block becomes
    // sixty undeclared symbols and one unbalanced brace. That is why this paragraph, and
    // the two events below, sit ahead of the `ere` rather than beside it.
    //
    // REQUIRES `!macced[_, plainText];` of Cipher.crysl, read at the two `doFinal` overloads
    // the rule binds `plainText` in and `CipherSpec` does not: the event of `CipherSpec` that
    // covers them is declared `call(public byte[] Cipher.doFinal(byte[], ..))`, stands for the
    // rule's `f2` and `f4` at once and binds no argument of its own. Giving each overload its
    // own event there is not available: `CipherSpec` already declares the 17 events the
    // generator can build. The rule's `f5` and `f6` are bound by events of their own at
    // `CipherSpec`, which reads this clause at both; the rule's `f7` is bound there too, over a
    // `ByteBuffer` plaintext, and carries no read, because no site of this set marks a
    // `ByteBuffer` with this predicate. These two overloads are the ones with nowhere else to
    // go, and they are the ones almost every program uses.
    //
    // One event per overload with every type written out, which is this file's own
    // discipline, for the reasons the `useRandom*` block above sets out: a
    // disjunction of the signatures makes javamop emit no aspect at all, a trailing
    // `args(.., x)` binds nothing and accuses everything that passes through it, and a
    // wildcard before a discriminating type defeats the trace harness's resolver. The
    // trailing wildcards in `finalRange` sit after the discriminating `byte[]`, which is
    // where a wildcard is safe.
    //
    // `macced[_, plainText]` says a monitored `Mac` computed a MAC over these bytes. The
    // producing site is the acceptance handler of `MacSpec`, which writes the mark over the
    // data the MAC was computed over rather than over the tag; the bound object is the array
    // itself, compared by identity, so only the very array a `Mac` was run over carries it.
    //
    // `validateAbsent` and not `validate`: the clause is negated, so the read's table is
    // inverted -- absence is conformance, so it answers SATISFIED when the object carries
    // nothing and VIOLATED when it does, and never NOT_OBSERVED. There is no not-observed code
    // for either site, and that absence is not an omission.
    //
    // `f2` of Cipher.crysl: `cipherText = doFinal(plainText)`, the one-argument overload.
    event finalInput after(byte[] plainText, Cipher c):
      call(public byte[] Cipher.doFinal(byte[])) &&
      args(plainText) &&
      target(c) {
        if (PredicateStore.instance().validateAbsent(Property.MACED, plainText) == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-CONSTR-06 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedUnmacced) + "' msg='the plaintext given to Cipher.doFinal was already authenticated by a Mac'"));
        }
    }

    // `f4` of Cipher.crysl: `cipherText = doFinal(plainText, plainTextOffset, plainTextLen)`.
    // The same negated read over the same first argument, under this site's own code; the two
    // trailing positions are wildcards because the clause says nothing about them.
    event finalRange after(byte[] plainText, Cipher c):
      call(public byte[] Cipher.doFinal(byte[], int, int)) &&
      args(plainText, *, *) &&
      target(c) {
        if (PredicateStore.instance().validateAbsent(Property.MACED, plainText) == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvChainJunctionSpec", "" + __LOC,
                "v=1 code=IVCHAINJUNCTION-CONSTR-07 ev=" + __EVENTNAME + " obj=Cipher val='" + q(c.getAlgorithm()) + "' exp='" + q(expectedUnmacced) + "' msg='the plaintext given to Cipher.doFinal was already authenticated by a Mac'"));
        }
    }

    ere : (use | useRandomKey | useRandomCert | useRandomSpec | useRandomParams | finalInput | finalRange)*

    @match {
    }
}
