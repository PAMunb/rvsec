package mop;

import java.security.spec.X509EncodedKeySpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * X509EncodedKeySpecSpec
 *
 * Monitors java.security.spec.X509EncodedKeySpec against the CrySL rule
 * X509EncodedKeySpec.crysl.
 *
 * The rule's ORDER is the single label `Con`, the constructor
 * `c1: X509EncodedKeySpec(encodedKey)`, so the only sequence this specification accepts is
 * one construction of the spec and nothing after it. The rule states no CONSTRAINTS. It
 * REQUIRES `preparedKeyMaterial[encodedKey]`, so the bytes an X.509 key spec is built from
 * have to be key material a monitored key or key agreement handed out, and it ENSURES
 * `speccedKey[this, _] after Con`, which the key factories of this set read before they
 * decode a spec into a key.
 *
 * The platform declares only the `X509EncodedKeySpec(byte[])` constructor, so that is the one
 * join point this specification binds; the `(byte[], String)` overload a desktop JDK carries
 * is not on this platform. The `@fail` handler cannot fire: a one-symbol ordering over a
 * monitor keyed on the constructed object never sees a second event. It is written because
 * the generator expects it.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/X509EncodedKeySpec.crysl
 */
X509EncodedKeySpecSpec(X509EncodedKeySpec s) {

   // Bound only on the conforming branch, which is what carries the object to `@match`.
   X509EncodedKeySpec spec;

   // Set by `c1` and read by `@fail` (X509ENCODEDKEYSPEC-ORDER-01). The generated `reset()`
   // clears the state and not this field.
   boolean creationObserved = false;

   // `Con`: `c1: X509EncodedKeySpec(encodedKey)`, the rule's one event and the whole of its
   // ORDER. The platform declares exactly this constructor, so the pointcut binds every
   // construction of an X.509 key spec there is to see.
   //
   // REQUIRES `preparedKeyMaterial[encodedKey]`: the bytes are key material a monitored key or
   // key agreement handed out. The read is three-valued. SATISFIED leaves the body silent and
   // binds the spec for the write at `@match`. VIOLATED is positive evidence about these bytes
   // -- an entry exists and is not what the clause demands -- and draws the constraint code; no
   // site of this set negates `preparedKeyMaterial` and the clause names no value position, so
   // that branch has no execution path, and it is written because every branch of a site carries
   // its own code in `codes.csv`. NOT_OBSERVED means no entry at all: no producer of these bytes was ever seen, which on
   // this platform is as often a limit of what the weaving reaches as a misuse, so it draws a
   // code of its own instead of the constraint one. What can satisfy it is a `getEncoded()`
   // call on a key, which `KeySpec.mop` and `SecretKeySpec.mop` mark, or a shared-secret buffer
   // a key agreement handed out, which `KeyAgreementSpec.mop` marks.
   //
   // The read sits in the event body and not in a `condition(...)` guard: a guard compiles to
   // an early return ahead of both the body and the transition, so a construction from
   // unprepared bytes would leave the automaton in the state before the call and the next call
   // would be reported as a wrong call sequence instead of as the unsatisfied REQUIRES it is.
   //
   // Bytes that carry REPORTED_UPSTREAM came from an object whose producer already reported it,
   // so a site that finds no predicate for them is looking at a refusal upstream and not at a
   // gap in instrumentation reach; that branch is taken ahead of the plain NOT_OBSERVED one and
   // reports under its own code. Whichever report this body makes, the constructed spec is
   // marked REPORTED_UPSTREAM in turn, so the key factory that decodes it says the same.
   event c1 after(byte[] encodedKey) returning(X509EncodedKeySpec s):
     call(public X509EncodedKeySpec.new(byte[])) &&
     args(encodedKey) {
       creationObserved = true;
       boolean reported = false;
       PredicateVerdict prepared = PredicateStore.instance().validate(Property.PREPARED_KEY_MATERIAL, encodedKey);
       if (prepared == PredicateVerdict.VIOLATED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "X509EncodedKeySpecSpec", "" + __LOC,
               "v=1 code=X509ENCODEDKEYSPEC-CONSTR-00 ev=" + __EVENTNAME + " obj=X509EncodedKeySpec val='' exp='key material the monitor observed being prepared' msg='the encoded key carries a preparation predicate the rule does not admit'"));
           reported = true;
       }
       else if (prepared == PredicateVerdict.NOT_OBSERVED && PredicateStore.instance().validateAny(Property.REPORTED_UPSTREAM, encodedKey) == PredicateVerdict.SATISFIED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "X509EncodedKeySpecSpec", "" + __LOC,
               "v=1 code=X509ENCODEDKEYSPEC-NOBS-01 ev=" + __EVENTNAME + " obj=X509EncodedKeySpec val='' exp='key material the monitor observed being prepared' msg='the encoded key material comes from an object that was already reported upstream'" + Evidence.keysFor(encodedKey)));
           reported = true;
       }
       else if (prepared == PredicateVerdict.NOT_OBSERVED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "X509EncodedKeySpecSpec", "" + __LOC,
               "v=1 code=X509ENCODEDKEYSPEC-NOBS-00 ev=" + __EVENTNAME + " obj=X509EncodedKeySpec val='' exp='key material the monitor observed being prepared' msg='no preparation of the encoded key material was observed'" + Evidence.keysFor(encodedKey)));
           reported = true;
       }
       else {
           spec = s;
       }
       if (reported) {
           PredicateStore.instance().ensure(Property.REPORTED_UPSTREAM, s);
       }
   }

   // `ORDER Con` with `Con := c1` is the whole ordering, so the `@fail` handler below cannot
   // fire: one symbol, and a monitor keyed on the constructed object, so no monitor of this
   // specification ever sees a second event. It is written because the generator expects a
   // handler, and its two codes are registered in `codes.csv` like any other site.
   ere : c1

   @fail {
      if (!creationObserved) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "X509EncodedKeySpecSpec", "" + __LOC,
              "v=1 code=X509ENCODEDKEYSPEC-ORDER-01 ev=" + __EVENTNAME + " obj=X509EncodedKeySpec val='' exp='' msg='the observed call sequence is not one X509EncodedKeySpecSpec accepts, and no construction of this X509EncodedKeySpec was observed'"));
      }
      else {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "X509EncodedKeySpecSpec", "" + __LOC,
              "v=1 code=X509ENCODEDKEYSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=X509EncodedKeySpec val='' exp='' msg='the observed call sequence is not one X509EncodedKeySpecSpec accepts'"));
      }
      __RESET;
   }

   // ENSURES `speccedKey[this, _] after Con`: the key spec was constructed by a call the
   // instrumentation observed and the rule admitted. The qualification names the whole of the
   // ORDER, so the state `Con` leads to and the accepting state are one and the same, and
   // `@match` is the acceptance point.
   //
   // The write is completed here because a handler receives no event arguments and runs after
   // the transition is decided: the event that saw the constructed spec staged it in the `spec`
   // field, and staged it only where the read answered SATISFIED, so a construction this
   // specification reported reaches the handler with nothing bound and `ensure` treats a null
   // binding as a no-op.
   //
   // The second place of the clause is `_`, so nothing is written into it: the write records
   // the object and determines no value. That is what the readers ask for -- `KeyFactory.crysl`
   // and `SecretKeyFactory.crysl` both REQUIRE `speccedKey[keySpec, _]`, an anonymous position,
   // which is read with `validateAny`: does this object carry the predicate at all.
   @match {
      PredicateStore.instance().ensure(Property.SPECCED_KEY, spec);
   }

}
