package mop;

import javax.crypto.spec.PBEParameterSpec;
import java.security.spec.AlgorithmParameterSpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * PBEParameterSpecSpec
 *
 * Monitors javax.crypto.spec.PBEParameterSpec against the CrySL rule PBEParameterSpec.crysl.
 *
 * The rule's ORDER is the single label `Con`, with `Con := c1 | c2` over the two constructors,
 * so the only sequence this specification accepts is one construction. It checks the rule's one
 * CONSTRAINTS clause, `iterationCount >= 10000`, at both constructors; it REQUIRES
 * `randomized[salt]`, read at both; and it ENSURES `preparedPBE[this]`, written at the
 * acceptance point. The predicate has a reader in this set: AlgorithmParametersSpec.mop reads
 * it at `init`, under the guard of the PBE algorithm names its own rule lists.
 *
 * The `@fail` handler cannot fire: both events lead from the initial state to the accepting
 * one, and a monitor of this specification is keyed on the constructed object, so it never
 * sees a second event.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/PBEParameterSpec.crysl
 */
PBEParameterSpecSpec(PBEParameterSpec s) {

        // The constructed spec, staged by the conforming branch of either constructor for the
        // ENSURES write at `@match`: a handler receives no event arguments.
        PBEParameterSpec spec;

        // Set by the two creation events, `c1` and `c2`, whatever they report, and never
        // cleared: the generated `reset()` restores the automaton state and leaves this
        // field. `@fail` reads it to choose between `PBEPARAMETERSPEC-ORDER-01`
        // (`creation-unobserved`) and the wrong-sequence code.
        boolean creationObserved = false;

        // `Con`: `c1: PBEParameterSpec(salt, iterationCount)`, one of the two alternatives of
        // the rule's only ordering label.
        //
        // CONSTRAINTS `iterationCount >= 10000`, checked first in the body. A lower count draws
        // the constraint code registered in `codes.csv` for this site and clears `conforms`.
        //
        // REQUIRES `randomized[salt]`: the object came from a SecureRandom the instrumentation
        // observed -- the generator itself, or bytes it produced. The read is three-valued and
        // the two accusing verdicts are different claims. SATISFIED is silent. VIOLATED is
        // positive evidence about this array -- an entry exists and is not what the clause
        // demands -- and draws the constraint code. NOT_OBSERVED means no entry at all: no
        // randomised source of this array was ever seen, which on this platform is as often a
        // limit of what the weaving reaches as a misuse, so it draws a code of its own. The
        // array is compared by identity, so only the very array a monitored SecureRandom filled
        // carries the mark; a copy of it does not.
        //
        // Both checks sit in the event body and not in a `condition(...)` guard: a guard
        // compiles to an early return ahead of both the body and the transition, so a
        // construction with a low count or an unwatched salt would leave the automaton in the
        // state before the constructor and the next call would be reported as a wrong call
        // sequence instead of as the misuse it is. Neither the count nor the salt may decide
        // whether the constructor happened -- one is a CONSTRAINTS clause, the other a REQUIRES
        // predicate, and the rule's ordering is the construction alone.
        //
        // `spec` is staged only where both clauses held, because `@match` turns it into
        // `preparedPBE[this]` and CrySL establishes a predicate only for a use that satisfied
        // the rule.
        event c1 after(byte[] salt, int iterationCount) returning(PBEParameterSpec s):
          call(public PBEParameterSpec.new(byte[], int)) &&
          args(salt, iterationCount) {
              creationObserved = true;
              boolean conforms = true;
              if (iterationCount < 10000) {
                  ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEParameterSpecSpec", "" + __LOC,
                      "v=1 code=PBEPARAMETERSPEC-CONSTR-00 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='" + iterationCount + "' exp='>= 10000' msg='the iteration count should be >= 10000'"));
                  conforms = false;
              }
              PredicateVerdict randomisedSalt = PredicateStore.instance().validate(Property.RANDOMIZED, salt);
              if (randomisedSalt == PredicateVerdict.VIOLATED) {
                  ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEParameterSpecSpec", "" + __LOC,
                      "v=1 code=PBEPARAMETERSPEC-CONSTR-01 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='' exp='a randomized byte[]' msg='the salt carries a randomization predicate the rule does not admit'"));
                  conforms = false;
              }
              else if (randomisedSalt == PredicateVerdict.NOT_OBSERVED) {
                  ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEParameterSpecSpec", "" + __LOC,
                      "v=1 code=PBEPARAMETERSPEC-NOBS-00 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='' exp='a randomized byte[]' msg='the salt was not observed to come from a randomized source'" + Evidence.keysFor(salt)));
                  conforms = false;
              }
              if (conforms) {
                  spec = s;
              }
        }

        // `Con`: `c2: PBEParameterSpec(salt, iterationCount, params)`, the other alternative of
        // the same label. The rule binds the salt and the count in both events, so this overload
        // checks the same CONSTRAINTS clause `iterationCount >= 10000` and the same REQUIRES
        // `randomized[salt]` as the two-argument one, under codes of its own because a code
        // names a site. The `params` argument binds no clause of the rule and is not read here.
        //
        // `randomized[salt]`: the object came from a SecureRandom the instrumentation observed
        // -- the generator itself, or bytes it produced. SATISFIED is silent; VIOLATED is
        // positive evidence about this array and draws the constraint code; NOT_OBSERVED means
        // no randomised source of it was ever seen, and draws a code of its own, because an
        // array whose producer the weaving never reached is not a misuse.
        //
        // Both checks sit in the body and not in a `condition(...)` guard, and here that
        // placement is what makes the site accuse at all: a guard compiles to an early return
        // ahead of both the body and the transition, so a construction that broke either clause
        // would take no transition, reach no accepting state and be accused of nothing, while
        // the identical two-argument construction would be reported.
        event c2 after(byte[] salt, int iterationCount, AlgorithmParameterSpec paramSpec) returning(PBEParameterSpec s):
          call(public PBEParameterSpec.new(byte[], int, AlgorithmParameterSpec)) &&
          args(salt, iterationCount, paramSpec) {
              creationObserved = true;
              boolean conforms = true;
              if (iterationCount < 10000) {
                  ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEParameterSpecSpec", "" + __LOC,
                      "v=1 code=PBEPARAMETERSPEC-CONSTR-02 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='" + iterationCount + "' exp='>= 10000' msg='the iteration count should be >= 10000'"));
                  conforms = false;
              }
              PredicateVerdict randomisedSalt = PredicateStore.instance().validate(Property.RANDOMIZED, salt);
              if (randomisedSalt == PredicateVerdict.VIOLATED) {
                  ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEParameterSpecSpec", "" + __LOC,
                      "v=1 code=PBEPARAMETERSPEC-CONSTR-03 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='' exp='a randomized byte[]' msg='the salt carries a randomization predicate the rule does not admit'"));
                  conforms = false;
              }
              else if (randomisedSalt == PredicateVerdict.NOT_OBSERVED) {
                  ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEParameterSpecSpec", "" + __LOC,
                      "v=1 code=PBEPARAMETERSPEC-NOBS-01 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='' exp='a randomized byte[]' msg='the salt was not observed to come from a randomized source'" + Evidence.keysFor(salt)));
                  conforms = false;
              }
              if (conforms) {
                  spec = s;
              }
        }

        // `ORDER Con` with `Con := c1 | c2`: constructing a PBEParameterSpec is the whole of the
        // ordering this specification observes, so the `@fail` handler below cannot fire. Both
        // events lead from the initial state to the accepting one, and a monitor is keyed on the
        // constructed object, so it never sees a second event. The handler is written because
        // the generator expects one and each of its branches carries its own code in
        // `codes.csv`.
        ere : c1 | c2

        @fail {
          if (!creationObserved) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "PBEParameterSpecSpec", "" + __LOC,
                "v=1 code=PBEPARAMETERSPEC-ORDER-01 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='' exp='' msg='the observed call sequence is not one PBEParameterSpecSpec accepts and no creation of the parameters was observed'"));
          }
          else {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "PBEParameterSpecSpec", "" + __LOC,
                "v=1 code=PBEPARAMETERSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='' exp='' msg='the observed call sequence is not one PBEParameterSpecSpec accepts'"));
          }
          __RESET;
        }

        // ENSURES `preparedPBE[this]`: the PBEParameterSpec carries a salt and an iteration
        // count the rule admits, and its salt came from a source the instrumentation observed.
        // The clause carries no `after L`, and the rule's ORDER is the single `Con`, so it holds
        // wherever the object's use so far is a complete conforming call sequence -- the
        // accepting state, which in an `ere` is exactly what `@match` names.
        //
        // The object is staged: a handler receives no event arguments and runs after the
        // transition is decided, so the constructor event put the spec in a field, and put it
        // there only on its conforming branch. A construction that broke a clause reaches this
        // handler with nothing staged, and `ensure` treats a null binding as a no-op.
        //
        // The predicate is read: `AlgorithmParameters.crysl` REQUIRES
        // `algorithm in {"PBEWithHmacSHA224AndAES_128", ...} => preparedPBE[paramSpec]`, and
        // AlgorithmParametersSpec.mop reads it at `init` under that algorithm guard.
        @match {
          PredicateStore.instance().ensure(Property.PREPARED_PBE, spec);
        }
}
