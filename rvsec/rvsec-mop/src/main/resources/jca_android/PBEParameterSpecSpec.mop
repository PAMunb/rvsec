package mop;

import javax.crypto.spec.PBEParameterSpec;
import java.security.spec.AlgorithmParameterSpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * PBEParameterSpec
 *
 * A JavaMOP specification of the correct usage of the
 * javax.crypto.spec.PBEParameterSpec.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/PBEParameterSpec.crysl
 */
PBEParameterSpecSpec(PBEParameterSpec s) {

        PBEParameterSpec spec;

        // One event over `PBEParameterSpec(byte[], int)`, where there used to be two
        // split by the sign of a guard. The negated twin `c3` matched the same call
        // with the same `args(salt, iterationCount)` and named no state in the `ere`,
        // so one bad construction drew two reports: a constraint report from its body
        // and a PBEPARAMETERSPEC-ORDER-00 about an ordering the rule accepts, because
        // the generator gives an event absent from the automaton a transition row that
        // sends every state to the fail state. The rule's ORDER is `Cons` with
        // `Cons := c1 | c2`: constructing a PBEParameterSpec is the whole of the
        // ordering, and neither the iteration count nor the salt may govern the
        // transition -- the count is a CONSTRAINTS clause and the salt a REQUIRES
        // predicate.
        //
        // The body decomposes per clause, one report each, where the fusion first
        // wrote a single report over the disjunction the twin carried. The two halves
        // are two clauses of two different sections of the rule, and a composite site
        // is only admitted for probes of *one* clause: with both halves broken there
        // was no consistent code to file the report under, so the message named both
        // and the reader could not tell which had failed.
        //
        // The salt read is three-valued, and the two accusing outcomes are different
        // claims. VIOLATED is positive evidence that the array carries a randomisation
        // predicate that was withdrawn; NOT_OBSERVED says only that no randomised
        // source of it was ever seen -- on Android as often a reach limit of the
        // instrumentation as a misuse. The message this site used to emit was already
        // the second one; the split makes the code say what the message meant.
        //
        // The write stays behind the check: `spec` is bound only when every clause
        // holds, because `@match` turns `spec` into `preparedPBE[this]` and CrySL
        // ensures a predicate only for a use that satisfied the rule.
        event c1 after(byte[] salt, int iterationCount) returning(PBEParameterSpec s):
          call(public PBEParameterSpec.new(byte[], int)) &&
          args(salt, iterationCount) {
              boolean conforms = true;
              if (iterationCount < 10000) {
                  ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEParameterSpecSpec", "" + __LOC,
                      "v=1 code=PBEPARAMETERSPEC-CONSTR-00 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='" + iterationCount + "' exp='>= 10000' msg='the iteration count should be >= 10000'"));
                  conforms = false;
              }
              PredicateVerdict randomisedSalt = PredicateStore.instance().validate(Property.RANDOMIZED, salt);
              if (randomisedSalt == PredicateVerdict.VIOLATED) {
                  ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEParameterSpecSpec", "" + __LOC,
                      "v=1 code=PBEPARAMETERSPEC-CONSTR-01 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='' exp='a randomized byte[]' msg='the salt carries a randomization predicate the rule does not admit'"));
                  conforms = false;
              }
              else if (randomisedSalt == PredicateVerdict.NOT_OBSERVED) {
                  ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEParameterSpecSpec", "" + __LOC,
                      "v=1 code=PBEPARAMETERSPEC-NOBS-00 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='' exp='a randomized byte[]' msg='the salt was not observed to come from a randomized source'"));
                  conforms = false;
              }
              if (conforms) {
                  spec = s;
              }
        }

        // The three-argument constructor, which api30 states as its own event `c2` and
        // puts in the same `Cons` alternative as `c1`. It carried, until this pass, the
        // guard `c1` carried before the fusion -- the same conjunction, character for
        // character -- and a guard on this event is not the harmless thing it looks
        // like. Measured in this file's own generated monitor: `Prop_1_event_c2` opened
        // with `if (!(iterationCount >= 10000 && <read>)) return false;` *ahead* of
        // `handleEvent`, so a construction that broke either clause took no transition,
        // reached no accepting state and was accused of nothing at all. Three traces
        // written for this pass measure that silence on both snapshots: a plain salt, a
        // count of 1000, and both together produced not one report from the seed.
        //
        // So the guard leaves whole, and the body says what the rule says, exactly as
        // `c1` does. The count is a CONSTRAINTS clause and the salt a REQUIRES
        // predicate; neither may decide whether the constructor happened. Keeping the
        // count as a guard was the alternative, and it is admitted for CONSTRAINTS
        // checks in general -- but here it would have left the read this pass moves out
        // of the guard sitting behind a second guard that suppresses the same
        // transition, and the file would have accused a two-argument construction of a
        // low count while staying silent about the identical three-argument one.
        //
        // This is the site the rule's own REQUIRES clause is about and the site that
        // had no accuser of its own: the twin the fusion deleted bound only the
        // two-argument constructor, so a three-argument construction with an
        // unrandomised salt was never anybody's report. It gains one here.
        event c2 after(byte[] salt, int iterationCount, AlgorithmParameterSpec paramSpec) returning(PBEParameterSpec s):
          call(public PBEParameterSpec.new(byte[], int, AlgorithmParameterSpec)) &&
          args(salt, iterationCount, paramSpec) {
              boolean conforms = true;
              if (iterationCount < 10000) {
                  ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEParameterSpecSpec", "" + __LOC,
                      "v=1 code=PBEPARAMETERSPEC-CONSTR-02 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='" + iterationCount + "' exp='>= 10000' msg='the iteration count should be >= 10000'"));
                  conforms = false;
              }
              PredicateVerdict randomisedSalt = PredicateStore.instance().validate(Property.RANDOMIZED, salt);
              if (randomisedSalt == PredicateVerdict.VIOLATED) {
                  ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEParameterSpecSpec", "" + __LOC,
                      "v=1 code=PBEPARAMETERSPEC-CONSTR-03 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='' exp='a randomized byte[]' msg='the salt carries a randomization predicate the rule does not admit'"));
                  conforms = false;
              }
              else if (randomisedSalt == PredicateVerdict.NOT_OBSERVED) {
                  ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEParameterSpecSpec", "" + __LOC,
                      "v=1 code=PBEPARAMETERSPEC-NOBS-01 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='' exp='a randomized byte[]' msg='the salt was not observed to come from a randomized source'"));
                  conforms = false;
              }
              if (conforms) {
                  spec = s;
              }
        }

        ere : c1 | c2

        @fail {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "PBEParameterSpecSpec", "" + __LOC,
              "v=1 code=PBEPARAMETERSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=PBEParameterSpec val='' exp='' msg='the observed call sequence is not one PBEParameterSpecSpec accepts'"));
          __RESET;
        }

        // The one place the rule's `ENSURES preparedPBE[this]` may be written. api30
        // states the clause without an `after L` qualification, so its acceptance point
        // is the accepting state itself, which in an `ere` is exactly what `@match`
        // names -- unlike the sibling PBEKeySpec rule, whose `after c1` names a state
        // an `ere` cannot address. The monitor field is what carries the object here:
        // a handler sees no event arguments, and the field is bound only by the
        // conforming branch of either constructor, so a construction that broke a
        // clause reaches this handler with nothing bound and the call is a no-op.
        //
        // `preparedPBE` is written here and required by no rule of the oracle -- it
        // appears exactly once in api30, as this rule's own ENSURES. It is one of the
        // nine dead ends the change disposes of by recording the omission rather than
        // by fabricating a reader: a read invented on the strength of a producer alone
        // would accuse every conforming use of a consumer nobody models. The record
        // lives in the `disposition` column of predicate_graph.csv.
        //
        // The accepting-state bookkeeping that stood beside this write is gone: the new
        // substrate does not offer it, and the set never read it (INV-INS-147).
        @match {
          PredicateStore.instance().ensure(Property.PREPARED_PBE, spec);
        }
}
