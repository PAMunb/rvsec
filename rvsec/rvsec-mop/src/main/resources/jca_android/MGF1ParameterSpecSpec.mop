package mop;

import java.security.spec.MGF1ParameterSpec;
import java.util.Arrays;
import java.util.List;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.Property;

/**
 * MGF1ParameterSpecSpec
 *
 * Monitors java.security.spec.MGF1ParameterSpec against the CrySL rule MGF1ParameterSpec.crysl.
 * The rule's ORDER is a single constructor call, `Con`, so the whole of what this specification
 * checks is that a mask-generation parameter spec is built with a digest the rule admits: the
 * CONSTRAINTS clause `mdName in {"SHA-256", "SHA-384", "SHA-512"}`, matched through the Conscrypt
 * alias table so a provider spelling of the same digest passes. It requires no predicate. On the
 * conforming branch it writes the ENSURES clause `preparedMGF1[this, mdName]`: the
 * MGF1ParameterSpec names a digest the rule admits, and carries that digest with it, canonical, so
 * the OAEP specification that reads it with the standard spelling matches a spec built with an
 * alias.
 *
 * Reach limit: the class also exposes five static constants (SHA1, SHA224, SHA256, SHA384,
 * SHA512), whose parameter specs are built inside the platform, where the instrumentation does not
 * weave. A program that reads one of those never reaches this constructor, so nothing is checked
 * and nothing is written for that object, and its consumer sees it unobserved rather than
 * violating.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/MGF1ParameterSpec.crysl
 */
MGF1ParameterSpecSpec(MGF1ParameterSpec s) {

   // The envelope's quoting rule: a null value becomes the empty string, a single quote is
   // escaped so it cannot close the field early, and the value is capped so a pathological
   // argument cannot push the record past the logcat payload limit.
   private String q(String s) {
       if (s == null) {
           return "";
       }
       String value = s.length() > 512 ? s.substring(0, 512) : s;
       return value.replace("'", "\\'");
   }

   // The CONSTRAINTS clause of MGF1ParameterSpec.crysl, `mdName in {"SHA-256", "SHA-384",
   // "SHA-512"}`, transcribed. The class also exposes five static constants (SHA1, SHA224,
   // SHA256, SHA384, SHA512), and a program that reads one of those never reaches this
   // constructor: the field is initialised inside the platform, outside anything the
   // instrumentation weaves. That is a reach limit of the monitor and not a hole in the rule,
   // and it is why the read at `OAEPParameterSpecSpec` separates NOT_OBSERVED from VIOLATED --
   // `MGF1ParameterSpec.SHA256` is the ordinary way to write this and it arrives unobserved,
   // which is not evidence of a misuse.
   List<String> digests = Arrays.asList("SHA-256", "SHA-384", "SHA-512");

   // Bound only on the conforming branch, which is what carries the object to `@match`.
   MGF1ParameterSpec spec;

   // The second place of the ENSURES clause `preparedMGF1[this, mdName]`, staged beside the
   // object for the same reason the object is staged: a handler sees no event arguments.
   String stagedDigest;

   // Set by the one creation event, `c1`, on both of its branches, and never cleared: the
   // generated `reset()` restores the automaton state and leaves this field. `@fail` reads it
   // to choose between `MGF1PARAMETERSPEC-ORDER-01` (`creation-unobserved`) and the
   // wrong-sequence code.
   boolean creationObserved = false;

   // `Con` of MGF1ParameterSpec.crysl: `c1: MGF1ParameterSpec(mdName)`. It is the rule's one
   // event and the whole of its ORDER, and the platform declares exactly this constructor.
   //
   // The digest name is the CONSTRAINTS clause `mdName in {"SHA-256", "SHA-384", "SHA-512"}`,
   // checked here in the event body and never in a `condition(...)` guard: a guard compiles to
   // an early return ahead of both the body and the transition, so a spec built on MD5 would
   // drop out of the automaton in silence instead of being reported. A digest outside the
   // clause is reported under the code registered in `codes.csv` for this site.
   //
   // `ConscryptAliasTable.matches("MessageDigest", ...)` is the same call the digest
   // specification of the set makes, and here the table earns its keep rather than merely
   // folding case: `SHA256` and `2.16.840.1.101.3.4.2.1` are Conscrypt aliases of
   // `SHA-256`, and a program spelling the digest either way has satisfied the rule.
   event c1 after(String mdName) returning(MGF1ParameterSpec s):
     call(public MGF1ParameterSpec.new(String)) &&
     args(mdName) {
       creationObserved = true;
       if (!ConscryptAliasTable.matches("MessageDigest", mdName, digests)) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MGF1ParameterSpecSpec", "" + __LOC,
               "v=1 code=MGF1PARAMETERSPEC-ALG-00 ev=" + __EVENTNAME + " obj=MGF1ParameterSpec val='" + q(mdName) + "' exp='" + q(String.join(",", digests)) + "' msg='the mask generation function digest is not one the rule admits'"));
       }
       else {
           spec = s;
           // An algorithm-valued predicate is staged canonical. `PredicateStore` compares
           // value positions after lowercasing and nothing else, so a raw `SHA256` written
           // here would never match the `SHA-256` the OAEP reader asks with, and the chain
           // would break in silence.
           stagedDigest = ConscryptAliasTable.canonical("MessageDigest", mdName);
       }
   }

   // The ORDER of MGF1ParameterSpec.crysl is `Con`, and its EVENTS declare `Con := c1`, so this
   // `ere` holds a single symbol and the `@fail` handler below cannot fire: one symbol, a
   // {1, 2, 2} transition row, and a monitor keyed on the constructed object, so no monitor ever
   // sees a second event. The handler is written because the generator and the `codes.csv`
   // bijection expect it.
   ere : c1

   // Unreachable, for the reason given above the `ere`: a single-symbol automaton has no second
   // event with which to leave its accepting language. Both branches report a wrong call
   // sequence under the codes registered in `codes.csv`, the first of them when the constructor
   // itself was never seen, so the two cases stay apart in the report.
   @fail {
      if (!creationObserved) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "MGF1ParameterSpecSpec", "" + __LOC,
             "v=1 code=MGF1PARAMETERSPEC-ORDER-01 ev=" + __EVENTNAME + " obj=MGF1ParameterSpec val='' exp='' msg='the observed call sequence is not one MGF1ParameterSpecSpec accepts and no creation of the parameters was observed'"));
      }
      else {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "MGF1ParameterSpecSpec", "" + __LOC,
             "v=1 code=MGF1PARAMETERSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=MGF1ParameterSpec val='' exp='' msg='the observed call sequence is not one MGF1ParameterSpecSpec accepts'"));
      }
      __RESET;
   }

   // ENSURES `preparedMGF1[this, mdName]`: the MGF1ParameterSpec names a digest the rule admits,
   // and carries that digest with it. The clause carries no `after L`, so its acceptance point
   // is the accepting state of the ORDER, which in an `ere` is where `@match` runs. Both places
   // are written: the object, and the canonical digest it was built with, staged by `c1` because
   // a handler receives no event arguments.
   //
   // The second place is what makes the consuming clause more than an existence check. The
   // REQUIRES of OAEPParameterSpec.crysl, `preparedMGF1[mgfSpec, mdName]`, asks with the OAEP
   // spec's *own* digest name, so that read compares the two names and refuses an OAEP spec
   // whose digest and whose mask-generation digest disagree. A one-place write here would make
   // that comparison unaskable.
   @match {
      PredicateStore.instance().ensure(Property.PREPARED_MGF1, spec, stagedDigest);
   }

}
