package mop;

import java.security.cert.CertPathParameters;
import javax.net.ssl.CertPathTrustManagerParameters;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * CertPathTrustManagerParametersSpec
 *
 * Monitors javax.net.ssl.CertPathTrustManagerParameters against the CrySL rule
 * CertPathTrustManagerParameters.crysl.
 *
 * The rule's ORDER is `Con`, the single constructor event `c1:
 * CertPathTrustManagerParameters(params);`. It states no CONSTRAINTS. Its one REQUIRES clause,
 * `generatedCertPathParameters[params]`, is read in that event's body, and its one ENSURES
 * clause, `generatedManagerFactoryParameters[this]`, is written at the accepting state and read
 * by `KeyManagerFactorySpec` and `TrustManagerFactorySpec` at their `init` event.
 *
 * This is the middle link of a chain three specifications deep: `PKIXParametersSpec` and
 * `PKIXBuilderParametersSpec` mark the cert path parameters they built -- over a key store
 * `KeyStoreSpec` observed being loaded, or over a set of trust anchors, whose argument no live
 * clause of their rules reads -- and the mark this file writes is what the two factory
 * specifications read.
 *
 * Divergences from the rule and reach limits of this monitor:
 *
 * - The predicate is written only for a construction whose own read answered SATISFIED, so
 *   parameters built over cert path parameters that were not observed carry no mark and are read
 *   downstream as parameters whose construction was not observed.
 * - The `@fail` handler cannot fire, because a one-symbol expression gives a monitor keyed on the
 *   constructed object no second event to refuse.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/CertPathTrustManagerParameters.crysl
 */
CertPathTrustManagerParametersSpec(CertPathTrustManagerParameters s) {

   // Bound only on the conforming branch, which is what carries the object to `@match`.
   CertPathTrustManagerParameters spec;

   // Set by the creation event `c1`. The generated `reset()` does not clear it, so every
   // failure of a monitor that saw no creation reports the `-ORDER-01` code in `@fail`.
   boolean creationObserved = false;

   // `Con` of CertPathTrustManagerParameters.crysl:
   // `c1: CertPathTrustManagerParameters(params);`, and the whole of its ORDER. The platform
   // declares exactly this constructor.
   //
   // REQUIRES of CertPathTrustManagerParameters.crysl: `generatedCertPathParameters[params];`.
   // The predicate says that the PKIX parameters were built over a key store the instrumentation
   // observed being loaded. Its producers in this set are `PKIXParametersSpec` and
   // `PKIXBuilderParametersSpec`, each of which marks the object it constructed where the key
   // store it was built over carried the loading mark, and marks it unconditionally at its
   // trust-anchor constructor, whose argument no live clause of either rule reads.
   //
   // The read sits in the event body and not in a `condition(...)` guard: a guard compiles to an
   // early return ahead of both the body and the transition, so a construction over unprepared
   // parameters would drop out of the automaton silently and a later call would be reported as a
   // wrong call sequence instead of as the unprepared parameters it is. A failed REQUIRES is not
   // a typestate failure; read in the body, the clause accuses about what it saw instead of
   // deciding whether the construction happened.
   //
   // The verdict is three-valued and the two accusing outcomes are different claims, reported
   // under different codes. VIOLATED is positive evidence about this object -- an entry exists
   // whose values differ, or the predicate was revoked by a `negate`. NOT_OBSERVED says only
   // that no entry exists: no `PKIXParameters` or `PKIXBuilderParameters` construction was ever
   // observed for it, which on this platform is as often a limit of what the weaving reaches as
   // a misuse.
   //
   // Only the SATISFIED branch stages the object, so the chain lands whole here: a store nobody
   // loaded produces parameters nobody may trust, and a trust manager parameter object built
   // over those carries no mark on to the two factory specifications.
   event c1 after(CertPathParameters params) returning(CertPathTrustManagerParameters s):
     call(public CertPathTrustManagerParameters.new(CertPathParameters)) &&
     args(params) {
       creationObserved = true;
       PredicateVerdict generated = PredicateStore.instance().validate(Property.GENERATED_CERT_PATH_PARAMETERS, params);
       if (generated == PredicateVerdict.VIOLATED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "CertPathTrustManagerParametersSpec", "" + __LOC,
               "v=1 code=CERTPATHTRUSTMANAGERPARAMETERS-CONSTR-00 ev=" + __EVENTNAME + " obj=CertPathTrustManagerParameters val='' exp='cert path parameters the monitor observed being built' msg='the cert path parameters carry a generation predicate the rule does not admit'"));
       }
       else if (generated == PredicateVerdict.NOT_OBSERVED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "CertPathTrustManagerParametersSpec", "" + __LOC,
               "v=1 code=CERTPATHTRUSTMANAGERPARAMETERS-NOBS-00 ev=" + __EVENTNAME + " obj=CertPathTrustManagerParameters val='' exp='cert path parameters the monitor observed being built' msg='no construction of the cert path parameters was observed'" + Evidence.keysFor(params)));
       }
       else {
           spec = s;
       }
   }

   // `Con := c1` is the whole ORDER, so the `@fail` handler below cannot fire: a single-symbol
   // expression has no second event to take, and the monitor is keyed on the constructed object,
   // so no monitor ever sees one. It is written because the generator expects a handler and
   // because the codes it names are registered in `codes.csv`.
   ere : c1

   @fail {
      if (!creationObserved) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "CertPathTrustManagerParametersSpec", "" + __LOC,
              "v=1 code=CERTPATHTRUSTMANAGERPARAMETERS-ORDER-01 ev=" + __EVENTNAME + " obj=CertPathTrustManagerParameters val='' exp='' msg='the observed call sequence is not one CertPathTrustManagerParametersSpec accepts and no creation of the CertPathTrustManagerParameters was observed'"));
      }
      else {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "CertPathTrustManagerParametersSpec", "" + __LOC,
              "v=1 code=CERTPATHTRUSTMANAGERPARAMETERS-ORDER-00 ev=" + __EVENTNAME + " obj=CertPathTrustManagerParameters val='' exp='' msg='the observed call sequence is not one CertPathTrustManagerParametersSpec accepts'"));
      }
      __RESET;
   }

   // ENSURES of CertPathTrustManagerParameters.crysl:
   // `generatedManagerFactoryParameters[this];`. The predicate says that the parameter object
   // was constructed by a call the instrumentation observed, so a key or trust manager factory
   // may be initialised from it. The clause carries no `after L`, so its acceptance point is the
   // accepting state, which in a specification written as an `ere` is this handler: it fires
   // whenever the trace so far is a word of the expression.
   //
   // The object travels here in a field because a handler receives no event arguments and runs
   // after the transition has been decided. `spec` is staged only where the read in `c1`
   // answered SATISFIED, and `ensure` treats a null binding as a no-op, so parameters whose own
   // origin was not observed do not go on to prepare a manager factory. That is the literal
   // reading of CrySL -- a predicate is ensured for a use that satisfied the rule -- and it is
   // what keeps the chain from carrying an unobserved key store into a trusted manager factory
   // two hops later.
   //
   // The predicate has a second producer in this set, `KeyStoreBuilderParametersSpec`, and two
   // consumers, `KeyManagerFactorySpec` and `TrustManagerFactorySpec`, which read it at their
   // `init` event over an argument whose runtime type is a `ManagerFactoryParameters`.
   @match {
      PredicateStore.instance().ensure(Property.GENERATED_MANAGER_FACTORY_PARAMETERS, spec);
   }

}
