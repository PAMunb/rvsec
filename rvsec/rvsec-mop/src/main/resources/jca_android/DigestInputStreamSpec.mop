package mop;

import java.io.InputStream;
import java.security.DigestInputStream;
import java.security.MessageDigest;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * DigestInputStream
 *
 * A JavaMOP specification of the correct usage of the
 * java.security.DigestInputStream.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/DigestInputStream.crysl
 */
DigestInputStreamSpec(DigestInputStream s) {

   // The envelope's quoting rule (design D-3).
   private String q(String str) {
       if (str == null) {
           return "";
       }
       String value = str.length() > 512 ? str.substring(0, 512) : str;
       return value.replace("'", "\\'");
   }

   // Staged by `c1` on the conforming branch, for the acceptance-point write, which sees no
   // event parameter of its own.
   InputStream wrapped = null;
   MessageDigest digester = null;

   String expectedGeneratedMessageDigest =
       "a MessageDigest this instrumentation observed being obtained";

   // `c1: DigestInputStream(stream, digest)` (:14), the whole of `Con`, and the site of the
   // rule's one REQUIRES.
   //
   // `generatedMessageDigest[digest]` (:33) is read here, three-valued, with a code per
   // accusing outcome (INV-INS-143). Its producer is `MessageDigestSpec`'s `g1`/`g2`/`g3`,
   // which write the predicate at `MessageDigest.crysl:46`'s `after Get` -- a write the
   // transcription had omitted until gh109 task 1.3(b), and one this specification could not
   // have been written before: a read whose producer never fires answers NOT_OBSERVED for
   // every program, which is the shape INV-INS-151 refuses.
   //
   // The two fields are bound on the conforming branch only, so a stream built over a digest
   // nobody watched does not go on to claim it digested anything.
   event c1 after(InputStream stream, MessageDigest digest) returning(DigestInputStream s):
     call(public DigestInputStream.new(InputStream, MessageDigest)) &&
     args(stream, digest) {
       PredicateVerdict generated = PredicateStore.instance().validate(Property.GENERATED_MESSAGE_DIGEST, digest);
       if (generated == PredicateVerdict.VIOLATED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "DigestInputStreamSpec", "" + __LOC,
               "v=1 code=DIGESTINPUTSTREAM-CONSTR-00 ev=" + __EVENTNAME + " obj=DigestInputStream val='' exp='" + q(expectedGeneratedMessageDigest) + "' msg='the message digest carries a generation predicate the rule does not admit'"));
       }
       else if (generated == PredicateVerdict.NOT_OBSERVED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "DigestInputStreamSpec", "" + __LOC,
               "v=1 code=DIGESTINPUTSTREAM-NOBS-00 ev=" + __EVENTNAME + " obj=DigestInputStream val='' exp='" + q(expectedGeneratedMessageDigest) + "' msg='no obtaining of the message digest was observed'"));
       }
       else {
           wrapped = stream;
           digester = digest;
       }
   }

   // `r1: read()` (:17), one alternative of `Read`. The rule states no clause about it.
   event r1 after(DigestInputStream s) returning(int b):
     call(public int DigestInputStream.read()) &&
     target(s) {
   }

   // `r2: read(data, offset, len)` (:18), the other alternative, and the site of the three
   // array-bounds CONSTRAINTS (:28-30).
   //
   // ONLY ONE OF THE THREE IS REACHABLE, and the other two are kept as guards without a
   // code, which is the rule the conventions note fixes for a conjunct the platform refuses
   // first (the R9 measurement on `IvParameterSpec`). `DigestInputStream.read(b, off, len)`
   // delegates to the wrapped stream before it updates the digest, and
   // `InputStream.read(byte[], int, int)` throws `IndexOutOfBoundsException` when
   // `off < 0`, when `len < 0` or when `len > b.length - off`. An `after ... returning`
   // advice never runs for a call that threw, so `offset >= 0` and
   // `length[data] >= offset + len` have no reachable violated branch and a code for either
   // would be an accusation against a program the platform forbids.
   //
   // `len > 0` is the one that survives: `read(b, off, 0)` returns 0 without throwing, and
   // it is a call the rule refuses.
   event r2 after(byte[] data, int offset, int len, DigestInputStream s):
     call(public int DigestInputStream.read(byte[], int, int)) &&
     args(data, offset, len) && target(s) {
       if (len <= 0) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "DigestInputStreamSpec", "" + __LOC,
               "v=1 code=DIGESTINPUTSTREAM-CONSTR-01 ev=" + __EVENTNAME + " obj=DigestInputStream val='" + len + "' exp='a length the expert DigestInputStream.crysl admits' msg='the read length is not one the rule admits'"));
       }
   }

   // `cl1: close()` (:21), the whole of `Close`.
   //
   // `DigestInputStream` does not DECLARE `close()`: it inherits it from
   // `java.io.FilterInputStream`. The pointcut names the subtype anyway, and that is
   // measured rather than assumed -- javac emits the call site's static receiver type as the
   // invoke owner, so `dis.close()` on a variable declared `DigestInputStream` compiles to
   // `invokevirtual java/security/DigestInputStream.close:()V`, which is what both the
   // AspectJ matcher and the DEX matcher read. A pointcut on `FilterInputStream.close()`
   // would instead match every filtered stream in the program.
   event cl1 after(DigestInputStream s):
     call(public void DigestInputStream.close()) &&
     target(s) {
   }

   // The rule's one FORBIDDEN entry, `on(boolean)` (:11). It accuses in its body and moves
   // the automaton nowhere -- a self-loop at every state -- for the reason
   // `SSLContextSpec.getDefault` and `PBEKeySpecSpec` both record: making a forbidden call
   // an alternative position of the ordering is the opposite of what FORBIDDEN says. The
   // `fsm` is what lets an event self-loop; an `ere` cannot spell it, which is why this file
   // has one where its siblings have an `ere`.
   event on after(boolean flag, DigestInputStream s):
     call(public void DigestInputStream.on(boolean)) &&
     args(flag) && target(s) {
       ErrorCollector.instance().addError(new ErrorDescription(ErrorType.ForbiddenMethod, "DigestInputStreamSpec", "" + __LOC,
           "v=1 code=DIGESTINPUTSTREAM-FORB-00 ev=" + __EVENTNAME + " obj=DigestInputStream val='" + flag + "' exp='no call at all' msg='DigestInputStream.on(boolean) is forbidden by the expert DigestInputStream.crysl'"));
   }

   // The rule's ORDER, `Con, Read+, Close` (:25), with the forbidden call self-looping at
   // every state. The `+` is checked against the R4 lesson: neither `r1` nor `r2` erases to
   // nothing against the rule's alphabet -- both stand for a labelled `Read` of the rule --
   // so the `+` here means what it looks like.
   fsm :
     start [
       c1 -> opened
       on -> start
     ]
     opened [
       r1 -> reading
       r2 -> reading
       on -> opened
     ]
     reading [
       r1 -> reading
       r2 -> reading
       cl1 -> closed
       on -> reading
     ]
     closed [
       on -> closed
     ]

   alias match = closed

   @fail {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "DigestInputStreamSpec", "" + __LOC,
          "v=1 code=DIGESTINPUTSTREAM-ORDER-00 ev=" + __EVENTNAME + " obj=DigestInputStream val='' exp='' msg='the observed call sequence is not one DigestInputStreamSpec accepts'"));
      wrapped = null;
      digester = null;
      __RESET;
   }

   // `ENSURES digestedInputStream[stream, digest]` (:36), with no `after L`, so the
   // acceptance point is the accepting state (INV-INS-134) -- here the state a `close()`
   // leads to, which is what the rule's ORDER makes accepting.
   //
   // No rule of the pinned oracle REQUIRES `digestedInputStream`. The write stands because
   // the rule ENSURES it and coverage is the obligation; no reader is fabricated for it
   // (INV-INS-137) and the graph carries the omission.
   @match {
      if (wrapped != null && digester != null) {
          PredicateStore.instance().ensure(Property.DIGESTED_INPUT_STREAM, wrapped, digester);
          wrapped = null;
          digester = null;
      }
   }

}
