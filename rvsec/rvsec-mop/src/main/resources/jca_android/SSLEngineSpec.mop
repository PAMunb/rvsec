package mop;

import javax.net.ssl.SSLEngine;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * SSLEngineSpec
 *
 * Monitors javax.net.ssl.SSLEngine against the CrySL rule SSLEngine.crysl.
 * The rule orders `(EnableCipher, EnableProtocol) | (EnableProtocol, EnableCipher)`: both
 * `setEnabledCipherSuites` and `setEnabledProtocols`, in either order, and neither alone. Its
 * CONSTRAINTS are three: `elements(protocols) in {"TLSv1.2", "TLSv1.3"}` over the enabled
 * protocols, and two implications whose antecedent is the protocol selection and whose
 * consequent is the list of cipher suites admitted beside it. It ENSURES
 * `generatedSSLEngine[this]`, which this specification writes at its acceptance point.
 *
 * The rule binds one of its two event labels to a name it declares nowhere: its EVENTS state
 * `EnableProtocol := cp1;`, while the only events it declares are
 * `ec1: setEnabledCipherSuites(cipherSuites)` and `ep1: setEnabledProtocols(protocols)`. This
 * specification realises `EnableProtocol` with `setEnabledProtocols`, the call `ep1` declares.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/SSLEngine.crysl
 */
SSLEngineSpec(SSLEngine eng) {

   // The report envelope's quoting rule.
   private String q(String str) {
       if (str == null) {
           return "";
       }
       String value = str.length() > 512 ? str.substring(0, 512) : str;
       return value.replace("'", "\\'");
   }

   // `elements(x) in {...}` is a clause about EVERY element of the array, so what a report
   // has to carry is the element that broke it and not the array. This returns the first
   // such element, or null when the clause holds -- which is also what makes the accusing
   // branch a single `if` at the site instead of a loop with a report inside it.
   //
   // An empty array satisfies the clause vacuously and returns null, which is the literal
   // reading: `elements(protocols) in {...}` quantifies over the elements there are.
   //
   // The comparison goes through `ConscryptAliasTable.matches` for the case folding it applies
   // to every allow-list of this set. The table carries no row under the `SSLEngine` service,
   // so nothing is resolved here: an element matches a list entry, or it does not.
   private String firstRejected(String[] values, List<String> allowList) {
       if (values == null) {
           return null;
       }
       for (String value : values) {
           if (!ConscryptAliasTable.matches("SSLEngine", value, allowList)) {
               return value;
           }
       }
       return null;
   }

   // The ANTECEDENT of the two suite implications: `elements(protocols) in {"TLSv1.2"}` holds
   // when every enabled protocol is that one protocol, and likewise for `"TLSv1.3"`.
   //
   // An empty array is treated as NOT selecting the protocol, which is the one place this
   // file departs from the vacuous reading above, and deliberately: read vacuously, an empty
   // `protocols` would satisfy BOTH antecedents at once and the same suite list would be
   // accused of failing two mutually exclusive consequents. An engine with no enabled
   // protocol negotiates nothing, so neither implication is about it.
   private boolean allProtocolsAre(String[] values, String only) {
       if (values == null || values.length == 0) {
           return false;
       }
       for (String value : values) {
           if (!only.equalsIgnoreCase(value)) {
               return false;
           }
       }
       return true;
   }

   // CONSTRAINTS of SSLEngine.crysl: `elements(protocols) in {"TLSv1.2", "TLSv1.3"}`,
   // transcribed. These are wire protocol names as `setEnabledProtocols` takes them, not the
   // JSSE service names `SSLContext.getInstance` takes, so the `TLS` entry that the allow-list
   // of `SSLContextSpec` carries has no counterpart here: no provider spells an enabled
   // protocol `TLS`. What the clause accuses is a program that NARROWS an engine to TLSv1,
   // TLSv1.1 or SSLv3; the platform enables TLSv1.2 and TLSv1.3 by default, so an engine
   // nobody narrows never reaches the `setEnabledProtocols` event at all.
   List<String> safeProtocols = Arrays.asList("TLSv1.2", "TLSv1.3");

   // The consequent of the first CONSTRAINTS implication of SSLEngine.crysl,
   // `elements(protocols) in {"TLSv1.2"} => elements(cipherSuites) in {...}`: the suites the
   // rule admits beside TLSv1.2, transcribed literally and in the rule's own order.
   List<String> tls12Suites = Arrays.asList(
       "TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384",
       "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256",
       "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
       "TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256",
       "TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA384",
       "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
       "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
       "TLS_DHE_DSS_WITH_AES_128_CBC_SHA256",
       "TLS_DHE_DSS_WITH_AES_256_CBC_SHA256",
       "TLS_DHE_DSS_WITH_AES_128_GCM_SHA256",
       "TLS_DHE_DSS_WITH_AES_256_GCM_SHA384",
       "TLS_DHE_RSA_WITH_AES_128_CBC_SHA256",
       "TLS_DHE_RSA_WITH_AES_256_CBC_SHA256",
       "TLS_DHE_RSA_WITH_AES_128_GCM_SHA256",
       "TLS_DHE_RSA_WITH_AES_256_GCM_SHA384",
       "TLS_ECDH_ECDSA_WITH_AES_128_CBC_SHA256",
       "TLS_ECDH_ECDSA_WITH_AES_256_CBC_SHA384",
       "TLS_ECDH_ECDSA_WITH_AES_128_GCM_SHA256",
       "TLS_ECDH_ECDSA_WITH_AES_256_GCM_SHA384",
       "TLS_ECDH_RSA_WITH_AES_128_CBC_SHA256",
       "TLS_ECDH_RSA_WITH_AES_256_CBC_SHA384",
       "TLS_ECDH_RSA_WITH_AES_128_GCM_SHA256",
       "TLS_ECDH_RSA_WITH_AES_256_GCM_SHA384");

   // The consequent of the second CONSTRAINTS implication of SSLEngine.crysl,
   // `elements(protocols) in {"TLSv1.3"} => elements(cipherSuites) in {"TLS_AES_128_GCM_SHA256",
   // "TLS_AES_256_GCM_SHA384"}`. The rule names no others, so the platform's third default
   // suite for TLSv1.3, the ChaCha20-Poly1305 one, is accused by this specification. That is
   // the clause as it stands and not a transcription slip: the same two suites, and only those
   // two, are what the rule admits.
   List<String> tls13Suites = Arrays.asList("TLS_AES_128_GCM_SHA256", "TLS_AES_256_GCM_SHA384");

   // The two arrays the events bind, staged because the two suite implications name BOTH of
   // them and the rule's ORDER admits either call first: whichever event fires second is the
   // one that can evaluate them, so each event must be able to.
   //
   // The arrays are staged as the caller passed them -- no copy. What the clause is about is
   // the array this call handed over, and a program that mutates it afterwards has changed the
   // object the accusation was about.
   String[] enabledProtocols = null;
   String[] enabledCipherSuites = null;

   // Bound by both events and consumed by the acceptance handler, which sees no event
   // parameter. Unlike the producer specifications of this set the binding is NOT confined
   // to a conforming branch, and it cannot be: no single event of this rule decides
   // conformance, because the implications span the two. `conforms` carries that decision
   // across them and the handler gates the write on it -- same reading of CrySL ("a
   // predicate is ensured for a use that satisfied the rule"), different mechanism, because
   // the clause has a different shape.
   SSLEngine engine = null;
   boolean conforms = true;

   String expectedTls12Suites = "a cipher suite the expert SSLEngine.crysl admits beside TLSv1.2";

   String expectedTls13Suites = "a cipher suite the expert SSLEngine.crysl admits beside TLSv1.3";

   // `EnableCipher := ec1` of SSLEngine.crysl: `ec1: setEnabledCipherSuites(cipherSuites)`.
   //
   // No clause of the rule constrains the suites on their own: both suite clauses are
   // implications whose antecedent is about the protocols, so this event stages its array and
   // then evaluates the pair -- but only when the protocols have already been seen. When this
   // call comes first the guard is false and nothing is accused here; the `ep1` that completes
   // the ordering carries the same block and accuses there instead. A suite outside the list
   // admitted beside the selected protocol is reported under the code registered in
   // `codes.csv` for this site, and the engine is marked as non-conforming for the acceptance
   // handler.
   //
   // The check sits in the event body and not in a `condition(...)` guard: a guard compiles to
   // an early return ahead of both the body and the transition, so a call enabling a suite the
   // rule refuses would leave the automaton in the state before it and the next call would be
   // reported as a wrong call sequence instead of as the weak suite it is.
   //
   // The two implications are `if`/`else if` because their antecedents are mutually exclusive
   // by construction -- every protocol is TLSv1.2, or every protocol is TLSv1.3 -- so at most
   // one of them has anything to say about any one engine.
   event ec1 after(String[] cipherSuites, SSLEngine eng):
     call(public void SSLEngine.setEnabledCipherSuites(String[])) &&
     args(cipherSuites) && target(eng) {
       engine = eng;
       enabledCipherSuites = cipherSuites;
       if (enabledProtocols != null) {
           if (allProtocolsAre(enabledProtocols, "TLSv1.2")) {
               String rejected = firstRejected(enabledCipherSuites, tls12Suites);
               if (rejected != null) {
                   conforms = false;
                   ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SSLEngineSpec", "" + __LOC,
                       "v=1 code=SSLENGINE-ALG-00 ev=" + __EVENTNAME + " obj=SSLEngine val='" + q(rejected) + "' exp='" + q(expectedTls12Suites) + "' msg='the enabled cipher suites are not ones the expert SSLEngine.crysl admits beside that protocol'"));
               }
           }
           else if (allProtocolsAre(enabledProtocols, "TLSv1.3")) {
               String rejected = firstRejected(enabledCipherSuites, tls13Suites);
               if (rejected != null) {
                   conforms = false;
                   ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SSLEngineSpec", "" + __LOC,
                       "v=1 code=SSLENGINE-ALG-01 ev=" + __EVENTNAME + " obj=SSLEngine val='" + q(rejected) + "' exp='" + q(expectedTls13Suites) + "' msg='the enabled cipher suites are not ones the expert SSLEngine.crysl admits beside that protocol'"));
               }
           }
       }
   }

   // `EnableProtocol` of SSLEngine.crysl, realised with `ep1: setEnabledProtocols(protocols)`.
   // The rule's EVENTS bind that label to `cp1`, a name the rule declares nowhere; the only
   // events it declares are `ec1` and `ep1`, and this is the one that binds the protocols the
   // label is about.
   //
   // The unconditional protocol clause, `elements(protocols) in {"TLSv1.2", "TLSv1.3"}`, is
   // accused HERE, at the one event that binds the array it quantifies over, and in the body
   // rather than in a `condition(...)`: a guard compiles to an early return ahead of both the
   // body and the transition, so an engine narrowed to a protocol the rule refuses would drop
   // out of the automaton silently and the `setEnabledCipherSuites` that completes the
   // ordering would be reported as a wrong call sequence instead. The suite block below is the
   // twin of `ec1`'s, for the other call order.
   event ep1 after(String[] protocols, SSLEngine eng):
     call(public void SSLEngine.setEnabledProtocols(String[])) &&
     args(protocols) && target(eng) {
       engine = eng;
       enabledProtocols = protocols;
       String rejectedProtocol = firstRejected(enabledProtocols, safeProtocols);
       if (rejectedProtocol != null) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeProtocol, "SSLEngineSpec", "" + __LOC,
               "v=1 code=SSLENGINE-PROTO-00 ev=" + __EVENTNAME + " obj=SSLEngine val='" + q(rejectedProtocol) + "' exp='" + q(String.join(",", safeProtocols)) + "' msg='expecting one of " + String.join(",", safeProtocols) + " but found " + rejectedProtocol + "'"));
       }
       if (enabledCipherSuites != null) {
           if (allProtocolsAre(enabledProtocols, "TLSv1.2")) {
               String rejected = firstRejected(enabledCipherSuites, tls12Suites);
               if (rejected != null) {
                   conforms = false;
                   ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SSLEngineSpec", "" + __LOC,
                       "v=1 code=SSLENGINE-ALG-02 ev=" + __EVENTNAME + " obj=SSLEngine val='" + q(rejected) + "' exp='" + q(expectedTls12Suites) + "' msg='the enabled cipher suites are not ones the expert SSLEngine.crysl admits beside that protocol'"));
               }
           }
           else if (allProtocolsAre(enabledProtocols, "TLSv1.3")) {
               String rejected = firstRejected(enabledCipherSuites, tls13Suites);
               if (rejected != null) {
                   conforms = false;
                   ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SSLEngineSpec", "" + __LOC,
                       "v=1 code=SSLENGINE-ALG-03 ev=" + __EVENTNAME + " obj=SSLEngine val='" + q(rejected) + "' exp='" + q(expectedTls13Suites) + "' msg='the enabled cipher suites are not ones the expert SSLEngine.crysl admits beside that protocol'"));
               }
           }
       }
   }

   // The rule's ORDER, `(EnableCipher, EnableProtocol) | (EnableProtocol, EnableCipher)`: both
   // calls, in either order, and neither alone. The alternation is the rule's own and is why
   // the two suite blocks above are twins rather than one block in one place -- the second
   // call to arrive is the one that can compare the two arrays, and the rule does not say
   // which that is.
   ere : (ec1 ep1) | (ep1 ec1)

   // A call sequence the ORDER refuses -- one of the two calls without the other, or either of
   // them twice. The staged arrays and the verdict are discarded here, so nothing an event of
   // the refused sequence staged can reach the acceptance handler after the reset.
   @fail {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SSLEngineSpec", "" + __LOC,
          "v=1 code=SSLENGINE-ORDER-00 ev=" + __EVENTNAME + " obj=SSLEngine val='' exp='' msg='the observed call sequence is not one SSLEngineSpec accepts'"));
      engine = null;
      enabledProtocols = null;
      enabledCipherSuites = null;
      conforms = true;
      __RESET;
   }

   // ENSURES `generatedSSLEngine[this]`: the `SSLEngine` was produced or configured by a call
   // the instrumentation observed. The clause carries no `after L`, so its acceptance point is
   // an accepting state of the ORDER, which in an `ere` is where this handler runs.
   //
   // The engine reaches the handler through the monitor field because a handler receives no
   // event arguments and runs after the transition is decided, and the write is gated on
   // `conforms` because that is where the verdict of the two implications lives: no single
   // event of this rule decides conformance, since the implications span both calls.
   //
   // `SSLContextSpec` writes the same predicate over the engine `createSSLEngine` returned. No
   // rule of the set REQUIRES it, so both writes stand for coverage of the rule and no reader
   // consumes them.
   @match {
      if (conforms && engine != null) {
          PredicateStore.instance().ensure(Property.GENERATE_SSL_ENGINE, engine);
      }
   }

}
