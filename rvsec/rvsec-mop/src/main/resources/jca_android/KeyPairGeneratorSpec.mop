package mop;

import java.security.KeyPair;
import java.security.KeyPairGenerator;
import java.security.SecureRandom;
import java.security.spec.AlgorithmParameterSpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * KeyPairGeneratorSpec
 *
 * Monitors java.security.KeyPairGenerator against the CrySL rule KeyPairGenerator.crysl.
 *
 * ORDER. The rule orders `Get, Init, Gen`: a `getInstance`, one `initialize`, then
 * `generateKeyPair()` or `genKeyPair()`. The `initialize` is mandatory, as the rule writes it.
 * A sequence the automaton does not accept is reported under `KEYPAIRGENERATOR-ORDER-01` when
 * no `getInstance` of the generator was observed, under `KEYPAIRGENERATOR-ORDER-02` when the
 * observed `getInstance` asked for an algorithm this specification refuses, and under
 * `KEYPAIRGENERATOR-ORDER-00` otherwise. The codes are registered in `codes.csv`.
 *
 * CONSTRAINTS. All five clauses of the rule are checked.
 * `algorithm in {"RSA", "EC", "DSA", "DiffieHellman", "DH"}` is transcribed in
 * `safeAlgorithms` and accused at `g3` and `g4`, the refused twins of the two `getInstance`
 * events, under `KEYPAIRGENERATOR-ALG-00` and `-ALG-01`.
 * The four key-size clauses -- `algorithm in {"RSA"} => keysize in {4096, 3072, 2048}`,
 * `algorithm in {"DSA"} => keysize in {2048}`, `algorithm in {"DiffieHellman", "DH"} =>
 * keysize in {2048}` and `algorithm in {"EC"} => keysize in {256}` -- are transcribed in
 * `validate(int)` and accused at `initError` and `initError2` under
 * `KEYPAIRGENERATOR-KEYSIZE-00` and `-KEYSIZE-01`.
 *
 * REQUIRES four guarded clauses -- `algorithm in {"RSA"} => preparedRSA[params];` and its DSA,
 * DH and EC twins -- read at `init3` and `init4` over the `AlgorithmParameterSpec` the call
 * carries, with the generator's algorithm selecting which of the four applies. Their producers
 * are `RSAKeyGenParameterSpecSpec`, `DSAParameterSpecSpec`, `DHParameterSpecSpec`, and
 * `ECParameterSpecSpec`/`ECGenParameterSpecSpec`.
 *
 * ENSURES `generatedKeypair[keyPair, algorithm];`, written at the accepting state over the
 * pair the generating call returned: the key pair was produced by a `KeyPairGenerator` the
 * instrumentation observed.
 *
 * Reach limits and divergences from the rule.
 * - The ENSURES is written with one place where the rule writes two. No rule this set
 *   transcribes requires `generatedKeypair`, so nothing reads the algorithm place; the write
 *   records a fact and no site consumes it.
 * - A key size is accused only when a `getInstance` of the generator was observed: `init1`,
 *   `init2`, `initError` and `initError2` are all guarded on `algorithm != null`, so an
 *   `initialize(int)` on a generator this specification never saw created matches no event at
 *   all, takes no transition, and leaves the generating call that follows to be reported as a
 *   wrong call sequence.
 * - A generator whose algorithm this specification refused draws, besides the algorithm code,
 *   a `KEYPAIRGENERATOR-KEYSIZE-00` on its next `initialize(int)` -- `validate` answers false
 *   for an algorithm the rule does not name -- and the ordering code, because the automaton
 *   wants an admitted `getInstance` before any `Init`. The algorithm code is the one of the
 *   three that names the misuse.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/KeyPairGenerator.crysl
 */
KeyPairGeneratorSpec(KeyPairGenerator k) {
    // The quoting rule of the report envelope: a null value is the empty string, a single
    // quote is escaped so it cannot close the field early, and the value is capped so a
    // pathological argument cannot push the record past the logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    // The rule's first CONSTRAINTS clause, transcribed entry for entry:
    // `algorithm in {"RSA", "EC", "DSA", "DiffieHellman", "DH"}`. Both spellings of
    // Diffie-Hellman are the clause's own. `ConscryptAliasTable.matches("KeyPairGenerator",
    // ...)` compares case-insensitively and resolves a provider alias -- an OID, for instance
    // -- to its canonical name before comparing, so a call that spells `RSA` as
    // `1.2.840.113549.1.1.1` is admitted as `RSA`. The list is also what the report shows as
    // the expected value.
    List<String> safeAlgorithms = Arrays.asList("RSA", "EC", "DSA", "DiffieHellman", "DH");

    // Staged by `gen` for the acceptance-point handler, which sees no event parameter, and
    // cleared the moment it is used or the sequence is rejected.
    KeyPair kp = null;

    // The algorithm a `getInstance` was handed, as the program spelled it. All four creation
    // events write it, the refused twins included, and nothing clears it. Every later site
    // selects its clause by it: `validate(int)` and `requiredPreparation()` both resolve it
    // through `ConscryptAliasTable`, and the four `initialize` events test it for null, which
    // is the case where no `getInstance` of this generator was observed and no clause applies.
    String algorithm;

    // Set by the four creation events, `g1` to `g4`, the refused twins included, and never
    // cleared: the generated `reset()` restores the automaton state and leaves this field, so
    // the fact survives a failure. `@fail` reads it to report a generator whose creation no
    // event of this specification observed under `KEYPAIRGENERATOR-ORDER-01`
    // (`creation-unobserved`) instead of the wrong-sequence code.
    boolean creationObserved = false;

    // Set by the refused twins `g3` and `g4` and never cleared. `@fail` reads it to report a
    // failure of a generator whose `getInstance` asked for an algorithm the rule refuses under
    // `KEYPAIRGENERATOR-ORDER-02` (`creation-refused`): the `ere` wants an admitted `getInstance`
    // before any Init, so no use of such a generator is admitted, and its ordering failure is the
    // consequence of the refusal `g3` or `g4` already reported. Like `creationObserved`, it
    // survives the generated `reset()`.
    boolean creationRefused = false;

    private boolean validate(int keySize) {
      // The four key-size clauses of KeyPairGenerator.crysl, transcribed one branch each:
      // `algorithm in {"RSA"} => keysize in {4096, 3072, 2048}`,
      // `algorithm in {"DSA"} => keysize in {2048}`,
      // `algorithm in {"DiffieHellman", "DH"} => keysize in {2048}` and
      // `algorithm in {"EC"} => keysize in {256}`.
      //
      // The algorithm is resolved through `ConscryptAliasTable` and then upper-cased, so the
      // two spellings of the Diffie-Hellman clause reach the same branch and an alias reaches
      // the branch of the name it denotes. An algorithm none of the four clauses names falls
      // through to `false`, which is why the callers of this helper are guarded on an observed
      // creation: without that guard a generator built for an algorithm outside the rule's
      // list would be accused of a key size no clause of the rule states for it.
      switch(ConscryptAliasTable.canonical("KeyPairGenerator", algorithm).toUpperCase()) {
        case "RSA": return Arrays.asList(4096, 3072, 2048).contains(keySize);
        case "DSA": return keySize == 2048;
        case "DIFFIEHELLMAN":
        case "DH": return keySize == 2048;
        case "EC": return keySize == 256;
      }
      return false;
    }

    // Which of the rule's four guarded REQUIRES clauses -- `algorithm in {"RSA"} =>
    // preparedRSA[params];`, `algorithm in {"DSA"} => preparedDSA[params];`,
    // `algorithm in {"DiffieHellman", "DH"} => preparedDH[params];` and
    // `algorithm in {"EC"} => preparedEC[params];` -- applies to the `params` an `initialize`
    // was handed. The guard is the rule's own: the algorithm selects the clause, and an
    // algorithm none of the four names -- or one this instrumentation never observed, which is
    // the same case -- selects none, so `null` is the answer that means *no clause applies
    // here*. Read at `init3` and `init4`, where the reads are explained; it is declared up
    // here because javamop's parser takes the declaration block before the first `event` and
    // nothing after it.
    private Property requiredPreparation() {
        if (algorithm == null) {
            return null;
        }
        switch (ConscryptAliasTable.canonical("KeyPairGenerator", algorithm).toUpperCase()) {
            case "RSA": return Property.PREPARED_RSA;
            case "DSA": return Property.PREPARED_DSA;
            case "DIFFIEHELLMAN":
            case "DH": return Property.PREPARED_DH;
            case "EC": return Property.PREPARED_EC;
        }
        return null;
    }

    // The name the report shows for the predicate the selected clause requires. It is the
    // rule's own spelling and not the enum constant's, because the reader who follows a
    // report back is reading KeyPairGenerator.crysl.
    private String preparationName(Property required) {
        if (required == Property.PREPARED_RSA) { return "preparedRSA"; }
        if (required == Property.PREPARED_DSA) { return "preparedDSA"; }
        if (required == Property.PREPARED_DH) { return "preparedDH"; }
        return "preparedEC";
    }

    // `Get` of KeyPairGenerator.crysl: `g1: getInstance(algorithm);`, under the guard that
    // admits the CONSTRAINTS clause `algorithm in {"RSA", "EC", "DSA", "DiffieHellman", "DH"}`.
    // The body records that a creation was observed and keeps the requested name, which is
    // what every later site of this specification selects its clause by: `validate(int)` and
    // `requiredPreparation()` both read `algorithm`, and the four `initialize` events test it
    // for null before they do anything. The calls this guard turns down are taken by `g3`.
    event g1 after(String alg) returning(KeyPairGenerator k):
      call(public static KeyPairGenerator KeyPairGenerator.getInstance(String)) &&
      args(alg) &&
      condition(ConscryptAliasTable.matches("KeyPairGenerator", alg, safeAlgorithms)) {
        creationObserved = true;
        algorithm = alg;
    }

    // `Get` of KeyPairGenerator.crysl: `g2: getInstance(algorithm, _);`, under the same
    // admitting guard as `g1` and with the same body.
    //
    // `Object+` covers both two-argument `getInstance` overloads the platform declares --
    // `(String, String)` for the provider's name and `(String, Provider)` for the object -- in
    // one pointcut, so no second event is spent on the same `Get`. It is `Object+` and not
    // `..` on purpose: the trace harness's resolver walks the declared parameter types of a
    // `call(...)` signature and stops at the first wildcard, so a wildcard here would make
    // every `getInstance` fit this pointcut, while `Object+` keeps the arity known and the
    // second position typed. The calls this guard turns down are taken by `g4`.
    event g2 after(String alg, Object provider) returning(KeyPairGenerator k):
      call(public static KeyPairGenerator KeyPairGenerator.getInstance(String, Object+)) &&
      args(alg, provider) &&
      condition(ConscryptAliasTable.matches("KeyPairGenerator", alg, safeAlgorithms)) {
        creationObserved = true;
        algorithm = alg;
    }

    // The refused twin of `g1`: the same one-argument pointcut, the rule's
    // `g1: getInstance(algorithm);`, under the negated guard, and the site of the CONSTRAINTS
    // clause `algorithm in {"RSA", "EC", "DSA", "DiffieHellman", "DH"}`. A name outside the
    // list is reported here under `KEYPAIRGENERATOR-ALG-00`, registered in `codes.csv`.
    //
    // The clause is accused by a separate event rather than by a `condition(...)` on `g1`
    // alone: a guard compiles to an early return ahead of both the body and the transition, so
    // a refused algorithm would run no body, make no report, and leave the generator at the
    // state before the call, where its next call would be reported as a wrong call sequence
    // instead of as the unsafe algorithm it is. Splitting the pointcut on the sign of the
    // guard gives the refused call a symbol of its own, a body that accuses, and a place in
    // the automaton.
    //
    // Two further reports follow a refused algorithm, and a reader should read them as
    // consequences of this one. `validate(int)` has no answer for an algorithm the rule does
    // not name, so the next `initialize(int)` draws `KEYPAIRGENERATOR-KEYSIZE-00`; and the
    // automaton wants an admitted `getInstance` before any `Init`, so the sequence also draws
    // an ordering code. This event's report is the one that names the misuse.
    event g3 after(String alg) returning(KeyPairGenerator k):
      call(public static KeyPairGenerator KeyPairGenerator.getInstance(String)) &&
      args(alg) &&
      condition(!ConscryptAliasTable.matches("KeyPairGenerator", alg, safeAlgorithms)) {
        creationObserved = true;
        creationRefused = true;
        algorithm = alg;
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "KeyPairGeneratorSpec", "" + __LOC,
            "v=1 code=KEYPAIRGENERATOR-ALG-00 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + q(alg) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + alg + "'"));
    }

    // The refused twin of `g2`: the same two-argument pointcut, the rule's
    // `g2: getInstance(algorithm, _);`, under the negated guard, and the same CONSTRAINTS
    // clause one arity over. A name outside the list is reported here under
    // `KEYPAIRGENERATOR-ALG-01`, registered in `codes.csv`.
    //
    // The clause needs a site at both arities. `g2`'s guard is positive and `g3`'s pointcut is
    // one-argument, so without this event a refused algorithm passed through
    // `getInstance(alg, provider)` would match no event of this specification at all -- and
    // more than the value report would be lost. `algorithm` is the field `init1`, `init2`,
    // `initError` and `initError2` all test for null before they do anything, so the generator
    // would go on unbound and the specification would stay silent for it: no algorithm code,
    // no key-size code, not even the ordering report.
    //
    // `algorithm = alg` is written here exactly as `g3` writes it, so the two arities answer
    // the same thing to the same misuse, and the two consequent reports `g3` describes follow
    // a refused algorithm through this route as well.
    //
    // `Object+` and the explicit `args(alg, provider)` are `g2`'s, for `g2`'s reason: the
    // pointcut covers both two-argument overloads the platform declares, and a `..` wildcard
    // would make every `getInstance` fit it.
    event g4 after(String alg, Object provider) returning(KeyPairGenerator k):
      call(public static KeyPairGenerator KeyPairGenerator.getInstance(String, Object+)) &&
      args(alg, provider) &&
      condition(!ConscryptAliasTable.matches("KeyPairGenerator", alg, safeAlgorithms)) {
        creationObserved = true;
        creationRefused = true;
        algorithm = alg;
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "KeyPairGeneratorSpec", "" + __LOC,
            "v=1 code=KEYPAIRGENERATOR-ALG-01 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + q(alg) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + alg + "'"));
    }

    // `Init` of KeyPairGenerator.crysl: `i1: initialize(keysize);`, on the route where the key
    // size satisfies the clause the generator's algorithm selects. The guard is what selects
    // between this event and `initError`, its accusing twin over the same call: both are
    // symbols of the automaton, so the call takes its `Init` transition either way and a
    // refused key size is reported as the misuse it is rather than as a wrong call sequence.
    //
    // `algorithm != null` is the other half of the guard. When no `getInstance` of this
    // generator was observed, neither this event nor `initError` matches, the call takes no
    // transition at all, and the report that follows is the ordering one.
    event init1 after(int keySize, KeyPairGenerator k):
      call(public void KeyPairGenerator.initialize(int)) &&
      args(keySize) &&
      target(k) &&
      condition(algorithm != null && validate(keySize)) { }

    // `Init` of KeyPairGenerator.crysl: `i2: initialize(keysize, _);`, on the route where the
    // key size satisfies the clause the generator's algorithm selects. Same guard, same empty
    // body and same accusing twin arrangement as `init1`, one overload over: `initError2`
    // takes the calls this guard turns down. The rule states nothing about the `SecureRandom`
    // this overload carries, so the event binds it and checks nothing over it.
    event init2 after(int keySize, SecureRandom random, KeyPairGenerator k):
      call(public void KeyPairGenerator.initialize(int, SecureRandom)) &&
      args(keySize, random) &&
      target(k) &&
      condition(algorithm != null && validate(keySize)) { }

    // `Init` of KeyPairGenerator.crysl: `i3: initialize(params);`, and the site of the rule's
    // four guarded REQUIRES clauses -- `algorithm in {"RSA"} => preparedRSA[params];`,
    // `algorithm in {"DSA"} => preparedDSA[params];`,
    // `algorithm in {"DiffieHellman", "DH"} => preparedDH[params];` and
    // `algorithm in {"EC"} => preparedEC[params];`.
    //
    // What each read asks is what its producer writes: that the parameter spec carries values
    // the rule admits, checked where it was constructed. `RSAKeyGenParameterSpecSpec` writes
    // `preparedRSA` for a key size and public exponent the rule admits, `DSAParameterSpecSpec`
    // writes `preparedDSA` for an admitted modulus and generator, `DHParameterSpecSpec` writes
    // `preparedDH` for admitted Diffie-Hellman parameters, and `ECParameterSpecSpec` and
    // `ECGenParameterSpecSpec` write `preparedEC` for an admitted curve.
    //
    // The clause is guarded, so the read is too: the algorithm selects which of the four
    // predicates is required, and a `params` handed to a generator whose algorithm none of the
    // four clauses names reaches no read at all. `algorithm` is null when no `getInstance` of
    // this generator was observed, and that is the same no-clause-applies case -- the rule
    // states the requirement per algorithm, and an unobserved algorithm selects nothing.
    //
    // The read is in the event body and not in a `condition(...)` guard: a guard compiles to
    // an early return ahead of both the body and the transition, so an unprepared parameter
    // spec would leave the generator at the state before `initialize` and the generating call
    // that follows would be reported as a wrong call sequence instead of as the unsatisfied
    // requirement it is.
    //
    // The verdict is three-valued and its two accusing outcomes are different claims, so they
    // carry different codes. VIOLATED says the store holds an entry for this parameter object
    // and what it records is not what the clause demands -- the producing specification saw it
    // built and refused it -- and is reported under `KEYPAIRGENERATOR-CONSTR-00`.
    // NOT_OBSERVED says only that nothing about the object was ever recorded, which happens
    // when its construction was not woven or runs inside a library the weaving does not reach,
    // and is reported under `KEYPAIRGENERATOR-NOBS-00`. Folding them together would count a
    // reach limit as a misuse. `init4` is a site of its own and carries codes of its own, so a
    // reader can tell which overload a report is about. All four codes are registered in
    // `codes.csv`.
    event init3 after(AlgorithmParameterSpec params, KeyPairGenerator k):
      call(public void KeyPairGenerator.initialize(AlgorithmParameterSpec)) &&
      args(params) &&
      target(k)  {
        Property required = requiredPreparation();
        PredicateVerdict prepared = PredicateVerdict.SATISFIED;
        // Each branch names its predicate as a literal `Property` constant rather than passing
        // the one `requiredPreparation()` returned, so that each of the four clauses has a
        // visible site in the source at the store call that realises it. The four-way `if` is
        // what that costs.
        if (required == Property.PREPARED_RSA) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_RSA, params);
        }
        else if (required == Property.PREPARED_DSA) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_DSA, params);
        }
        else if (required == Property.PREPARED_DH) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_DH, params);
        }
        else if (required == Property.PREPARED_EC) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_EC, params);
        }
        if (required != null && prepared == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyPairGeneratorSpec", "" + __LOC,
                "v=1 code=KEYPAIRGENERATOR-CONSTR-00 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + q(algorithm) + "' exp='" + q(preparationName(required)) + "' msg='the AlgorithmParameterSpec given to KeyPairGenerator.initialize carries a preparation predicate the rule does not admit'"));
        }
        else if (required != null && prepared == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyPairGeneratorSpec", "" + __LOC,
                "v=1 code=KEYPAIRGENERATOR-NOBS-00 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + q(algorithm) + "' exp='" + q(preparationName(required)) + "' msg='no preparation of the AlgorithmParameterSpec given to KeyPairGenerator.initialize was observed'" + Evidence.keysFor(params)));
        }
    }

    // `Init` of KeyPairGenerator.crysl: `i4: initialize(params, _);`, and the second site of
    // the rule's four guarded REQUIRES clauses -- `algorithm in {"RSA"} =>
    // preparedRSA[params];`, `algorithm in {"DSA"} => preparedDSA[params];`,
    // `algorithm in {"DiffieHellman", "DH"} => preparedDH[params];` and
    // `algorithm in {"EC"} => preparedEC[params];`.
    //
    // Everything the reads do is what `init3` does, over the same parameter object one
    // overload later: the generator's algorithm selects which of the four predicates is
    // required, an algorithm none of them names selects none and reaches no read, and the
    // reads sit in the event body and not in a `condition(...)` guard -- a guard compiles to
    // an early return ahead of both the body and the transition, so an unprepared parameter
    // spec would leave the generator at the state before `initialize` and the generating call
    // that follows would be reported as a wrong call sequence instead of as the unsatisfied
    // requirement it is.
    //
    // This is a site of its own and so carries codes of its own: VIOLATED, which says the
    // producing specification saw the parameter object built and refused it, is reported under
    // `KEYPAIRGENERATOR-CONSTR-01`, and NOT_OBSERVED, which says nothing about the object was
    // ever recorded, under `KEYPAIRGENERATOR-NOBS-01`. Both are registered in `codes.csv`. The
    // rule states nothing about the `SecureRandom` this overload carries, so the event binds it
    // and checks nothing over it.
    event init4 after(AlgorithmParameterSpec params, SecureRandom random, KeyPairGenerator k):
      call(public void KeyPairGenerator.initialize(AlgorithmParameterSpec, SecureRandom)) &&
      args(params, random) &&
      target(k) {
        Property required = requiredPreparation();
        PredicateVerdict prepared = PredicateVerdict.SATISFIED;
        // Each branch names its predicate as a literal `Property` constant rather than passing
        // the one `requiredPreparation()` returned, so that each of the four clauses has a
        // visible site in the source at the store call that realises it. The four-way `if` is
        // what that costs.
        if (required == Property.PREPARED_RSA) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_RSA, params);
        }
        else if (required == Property.PREPARED_DSA) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_DSA, params);
        }
        else if (required == Property.PREPARED_DH) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_DH, params);
        }
        else if (required == Property.PREPARED_EC) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_EC, params);
        }
        if (required != null && prepared == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyPairGeneratorSpec", "" + __LOC,
                "v=1 code=KEYPAIRGENERATOR-CONSTR-01 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + q(algorithm) + "' exp='" + q(preparationName(required)) + "' msg='the AlgorithmParameterSpec given to KeyPairGenerator.initialize carries a preparation predicate the rule does not admit'"));
        }
        else if (required != null && prepared == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyPairGeneratorSpec", "" + __LOC,
                "v=1 code=KEYPAIRGENERATOR-NOBS-01 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + q(algorithm) + "' exp='" + q(preparationName(required)) + "' msg='no preparation of the AlgorithmParameterSpec given to KeyPairGenerator.initialize was observed'" + Evidence.keysFor(params)));
        }
    }

    // The accusing twin of `init1` over `initialize(int)`, and one site of the rule's four
    // key-size clauses: `algorithm in {"RSA"} => keysize in {4096, 3072, 2048}`,
    // `algorithm in {"DSA"} => keysize in {2048}`,
    // `algorithm in {"DiffieHellman", "DH"} => keysize in {2048}` and
    // `algorithm in {"EC"} => keysize in {256}`, all four transcribed in `validate(int)`.
    //
    // The clause is realised by a pair of events split on the sign of one guard, and not by a
    // guard on `init1` alone, because a `condition(...)` compiles to an early return ahead of
    // both the body and the transition: a call with a refused key size would then run no body,
    // make no report, and leave the generator at the state before `initialize`, where the
    // generating call that follows would be reported as a wrong call sequence instead of as
    // the weak key it is. As its own symbol this event is an `Init` alternative of the
    // automaton, at the only position where an `initialize` is legal -- which is what the rule
    // says it is, since `i1: initialize(keysize);` is an `Init` whatever size it is handed and
    // the size is stated separately, under CONSTRAINTS.
    //
    // A refused size is reported under `KEYPAIRGENERATOR-KEYSIZE-00`, registered in
    // `codes.csv`.
    event initError after(int keySize, KeyPairGenerator k):
      call(public void KeyPairGenerator.initialize(int)) &&
      args(keySize) &&
      target(k) &&
      condition(algorithm != null && !validate(keySize)) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidKeySize, "KeyPairGeneratorSpec", "" + __LOC,
             "v=1 code=KEYPAIRGENERATOR-KEYSIZE-00 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + keySize + "' exp='the key size the expert KeyPairGenerator.crysl declares for " + q(k.getAlgorithm()) + "' msg='invalid key size for algorithm " + k.getAlgorithm() + "'"));
    }

    // The accusing twin of `init2` over `initialize(int, SecureRandom)`, and the second site
    // of the same four key-size clauses `initError` accuses, transcribed in `validate(int)`.
    //
    // The clause needs a site at both overloads. Without this event a call with a key size the
    // rule's CONSTRAINTS refuse would take no transition -- a false `condition(...)` returns
    // ahead of the body -- and draw no report, because nothing else watches that overload; the
    // two-argument route would be silent on exactly the misuse the one-argument route accuses,
    // and the only difference between them is a `SecureRandom` the rule says nothing about.
    //
    // It is a site of its own and so carries a code of its own, `KEYPAIRGENERATOR-KEYSIZE-01`,
    // registered in `codes.csv`: a report has to say which overload it is about.
    event initError2 after(int keySize, SecureRandom random, KeyPairGenerator k):
      call(public void KeyPairGenerator.initialize(int, SecureRandom)) &&
      args(keySize, random) &&
      target(k) &&
      condition(algorithm != null && !validate(keySize)) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidKeySize, "KeyPairGeneratorSpec", "" + __LOC,
             "v=1 code=KEYPAIRGENERATOR-KEYSIZE-01 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + keySize + "' exp='the key size the expert KeyPairGenerator.crysl declares for " + q(k.getAlgorithm()) + "' msg='invalid key size for algorithm " + k.getAlgorithm() + "'"));
    }

    // `Gen` of KeyPairGenerator.crysl, both of its events -- `k1: keyPair = generateKeyPair();`
    // and `k2: keyPair = genKeyPair();` -- under one symbol, since the rule's ORDER puts them
    // in one alternation and neither carries a clause the other does not.
    //
    // The body stages the pair for the acceptance-point handler, which receives no event
    // arguments and so cannot see what the call returned. See `@match` below.
    event gen after(KeyPairGenerator k) returning(KeyPair keyPair):
      (call(public KeyPair KeyPairGenerator.generateKeyPair()) || call(public KeyPair KeyPairGenerator.genKeyPair())) &&
      target(k) {
       kp = keyPair;
    }

    // The rule's ORDER, `Get, Init, Gen`: a `getInstance`, one `initialize`, then a generating
    // call. The refused creations stand ahead of it as the prefix `(g3 | g4)*`, which reaches
    // no accepting state on its own, so a generator whose algorithm the list turns down cannot
    // complete an accepted sequence.
    //
    // The two accusing events enter the alternation beside the events they accuse, at the only
    // position where an `initialize` call is legal, because that is what the rule says they
    // are: `i1: initialize(keysize);` is an `Init` whatever size it is handed, and the size is
    // stated separately, under CONSTRAINTS. Outside the automaton `initError` would draw a
    // `KEYPAIRGENERATOR-ORDER-00` beside its own key-size code, for an ordering the rule
    // accepts; a self-loop would keep that second report too, because a loop does not satisfy
    // the `Init` the `gen` that follows needs.
    ere: ((g3 | g4)* g1 | (g3 | g4)* g2) (init1 | init2 | init3 | init4 | initError | initError2) gen

    // A call sequence the automaton rejects. The three codes separate the three cases a reader
    // has to tell apart: no `getInstance` of this generator was observed at all
    // (`KEYPAIRGENERATOR-ORDER-01`), one was observed and this specification refused its
    // algorithm (`KEYPAIRGENERATOR-ORDER-02`, where the ordering failure is the consequence of
    // that refusal), and a plain wrong call sequence (`KEYPAIRGENERATOR-ORDER-00`).
    // `creationObserved` and `creationRefused` are not touched by the generated `reset()`,
    // which restores the automaton state and leaves the fields, so the distinction holds on
    // every later failure as well. All three codes are registered in `codes.csv`.
    //
    // The staged key pair is discarded here, so a pair bound on a sequence the automaton
    // refused is never marked at a later acceptance point.
    @fail {
      if (!creationObserved) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyPairGeneratorSpec", "" + __LOC,
            "v=1 code=KEYPAIRGENERATOR-ORDER-01 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='' exp='' msg='the observed call sequence is not one KeyPairGeneratorSpec accepts and no creation of the generator was observed'"));
      }
      else if (creationRefused) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyPairGeneratorSpec", "" + __LOC,
            "v=1 code=KEYPAIRGENERATOR-ORDER-02 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='' exp='' msg='the observed call sequence is not one KeyPairGeneratorSpec accepts, after a creation the specification refused'"));
      }
      else {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyPairGeneratorSpec", "" + __LOC,
            "v=1 code=KEYPAIRGENERATOR-ORDER-00 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='' exp='' msg='the observed call sequence is not one KeyPairGeneratorSpec accepts'"));
      }
      kp = null;

      // The reset the other twenty `@fail` blocks of the set carry. Without it the
      // monitor stays in the failure category after the first rejected sequence:
      // `fail` is a sink, `Category_fail` is recomputed as `nextstate == 4` after
      // every event, and the dispatcher calls this handler whenever it holds --
      // including on dispatches whose `condition(...)` is false, which take no
      // transition and so never move the state that made it hold. The reset clears
      // the category so those silent dispatches stop re-raising; a later event that
      // does transition still accuses, from `start` into `fail` again, which is the
      // one report a rejected sequence is owed.
      __RESET;
    }

    // The acceptance point of `ENSURES generatedKeypair[keyPair, algorithm];`. The clause
    // carries no `after L`, so it holds wherever the object's use so far is a complete,
    // conforming call sequence; in a specification written as an `ere`, that is where this
    // handler runs, and `gen` is the only event that reaches it.
    //
    // A handler receives no event arguments and runs after the transition has been decided, so
    // it cannot see the pair the generating call returned: `gen` puts it in a field and this
    // handler reads the field and clears it. `@fail` discards it, so a pair bound on a sequence
    // the automaton refused is never marked.
    //
    // What the write establishes: the key pair was produced by a `KeyPairGenerator` the
    // instrumentation observed. The bound place is the `KeyPair`, compared by identity.
    //
    // Two things a reader should not take this write for. It is written with one place where
    // the rule writes two, and nothing depends on the missing one: no rule this set
    // transcribes requires `generatedKeypair`, so the predicate is written and never read, and
    // no site here asks for the algorithm it was generated under. The rule's other producing
    // clause, `generatedKeypair[this, _] after Con;` of KeyPair.crysl, has no site at all in
    // the set.
    @match {
       if (kp != null) {
           PredicateStore.instance().ensure(Property.GENERATED_KEY_PAIR, kp);
           kp = null;
       }
    }

}