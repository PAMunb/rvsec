package mop;

import java.security.KeyPair;
import java.security.KeyPairGenerator;
import java.security.SecureRandom;
import java.security.spec.AlgorithmParameterSpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * KeyPairGeneratorSpec
 *
 * A JavaMOP specification of the correct usage of the
 * java.security.KeyPairGenerator class.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/KeyPairGenerator.crysl
 */
KeyPairGeneratorSpec(KeyPairGenerator k) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    // D-15: the five entries of KeyPairGenerator.crysl. `DiffieHellman` returns -- the
    // withdrawn generated clause named only its short form, and the frozen jca carried both.
    // `EC` needs no divergence row any more: it is an expert entry, so the exception D-10
    // recorded for it has dissolved. That row's kind is still spelled `api30-omits`: D-16
    // keeps the spelling as a record key and not as an authority.
    List<String> safeAlgorithms = Arrays.asList("RSA", "EC", "DSA", "DiffieHellman", "DH");

    // Staged by `gen` for the acceptance-point handler, which sees no event parameter, and
    // cleared the moment it is used or the sequence is rejected.
    KeyPair kp = null;
    String algorithm;

    private boolean validate(int keySize) {
      // D-15: the four key-size clauses of KeyPairGenerator.crysl. `3072` returns to the RSA
      // sizes -- the withdrawn generated rule had lost it and the frozen jca was right to
      // carry it. The
      // subject is upper-cased, so the label for `DiffieHellman` is its upper-case form; it
      // shares the DH clause, `algorithm in {"DiffieHellman", "DH"} => keysize in {2048}`.
      switch(ConscryptAliasTable.canonical("KeyPairGenerator", algorithm).toUpperCase()) {
        case "RSA": return Arrays.asList(4096, 3072, 2048).contains(keySize);
        case "DSA": return keySize == 2048;
        case "DIFFIEHELLMAN":
        case "DH": return keySize == 2048;
        case "EC": return keySize == 256;
      }
      return false;
    }

    // Which of the four guarded REQUIRES clauses of KeyPairGenerator.crysl:35-38 applies to
    // the `params` an `initialize` was handed. The guard is the rule's own: the algorithm
    // selects the clause, and an algorithm none of the four names -- or one this
    // instrumentation never observed, which is the same case -- selects none, so `null` is
    // the answer that means *no clause applies here*. Read at `init3` and `init4`, where the
    // narrative of the reads lives; it is declared up here because javamop's parser takes the
    // declaration block before the first `event` and nothing after it.
    private Property requiredPreparation() {
        if (algorithm == null) {
            return null;
        }
        switch (ConscryptAliasTable.canonical("KeyPairGenerator", algorithm).toUpperCase()) {
            case "RSA": return Property.PREPARED_RSA;
            case "DSA": return Property.PREPARED_DSA;
            case "DIFFIEHELLMAN":
            case "DH": return Property.PREPARED_DH;
            case "EC": return Property.PREPARED_EC;
        }
        return null;
    }

    // The name the report shows for the predicate the selected clause requires. It is the
    // rule's own spelling and not the enum constant's, because the reader who follows a
    // report back is reading KeyPairGenerator.crysl.
    private String preparationName(Property required) {
        if (required == Property.PREPARED_RSA) { return "preparedRSA"; }
        if (required == Property.PREPARED_DSA) { return "preparedDSA"; }
        if (required == Property.PREPARED_DH) { return "preparedDH"; }
        return "preparedEC";
    }

    event g1 after(String alg) returning(KeyPairGenerator k):
      call(public static KeyPairGenerator KeyPairGenerator.getInstance(String)) &&
      args(alg) &&
      condition(ConscryptAliasTable.matches("KeyPairGenerator", alg, safeAlgorithms)) {
        algorithm = alg;
    }

    // `Object+` covers both two-argument `getInstance` overloads the platform declares --
    // `(String, String)` for the provider's name and `(String, Provider)` for the object -- in
    // one pointcut, so no second event is spent on the same `Gets`. An object obtained through
    // the overload this pointcut used to miss reached its next event with the monitor at state
    // 0, where every row is `fail`. It is `Object+` and not `..` on purpose: the trace harness's
    // resolver walks the declared parameter types of a `call(...)` signature and stops at the
    // first wildcard (KeyManagerFactorySpec.mop:87-90), so a wildcard here would make every
    // `getInstance` fit this pointcut, while `Object+` keeps the arity known and the second
    // position typed. Precedent: `KeyGeneratorSpec.g2`.
    event g2 after(String alg, Object provider) returning(KeyPairGenerator k):
      call(public static KeyPairGenerator KeyPairGenerator.getInstance(String, Object+)) &&
      args(alg, provider) &&
      condition(ConscryptAliasTable.matches("KeyPairGenerator", alg, safeAlgorithms)) {
        algorithm = alg;
    }

    event g3 after(String alg) returning(KeyPairGenerator k):
      call(public static KeyPairGenerator KeyPairGenerator.getInstance(String)) &&
      args(alg) &&
      condition(!ConscryptAliasTable.matches("KeyPairGenerator", alg, safeAlgorithms)) {
        algorithm = alg;
    }

    /*
    It can be very difficult to format code properly inside these .mop files.
     */
    event init1 after(int keySize, KeyPairGenerator k):
      call(public void KeyPairGenerator.initialize(int)) &&
      args(keySize) &&
      target(k) &&
      condition(algorithm != null && validate(keySize)) { }

    event init2 after(int keySize, SecureRandom random, KeyPairGenerator k):
      call(public void KeyPairGenerator.initialize(int, SecureRandom)) &&
      args(keySize, random) &&
      target(k) &&
      condition(algorithm != null && validate(keySize)) { }

    // `init3` and `init4` bind the `params` of the rule's four guarded REQUIRES clauses --
    // `{RSA} => preparedRSA[params]`, `{DSA} => preparedDSA[params]`,
    // `{DiffieHellman, DH} => preparedDH[params]` and `{EC} => preparedEC[params]`
    // (KeyPairGenerator.crysl:35-38, ledger #32, #33, #34, #35) -- and now read all four.
    // Until gh109 group G2 they read none: no rule that ENSURES any of the four had a
    // `.mop` in this set, so a read here would have answered NOT_OBSERVED for every
    // conforming program, and the four clauses were recorded `unmonitored-producer`. G2
    // wrote the producers -- `RSAKeyGenParameterSpecSpec` (preparedRSA),
    // `DSAParameterSpecSpec` (preparedDSA), `DHParameterSpecSpec` (preparedDH),
    // `ECGenParameterSpecSpec` and `ECParameterSpecSpec` (preparedEC) -- and D-24 is what
    // makes opening the reads part of closing the gap: a predicate written by a brand-new
    // specification and read by nobody is not a wired clause.
    //
    // The measurement that motivated the old conclusion stays true and stays relevant, so
    // it is kept rather than deleted. On Temurin 21, re-run 2026-08-26:
    // `KeyPairGenerator.getInstance("DH").initialize(new DHGenParameterSpec(2048, 0))`
    // raises `InvalidAlgorithmParameterException: Inappropriate parameter type`, while
    // `initialize(new DHParameterSpec(p, g))` over an RFC 3526 group is accepted, and the
    // `DHGenParameterSpec` into `AlgorithmParameterGenerator.getInstance("DH").init(...)`
    // -- the consumer that class exists for -- runs. That is why the producer this read
    // needs is `DHParameterSpec` and not `DHGenParameterSpec`, and why
    // `DHGenParameterSpecSpec`'s own write keeps its deliberate-omission record instead of
    // being wired here (INV-INS-137, researcher decision 2026-08-22).
    //
    // The clause is guarded, so the read is too: the algorithm selects which of the four
    // predicates is required, and a `params` handed to a generator whose algorithm none of
    // the four clauses names reaches no read at all. `algorithm` is null when no
    // `getInstance` of this program was observed, and that is the same no-clause-applies
    // case -- the rule states the requirement per algorithm, and an unobserved algorithm
    // selects nothing.
    //
    // The verdict is three-valued and its two accusing outcomes carry different codes, as
    // at every other read of this set (INV-INS-143): VIOLATED says the program prepared the
    // parameter object in a way the producing rule refuses, NOT_OBSERVED says this
    // instrumentation never saw it prepared at all. Folding them together would count a
    // reach limit of the monitored set as a misuse. The two events are two sites and so
    // carry two pairs of codes -- a reader has to be able to tell which overload the report
    // is about, which is the reason `initError`/`initError2` above have codes of their own.
    event init3 after(AlgorithmParameterSpec params, KeyPairGenerator k):
      call(public void KeyPairGenerator.initialize(AlgorithmParameterSpec)) &&
      args(params) &&
      target(k)  {
        Property required = requiredPreparation();
        PredicateVerdict prepared = PredicateVerdict.SATISFIED;
        // Each of the four clauses names its predicate as a LITERAL `Property.` constant, and
        // the four-way `if` is what that costs. It is not a style: the record reader anchors a
        // predicate site on the literal first argument of the store call
        // (`gh105_predicate_graph.py`, pass 1), precisely so that a private helper named
        // `validate` -- this file has one -- is not mistaken for the store's. A `Property` held
        // in a variable is invisible to it, and the clause would vanish from the graph, from the
        // ledger and from every gate that reads them while the monitor went on accusing.
        if (required == Property.PREPARED_RSA) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_RSA, params);
        }
        else if (required == Property.PREPARED_DSA) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_DSA, params);
        }
        else if (required == Property.PREPARED_DH) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_DH, params);
        }
        else if (required == Property.PREPARED_EC) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_EC, params);
        }
        if (required != null && prepared == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyPairGeneratorSpec", "" + __LOC,
                "v=1 code=KEYPAIRGENERATOR-CONSTR-00 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + q(algorithm) + "' exp='" + q(preparationName(required)) + "' msg='the AlgorithmParameterSpec given to KeyPairGenerator.initialize carries a preparation predicate the rule does not admit'"));
        }
        else if (required != null && prepared == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyPairGeneratorSpec", "" + __LOC,
                "v=1 code=KEYPAIRGENERATOR-NOBS-00 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + q(algorithm) + "' exp='" + q(preparationName(required)) + "' msg='no preparation of the AlgorithmParameterSpec given to KeyPairGenerator.initialize was observed'"));
        }
    }

    event init4 after(AlgorithmParameterSpec params, SecureRandom random, KeyPairGenerator k):
      call(public void KeyPairGenerator.initialize(AlgorithmParameterSpec, SecureRandom)) &&
      args(params, random) &&
      target(k) {
        Property required = requiredPreparation();
        PredicateVerdict prepared = PredicateVerdict.SATISFIED;
        // Each of the four clauses names its predicate as a LITERAL `Property.` constant, and
        // the four-way `if` is what that costs. It is not a style: the record reader anchors a
        // predicate site on the literal first argument of the store call
        // (`gh105_predicate_graph.py`, pass 1), precisely so that a private helper named
        // `validate` -- this file has one -- is not mistaken for the store's. A `Property` held
        // in a variable is invisible to it, and the clause would vanish from the graph, from the
        // ledger and from every gate that reads them while the monitor went on accusing.
        if (required == Property.PREPARED_RSA) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_RSA, params);
        }
        else if (required == Property.PREPARED_DSA) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_DSA, params);
        }
        else if (required == Property.PREPARED_DH) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_DH, params);
        }
        else if (required == Property.PREPARED_EC) {
            prepared = PredicateStore.instance().validate(Property.PREPARED_EC, params);
        }
        if (required != null && prepared == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyPairGeneratorSpec", "" + __LOC,
                "v=1 code=KEYPAIRGENERATOR-CONSTR-01 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + q(algorithm) + "' exp='" + q(preparationName(required)) + "' msg='the AlgorithmParameterSpec given to KeyPairGenerator.initialize carries a preparation predicate the rule does not admit'"));
        }
        else if (required != null && prepared == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyPairGeneratorSpec", "" + __LOC,
                "v=1 code=KEYPAIRGENERATOR-NOBS-01 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + q(algorithm) + "' exp='" + q(preparationName(required)) + "' msg='no preparation of the AlgorithmParameterSpec given to KeyPairGenerator.initialize was observed'"));
        }
    }

    event initError after(int keySize, KeyPairGenerator k):
      call(public void KeyPairGenerator.initialize(int)) &&
      args(keySize) &&
      target(k) &&
      condition(algorithm != null && !validate(keySize)) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidKeySize, "KeyPairGeneratorSpec", "" + __LOC,
             "v=1 code=KEYPAIRGENERATOR-KEYSIZE-00 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + keySize + "' exp='the key size the expert KeyPairGenerator.crysl declares for " + q(k.getAlgorithm()) + "' msg='invalid key size for algorithm " + k.getAlgorithm() + "'"));
    }

    // The twin of `initError` over `initialize(int, SecureRandom)`. `init2` carries the
    // same guard as `init1` -- `algorithm != null && validate(keySize)` -- and until this
    // event existed it had no complement: a call with a key size the rule's CONSTRAINTS
    // refuse took no transition, because a false `condition(...)` returns ahead of the
    // body, and drew no report, because nothing else was watching that overload. The
    // two-argument route was therefore silent on exactly the misuse the one-argument
    // route accuses, and the difference between them was the presence of a `SecureRandom`
    // the rule says nothing about.
    //
    // It is a site of its own and so it carries a code of its own: the report has to say
    // which overload it is about (INV-INS-143, the same reason `IvParameterSpec` gives two
    // codes to one clause read at two constructors).
    event initError2 after(int keySize, SecureRandom random, KeyPairGenerator k):
      call(public void KeyPairGenerator.initialize(int, SecureRandom)) &&
      args(keySize, random) &&
      target(k) &&
      condition(algorithm != null && !validate(keySize)) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidKeySize, "KeyPairGeneratorSpec", "" + __LOC,
             "v=1 code=KEYPAIRGENERATOR-KEYSIZE-01 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='" + keySize + "' exp='the key size the expert KeyPairGenerator.crysl declares for " + q(k.getAlgorithm()) + "' msg='invalid key size for algorithm " + k.getAlgorithm() + "'"));
    }

    event gen after(KeyPairGenerator k) returning(KeyPair keyPair):
      (call(public KeyPair KeyPairGenerator.generateKeyPair()) || call(public KeyPair KeyPairGenerator.genKeyPair())) &&
      target(k) {
       kp = keyPair;
    }

    // `initError` is absorbed rather than fused: it accuses a key size the rule's
    // CONSTRAINTS bound, which is a report of its own and not the negation of another
    // event's guard. It enters the automaton as one more alternative of the `Inits`
    // group, at the only position where an `initialize` call is legal, because that is
    // what the rule says it is: `i1: initialize(keysize)` is an `Init` event
    // whatever size it is handed, and the size is stated separately, under CONSTRAINTS.
    // Outside the automaton it drew a KEYPAIRGENERATOR-ORDER-00 as well as its own
    // KEYPAIRGENERATOR-KEYSIZE-00, for an ordering -- `Get, Init, Gen` -- that
    // the rule accepts; a self-loop would have kept that second report, because a loop
    // does not satisfy the `Inits` the `gen` that follows needs.
    //
    // `order_alphabet_map.csv` therefore maps it to `i3`, like `init1`, instead of
    // exempting it: the two events stand for the same rule symbol, the erased
    // languages are the ones compared today, and G-ORDER sees no change.
    //
    // `initError2` is absorbed on the same ground and mapped the same way, but to
    // `init2`'s symbol and not to `initError`'s: it stands for `i2: initialize(keysize,
    // random)`, the rule's own two-argument `Init`, so it maps to `i4` in
    // `order_alphabet_map.csv` and `i2` in `order_alphabet_map_expert.csv`. Mapping it to
    // `initError`'s symbol would file the two-argument call under `initialize(keysize)`
    // and erase the wrong language.
    ere: (g3* g1 | g3* g2) (init1 | init2 | init3 | init4 | initError | initError2) gen

    @fail {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyPairGeneratorSpec", "" + __LOC,
          "v=1 code=KEYPAIRGENERATOR-ORDER-00 ev=" + __EVENTNAME + " obj=KeyPairGenerator val='' exp='' msg='the observed call sequence is not one KeyPairGeneratorSpec accepts'"));
      kp = null;

      // The reset the other twenty `@fail` blocks of the set carry. Without it the
      // monitor stays in the failure category after the first rejected sequence:
      // `fail` is a sink, `Category_fail` is recomputed as `nextstate == 4` after
      // every event, and the dispatcher calls this handler whenever it holds --
      // including on dispatches whose `condition(...)` is false, which take no
      // transition and so never move the state that made it hold. The reset clears
      // the category so those silent dispatches stop re-raising; a later event that
      // does transition still accuses, from `start` into `fail` again, which is the
      // one report a rejected sequence is owed.
      __RESET;
    }

    // The acceptance point of `generatedKeypair[kp, alg]`. The clause carries no `after L`,
    // so it is established at the accepting state; read off the generated monitor, `gen`
    // has the transition row {4, 4, 3, 4, 4} and the match category is `nextstate == 3`,
    // so `gen` is the only event that reaches this handler.
    //
    // `generatedKeypair` is required by no rule of the oracle -- it is the last of the seven
    // dead-end predicates design.md counts over eleven sites, and this is that eleventh
    // site. The write is relocated as the clause asks and carries a deliberate-omission
    // record for its absent reader (INV-INS-137); no read is fabricated for it. The other
    // half of the clause, `generatedKeypair[this, _] after Con` (KeyPair.crysl:27), has
    // no site at all in `KeyPairSpec.c1`; task 4.13 measured it and routed the record to
    // task 5.10, because a clause without a site has no row in this inventory of sites.
    //
    // The arity stays at one place where the rule writes two, under INV-INS-134's arity
    // exception -- there is no consumer to move with it, here or at task 5.6.
    @match {
       if (kp != null) {
           PredicateStore.instance().ensure(Property.GENERATED_KEY_PAIR, kp);
           kp = null;
       }
    }

}