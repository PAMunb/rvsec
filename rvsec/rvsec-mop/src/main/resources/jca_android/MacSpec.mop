package mop;

import javax.crypto.Mac;
import java.nio.ByteBuffer;
import java.security.spec.AlgorithmParameterSpec;
import java.util.ArrayList;
import java.util.List;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

MacSpec(Mac m) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

        List<String> safeAlgorithms = Arrays.asList("PBEwithHmacSHA256", "PBEwithHmacSHA1", "HmacSHA224",
           "HmacSHA256", "HmacMD5", "HmacSHA512", "PBEwithHmacSHA512", "HmacSHA384", "PBEwithHmacSHA384",
           "PBEwithHmacSHA224", "PBEwithHmacSHA", "HmacSHA1");

        // A second monitor field, `Mac mac`, stood beside this one until this pass.
        // Its only reader was the accepting-state bookkeeping in the `@match`
        // handler, which the new substrate does not offer and which no
        // specification of the set ever read back (INV-INS-147), so the field went
        // with the handler and the two `getInstance` events no longer bind it.
        //
        // This one is assigned by the three `getInstance` events and read by
        // nothing -- here and before this pass alike. It is left standing on
        // purpose: this pass owns the file's predicate sites, and a monitor field
        // that no site reads is a separate repair. Recorded, not made, alongside
        // the ordering finding above the `ere` below.
        String currentAlgorithmInstance = "";

        // The data this Mac authenticated, held from the events that bind it to the
        // handler that writes about it. api30 ENSURES `macced[M, D]` -- M is the MAC of
        // D -- and `Property.MACED` holds the second place, the data, which is the place
        // Cipher's `!macced[_, plainText]` quantifies over. A handler sees no event
        // parameter, so what the events observe has to travel in fields.
        //
        // Two fields and not one because a Mac may be fed incrementally and then closed:
        // `update(...)` contributes data and `doFinal(input)` contributes its own, and a
        // program that does both authenticated both arrays. The update field is a list
        // rather than a single value for the same reason -- `update+` is in the rule's
        // ORDER, so a run may contribute several arrays before the final.
        List<Object> maccedByUpdate = new ArrayList<Object>();

        Object maccedByFinal = null;

        event g1 after(String alg) returning(Mac m):
          call(public static Mac Mac.getInstance(String)) &&
          args(alg) &&
          condition(ConscryptAliasTable.matches("Mac", alg, safeAlgorithms)) {
            currentAlgorithmInstance = alg;
        }

        event g2 after(String alg, String provider) returning(Mac m):
          call(public static Mac Mac.getInstance(String, String)) &&
          args(alg, provider) &&
          condition(ConscryptAliasTable.matches("Mac", alg, safeAlgorithms)) {
            currentAlgorithmInstance = alg;
        }

        event g3 after(String alg) returning(Mac m):
          call(public static Mac Mac.getInstance(String)) &&
          args(alg) &&
          condition(!ConscryptAliasTable.matches("Mac", alg, safeAlgorithms)) {
            currentAlgorithmInstance = alg;
        }

        // api30's `Inits`, the one-argument overload. Until this pass it opened
        // with a `condition(...)` that read a `generatedKey` predicate on the key,
        // and this pass deletes that read outright instead of moving it into the
        // body the way the rest of the group moves its reads.
        //
        // It translates no clause. The api30 Mac rule requires
        // `preparedHMAC[params]` and the two negated `encrypted[output1, _]` /
        // `encrypted[output2, _]` (Mac.cryptsl:80-84); `generatedKey` is not among
        // them, and no CONSTRAINTS clause mentions the key either. Nor did the read
        // propagate: the reads elsewhere in the set that carry no clause of their
        // own -- `RandomStringPassword.vo` and `gb`, `SecretKeySpec.e1` -- each feed
        // a write, so a verdict of theirs travels; this one fed nothing. It
        // computed a verdict, discarded it, and its only surviving effect was the
        // transition it suppressed. Deleting it and moving it to the body without
        // an accuser are behaviourally the same program, and what separates them is
        // dead code and two rows in predicate_graph.csv.
        //
        // The suppression was not harmless, which is why the deletion is a repair
        // and not housekeeping. A guard compiles into the generated monitor as
        // `if (!(<read>)) return false;` ahead of `handleEvent`, so `init` took no
        // transition whenever the key came from no observed generator, `doFinal`
        // then arrived in a state the ORDER does not admit, and the file accused
        // the program of `MAC-ORDER-00`. Measured over the whole ErrorCollector, on
        // the two traces this pass added to the corpus: a safe algorithm with an
        // unobserved key -- a program that breaks no clause of the rule -- drew one
        // report, and an unsafe algorithm with an unobserved key drew the same
        // single ordering report while the real defect stayed silent, because
        // `MAC-ALG-00` lives in this body and this body did not run. After the
        // deletion the first is silent and the second reports the algorithm.
        //
        // None of the rule's three clauses reaches this event. `preparedHMAC` binds
        // `params`, which the one-argument overload does not have; the two negated
        // `encrypted` clauses bind the `doFinal` outputs. This event translates no
        // clause of the rule and holds no predicate site.
        event i1 before(java.security.Key key, Mac m):
          call(public void Mac.init(java.security.Key)) &&
          args(key) &&
          target(m) {
            if (!ConscryptAliasTable.matches("Mac", m.getAlgorithm(), safeAlgorithms)) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-ALG-00 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + m.getAlgorithm() + "'"));
            }
        }

        // The other alternative of `Inits`, taking parameters beside the key. It
        // carried the same read on the same key and loses it for the same reason.
        //
        // The `params` it binds is the subject of api30 Mac `preparedHMAC[params]`
        // (Mac.cryptsl:80, ledger clause #21), and that clause is recorded here
        // rather than read: the platform cannot compose its two ends. Three
        // measurements, in the order that decided it.
        //
        // The producer is `javax.xml.crypto.dsig.spec.HMACParameterSpec`
        // (HMACParameterSpec.cryptsl:21, realised by HMACParameterSpecSpec.mop),
        // an XML-DSig class of the `java.xml.crypto` module. The api30 android.jar
        // holds `javax/crypto/Mac` and `javax/crypto/spec/PBEParameterSpec` and no
        // entry at all under `javax/xml/crypto`, so on the platform this set
        // targets the producing class cannot be loaded and the predicate can never
        // be written.
        //
        // On a JVM, where it can be loaded, no `Mac` accepts it. Measured over the
        // twelve algorithms of the rule's own CONSTRAINTS allow-list on Temurin 21:
        // the six `Hmac*` reject every parameter object with "HMAC does not use
        // parameters"; the five `PBEwithHmac*` accept `PBEParameterSpec` only and
        // answer "PBEParameterSpec type required" to this one; and
        // `PBEwithHmacSHA`, which the allow-list names, does not exist.
        //
        // The advice is `after`, which is after-finally, so it runs on the throwing
        // call too -- the only program that could reach a read here with the
        // predicate present is one that raises InvalidAlgorithmParameterException at
        // this very line. Writing the read would therefore accuse `NOT_OBSERVED` on
        // every conforming two-argument `init` in the world, which is the shape of
        // the seventeen orphan accusers Group 3 removed. Recorded in
        // predicate_graph.csv against the producer's row, not read (researcher
        // decision, 2026-08-22).
        event i2 after(java.security.Key key, java.security.spec.AlgorithmParameterSpec params, Mac m):
          call(public void Mac.init(java.security.Key, java.security.spec.AlgorithmParameterSpec)) &&
          args(key, params) &&
          target(m) {
            if (!ConscryptAliasTable.matches("Mac", m.getAlgorithm(), safeAlgorithms)) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-ALG-01 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + m.getAlgorithm() + "'"));
            }
        }

        // api30's `Updates`, which the rule states as four events and this file observed
        // as one, `update(..)`, binding nothing. That was enough while the file wrote no
        // predicate; it is not enough now, because `macced[output1, pre_input]`
        // (Mac.cryptsl:91) is about the array the call was given and a pointcut that binds
        // no argument has no array to be about (finding 74).
        //
        // So the aggregate splits into siblings, one per overload whose argument the
        // clause names, with every type written out. The three shorter statements were
        // measured on this set and all fail: a disjunction of the signatures makes javamop
        // emit no aspect at all, `args(.., input)` matches every `update` whatever the
        // argument's type and binds nothing, and a wildcard in a middle position generates
        // a correct aspect but defeats the trace harness's resolver, which accepts any
        // call from the first wildcard onward (finding 79). A trailing wildcard after
        // every discriminating type is safe, which is why `updateRange` may keep `args`
        // positions it does not read.
        //
        // The split adds symbols and moves no ordering claim: the rule puts u1 to u4 in
        // one alternation, `Updates`, so the `ere` accepts each sibling exactly where it
        // accepted the aggregate. The aggregate itself stays, and keeps its name, for the
        // one overload whose argument the rule does not name in any ENSURES.
        //
        // `macced[output1, inp]` (Mac.cryptsl:89) is the rule's third clause and gains no
        // site. `inp` is a primitive `byte`: a write would box it, the store is keyed by
        // object identity, and no `Cipher` takes a `byte` as its plaintext -- so no read
        // of the consuming clause could ever meet what a write here recorded. Vacuous,
        // recorded rather than written, on the ground decision 19 states.
        event update after(Mac m):
          call(public void Mac.update(byte)) &&
          target(m) { }

        // api30's u2 and u4, which the rule declares twice over the same signature.
        event updateBytes after(byte[] input, Mac m):
          call(public void Mac.update(byte[])) &&
          args(input) &&
          target(m) {
            maccedByUpdate.add(input);
        }

        // api30's u3, `update(pre_input, offset, len)`. The clause names the array and not
        // the window, so the two int positions are bound and unread.
        event updateRange after(byte[] input, int offset, int len, Mac m):
          call(public void Mac.update(byte[], int, int)) &&
          args(input, offset, len) &&
          target(m) {
            maccedByUpdate.add(input);
        }

        // `Mac.update(ByteBuffer)` is an overload of the API that api30 does not declare:
        // the rule's `Updates` names four events and none of them is this one, so there is
        // no clause here and the event stages nothing. It is declared all the same, because
        // the aggregate pointcut this split replaced did match it, and dropping it would
        // quietly narrow what the automaton observes -- a change to the alphabet that no
        // clause asks for. It stands where the aggregate stood.
        event updateBuffer after(ByteBuffer input, Mac m):
          call(public void Mac.update(ByteBuffer)) &&
          args(input) &&
          target(m) { }

        // api30's `Finals`. Both of these events established a one-place
        // "a MAC was generated" property on the tag they return, and this pass
        // deletes both writes rather than moving them to the acceptance point.
        //
        // The property is written by three of this tree's five specification sets
        // and read by none of them, so nothing downstream loses a fact. And it does
        // not translate the rule's ENSURES: api30 states `macced[output1, inp]`,
        // `macced[output1, pre_input]` and `macced[output2, input]`
        // (Mac.cryptsl:89-93) -- two places, the tag and the data it authenticates
        // -- while a one-place property over the tag alone cannot say which data
        // was authenticated, which is the only thing the consumer asks. That
        // consumer is Cipher's `!macced[_, plainText]`, ledger clause #8, and it is
        // wired at task 5.7 by a write made at the acceptance point with the arity
        // the clause states. Relocating this write would have handed that one edge
        // a second producer, at an arity that cannot answer it.
        //
        // The `returning` binding stays as it is: it is what task 5.7 writes from,
        // and this pass moves no symbol of the alphabet.
        //
        // This event is where the rule's two negated clauses would seem to belong,
        // and it carries neither. It merges the rule's `f1: output1 = doFinal()`
        // and `f2: output2 = doFinal(input)` under one pointcut disjunction, and in
        // both the array it binds is the one the call returns. The JCA allocates
        // that array fresh on every invocation -- measured on Temurin 21 over
        // HmacSHA1, HmacSHA256 and HmacSHA512, the returned tag is never the same
        // object as a ciphertext produced beside it -- so no Cipher acceptance
        // point can ever have marked it. `validateAbsent` never answers
        // NOT_OBSERVED, absence being conformance for a negated clause, so a read
        // placed here could only ever answer SATISFIED. It would be a site with no
        // path to an accusation, which decision 19 deletes rather than writes.
        // Clause #23 (`!encrypted[output2, _]`) has no other site and is recorded
        // vacuous in full; clause #22 keeps its second site, below.
        // api30's `f1: output1 = doFinal()`, the overload that authenticates only what
        // `update` already contributed. It binds no data of its own, so it stages none;
        // what the run authenticated is in the update field.
        event f1 after(Mac m) returning(byte[] output):
          call(byte[] Mac.doFinal()) &&
          target(m){
        }

        // api30's `f2: output2 = doFinal(input)`, and the site of
        // `macced[output2, input]` (Mac.cryptsl:93). It splits off the disjunction it
        // shared with `f1` for the reason the `update` family split: the clause is about
        // the array the call was given, and the merged pointcut bound no argument. Same
        // ordering claim -- the rule puts both in `FinalsWU`, and the `ere` accepts either
        // symbol wherever it accepted the merged one.
        event f1Input after(byte[] input, Mac m) returning(byte[] output):
          call(byte[] Mac.doFinal(byte[])) &&
          args(input) &&
          target(m){
            maccedByFinal = input;
        }

        // api30's `f3: doFinal(output1, outOffset)` (Mac.cryptsl:59), the only
        // event of the rule whose `byte[]` the caller owns: the tag is written into
        // a buffer the program already had. That makes it the one site where
        // `!encrypted[output1, _]` (Mac.cryptsl:82, ledger clause #22) can be
        // violated -- a program that hands its ciphertext to this call destroys the
        // bytes it means to authenticate, and authenticates whatever they were.
        //
        // The `Mac m` formal is a repair, not a binding this pass moved. The event
        // declared `target(m)` while naming no `m` among its formals, which is the
        // empty-binding broadcast recorded at conformance_record.csv:67 item (c):
        // the generator gives such an event the specification's parameterless map,
        // so it lands on a root monitor that has seen no `getInstance` and no
        // `init` and is therefore rejected by the `ere`. Measured on the three
        // traces this pass adds, against the pre-image, this tree and the frozen
        // control alike: every one of them drew `MAC-ORDER-00` at this event,
        // including the conforming one. The repair travels with the clause because
        // without it the read has no object to read and the accusation it produces
        // could not be told apart from the spurious ordering report already there
        // -- the same coupling task 6.2 has with task 5.9.
        //
        // The verdict is two-valued by construction, so there is no NOBS code
        // beside this one and its absence is not an omission under INV-INS-143.
        event f2 after(byte[] output, int outOffset, Mac m):
          call(void Mac.doFinal(byte[], int)) &&
          args(output, outOffset) &&
          target(m){
            if (PredicateStore.instance().validateAbsent(Property.ENCRYPTED, output) == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-CONSTR-00 ev=" + __EVENTNAME + " obj=Mac val='encrypted' exp='not encrypted' msg='the buffer the mac is written into already holds ciphertext'"));
            }
        }

        // `g3` is the unsafe-algorithm `getInstance`, and `g3*` is followed by a
        // required `g1` or `g2` -- a safe one. A program that only ever asks for an
        // unsafe algorithm therefore never leaves the prefix, and every such run
        // ends in `MAC-ORDER-00` no matter what else it does correctly. It is the
        // third site of the family the CipherSpec `unsafeAlg` sink opened and the
        // GCMParameterSpecSpec unreachable `@fail` continued: an ordering
        // accusation standing in for a constraint the automaton has no way to
        // state. Recorded, not repaired -- the repair is to the automaton, this
        // pass moves no symbol, and this file is one of the thirteen still absent
        // from order_alphabet_map.csv, which task 7.1 owns, so G-ORDER skips it in
        // both directions.
        ere : (g3* g1 | g3* g2) (i1 | i2) ((f1 | f1Input | f2) | ((update | updateBytes | updateRange | updateBuffer)* (f1 | f1Input | f2)))

        @fail {
            // The withdrawal that stood in this handler went with the write it
            // withdrew. INV-INS-142 requires all eight of the set's `@fail`
            // withdrawals to go, on the ground that "undo the predicate when the
            // automaton fails" is a semantics no generation of CrySL has; this one
            // goes here rather than at task 6.4 by the criterion task 4.6 used for
            // the `clearPassword` withdrawal -- a withdrawal travels with the write
            // it undoes, and both of this file's writes are deleted above. The
            // other seven remain 6.4's.
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "MacSpec", "" + __LOC,
                "v=1 code=MAC-ORDER-00 ev=" + __EVENTNAME + " obj=Mac val='' exp='' msg='the observed call sequence is not one MacSpec accepts'"));
            maccedByUpdate.clear();
            maccedByFinal = null;
            __RESET;
        }

        // The acceptance point of `macced[output1, pre_input]` (Mac.cryptsl:91) and
        // `macced[output2, input]` (Mac.cryptsl:93), and the handler task 4.9 deleted
        // whole -- it had nothing left to do once the accepting-state bookkeeping went
        // (INV-INS-147), and it comes back because this pass gives it a clause to write.
        // Neither clause carries an `after L`, so the acceptance point is the accepting
        // state itself, which in an `ere` is what `@match` names (INV-INS-134).
        //
        // What the acceptance point buys over the event bodies is the same thing it buys
        // everywhere in this set, and here it is worth naming: `macced` says a program
        // authenticated this data, and a `doFinal` the automaton rejects -- one on a Mac
        // that was never initialised, for instance -- authenticated nothing. A body write
        // would mark the array anyway, and `Cipher`'s `!macced` would then refuse to
        // encrypt data no Mac ever covered.
        //
        // The two places of the clause are not both recorded, and that is by construction
        // rather than by omission: `Property.MACED` holds the second place, the data,
        // because that is the place the only consumer quantifies over --
        // `Cipher: !macced[_, plainText]` leaves the first anonymous. The tag itself is
        // marked by nothing, and no rule asks about it.
        //
        // Measured before the write was made: the composition is real and it is the one
        // the negated clause names. `mac.doFinal(data)` followed by
        // `cipher.doFinal(data)` over the *same array object* runs to completion on
        // Temurin 21 -- mac-then-encrypt, which api30 forbids -- and the tag `doFinal`
        // returns is never the same object as the ciphertext beside it, so marking the
        // data cannot be confused with marking the output.
        @match {
            for (Object authenticated : maccedByUpdate) {
                PredicateStore.instance().ensure(Property.MACED, authenticated);
            }
            maccedByUpdate.clear();
            if (maccedByFinal != null) {
                PredicateStore.instance().ensure(Property.MACED, maccedByFinal);
                maccedByFinal = null;
            }
        }

}
