package mop;

import javax.crypto.Mac;
import java.nio.ByteBuffer;
import java.security.spec.AlgorithmParameterSpec;
import java.util.ArrayList;
import java.util.List;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * MacSpec
 *
 * Monitors javax.crypto.Mac against the CrySL rule Mac.crysl.
 *
 * The rule's ORDER is `Get, Init, (FinalWU | (Update+, Final))`: a Mac is obtained, initialised
 * with a key, and then either finalised by the one call that carries its own data or fed by
 * `update` before any final. The CONSTRAINTS clause this specification enforces is the
 * algorithm one, `algorithm in {"HmacSHA256", "HmacSHA384", "HmacSHA512", "HmacPBESHA1",
 * "PBEWithHmacSHA1", "PBEWithHmacSHA224", "PBEWithHmacSHA256", "PBEWithHmacSHA384",
 * "PBEWithHmacSHA512"}`, read off the Mac itself at both `init` events.
 *
 * Of the rule's four REQUIRES clauses it reads two. `generatedKey[key,_]` is read at both
 * `init` events, with `validateAny`, because the clause leaves the algorithm place anonymous.
 * `!encrypted[output1, _]` is read at `doFinal(byte[], int)`, the one final whose buffer the
 * caller owns. `!encrypted[output2,_]` gets no site: the array `doFinal(byte[])` returns is
 * allocated fresh by the JCA, so a negated read over it could only ever answer SATISFIED.
 *
 * `preparedHMAC[params]` gets no site either. The two-argument `init` binds the parameter spec
 * that clause is about and reads no predicate on it, so this specification does not check the
 * clause -- although `HMACParameterSpecSpec` writes `preparedHMAC` for every HMACParameterSpec
 * the instrumentation observes being constructed.
 *
 * It ENSURES `macced[output1, preInput]` and `macced[output2, input]` at the acceptance point,
 * over the data the run authenticated. `macced[output1, inputByte]` gets no site, for the
 * reason written at the `update` event.
 *
 * What it does not check: the rule's remaining CONSTRAINTS are the window clauses
 * `length[output1] > outOffset`, `length[preInput] >= offset + len`, `offset >= 0` and
 * `len > 0`, and no event of this file compares them.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/Mac.crysl
 */
MacSpec(Mac m) {
    // The envelope's quoting rule: a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

        // What a MAC key may have come from, as the report's `exp=` field. It is a field and not
        // a literal in two messages so the two sites cannot drift apart. The specifications of
        // this set that write `Property.GENERATED_KEY` are `KeyGeneratorSpec`, `KeyStoreSpec`,
        // `SecretKeyFactorySpec` and `SecretKeySpecSpec`.
        String expectedGeneratedKey = "a key observed coming from a key generator, a key store or a key specification";

        // CONSTRAINTS of Mac.crysl: `algorithm in {"HmacSHA256", "HmacSHA384", "HmacSHA512",
        // "HmacPBESHA1", "PBEWithHmacSHA1", "PBEWithHmacSHA224", "PBEWithHmacSHA256",
        // "PBEWithHmacSHA384", "PBEWithHmacSHA512"}`. Those nine are the first nine entries of
        // the list, verbatim. `HmacMD5` and `HmacSHA1` are not among them, and a Mac obtained
        // for either is what a Mac specification exists to accuse.
        //
        // The six that follow are Conscrypt spellings of admitted canonicals, and they admit
        // nothing the clause refuses. Comparison runs through `ConscryptAliasTable.matches`,
        // which folds case and resolves the provider's alias names before comparing, and the
        // table holds a `Mac` row taking each of `HMAC-SHA256`, `HMAC/SHA256`, `HMAC-SHA384`,
        // `HMAC/SHA384`, `HMAC-SHA512` and `HMAC/SHA512` to the `HmacSHA256`, `HmacSHA384` or
        // `HmacSHA512` the clause states.
        //
        // An entry is also compared on its own text, folded, so a spelling the table has no row
        // for would be admitted by its presence in this list alone. Only names the clause
        // states, and aliases the table resolves to them, belong here.
        List<String> safeAlgorithms = Arrays.asList("HmacSHA256", "HmacSHA384", "HmacSHA512", "HmacPBESHA1",
            "PBEWithHmacSHA1", "PBEWithHmacSHA224", "PBEWithHmacSHA256", "PBEWithHmacSHA384", "PBEWithHmacSHA512",
            "HMAC-SHA256", "HMAC/SHA256", "HMAC-SHA384", "HMAC/SHA384", "HMAC/SHA512", "HMAC-SHA512");

        // The data this Mac authenticated, held from the events that bind it to the handler that
        // writes about it. The rule ENSURES `macced[M, D]` -- M is the MAC of D -- and
        // `Property.MACED` holds the second place, the data, which is the place `Cipher.crysl`
        // quantifies over in `!macced[_, plainText]`. A handler sees no event parameter, so what
        // the events observe has to travel in fields.
        //
        // Two fields and not one because a Mac may be fed incrementally and then closed:
        // `update(...)` contributes data and `doFinal(input)` contributes its own, and a
        // program that does both authenticated both arrays. The update field is a list
        // rather than a single value for the same reason -- `update+` is in the rule's
        // ORDER, so a run may contribute several arrays before the final.
        List<Object> maccedByUpdate = new ArrayList<Object>();

        Object maccedByFinal = null;

        // Four facts about the monitored Mac that the `@fail` handler reads to choose its code.
        // The generated `reset()` clears only the state and the category flags, so all four
        // survive a failure, and once a label is reported every later failure of the same monitor
        // carries it: after a reset no creation event can arrive for the object, and the
        // automaton cannot return to a state its real history satisfies.
        //
        // `creationObserved` is set by the creation events `g1` to `g4`, the refused `g3` and `g4`
        // included, so a Mac created in woven code is never counted as unobserved.
        //
        // `creationRefused` is set by the refused creation events `g3` (one argument) and `g4`
        // (two arguments). The prefix `(g3 | g4)*` admits no use of such a Mac, so its ordering
        // failure is the consequence of the refused algorithm, and `@fail` reports it with the
        // `creation-refused` code, MAC-ORDER-03.
        //
        // `operationFinished` is set by the events that complete an operation, which are the
        // three finals of the `ere`: `f1`, `f1Input` and `f2`. It is set in the body, before the
        // transition is decided, because the fact it records is about the object and not about
        // the automaton: the program ran a final operation on this Mac whether or not the
        // sequence that led to it was one the rule accepts.
        //
        // `reuseObserved` is set by `@fail` when the failing event is `i1` or `i2` on a Mac whose
        // operation had finished: the API lets a used Mac be initialised again, and the rule's
        // ORDER does not.
        boolean creationObserved = false;
        boolean creationRefused = false;
        boolean operationFinished = false;
        boolean reuseObserved = false;

        // `Get` of Mac.crysl: `g1: getInstance(algorithm)`, the one-argument overload, under a
        // guard that admits only an algorithm the CONSTRAINTS clause allows. The body records the
        // creation and nothing else: the rule ENSURES nothing over the Mac itself, and the
        // algorithm is accused where it is consumed, at `i1` or `i2`.
        //
        // The guard hides no call, which is why a `condition(...)` is the right shape at this
        // event: whichever way it goes the call is observed, because `g3` is its complement over
        // the same pointcut.
        event g1 after(String alg) returning(Mac m):
          call(public static Mac Mac.getInstance(String)) &&
          args(alg) &&
          condition(ConscryptAliasTable.matches("Mac", alg, safeAlgorithms)) {
            creationObserved = true;
        }

        // `Get` of Mac.crysl: `g2: getInstance(algorithm, _)`. `Object+` covers both two-argument
        // overloads the platform declares -- `(String, String)` for the provider's name and
        // `(String, Provider)` for the object -- in one pointcut, so one event answers for the
        // rule's one `g2`. A Mac obtained through an overload no pointcut matched would reach its
        // next event with the monitor still at its start state, where every row is a failure.
        //
        // It is `Object+` and not `..` on purpose: the trace harness's resolver walks the declared
        // parameter types of a `call(...)` signature and stops at the first wildcard, so a
        // wildcard here would make every `getInstance` fit this pointcut, while `Object+` keeps
        // the arity known and the second position typed.
        event g2 after(String alg, Object provider) returning(Mac m):
          call(public static Mac Mac.getInstance(String, Object+)) &&
          args(alg, provider) &&
          condition(ConscryptAliasTable.matches("Mac", alg, safeAlgorithms)) {
            creationObserved = true;
        }

        // The complement of `g1` over the same one-argument pointcut, under the negated guard, so
        // exactly one of the two runs for any `getInstance(String)` the weaving reaches. The body
        // records the creation as a refused one and reports nothing: the algorithm is accused at
        // `i1` or `i2`, and the prefix `(g3 | g4)*` sends the Mac's first use to `@fail` exactly
        // as a Mac no event saw would go.
        event g3 after(String alg) returning(Mac m):
          call(public static Mac Mac.getInstance(String)) &&
          args(alg) &&
          condition(!ConscryptAliasTable.matches("Mac", alg, safeAlgorithms)) {
            creationObserved = true;
            creationRefused = true;
        }

        // The refused twin of `g2`: the same `Object+` pointcut over both two-argument
        // `getInstance` overloads, under the negated guard -- the two-argument half of what `g3`
        // is for the one-argument overload. Without it an algorithm the list refuses, requested
        // with a provider, runs no body, and the Mac's failure would read `creation-unobserved`
        // although its creation ran in woven code.
        //
        // The body only records the creation. It does not report and writes no field another
        // event reads: the algorithm is accused at `i1` or `i2`, and the prefix `(g3 | g4)*` sends
        // the Mac's first use to `@fail` exactly as a Mac no event saw would go, so no reported
        // site changes and only the handler's code does.
        event g4 after(String alg, Object provider) returning(Mac m):
          call(public static Mac Mac.getInstance(String, Object+)) &&
          args(alg, provider) &&
          condition(!ConscryptAliasTable.matches("Mac", alg, safeAlgorithms)) {
            creationObserved = true;
            creationRefused = true;
        }

        // `Init` of Mac.crysl: `i1: init(key)`, the one-argument overload.
        //
        // The body checks the algorithm clause off the Mac itself and reports an algorithm outside
        // it under the code registered in `codes.csv` for this site. The check sits in the body
        // and not in a `condition(...)` guard: a guard compiles to an early return ahead of both
        // the body and the transition, so an `init` on an `HmacMD5` Mac would leave the automaton
        // in the state before the call, the `doFinal` that follows would arrive in a state the
        // ORDER does not admit, and the program would be accused of a wrong call sequence instead
        // of the weak algorithm it used.
        //
        // REQUIRES `generatedKey[key,_]`: the key was produced by a call the instrumentation
        // observed, for the algorithm recorded with it. The read is three-valued and each accusing
        // outcome carries its own code. VIOLATED is positive evidence -- an entry for this key
        // exists and what it records is not what the clause demands -- and draws the constraint
        // code. NOT_OBSERVED says only that no producing call for this key was ever recorded,
        // which on this platform is as often a reach limit of the weaving as it is a misuse, so it
        // draws a code of its own instead of being reported as a violation.
        //
        // The read is `validateAny` and not `validate`, because the clause writes `_` in the
        // algorithm place and the producers do not agree on how to spell it: `KeyGeneratorSpec`
        // records the name the program handed `getInstance`, `KeyStoreSpec` and
        // `SecretKeySpecSpec` record the key's own `getAlgorithm()`, and `SecretKeyFactorySpec`
        // records the factory's canonical name. A read that named one spelling would answer
        // VIOLATED for a key produced under another -- an ordinary Conscrypt alias on this
        // platform. `validate` with no value is not the alternative either: it compares the whole
        // argument list, and the empty list matches no producer's entry, so every conforming key
        // would come back VIOLATED. `validateAny` asks what the clause asks -- whether the key
        // carries the predicate at all -- and is blind only to the position the rule itself
        // leaves anonymous.
        //
        // The NOT_OBSERVED branch splits once more, on `Property.REPORTED_UPSTREAM`: a key whose
        // producer already reported a failure about it carries that mark, so the absence here is a
        // refusal upstream and not a gap in instrumentation reach, and it draws the
        // `upstream-refused` code rather than the `not-observed` one. One object draws one report
        // and not two with different reasons.
        //
        // Of the rule's four REQUIRES clauses this event realises one. `preparedHMAC[params]`
        // binds a parameter spec the one-argument overload does not have, and the two negated
        // `encrypted` clauses bind the `doFinal` outputs.
        event i1 before(java.security.Key key, Mac m):
          call(public void Mac.init(java.security.Key)) &&
          args(key) &&
          target(m) {
            if (!ConscryptAliasTable.matches("Mac", m.getAlgorithm(), safeAlgorithms)) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-ALG-00 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + m.getAlgorithm() + "'"));
            }
            PredicateVerdict keyOrigin = PredicateStore.instance().validateAny(Property.GENERATED_KEY, key);
            if (keyOrigin == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-CONSTR-01 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(expectedGeneratedKey) + "' msg='the key given to Mac.init carries a key-origin predicate the rule does not admit'"));
            }
            else if (keyOrigin == PredicateVerdict.NOT_OBSERVED && PredicateStore.instance().validateAny(Property.REPORTED_UPSTREAM, key) == PredicateVerdict.SATISFIED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-NOBS-02 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(expectedGeneratedKey) + "' msg='the key given to Mac.init was already reported by the specification that produced it'" + Evidence.keysFor(key)));
            }
            else if (keyOrigin == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-NOBS-00 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(expectedGeneratedKey) + "' msg='the key given to Mac.init was not observed coming from a key generator, a key store or a key specification'" + Evidence.keysFor(key)));
            }
        }

        // `Init` of Mac.crysl: `i2: init(key, params)`, the other alternative of `Init`. It carries
        // the same algorithm check and the same `generatedKey[key,_]` read as `i1`, under codes of
        // its own because a report has to say which overload it came from; the mechanism of each
        // is written out at `i1`.
        //
        // The one difference in the read is that this event's NOT_OBSERVED branch does not split
        // on `Property.REPORTED_UPSTREAM` the way `i1`'s does, so a key whose producer already
        // reported it draws the same `not-observed` code here as a key nothing was ever recorded
        // about.
        //
        // The `params` this overload binds is the subject of the rule's REQUIRES
        // `preparedHMAC[params]`, and this event reads no predicate on it: that clause of the rule
        // is not one this specification checks. `HMACParameterSpecSpec` does write `preparedHMAC`
        // for every HMACParameterSpec the instrumentation observes being constructed, so the
        // predicate is produced by this set and read by no site of it.
        event i2 after(java.security.Key key, java.security.spec.AlgorithmParameterSpec params, Mac m):
          call(public void Mac.init(java.security.Key, java.security.spec.AlgorithmParameterSpec)) &&
          args(key, params) &&
          target(m) {
            if (!ConscryptAliasTable.matches("Mac", m.getAlgorithm(), safeAlgorithms)) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-ALG-01 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + m.getAlgorithm() + "'"));
            }
            PredicateVerdict keyOrigin = PredicateStore.instance().validateAny(Property.GENERATED_KEY, key);
            if (keyOrigin == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-CONSTR-02 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(expectedGeneratedKey) + "' msg='the key given to Mac.init carries a key-origin predicate the rule does not admit'"));
            }
            else if (keyOrigin == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-NOBS-01 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(expectedGeneratedKey) + "' msg='the key given to Mac.init was not observed coming from a key generator, a key store or a key specification'" + Evidence.keysFor(key)));
            }
        }

        // `Update` of Mac.crysl: `u1: update(inputByte)`, the single-byte overload. It binds no
        // array and stages nothing.
        //
        // The rule's ENSURES `macced[output1, inputByte]` gets no site from it. `inputByte` is a
        // primitive `byte`: a write would box it, the store compares a bound object by identity,
        // and no `Cipher` takes a `byte` as its plaintext, so no read of the consuming clause
        // could ever meet what a write here recorded.
        //
        // The rule's other three `update` events are declared separately below, one per overload
        // whose argument a clause names, because a pointcut that binds no argument has no array to
        // write a predicate about. The split adds symbols and moves no ordering claim: the rule
        // puts `u1` to `u4` in one alternation, `Update`, so the `ere` accepts each sibling
        // exactly where it accepts this one.
        //
        // Each sibling writes its parameter types out in full, and the three shorter ways of
        // spelling them all fail on this set: a disjunction of the signatures makes javamop emit
        // no aspect at all, `args(.., input)` matches every `update` whatever the argument's type
        // and binds nothing, and a wildcard in a middle position generates a correct aspect but
        // defeats the trace harness's resolver, which accepts any call from the first wildcard
        // onward. A trailing wildcard after every discriminating type is safe, which is why
        // `updateRange` may keep `args` positions it does not read.
        event update after(Mac m):
          call(public void Mac.update(byte)) &&
          target(m) { }

        // `Update` of Mac.crysl: `u2: update(preInput)`. It stages the array for the acceptance
        // point, which is where `macced[output1, preInput]` is written: a handler receives no
        // event arguments, so the array has to travel in a field. The field is a list because the
        // rule's ORDER has `Update+` and a run may contribute several arrays before its final.
        event updateBytes after(byte[] input, Mac m):
          call(public void Mac.update(byte[])) &&
          args(input) &&
          target(m) {
            maccedByUpdate.add(input);
        }

        // `Update` of Mac.crysl: `u3: update(preInput, offset, len)`. The ENSURES clause names the
        // array and not the window, so the array is staged for the acceptance point and the two
        // int positions are bound and unread. The rule does constrain them --
        // `length[preInput] >= offset + len`, `offset >= 0` and `len > 0` -- and this
        // specification implements none of the three.
        event updateRange after(byte[] input, int offset, int len, Mac m):
          call(public void Mac.update(byte[], int, int)) &&
          args(input, offset, len) &&
          target(m) {
            maccedByUpdate.add(input);
        }

        // `Update` of Mac.crysl: `u4: update(preInputByteBuffer)`. No ENSURES clause of the rule
        // names `preInputByteBuffer` -- the three name `inputByte`, `preInput` and `input` -- so
        // the event carries no clause and stages nothing.
        //
        // It is declared because the rule puts it inside `Update` and the automaton has to observe
        // it: a call the monitor does not declare is a call the ORDER cannot count, and a Mac fed
        // only through a ByteBuffer would then reach its final with no `update` seen and be
        // reported as a wrong call sequence.
        event updateBuffer after(ByteBuffer input, Mac m):
          call(public void Mac.update(ByteBuffer)) &&
          args(input) &&
          target(m) { }

        // `FinalWOU` of Mac.crysl: `f1: output1 = doFinal()`, the overload that authenticates only
        // what `update` already contributed. It binds no data of its own, so it stages none; what
        // the run authenticated is in the update field.
        //
        // The rule's REQUIRES `!encrypted[output1, _]` binds the array this call returns, and this
        // event does not read it. The JCA allocates that array fresh on every invocation, so it
        // can never be an array a `Cipher` acceptance point marked as ciphertext; and
        // `validateAbsent` never answers NOT_OBSERVED, absence being conformance for a negated
        // clause, so a read placed here could only ever answer SATISFIED. The clause's other site,
        // `f2` below, is the one where a program can violate it.
        //
        // `operationFinished` is set in the body, before the transition is decided, because what it
        // records is about the object: a final operation ran on this Mac, whether or not the
        // sequence that led to it is one the rule accepts.
        event f1 after(Mac m) returning(byte[] output):
          call(byte[] Mac.doFinal()) &&
          target(m){
            operationFinished = true;
        }

        // `FinalWU` of Mac.crysl: `f2: output2 = doFinal(input)`, the only final that brings the
        // data it authenticates, which is why the rule puts it alone in `FinalWU` and why it is
        // the one final the `ere` below accepts with no `update` before it. The array it is given
        // is staged for the acceptance point, where `macced[output2, input]` is written.
        //
        // The rule's REQUIRES `!encrypted[output2,_]` binds the array this call returns, and this
        // event does not read it, for the reason written out at `f1`: the returned array is
        // allocated fresh, so a negated read over it could only ever answer SATISFIED. That clause
        // has no site anywhere in this specification.
        //
        // The name here is not the rule's: this event is the rule's `f2`, and the event named `f2`
        // below is the rule's `f3`.
        event f1Input after(byte[] input, Mac m) returning(byte[] output):
          call(byte[] Mac.doFinal(byte[])) &&
          args(input) &&
          target(m){
            operationFinished = true;
            maccedByFinal = input;
        }

        // `FinalWOU` of Mac.crysl: `f3: doFinal(output1, outOffset)`, the one final whose `byte[]`
        // the caller owns -- the tag is written into a buffer the program already had.
        //
        // REQUIRES `!encrypted[output1, _]`, read here with `validateAbsent`. This is the one site
        // of the specification where that clause can be violated: a program that hands its own
        // ciphertext to this call destroys the bytes it means to authenticate and authenticates
        // whatever they were. A negated clause inverts the table -- absence is conformance -- so
        // the read answers SATISFIED when the buffer carries no ciphertext marking and VIOLATED
        // when it does, and never NOT_OBSERVED; that the verdict is two-valued is why this site
        // has no not-observed code beside its constraint one. The arguments of a `validateAbsent`
        // are accepted for symmetry and not compared: the clause asks whether a predicate of that
        // name exists on the object at all.
        //
        // The rule constrains the buffer as well, `length[output1] > outOffset`, and this event
        // does not compare it.
        event f2 after(byte[] output, int outOffset, Mac m):
          call(void Mac.doFinal(byte[], int)) &&
          args(output, outOffset) &&
          target(m){
            operationFinished = true;
            if (PredicateStore.instance().validateAbsent(Property.ENCRYPTED, output) == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-CONSTR-00 ev=" + __EVENTNAME + " obj=Mac val='encrypted' exp='not encrypted' msg='the buffer the mac is written into already holds ciphertext'"));
            }
        }

        // The rule's ORDER, `Get, Init, (FinalWU | (Update+, Final))`.
        //
        // `(g3 | g4)*` before a required `g1` or `g2` lets a program ask for an algorithm the
        // clause refuses and then ask again for one it admits. A program that only ever asks for a
        // refused algorithm never leaves that prefix, so its first use of the Mac fails the
        // ordering, and `@fail` reports it under the `creation-refused` code rather than as a call
        // order the program chose. What the report carries is still an ordering accusation
        // standing in for a constraint the automaton has no way to state.
        //
        // `f1Input` stands alone on the left, as the rule's `FinalWU` does: the one final that may
        // dispense with `update` is the one that carries its own data. `doFinal()` and
        // `doFinal(out, off)` with nothing updated authenticate the empty input, so both require
        // the `Update+` the rule requires.
        //
        // The expression ends at the first final, as the rule's ORDER does: nothing leads back
        // to `Init`. A Mac initialised again after a final therefore fails at that `init`, and
        // `@fail` reports it with the `reuse-after-final` code, apart from a sequence the program
        // got wrong: the API admits the reuse and only the rule refuses it.
        //
        // `f1Input` is the `.mop` name of the rule's `f2`, and `f2` here is the rule's `f3`; the
        // numbering is crossed between the two files.
        ere : ((g3 | g4)* g1 | (g3 | g4)* g2) (i1 | i2) (f1Input | ((update | updateBytes | updateRange | updateBuffer)+ (f1 | f1Input | f2)))

        // Reached whenever the sequence observed so far is not a word of the `ere` above. Four
        // codes, all registered in `codes.csv`, chosen from the facts the events recorded: a Mac
        // whose creation no event saw is reported as an unobserved creation; one created under an
        // algorithm the clause refused, as a refused creation; one initialised again after a
        // final, as a reuse; anything else as a call sequence the specification does not accept.
        // The staged data is dropped here, so a run the automaton refused authenticates nothing.
        //
        // `reuseObserved` is decided in this handler and not in an event body because it is a fact
        // about the transition and not about the call: the failing event has to be an `init`, and
        // the Mac has to have finished an operation already.
        @fail {
            if (operationFinished && ("i1".equals(__EVENTNAME) || "i2".equals(__EVENTNAME))) {
                reuseObserved = true;
            }
            if (!creationObserved) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-ORDER-01 ev=" + __EVENTNAME + " obj=Mac val='' exp='' msg='the observed call sequence is not one MacSpec accepts and no creation of the Mac was observed'"));
            }
            else if (creationRefused) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-ORDER-03 ev=" + __EVENTNAME + " obj=Mac val='' exp='' msg='the observed call sequence is not one MacSpec accepts, after a creation the specification refused'"));
            }
            else if (reuseObserved) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-ORDER-02 ev=" + __EVENTNAME + " obj=Mac val='' exp='' msg='the Mac was initialised again after it completed an operation, which the rule does not accept'"));
            }
            else {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-ORDER-00 ev=" + __EVENTNAME + " obj=Mac val='' exp='' msg='the observed call sequence is not one MacSpec accepts'"));
            }
            maccedByUpdate.clear();
            maccedByFinal = null;
            __RESET;
        }

        // The acceptance point of `macced[output1, preInput]` and `macced[output2, input]`. Neither
        // clause carries an `after L`, so the acceptance point of both is an accepting state of the
        // ORDER, which in an `ere` is where this handler runs. The write establishes that a
        // monitored Mac computed a MAC over these bytes.
        //
        // It writes what the events staged, because a handler receives no event parameter and runs
        // after the transition is decided. Writing here and not in the event bodies is what keeps
        // a `doFinal` the automaton rejects -- one on a Mac that was never initialised, say --
        // from marking data that no accepted run authenticated; `Cipher`'s negated read would
        // otherwise refuse to encrypt data no Mac ever covered.
        //
        // `Property.MACED` holds the second place of the clause, the data, and not the first: the
        // only consumer quantifies over the data -- `Cipher.crysl` REQUIRES `!macced[_,
        // plainText]` -- and leaves the tag anonymous. The tag itself is marked by nothing, and no
        // rule of this set asks about it.
        @match {
            for (Object authenticated : maccedByUpdate) {
                PredicateStore.instance().ensure(Property.MACED, authenticated);
            }
            maccedByUpdate.clear();
            if (maccedByFinal != null) {
                PredicateStore.instance().ensure(Property.MACED, maccedByFinal);
                maccedByFinal = null;
            }
        }

}
