package mop;

import javax.crypto.Mac;
import java.nio.ByteBuffer;
import java.security.spec.AlgorithmParameterSpec;
import java.util.ArrayList;
import java.util.List;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

MacSpec(Mac m) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

        // D-15: Mac.crysl names nine algorithms; the eight further entries are the frozen
        // jca's spelling variants of them. `HmacMD5` and `HmacSHA1`, which the withdrawn
        // catalogue admitted, are gone -- they are what a Mac specification exists to accuse.
        // What a MAC key may have come from, as the report's `exp=` field. The three
        // producers of `Property.GENERATED_KEY` in this set, named rather than counted:
        // `KeyGeneratorSpec`, `KeyStoreSpec` and `SecretKeySpecSpec`. It is a field and
        // not a literal in two messages so the two sites cannot drift apart.
        String expectedGeneratedKey = "a key observed coming from a key generator, a key store or a key specification";

        List<String> safeAlgorithms = Arrays.asList("HmacSHA256", "HmacSHA384", "HmacSHA512", "HmacPBESHA1",
            "PBEWithHmacSHA1", "PBEWithHmacSHA224", "PBEWithHmacSHA256", "PBEWithHmacSHA384", "PBEWithHmacSHA512",
            "HMAC-SHA256", "HMAC/SHA256", "HMAC-SHA384", "HMAC/SHA384", "HMAC/SHA512", "HMAC-SHA512",
            "PBEWITHHMACSHA", "PBEWITHHMACSHA-256");

        // A second monitor field, `Mac mac`, stood beside this one until this pass.
        // Its only reader was the accepting-state bookkeeping in the `@match`
        // handler, which the new substrate does not offer and which no
        // specification of the set ever read back (INV-INS-147), so the field went
        // with the handler and the two `getInstance` events no longer bind it.
        //
        // This one is assigned by the three `getInstance` events and read by
        // nothing -- here and before this pass alike. It is left standing on
        // purpose: this pass owns the file's predicate sites, and a monitor field
        // that no site reads is a separate repair. Recorded, not made, alongside
        // the ordering finding above the `ere` below.

        // The data this Mac authenticated, held from the events that bind it to the
        // handler that writes about it. The rule ENSURES `macced[M, D]` (Mac.crysl:57-59)
        // -- M is the MAC of
        // D -- and `Property.MACED` holds the second place, the data, which is the place
        // Cipher's `!macced[_, plainText]` quantifies over. A handler sees no event
        // parameter, so what the events observe has to travel in fields.
        //
        // Two fields and not one because a Mac may be fed incrementally and then closed:
        // `update(...)` contributes data and `doFinal(input)` contributes its own, and a
        // program that does both authenticated both arrays. The update field is a list
        // rather than a single value for the same reason -- `update+` is in the rule's
        // ORDER, so a run may contribute several arrays before the final.
        List<Object> maccedByUpdate = new ArrayList<Object>();

        Object maccedByFinal = null;

        event g1 after(String alg) returning(Mac m):
          call(public static Mac Mac.getInstance(String)) &&
          args(alg) &&
          condition(ConscryptAliasTable.matches("Mac", alg, safeAlgorithms)) {
        }

        // `Object+` covers both two-argument `getInstance` overloads the platform declares --
        // `(String, String)` for the provider's name and `(String, Provider)` for the object -- in
        // one pointcut, so no second event is spent on the same `Gets`. An object obtained through
        // the overload this pointcut used to miss reached its next event with the monitor at state
        // 0, where every row is `fail`. It is `Object+` and not `..` on purpose: the trace harness's
        // resolver walks the declared parameter types of a `call(...)` signature and stops at the
        // first wildcard (KeyManagerFactorySpec.mop:87-90), so a wildcard here would make every
        // `getInstance` fit this pointcut, while `Object+` keeps the arity known and the second
        // position typed. Precedent: `KeyGeneratorSpec.g2`.
        event g2 after(String alg, Object provider) returning(Mac m):
          call(public static Mac Mac.getInstance(String, Object+)) &&
          args(alg, provider) &&
          condition(ConscryptAliasTable.matches("Mac", alg, safeAlgorithms)) {
        }

        event g3 after(String alg) returning(Mac m):
          call(public static Mac Mac.getInstance(String)) &&
          args(alg) &&
          condition(!ConscryptAliasTable.matches("Mac", alg, safeAlgorithms)) {
        }

        // The rule's `Init`, the one-argument overload (Mac.crysl:23,25). Until this
        // pass it opened with a `condition(...)` that read a `generatedKey` predicate
        // on the key, and this pass deletes that read outright instead of moving it
        // into the body the way the rest of the group moves its reads.
        //
        // THE CLAUSE IS BACK, AND IT IS NOT A REVERT OF TASK 4.9. 4.9 wrote that the
        // read it deleted translated no clause, and against the withdrawn catalogue it
        // did not: that rule required `preparedHMAC[params]` and the two negated
        // `encrypted[...]`, and stated nothing over the key. The sole oracle states a
        // fourth clause -- `Mac.crysl:54` REQUIRES `generatedKey[key,_]` -- and
        // `predicate_ledger.csv` row 39 disposes it `wireable`, with both ends
        // specified in this set (KeyGenerator, KeyStore, SecretKeySpec). Task 11.5(a)
        // wires it, by the researcher's decision of 2026-08-26, under the 9.B
        // discipline: harness pair, divergence row, go/no-go per clause.
        //
        // What comes back is the clause, not the shape 4.9 removed, and the difference
        // is the whole of the repair. 4.9's guard sat in `condition(...)`, which
        // compiles into the generated monitor as `if (!(<read>)) return false;` ahead
        // of `handleEvent`: `init` took no transition whenever the key came from no
        // observed generator, `doFinal` then arrived in a state the ORDER does not
        // admit, and the file accused the program of `MAC-ORDER-00`. Measured over the
        // whole ErrorCollector on two corpus traces: a safe algorithm with an
        // unobserved key -- a program that breaks no clause of the rule -- drew one
        // report, and an unsafe algorithm with an unobserved key drew the same single
        // ordering report while the real defect stayed silent, because `MAC-ALG-00`
        // lives in this body and this body did not run. THE READ BELOW IS IN THE BODY.
        // It reports and it suppresses nothing, so both of those programs now say what
        // they are: the first draws MAC-NOBS-00 alone and the second draws MAC-ALG-00
        // beside it.
        //
        // The other half of 4.9's argument was that the old read propagated nothing --
        // it computed a verdict, discarded it, and its only surviving effect was the
        // transition it suppressed. That is answered here too: this read has an accuser
        // of its own, which is what the guard never was.
        //
        // Three-valued, with a code each, for the reason the rest of the set records:
        // VIOLATED is positive evidence -- this key carries a key-origin predicate that
        // was withdrawn -- while NOT_OBSERVED says only that no producer of it was
        // observed, which on Android is as often a reach limit of the instrumentation
        // as it is a misuse. VIOLATED has no program that produces it today, since no
        // NEGATES clause of the oracle reaches `generatedKey` on a key this event can
        // see, and the branch is written anyway so that the day one does, it is not
        // reported as an absence.
        //
        // THE ANONYMOUS PLACE IS READ AS ANONYMOUS, which needed a store method that
        // did not exist. `Mac.crysl:54` writes `generatedKey[key,_]` while all three
        // producers write a second place, and `PredicateStore.validate` compares the
        // whole tuple -- so a read with no values compares against the empty tuple,
        // which no producer records, and every conforming key would come back VIOLATED.
        // Filling the `_` in at the call site is not the same clause and was measured
        // not to work either: `KeyGeneratorSpec` writes the string the program handed
        // `getInstance` while `KeyStoreSpec` and `SecretKeySpecSpec` write the key's own
        // algorithm, so a reader that guessed one spelling would accuse a program that
        // used the other -- an ordinary Conscrypt alias on this platform.
        // `PredicateStore.validateAny` is the read the clause asks for and nothing
        // wider: it names the property and is blind only to the positions the rule
        // itself leaves anonymous.
        //
        // Three of the rule's four REQUIRES clauses do not reach this event:
        // `preparedHMAC` binds `params`, which the one-argument overload does not
        // have, and the two negated `encrypted` clauses bind the `doFinal` outputs.
        // The fourth is this one.
        event i1 before(java.security.Key key, Mac m):
          call(public void Mac.init(java.security.Key)) &&
          args(key) &&
          target(m) {
            if (!ConscryptAliasTable.matches("Mac", m.getAlgorithm(), safeAlgorithms)) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-ALG-00 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + m.getAlgorithm() + "'"));
            }
            PredicateVerdict keyOrigin = PredicateStore.instance().validateAny(Property.GENERATED_KEY, key);
            if (keyOrigin == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-CONSTR-01 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(expectedGeneratedKey) + "' msg='the key given to Mac.init carries a key-origin predicate the rule does not admit'"));
            }
            else if (keyOrigin == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-NOBS-00 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(expectedGeneratedKey) + "' msg='the key given to Mac.init was not observed coming from a key generator, a key store or a key specification'"));
            }
        }

        // The other alternative of `Init` (Mac.crysl:24), taking parameters beside the
        // key. It carries the same clause over the same key, and gains the same read,
        // with codes of its own: the two overloads are two sites of `generatedKey[key,_]`
        // and a report has to say which one it came from.
        //
        // The `params` it binds is the subject of the rule's `preparedHMAC[params]`
        // (Mac.crysl:53, ledger clause #21), and that clause is recorded here
        // rather than read: the platform cannot compose its two ends. Three
        // measurements, in the order that decided it.
        //
        // The producer is `javax.xml.crypto.dsig.spec.HMACParameterSpec`
        // (HMACParameterSpec.crysl:14, realised by HMACParameterSpecSpec.mop),
        // an XML-DSig class of the `java.xml.crypto` module. The android-30
        // `android.jar` holds `javax/crypto/Mac` and `javax/crypto/spec/PBEParameterSpec`
        // and no entry at all under `javax/xml/crypto`, so on the platform this set
        // targets the producing class cannot be loaded and the predicate can never
        // be written. That is a fact about the platform and not about a catalogue,
        // which is why the substitution of oracle leaves it standing (task 11.9(b)).
        //
        // On a JVM, where it can be loaded, no `Mac` accepts it. Re-measured for the
        // sole oracle over the nine algorithms of `Mac.crysl:44`, on Temurin 21:
        // `HmacSHA256`, `HmacSHA384` and `HmacSHA512` reject every parameter object
        // with "HMAC does not use parameters"; `HmacPBESHA1` and the five
        // `PBEWithHmac*` answer "PBEParameterSpec type required" to this one. Every
        // one of the nine resolves, which is the one way the measurement differs from
        // the one made against the withdrawn catalogue -- that list named
        // `PBEwithHmacSHA`, which no provider has. The conclusion is the one it was:
        // no `Mac` the rule admits takes an `HMACParameterSpec`.
        //
        // The advice is `after`, which is after-finally, so it runs on the throwing
        // call too -- the only program that could reach a read here with the
        // predicate present is one that raises InvalidAlgorithmParameterException at
        // this very line. Writing the read would therefore accuse `NOT_OBSERVED` on
        // every conforming two-argument `init` in the world, which is the shape of
        // the seventeen orphan accusers Group 3 removed. Recorded in
        // predicate_graph.csv against the producer's row, not read (researcher
        // decision, 2026-08-22).
        event i2 after(java.security.Key key, java.security.spec.AlgorithmParameterSpec params, Mac m):
          call(public void Mac.init(java.security.Key, java.security.spec.AlgorithmParameterSpec)) &&
          args(key, params) &&
          target(m) {
            if (!ConscryptAliasTable.matches("Mac", m.getAlgorithm(), safeAlgorithms)) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-ALG-01 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + m.getAlgorithm() + "'"));
            }
            PredicateVerdict keyOrigin = PredicateStore.instance().validateAny(Property.GENERATED_KEY, key);
            if (keyOrigin == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-CONSTR-02 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(expectedGeneratedKey) + "' msg='the key given to Mac.init carries a key-origin predicate the rule does not admit'"));
            }
            else if (keyOrigin == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-NOBS-01 ev=" + __EVENTNAME + " obj=Mac val='" + q(m.getAlgorithm()) + "' exp='" + q(expectedGeneratedKey) + "' msg='the key given to Mac.init was not observed coming from a key generator, a key store or a key specification'"));
            }
        }

        // The rule's `Update` (Mac.crysl:31), which it states as four events and this file
        // observed as one, `update(..)`, binding nothing. That was enough while the file
        // wrote no predicate; it is not enough now, because `macced[output1, preInput]`
        // (Mac.crysl:58) is about the array the call was given and a pointcut that binds
        // no argument has no array to be about (finding 74).
        //
        // So the aggregate splits into siblings, one per overload whose argument the
        // clause names, with every type written out. The three shorter statements were
        // measured on this set and all fail: a disjunction of the signatures makes javamop
        // emit no aspect at all, `args(.., input)` matches every `update` whatever the
        // argument's type and binds nothing, and a wildcard in a middle position generates
        // a correct aspect but defeats the trace harness's resolver, which accepts any
        // call from the first wildcard onward (finding 79). A trailing wildcard after
        // every discriminating type is safe, which is why `updateRange` may keep `args`
        // positions it does not read.
        //
        // The split adds symbols and moves no ordering claim: the rule puts u1 to u4 in
        // one alternation, `Update` (Mac.crysl:31), so the `ere` accepts each sibling
        // exactly where it accepted the aggregate. The aggregate itself stays, and keeps
        // its name, for `update(byte)` -- the one overload whose ENSURES clause can hold
        // no site, for the reason below.
        //
        // `macced[output1, inputByte]` (Mac.crysl:57) is the rule's remaining ENSURES
        // clause and gains no site. `inputByte` is a primitive `byte`: a write would box
        // it, the store is keyed by object identity, and no `Cipher` takes a `byte` as its
        // plaintext -- so no read of the consuming clause could ever meet what a write here
        // recorded. Vacuous, recorded rather than written, on the ground decision 19 states.
        event update after(Mac m):
          call(public void Mac.update(byte)) &&
          target(m) { }

        // The rule's `u2: update(preInput)` (Mac.crysl:28). The withdrawn catalogue
        // declared this signature twice, as `u2` and again as `u4`, so the alphabet map
        // needed a row for each; the sole oracle writes it once and its `u4` is a
        // different call (`order_alphabet_map_delta.csv`, `withdrawn-duplicate`).
        event updateBytes after(byte[] input, Mac m):
          call(public void Mac.update(byte[])) &&
          args(input) &&
          target(m) {
            maccedByUpdate.add(input);
        }

        // The rule's `u3: update(preInput, offset, len)` (Mac.crysl:29). The ENSURES clause
        // names the array and not the window, so the two int positions are bound and unread
        // here. The rule does constrain them -- `length[preInput] >= offset + len`,
        // `offset >= 0` and `len > 0` (Mac.crysl:46-48) -- and this file implements none of
        // the three, which `constraint_table.csv:58-60` records as CRYSL-NAO-IMPLEMENTADO.
        event updateRange after(byte[] input, int offset, int len, Mac m):
          call(public void Mac.update(byte[], int, int)) &&
          args(input, offset, len) &&
          target(m) {
            maccedByUpdate.add(input);
        }

        // THE ORACLE DOES DECLARE THIS OVERLOAD, WHERE THE GENERATED RULE DID NOT.
        // `Mac.update(ByteBuffer)` is the rule's `u4: update(preInputByteBuffer)`
        // (Mac.crysl:30), and `:31` puts it inside `Update`. This comment used to say the
        // rule named no such event, which was true of the withdrawn catalogue and is not
        // true of the sole oracle. What the rule still does not do is name
        // `preInputByteBuffer` in any ENSURES -- `:57-59` name `inputByte`, `preInput` and
        // `input` -- so the event carries no clause and stages nothing, which is the same
        // reading `CipherSpec.f7` carries at the consuming end.
        //
        // The alphabet map now carries the event as `u4` (`order_alphabet_map_expert.csv`),
        // restored at task 11.6 against the sole oracle after standing `order-unmapped`
        // since the map was written against the withdrawn catalogue. It is not cosmetic:
        // G-ORDER erases an unmapped event as an epsilon move, so while this row was
        // erased the `+` in the `ere` below would have been satisfiable with no call at
        // all. The event was declared in the first place because the aggregate pointcut
        // this split replaced did match it, and dropping it would quietly narrow what the
        // automaton observes; it stands where the aggregate stood, and now it stands
        // inside both languages instead of outside both.
        event updateBuffer after(ByteBuffer input, Mac m):
          call(public void Mac.update(ByteBuffer)) &&
          args(input) &&
          target(m) { }

        // The rule's `Final` (Mac.crysl:38). Both of these events established a one-place
        // "a MAC was generated" property on the tag they return, and this pass
        // deletes both writes rather than moving them to the acceptance point.
        //
        // The property is written by three of this tree's five specification sets
        // and read by none of them, so nothing downstream loses a fact. And it does
        // not translate the rule's ENSURES: it states `macced[output1, inputByte]`,
        // `macced[output1, preInput]` and `macced[output2, input]`
        // (Mac.crysl:57-59) -- two places, the tag and the data it authenticates
        // -- while a one-place property over the tag alone cannot say which data
        // was authenticated, which is the only thing the consumer asks. That
        // consumer is Cipher's `!macced[_, plainText]`, ledger clause #8, and it is
        // wired at task 5.7 by a write made at the acceptance point with the arity
        // the clause states. Relocating this write would have handed that one edge
        // a second producer, at an arity that cannot answer it.
        //
        // The `returning` binding stays as it is: it is what task 5.7 writes from,
        // and this pass moves no symbol of the alphabet.
        //
        // This event is where the rule's two negated clauses would seem to belong,
        // and it carries neither. It covers the rule's `f1: output1 = doFinal()` and
        // its sibling below covers `f2: output2 = doFinal(input)`; in both, the array
        // the event binds is the one the call returns. The JCA allocates
        // that array fresh on every invocation -- measured on Temurin 21 over
        // HmacSHA1, HmacSHA256 and HmacSHA512, the returned tag is never the same
        // object as a ciphertext produced beside it -- so no Cipher acceptance
        // point can ever have marked it. `validateAbsent` never answers
        // NOT_OBSERVED, absence being conformance for a negated clause, so a read
        // placed here could only ever answer SATISFIED. It would be a site with no
        // path to an accusation, which decision 19 deletes rather than writes.
        // Clause #23 (`!encrypted[output2, _]`) has no other site and is recorded
        // vacuous in full; clause #22 keeps its second site, below.
        // The rule's `f1: output1 = doFinal()` (Mac.crysl:33), the overload that authenticates only what
        // `update` already contributed. It binds no data of its own, so it stages none;
        // what the run authenticated is in the update field.
        event f1 after(Mac m) returning(byte[] output):
          call(byte[] Mac.doFinal()) &&
          target(m){
        }

        // The rule's `f2: output2 = doFinal(input)` (Mac.crysl:34), and the site of
        // `macced[output2, input]` (Mac.crysl:59). It splits off the disjunction it
        // shared with `f1` for the reason the `update` family split: the clause is about
        // the array the call was given, and the merged pointcut bound no argument. The
        // sole oracle puts `f2` alone in `FinalWU` and `f1` in `FinalWOU`
        // (Mac.crysl:36-37), so the two are not interchangeable there -- and since task
        // 11.6 they are not interchangeable here either. This event is the only final the
        // `ere` accepts with no `update` before it, because it is the only one that brings
        // the bytes it authenticates. The other two now require the `Update+` the rule
        // requires.
        event f1Input after(byte[] input, Mac m) returning(byte[] output):
          call(byte[] Mac.doFinal(byte[])) &&
          args(input) &&
          target(m){
            maccedByFinal = input;
        }

        // The rule's `f3: doFinal(output1, outOffset)` (Mac.crysl:35), the only
        // event of the rule whose `byte[]` the caller owns: the tag is written into
        // a buffer the program already had. That makes it the one site where
        // `!encrypted[output1, _]` (Mac.crysl:51, ledger clause #22) can be
        // violated -- a program that hands its ciphertext to this call destroys the
        // bytes it means to authenticate, and authenticates whatever they were.
        //
        // The `Mac m` formal is a repair, not a binding this pass moved. The event
        // declared `target(m)` while naming no `m` among its formals, which is the
        // empty-binding broadcast recorded at conformance_record.csv:67 item (c):
        // the generator gives such an event the specification's parameterless map,
        // so it lands on a root monitor that has seen no `getInstance` and no
        // `init` and is therefore rejected by the `ere`. Measured on the three
        // traces this pass adds, against the pre-image, this tree and the frozen
        // control alike: every one of them drew `MAC-ORDER-00` at this event,
        // including the conforming one. The repair travels with the clause because
        // without it the read has no object to read and the accusation it produces
        // could not be told apart from the spurious ordering report already there
        // -- the same coupling task 6.2 has with task 5.9.
        //
        // The verdict is two-valued by construction, so there is no NOBS code
        // beside this one and its absence is not an omission under INV-INS-143.
        event f2 after(byte[] output, int outOffset, Mac m):
          call(void Mac.doFinal(byte[], int)) &&
          args(output, outOffset) &&
          target(m){
            if (PredicateStore.instance().validateAbsent(Property.ENCRYPTED, output) == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "MacSpec", "" + __LOC,
                    "v=1 code=MAC-CONSTR-00 ev=" + __EVENTNAME + " obj=Mac val='encrypted' exp='not encrypted' msg='the buffer the mac is written into already holds ciphertext'"));
            }
        }

        // `g3` is the unsafe-algorithm `getInstance`, and `g3*` is followed by a
        // required `g1` or `g2` -- a safe one. A program that only ever asks for an
        // unsafe algorithm therefore never leaves the prefix, and every such run
        // ends in `MAC-ORDER-00` no matter what else it does correctly. It is the
        // third site of the family the CipherSpec `unsafeAlg` sink opened and the
        // GCMParameterSpecSpec unreachable `@fail` continued: an ordering
        // accusation standing in for a constraint the automaton has no way to
        // state. Recorded, not repaired -- the repair is to the automaton and this
        // pass moves no symbol. Task 7.1 has since mapped this file, so G-ORDER no
        // longer skips it, and task 11.2 re-anchored the map on the sole oracle.
        //
        // The shape below is task 11.6's repair, decided by the researcher on
        // 2026-08-26 under the standing rule of this group -- adherence to the CrySL
        // rule as the rule is written. `Mac.crysl:41` orders
        // `Get, Init, (FinalWU | (Update+, Final))` and puts `f2: doFinal(input)`
        // ALONE in `FinalWU` (`:36-37`), which reads plainly: the one final that may
        // dispense with `update` is the one that carries its own data. `doFinal()`
        // and `doFinal(out, off)` with nothing updated authenticate the empty input.
        // The previous shape accepted all three finals bare -- `((f1 | f1Input | f2) |
        // (Update* (f1 | f1Input | f2)))`, whose left branch and whose `*` both admit
        // a MAC over nothing -- and G-ORDER reported it as `g1 i1 f1`. The repair is
        // the rule transcribed: `f1Input` alone on the left, and `+` where the rule
        // writes `Update+`.
        //
        // Note that `f1Input` is the `.mop` name of the rule's `f2` and `f2` here is
        // the rule's `f3`; the numbering is crossed between the two files and the
        // alphabet map is where it is written down.
        //
        // What the `+` costs is measured, not estimated, and the harness pair is
        // `data/gh105/evidence/harness/f8f-MacSpec.md`: three corpus traces begin to
        // draw MAC-ORDER-00 -- `-decrypt-buffer`, `-encrypted-buffer` and
        // `-fresh-buffer`, each an `init` followed straight by `doFinal(buf, 0)`.
        // They were written to witness `!encrypted[output1, _]` at the `f2` site and
        // used the buffer overload for convenience, so they keep that report and gain
        // an ordering one beside it. Three sibling traces with an `update` before the
        // final were added in the same commit, so the clause keeps a witness under a
        // call sequence the rule admits.
        //
        // The repair needed the alphabet map to move first, which measurement settled
        // and the task had not foreseen: G-ORDER erases an `order-unmapped` event as
        // an epsilon move, so with `updateBuffer` still erased the `+` above would be
        // satisfiable by no call at all and `g1 i1 f1` would survive the repair
        // untouched. That restoration is the commit before this one.
        ere : (g3* g1 | g3* g2) (i1 | i2) (f1Input | ((update | updateBytes | updateRange | updateBuffer)+ (f1 | f1Input | f2)))

        @fail {
            // The withdrawal that stood in this handler went with the write it
            // withdrew. INV-INS-142 requires all eight of the set's `@fail`
            // withdrawals to go, on the ground that "undo the predicate when the
            // automaton fails" is a semantics no generation of CrySL has; this one
            // goes here rather than at task 6.4 by the criterion task 4.6 used for
            // the `clearPassword` withdrawal -- a withdrawal travels with the write
            // it undoes, and both of this file's writes are deleted above. The
            // other seven remain 6.4's.
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "MacSpec", "" + __LOC,
                "v=1 code=MAC-ORDER-00 ev=" + __EVENTNAME + " obj=Mac val='' exp='' msg='the observed call sequence is not one MacSpec accepts'"));
            maccedByUpdate.clear();
            maccedByFinal = null;
            __RESET;
        }

        // The acceptance point of `macced[output1, preInput]` (Mac.crysl:58) and
        // `macced[output2, input]` (Mac.crysl:59), and the handler task 4.9 deleted
        // whole -- it had nothing left to do once the accepting-state bookkeeping went
        // (INV-INS-147), and it comes back because this pass gives it a clause to write.
        // Neither clause carries an `after L`, so the acceptance point is the accepting
        // state itself, which in an `ere` is what `@match` names (INV-INS-134).
        //
        // What the acceptance point buys over the event bodies is the same thing it buys
        // everywhere in this set, and here it is worth naming: `macced` says a program
        // authenticated this data, and a `doFinal` the automaton rejects -- one on a Mac
        // that was never initialised, for instance -- authenticated nothing. A body write
        // would mark the array anyway, and `Cipher`'s `!macced` would then refuse to
        // encrypt data no Mac ever covered.
        //
        // The two places of the clause are not both recorded, and that is by construction
        // rather than by omission: `Property.MACED` holds the second place, the data,
        // because that is the place the only consumer quantifies over --
        // `Cipher: !macced[_, plainText]` leaves the first anonymous. The tag itself is
        // marked by nothing, and no rule asks about it.
        //
        // Measured before the write was made: the composition is real and it is the one
        // the negated clause names. `mac.doFinal(data)` followed by
        // `cipher.doFinal(data)` over the *same array object* runs to completion on
        // Temurin 21 -- mac-then-encrypt, which `Cipher.crysl:137` forbids -- and the tag `doFinal`
        // returns is never the same object as the ciphertext beside it, so marking the
        // data cannot be confused with marking the output.
        @match {
            for (Object authenticated : maccedByUpdate) {
                PredicateStore.instance().ensure(Property.MACED, authenticated);
            }
            maccedByUpdate.clear();
            if (maccedByFinal != null) {
                PredicateStore.instance().ensure(Property.MACED, maccedByFinal);
                maccedByFinal = null;
            }
        }

}
