package mop;

import java.security.PublicKey;
import java.security.cert.TrustAnchor;
import java.security.cert.X509Certificate;
import javax.security.auth.x500.X500Principal;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * TrustAnchorSpec
 *
 * Monitors java.security.cert.TrustAnchor against the CrySL rule TrustAnchor.crysl.
 * The rule's ORDER is `Con`, the alternation of its three constructors, so a conforming trace
 * is one construction and nothing else. It REQUIRES `generatedPubkey[publicKey]` of the
 * public key two of those constructors take, and it ENSURES `generatedTrustAnchor[this]`,
 * which this specification writes at its acceptance point.
 *
 * Every clause of the rule has a site here. The REQUIRES clause has two of them and not
 * three: the certificate constructor binds no public key of its own, so the clause is about
 * nothing there, and that silence is the rule's.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/TrustAnchor.crysl
 */
TrustAnchorSpec(TrustAnchor s) {

   // Bound where the construction satisfied whatever the rule asks of it, which for `c2`
   // is nothing; see the note on that event.
   TrustAnchor spec;

   // Set by the three creation events, `c1`, `c2` and `c3`, whatever they report, and never
   // cleared: the generated `reset()` restores the automaton state and leaves this field.
   // `@fail` reads it to choose between `TRUSTANCHOR-ORDER-01` (`creation-unobserved`) and
   // the wrong-sequence code.
   boolean creationObserved = false;

   // `Con := c1 | c2 | c3` of TrustAnchor.crysl, first alternative: `c1: TrustAnchor(_,
   // publicKey, _)`, the overload whose first parameter is the CA's distinguished name as a
   // `String`. The rule declares three events, the platform declares three constructors, and
   // they line up one for one, so each gets an event of its own and the alternation of the
   // ORDER is the alternation of the three.
   //
   // REQUIRES `generatedPubkey[publicKey]`: the public key was produced by a call the
   // instrumentation observed -- `KeyPairSpec` writes it over the key `KeyPair.getPublic()`
   // returned, and `KeyFactorySpec` over the key `generatePublic` returned. SATISFIED produces
   // no report and is the one branch that binds the anchor for the acceptance handler.
   // VIOLATED means the store holds an entry for this key whose values differ, or one `negate`
   // has revoked -- positive evidence that a producing call was seen and established something
   // else -- and is reported under the CONSTR code registered in `codes.csv` for this site.
   // NOT_OBSERVED means the store holds nothing about the key at all, which happens when its
   // producing call was not woven, ran before the monitor attached, or lives inside the
   // platform or a library the instrumentation does not reach; it is reported under this
   // site's NOBS code, with the evidence of the key, and it is kept apart from VIOLATED
   // because a key whose producer was never instrumented is not a misuse.
   //
   // The read is in the event body and not in a `condition(...)` guard: a guard compiles to an
   // early return ahead of both the body and the transition, so an anchor built over a key of
   // unknown origin would leave the automaton in the state before the constructor and a later
   // call would be reported as a wrong call sequence instead of as the unsatisfied requirement
   // it is. `c3` reads the same clause over the same object at its own site, and the two sites
   // carry two pairs of codes, because a code names a site and not a clause.
   event c1 after(String caName, PublicKey pubKey, byte[] nameConstraints) returning(TrustAnchor s):
     call(public TrustAnchor.new(String, PublicKey, byte[])) &&
     args(caName, pubKey, nameConstraints) {
       creationObserved = true;
       PredicateVerdict generated = PredicateStore.instance().validate(Property.GENERATED_PUBLIC_KEY, pubKey);
       if (generated == PredicateVerdict.VIOLATED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "TrustAnchorSpec", "" + __LOC,
               "v=1 code=TRUSTANCHOR-CONSTR-00 ev=" + __EVENTNAME + " obj=TrustAnchor val='' exp='a public key the monitor observed being generated' msg='the ca public key carries a generation predicate the rule does not admit'"));
       }
       else if (generated == PredicateVerdict.NOT_OBSERVED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "TrustAnchorSpec", "" + __LOC,
               "v=1 code=TRUSTANCHOR-NOBS-00 ev=" + __EVENTNAME + " obj=TrustAnchor val='' exp='a public key the monitor observed being generated' msg='no generation of the ca public key was observed'" + Evidence.keysFor(pubKey)));
       }
       else {
           spec = s;
       }
   }

   // `Con := c1 | c2 | c3` of TrustAnchor.crysl, second alternative: `c2: TrustAnchor(
   // trustedCert, _)`, the certificate overload. It binds `trustedCert`, and the rule reads
   // that object in no clause, so there is nothing to check here: the anchor is the
   // certificate, and the rule states its requirement about a public key handed over
   // separately. Silence here is the rule, not an omission. The body binds the anchor for the
   // acceptance handler unconditionally, since no clause can withhold it.
   event c2 after(X509Certificate trustedCert, byte[] nameConstraints) returning(TrustAnchor s):
     call(public TrustAnchor.new(X509Certificate, byte[])) &&
     args(trustedCert, nameConstraints) {
       creationObserved = true;
       spec = s;
   }

   // `Con := c1 | c2 | c3` of TrustAnchor.crysl, third alternative: `c3: TrustAnchor(
   // caPrincipal, publicKey, _)`, the same shape as `c1` with an `X500Principal` in place of
   // the distinguished-name string.
   //
   // REQUIRES `generatedPubkey[publicKey]` over the same object as at `c1`: the public key was
   // produced by a call the instrumentation observed. SATISFIED produces no report and binds
   // the anchor for the acceptance handler; VIOLATED is reported under this site's CONSTR
   // code; NOT_OBSERVED under its NOBS code, with the evidence of the key. The read is in the
   // body and not in a `condition(...)` guard, for the reason given at `c1`: a guard returns
   // ahead of the transition, and an unsatisfied requirement is not a typestate failure.
   event c3 after(X500Principal caPrincipal, PublicKey pubKey, byte[] nameConstraints) returning(TrustAnchor s):
     call(public TrustAnchor.new(X500Principal, PublicKey, byte[])) &&
     args(caPrincipal, pubKey, nameConstraints) {
       creationObserved = true;
       PredicateVerdict generated = PredicateStore.instance().validate(Property.GENERATED_PUBLIC_KEY, pubKey);
       if (generated == PredicateVerdict.VIOLATED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "TrustAnchorSpec", "" + __LOC,
               "v=1 code=TRUSTANCHOR-CONSTR-01 ev=" + __EVENTNAME + " obj=TrustAnchor val='' exp='a public key the monitor observed being generated' msg='the ca public key carries a generation predicate the rule does not admit'"));
       }
       else if (generated == PredicateVerdict.NOT_OBSERVED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "TrustAnchorSpec", "" + __LOC,
               "v=1 code=TRUSTANCHOR-NOBS-01 ev=" + __EVENTNAME + " obj=TrustAnchor val='' exp='a public key the monitor observed being generated' msg='no generation of the ca public key was observed'" + Evidence.keysFor(pubKey)));
       }
       else {
           spec = s;
       }
   }

   // `Con := c1 | c2 | c3` is the whole ORDER of TrustAnchor.crysl: one construction and
   // nothing else. A monitor is keyed on the constructed object, so it never sees a second
   // event, and the only state a second event could take it to is never entered.
   ere : c1 | c2 | c3

   // Unreachable. A single-symbol `ere` has no second event to take, and this monitor is keyed
   // on the object one constructor returns, so no trace ever leaves the accepting state. The
   // handler is written because the generator expects one and because each of its two codes is
   // registered in `codes.csv`.
   @fail {
      if (!creationObserved) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "TrustAnchorSpec", "" + __LOC,
             "v=1 code=TRUSTANCHOR-ORDER-01 ev=" + __EVENTNAME + " obj=TrustAnchor val='' exp='' msg='the observed call sequence is not one TrustAnchorSpec accepts and no creation of the anchor was observed'"));
      }
      else {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "TrustAnchorSpec", "" + __LOC,
             "v=1 code=TRUSTANCHOR-ORDER-00 ev=" + __EVENTNAME + " obj=TrustAnchor val='' exp='' msg='the observed call sequence is not one TrustAnchorSpec accepts'"));
      }
      __RESET;
   }

   // ENSURES `generatedTrustAnchor[this]`: the trust anchor was built over a public key the
   // instrumentation observed. The clause carries no `after L`, so its acceptance point is an
   // accepting state of the ORDER, which in an `ere` is where this handler runs. The anchor
   // reaches the handler through the monitor field because a handler receives no event
   // arguments and runs after the transition is decided.
   //
   // The field holds an anchor only where the REQUIRES read came back SATISFIED, or where the
   // certificate overload made the clause moot, and `ensure` treats a null binding as a no-op:
   // an anchor built over a public key of unobserved origin therefore writes nothing.
   //
   // No live clause consumes this predicate. `PKIXBuilderParameters.crysl` carries the
   // would-be consumer commented out in the rule itself, as `//generatedTrustAnchor[];`, so
   // the write stands for coverage of the rule and the absence of a reader is a property of
   // the rules and not a gap here.
   @match {
      PredicateStore.instance().ensure(Property.GENERATED_TRUST_ANCHOR, spec);
   }

}
