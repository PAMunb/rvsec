package mop;

import javax.net.ssl.KeyManagerFactory;
import javax.net.ssl.ManagerFactoryParameters;
import javax.net.ssl.KeyManager;
import java.security.KeyStore;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * KeyManagerFactory
 *
 * A JavaMOP specification of the correct usage of the
 * javax.net.ssl.KeyManagerFactory class.
 *
 * https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/KeyManagerFactory.crysl
 */
KeyManagerFactorySpec(KeyManagerFactory k) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    // D-15: KeyManagerFactory.crysl states `algorithm in {"PKIX", "SunX509"}`. `SunX509`
    // returns -- it names a JSE provider absent from Android, which makes it inert, not
    // removable. `X509` keeps resolving to `PKIX` through the alias table.
    List<String> safeAlgorithms = Arrays.asList("PKIX", "SunX509");

    // Staged by `init` for the acceptance-point handler, which sees no event parameter,
    // and cleared the moment it is used or the sequence is rejected.
    KeyManagerFactory initialisedFactory = null;

    String expectedGeneratedKeyStore = "a KeyStore this instrumentation observed being loaded";

    String expectedGeneratedManagerFactoryParameters =
        "a ManagerFactoryParameters this instrumentation observed being constructed";

    event g1 after(String alg) returning(KeyManagerFactory k):
      call(public static KeyManagerFactory KeyManagerFactory.getInstance(String))
      && args(alg)
      && condition(ConscryptAliasTable.matches("KeyManagerFactory", alg, safeAlgorithms)) {
    }

    event g2 after(String alg) returning(KeyManagerFactory k):
      call(public static KeyManagerFactory KeyManagerFactory.getInstance(String, ..))
      && args(alg, *)
      && condition(ConscryptAliasTable.matches("KeyManagerFactory", alg, safeAlgorithms)) {
    }

    event g3 after(String alg) returning(KeyManagerFactory k):
      call(public static KeyManagerFactory KeyManagerFactory.getInstance(String))
      && args(alg)
      && condition(!ConscryptAliasTable.matches("KeyManagerFactory", alg, safeAlgorithms))  {
    }

    // `generatedKeyStore[keyStore]` (KeyManagerFactory.crysl:31, ledger clause #14) is read
    // here, in the only event of this file that a key store ever reaches.
    //
    // The event stands for the rule's `i1` and `i2` at once -- the rule declares
    // `i1: init(keyStore, password)`, `i2: init(params)` and `Init := i1 | i2` -- and the two
    // overloads have different arities, so no named position exists in both signatures. What
    // does exist is the position they share: each has a first argument, so `args(arg, ..)`
    // binds it in both and the body discriminates by runtime type. That is the fusion idiom
    // this change already states for a varying argument, used under the condition it states:
    // the bound position is the zeroth, which every fused signature has, so no overload drops
    // out of the automaton. The two alternatives were measured and both cost more. Splitting
    // the event into the rule's own `i1`/`i2` grows the alphabet of two mirror automata, makes
    // the ordering map be rewritten for the sibling file, and changes the `ev=` field of an
    // ORDER code that is already published -- and it puts the algorithm accusation below in two
    // places. A separate consumer specification was the other, and the file of this set that
    // carries one says in its own header that a separate specification is the last resort,
    // taken because `CipherSpec` had no event left to spend; this file declares five events and
    // has no ceiling (researcher decision, 2026-08-22).
    //
    // The wildcard lives in `args` and not in the `call(...)` signatures, which are written out
    // in full. That is the distinction the trace harness makes: its resolver walks the declared
    // parameter types of the call and stops at the first that is a wildcard, so a wildcard in
    // the signature would make every `init` fit this pointcut.
    //
    // Reading a null argument is deliberate, not an oversight (researcher decision,
    // 2026-08-22). Measured on Temurin 21: `kmf.init(store, pw)` on a store that was never
    // loaded raises `KeyStoreException: initialization failed`, so a key store that arrives
    // here was loaded -- but a null one arrives freely, and the sibling `TrustManagerFactory`
    // takes null as its documented default-truststore route. The store answers NOT_OBSERVED for
    // a null object, and that is what the rule states: the clause requires a key store this
    // instrumentation saw generated, and no argument is not one. A guard on null would fold
    // "the program handed over no key store" into silence, which is the shape of suppression
    // this change exists to remove.
    //
    // The imprecision that buys, stated rather than hidden: a null carries no runtime type, so
    // `init((ManagerFactoryParameters) null)` -- the rule's `i2` with a null argument, a call no
    // program of the corpus makes -- is read as if it were `i1`. Discriminating them would need
    // the join point's static signature, which an event body does not see.
    //
    // The read is three-valued and its two accusing outcomes carry different codes, as at every
    // other read of this set. VIOLATED has no program that produces it today: the predicate is
    // written at arity 1 by `KeyStoreSpec` and withdrawn nowhere, so the store can only answer
    // SATISFIED or NOT_OBSERVED. The branch is written anyway, and this is the record of why
    // rather than a claim that it fires -- a predicate gains a withdrawal the day some rule's
    // NEGATES clause is wired to it, and a read that had folded VIOLATED into NOT_OBSERVED
    // would then report a withdrawn key store as an unobserved one.
    event init before(Object arg, KeyManagerFactory k):
       ( call(public void KeyManagerFactory.init(KeyStore, char[])) ||
         call(public void KeyManagerFactory.init(ManagerFactoryParameters))
       ) && args(arg, ..) && target(k) {
        if (!ConscryptAliasTable.matches("KeyManagerFactory", k.getAlgorithm(), safeAlgorithms)) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "KeyManagerFactorySpec", "" + __LOC,
                "v=1 code=KEYMANAGERFACTORY-ALG-00 ev=" + __EVENTNAME + " obj=KeyManagerFactory val='" + q(k.getAlgorithm()) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + k.getAlgorithm() + "'"));
        }
        if (arg == null || arg instanceof KeyStore) {
            PredicateVerdict generated = PredicateStore.instance().validate(Property.GENERATED_KEY_STORE, arg);
            if (generated == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyManagerFactorySpec", "" + __LOC,
                    "v=1 code=KEYMANAGERFACTORY-CONSTR-00 ev=" + __EVENTNAME + " obj=KeyManagerFactory val='" + q(k.getAlgorithm()) + "' exp='" + q(expectedGeneratedKeyStore) + "' msg='the KeyStore given to KeyManagerFactory.init carries a generation predicate the rule does not admit'"));
            }
            else if (generated == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyManagerFactorySpec", "" + __LOC,
                    "v=1 code=KEYMANAGERFACTORY-NOBS-00 ev=" + __EVENTNAME + " obj=KeyManagerFactory val='" + q(k.getAlgorithm()) + "' exp='" + q(expectedGeneratedKeyStore) + "' msg='no loading of the KeyStore given to KeyManagerFactory.init was observed'"));
            }
        }
        // The rule's other REQUIRES clause, `generatedManagerFactoryParameters[params]`
        // (KeyManagerFactory.crysl:32, ledger clause #29), on the sibling branch of the same
        // discrimination. `params` is what the rule's `i2` binds, so this is the branch where a
        // `ManagerFactoryParameters` reaches this event at all, and the guard that separates the
        // two clauses is the same runtime-type test the `generatedKeyStore` read above already
        // makes -- no new event, no new pointcut, no arity to fuse.
        //
        // Until gh109 group G2 the clause was recorded `unmonitored-producer`: nothing in the set
        // ensured the predicate, so the read could only ever have answered NOT_OBSERVED. G2 wrote
        // both producers the oracle states -- `KeyStoreBuilderParametersSpec` (task 2.8) and
        // `CertPathTrustManagerParametersSpec` (task 2.9), the two rules whose ENSURES names it --
        // and D-24 is why writing them is not enough: a predicate no specification reads is a
        // clause that moved no verdict. The `null` case belongs to the branch above and not to
        // this one, for the reason stated there; a null argument is read as the rule's `i1`.
        else if (arg instanceof ManagerFactoryParameters) {
            PredicateVerdict prepared = PredicateStore.instance().validate(Property.GENERATED_MANAGER_FACTORY_PARAMETERS, arg);
            if (prepared == PredicateVerdict.VIOLATED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyManagerFactorySpec", "" + __LOC,
                    "v=1 code=KEYMANAGERFACTORY-CONSTR-01 ev=" + __EVENTNAME + " obj=KeyManagerFactory val='" + q(k.getAlgorithm()) + "' exp='" + q(expectedGeneratedManagerFactoryParameters) + "' msg='the ManagerFactoryParameters given to KeyManagerFactory.init carries a generation predicate the rule does not admit'"));
            }
            else if (prepared == PredicateVerdict.NOT_OBSERVED) {
                ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyManagerFactorySpec", "" + __LOC,
                    "v=1 code=KEYMANAGERFACTORY-NOBS-01 ev=" + __EVENTNAME + " obj=KeyManagerFactory val='" + q(k.getAlgorithm()) + "' exp='" + q(expectedGeneratedManagerFactoryParameters) + "' msg='no construction of the ManagerFactoryParameters given to KeyManagerFactory.init was observed'"));
            }
        }
       initialisedFactory = k;
    }

    // `generatedKeyManagers[keyManager] after GetKeyMng` (KeyManagerFactory.crysl:36), the
    // predicate ledger #14's neighbour #28 and the one `SSLContext.init` reads at task 5.9.
    // The oracle names the predicate in the plural and qualifies it with an `after L` the
    // generated rule did not carry; neither moves this site, because `GetKeyMng` is the
    // aggregate `gkm1` belongs to and the write is already in its body.
    //
    // The write is at the acceptance point, in the sense the monitor has one: `gkm1` carries
    // the transition row {4, 4, 4, 2, 4} and lands on state 2, which is `@match2`, read off
    // the generated monitor, so this body runs on the transition that accepts. What keeps it
    // out of the `@match2` handler is the array and nothing else -- a handler sees no
    // parameter of the event it follows, and `kms` is the parameter, where
    // `initialisedFactory` is a field `@match1` can reach. The record is in
    // predicate_graph.csv.
    event gkm1 after(KeyManagerFactory k) returning(KeyManager[] keyManager):
      call(public KeyManager[] KeyManagerFactory.getKeyManagers())
      && target(k) {
        PredicateStore.instance().ensure(Property.GENERATED_KEY_MANAGERS, keyManager);
    }

    fsm :
      start [
        g3 -> unsafeAlg
        g1 -> waitingInit
        g2 -> waitingInit
      ]
      unsafeAlg [
        g3 -> unsafeAlg
        g1 -> waitingInit
        g2 -> waitingInit
      ]
      waitingInit [
        init -> final
      ]
      final [
        gkm1 -> taken
      ]
      taken [
      ]

    alias match1 = final
    alias match2 = taken

    @fail {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyManagerFactorySpec", "" + __LOC,
            "v=1 code=KEYMANAGERFACTORY-ORDER-00 ev=" + __EVENTNAME + " obj=KeyManagerFactory val='' exp='' msg='the observed call sequence is not one KeyManagerFactorySpec accepts'"));
        initialisedFactory = null;

        __RESET;
    }

    // The acceptance point of `generatedKeyManager[this] after Init`, where the two routes
    // INV-INS-134 admits are the same handler: `init` has the transition row {4, 3, 4, 4, 4}
    // and the match category is `nextstate == 3`, so the state the Init leads to and the
    // accepting state are one state, and `init` is the only event that reaches it.
    //
    // No rule of the oracle requires this half of the clause -- `SSLContext.crysl:32` asks
    // for `generatedKeyManagers[km]`, over the array, never over the factory -- so the site
    // carries a deliberate-omission record (INV-INS-137) and no read is fabricated for it.
    @match1 {
       if (initialisedFactory != null) {
           PredicateStore.instance().ensure(Property.GENERATED_KEY_MANAGERS, initialisedFactory);
           initialisedFactory = null;
       }
    }

    // The second accepting state, which is what makes the rule's `gkm?` optional and terminal
    // at once: the rule's ORDER `Get, Init, GetKeyMng?` (KeyManagerFactory.crysl:23) accepts
    // a factory whose key managers were taken, and the `?` refuses a
    // second taking, so `taken` accepts and declares no event of its own. An alias is how this
    // file says a state accepts -- it is also what G-ORDER reads to decide equivalence -- and
    // the handler is empty because there is nothing left to write: the clause's write over the
    // factory is `@match1`'s, and the one over the array is in the `gkm1` body, which is the
    // only place the array is visible.
    @match2 {
    }
}