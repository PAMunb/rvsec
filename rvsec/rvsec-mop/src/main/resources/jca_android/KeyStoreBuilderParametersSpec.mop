package mop;

import java.security.KeyStore;
import javax.net.ssl.KeyStoreBuilderParameters;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.Property;

/**
 * KeyStoreBuilderParametersSpec
 *
 * Monitors javax.net.ssl.KeyStoreBuilderParameters against the CrySL rule
 * KeyStoreBuilderParameters.crysl.
 *
 * The rule's ORDER is `Con`, the single constructor event `c1:
 * KeyStoreBuilderParameters(builder);`. It states no CONSTRAINTS and no REQUIRES, so this
 * specification accuses no value and reads no predicate; what it contributes is the one ENSURES
 * clause, `generatedManagerFactoryParameters[this]`, written at the accepting state and read by
 * `KeyManagerFactorySpec` and `TrustManagerFactorySpec` at their `init` event.
 *
 * Divergences from the rule and reach limits of this monitor:
 *
 * - The platform declares two constructors, over `KeyStore.Builder` and over a
 *   `List<KeyStore.Builder>`, and the rule declares the first. The pointcut cannot name the
 *   nested type, so it is written over `Object+` and the rule's type is restored by a test in the
 *   event body; the event's own comment states why, and what a construction through the list
 *   overload does.
 * - The `@fail` handler cannot fire, because a one-symbol expression gives a monitor keyed on the
 *   constructed object no second event to refuse.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/KeyStoreBuilderParameters.crysl
 */
KeyStoreBuilderParametersSpec(KeyStoreBuilderParameters s) {

   // Bound only where the rule's event is the one that happened; see the note below on why
   // that takes a test in the body rather than a type in the pointcut.
   KeyStoreBuilderParameters spec;

   // Set by the one creation event, `c1`, whichever overload it matched, and never cleared:
   // the generated `reset()` restores the automaton state and leaves this field. `@fail`
   // reads it to choose between `KEYSTOREBUILDERPARAMETERS-ORDER-01` (`creation-unobserved`)
   // and the wrong-sequence code.
   boolean creationObserved = false;

   // `Con` of KeyStoreBuilderParameters.crysl: `c1: KeyStoreBuilderParameters(builder);`, whose
   // object the rule declares as `java.security.KeyStore.Builder`, and the whole of its ORDER.
   // The rule states no CONSTRAINTS and no REQUIRES, so this event accuses nothing and reads
   // nothing; it records the construction and, on the rule's own overload, stages the object for
   // the write at the accepting state.
   //
   // The platform declares two constructors, `KeyStoreBuilderParameters(KeyStore.Builder)` and
   // `KeyStoreBuilderParameters(List<KeyStore.Builder>)`, and the rule declares the first. The
   // pointcut cannot say so: `KeyStore.Builder` is a nested type, and a matcher that turns a
   // dotted type name into a descriptor by replacing every dot with a slash yields
   // `Ljava/security/KeyStore/Builder;` where the platform's descriptor is
   // `Ljava/security/KeyStore$Builder;`, so a pointcut naming the nested type would match
   // nothing at all and the advice would never weave.
   //
   // So the pointcut is written over `Object+`, which covers both overloads, and the rule's
   // declared type is restored by a test in the body, where it is ordinary Java and the nested
   // name resolves. A construction through the list overload is not the rule's `c1`: it records
   // the creation, stages nothing and accuses nothing, because the rule never declared it. What
   // that costs downstream is that `KeyManagerFactorySpec` or `TrustManagerFactorySpec` reads
   // such a parameter object as one whose construction was not observed, rather than as a
   // violation -- which is the true answer, since no event of this rule was seen for it.
   event c1 after(Object builder) returning(KeyStoreBuilderParameters s):
     call(public KeyStoreBuilderParameters.new(Object+)) &&
     args(builder) {
       creationObserved = true;
       if (builder instanceof KeyStore.Builder) {
           spec = s;
       }
   }

   // `Con := c1` is the whole ORDER, so the `@fail` handler below cannot fire: a single-symbol
   // expression has no second event to take, and the monitor is keyed on the constructed object,
   // so no monitor ever sees one. It is written because the generator expects a handler and
   // because the codes it names are registered in `codes.csv`.
   ere : c1

   @fail {
      if (!creationObserved) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyStoreBuilderParametersSpec", "" + __LOC,
             "v=1 code=KEYSTOREBUILDERPARAMETERS-ORDER-01 ev=" + __EVENTNAME + " obj=KeyStoreBuilderParameters val='' exp='' msg='the observed call sequence is not one KeyStoreBuilderParametersSpec accepts and no creation of the parameters was observed'"));
      }
      else {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyStoreBuilderParametersSpec", "" + __LOC,
             "v=1 code=KEYSTOREBUILDERPARAMETERS-ORDER-00 ev=" + __EVENTNAME + " obj=KeyStoreBuilderParameters val='' exp='' msg='the observed call sequence is not one KeyStoreBuilderParametersSpec accepts'"));
      }
      __RESET;
   }

   // ENSURES of KeyStoreBuilderParameters.crysl:
   // `generatedManagerFactoryParameters[this];`. The predicate says that the parameter object
   // was constructed by a call the instrumentation observed, so a key or trust manager factory
   // may be initialised from it. The clause carries no `after L`, so its acceptance point is the
   // accepting state, which in a specification written as an `ere` is this handler: it fires
   // whenever the trace so far is a word of the expression.
   //
   // The object travels here in a field because a handler receives no event arguments and runs
   // after the transition has been decided. `ensure` treats a null binding as a no-op, so a
   // construction through the list overload -- which stages nothing -- writes nothing.
   //
   // The predicate has a second producer in this set, `CertPathTrustManagerParametersSpec`, and
   // two consumers, `KeyManagerFactorySpec` and `TrustManagerFactorySpec`, which read it at
   // their `init` event over an argument whose runtime type is a `ManagerFactoryParameters`.
   @match {
      PredicateStore.instance().ensure(Property.GENERATED_MANAGER_FACTORY_PARAMETERS, spec);
   }

}
