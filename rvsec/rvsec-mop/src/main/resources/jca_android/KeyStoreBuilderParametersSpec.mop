package mop;

import java.security.KeyStore;
import javax.net.ssl.KeyStoreBuilderParameters;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.Property;

/**
 * KeyStoreBuilderParameters
 *
 * A JavaMOP specification of the correct usage of the
 * javax.net.ssl.KeyStoreBuilderParameters.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/KeyStoreBuilderParameters.crysl
 */
KeyStoreBuilderParametersSpec(KeyStoreBuilderParameters s) {

   // Bound only where the rule's event is the one that happened; see the note below on why
   // that takes a test in the body rather than a type in the pointcut.
   KeyStoreBuilderParameters spec;

   // The rule's one event, `c1: KeyStoreBuilderParameters(builder)` (:7), whose object is
   // declared `java.security.KeyStore.Builder` (:4), and the whole of its ORDER. The rule
   // states no CONSTRAINTS and no REQUIRES, so this specification accuses nothing and
   // appears in `codes.csv` with its `@fail` row alone; what it contributes is the ENSURES.
   //
   // api30 declares two constructors, `KeyStoreBuilderParameters(KeyStore.Builder)` and
   // `KeyStoreBuilderParameters(List<KeyStore.Builder>)`, and the rule declares the first.
   // The pointcut cannot say so: `KeyStore.Builder` is a nested type, and the DEX matcher's
   // resolver turns a dotted type name into a descriptor by replacing every dot with a
   // slash (`TypeResolver.toDescriptor`), which yields `Ljava/security/KeyStore/Builder;`
   // where the platform's descriptor is `Ljava/security/KeyStore$Builder;`. A pointcut
   // naming the nested type would therefore match nothing at all -- the failure mode this
   // set has already paid for once, in the R5 owner that did not weave.
   //
   // So the pointcut is written over `Object+`, which covers both overloads -- the set's
   // form for one pointcut over several parameter types (`KeyStoreSpec.mop:90`,
   // `KeyGeneratorSpec.g2`) -- and the rule's declared type is restored in the body, where
   // it is ordinary Java and the nested name resolves. A construction through the List
   // overload is not the rule's `c1`, so it prepares nothing and accuses nothing: the rule
   // never declared it. What that costs downstream is a NOT_OBSERVED at
   // `KeyManagerFactorySpec` or `TrustManagerFactorySpec` rather than a violation, which is
   // the honest answer -- no producing event of this rule was seen -- and is exactly what
   // the NOBS family is for (INV-INS-143).
   event c1 after(Object builder) returning(KeyStoreBuilderParameters s):
     call(public KeyStoreBuilderParameters.new(Object+)) &&
     args(builder) {
       if (builder instanceof KeyStore.Builder) {
           spec = s;
       }
   }

   // `Con := c1` is the whole ORDER (:10-11), so the `@fail` handler cannot fire: one
   // symbol, a {1, 2, 2} transition row, and a monitor keyed on the constructed object, so
   // no monitor ever sees a second event. Written because the generator and the
   // `codes.csv` bijection expect it (precedent: `GCMParameterSpecSpec.mop:134-146`).
   ere : c1

   @fail {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyStoreBuilderParametersSpec", "" + __LOC,
          "v=1 code=KEYSTOREBUILDERPARAMETERS-ORDER-00 ev=" + __EVENTNAME + " obj=KeyStoreBuilderParameters val='' exp='' msg='the observed call sequence is not one KeyStoreBuilderParametersSpec accepts'"));
      __RESET;
   }

   // `ENSURES generatedManagerFactoryParameters[this]` (:14) carries no `after L`, so the
   // acceptance point is the accepting state, which in an `ere` is `@match` (INV-INS-134).
   // `ensure` treats a null binding as a no-op, so the List overload writes nothing.
   //
   // This predicate has a second producer in the same group -- `CertPathTrustManagerParameters`
   // (2.9) -- and two consumers, `KeyManagerFactory.crysl:32` and
   // `TrustManagerFactory.crysl:29`, wired at tasks 1b.2 and 1b.3. Both consuming
   // specifications already bind the argument and both recorded, in a comment, that their
   // read was left closed only because no producer existed (D-24). This file is half of
   // what opens it.
   @match {
      PredicateStore.instance().ensure(Property.GENERATED_MANAGER_FACTORY_PARAMETERS, spec);
   }

}
