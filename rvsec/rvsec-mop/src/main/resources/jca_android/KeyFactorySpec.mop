package mop;

import java.security.KeyFactory;
import java.security.PrivateKey;
import java.security.PublicKey;
import java.security.spec.KeySpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * KeyFactorySpec
 *
 * Monitors java.security.KeyFactory against the CrySL rule KeyFactory.crysl.
 *
 * The rule's ORDER is `Get, (GenPriv | GenPubl)*`: obtain a factory with `getInstance`, then
 * generate any number of keys from key specs, or none. The specification checks the rule's one
 * CONSTRAINTS clause, `algorithm in {"RSA", "DiffieHellman", "DH", "DSA", "EC"}`, at
 * `getInstance`; it REQUIRES `speccedKey[keySpec, _]` at both generating events; and it ENSURES
 * `generatedKeyFactory[this, algorithm] after Get`,
 * `generatedPrivkey[privateKey] after GenPriv` and `generatedPubkey[publicKey] after GenPubl`.
 *
 * `generatedKeyFactory` is written here and read nowhere: no rule this set transcribes
 * REQUIRES it. The write stands because the rule states the clause.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/KeyFactory.crysl
 */
KeyFactorySpec(KeyFactory f) {

   // The envelope's quoting rule: a null value is the empty string, a single quote is escaped
   // so it cannot close the field early, and the value is capped.
   private String q(String str) {
       if (str == null) {
           return "";
       }
       String value = str.length() > 512 ? str.substring(0, 512) : str;
       return value.replace("'", "\\'");
   }

   // The rule's one CONSTRAINTS clause,
   // `algorithm in {"RSA", "DiffieHellman", "DH", "DSA", "EC"}`, transcribed. `DiffieHellman`
   // and `DH` are two entries of the clause itself and both stay; `ConscryptAliasTable` has no
   // row that maps either spelling to the other for this service, so each is matched by its own
   // entry. What the table does add here is the OID spellings: it resolves the OIDs Conscrypt
   // registers for `KeyFactory` to `RSA` and to `EC`, so a `getInstance` written with one of
   // them meets the list entry the rule names.
   List<String> safeAlgorithms = Arrays.asList("RSA", "DiffieHellman", "DH", "DSA", "EC");

   // The canonical algorithm and the factory itself, staged by `get` for the `after Get` write
   // at `@match`, which receives no event arguments.
   String algorithm = null;
   KeyFactory obtained = null;

   // The `exp=` text of the six reports below, in one place so they all say the same.
   String expectedSpeccedKey = "a key spec this instrumentation observed being built from key material";

   // Set by `get` and read by `@fail` (KEYFACTORY-ORDER-01). The generated `reset()` clears
   // the state and not this field.
   boolean creationObserved = false;

   // `Get := g1 | g2`: `g1: getInstance(algorithm)` and `g2: getInstance(algorithm, _)`, fused
   // on the zeroth position. The rule leaves `g2`'s second position anonymous, so every overload
   // the platform declares is that event: it declares `(String)`, `(String, String)` and
   // `(String, Provider)`, and all three are named here. Leaving one out would send a factory
   // obtained through it to its next event with the monitor still in the initial state, where
   // every row is `fail`.
   //
   // CONSTRAINTS `algorithm in {"RSA", "DiffieHellman", "DH", "DSA", "EC"}`, checked in the body
   // against the list above through `ConscryptAliasTable.matches`, which compares
   // case-insensitively and resolves a provider alias to the name the rule writes. A name
   // outside the list draws the unsafe-algorithm code registered in `codes.csv` for this site.
   // The check sits in the body and not in a `condition(...)` guard: a guard compiles to an
   // early return ahead of both the body and the transition, so a factory obtained for an
   // algorithm the rule refuses would leave the automaton in its initial state and the
   // `generatePrivate` that followed would be reported as a wrong call sequence instead of as
   // the unsafe algorithm it is.
   event get after(String alg) returning(KeyFactory f):
     ( call(public static KeyFactory KeyFactory.getInstance(String)) ||
       call(public static KeyFactory KeyFactory.getInstance(String, String)) ||
       call(public static KeyFactory KeyFactory.getInstance(String, java.security.Provider))
     ) && args(alg, ..) {
       creationObserved = true;
       algorithm = ConscryptAliasTable.canonical("KeyFactory", alg);
       obtained = f;
       if (!ConscryptAliasTable.matches("KeyFactory", alg, safeAlgorithms)) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "KeyFactorySpec", "" + __LOC,
               "v=1 code=KEYFACTORY-ALG-00 ev=" + __EVENTNAME + " obj=KeyFactory val='" + q(alg) + "' exp='" + q(String.join(",", safeAlgorithms)) + "' msg='expecting one of " + String.join(",", safeAlgorithms) + " but found " + alg + "'"));
       }
   }

   // `GenPriv`: `gpr1: privateKey = generatePrivate(keySpec)`, the whole of that label.
   //
   // REQUIRES `speccedKey[keySpec, _]`: the key spec was constructed by a call the
   // instrumentation observed and the rule admitted. The clause leaves its second position
   // anonymous, which is what `validateAny` reads -- does this object carry the predicate at
   // all. Reading it with `validate` and no value would compare against the empty argument list,
   // which no producer of a wider clause records, so every conforming key spec would come back
   // VIOLATED. The producers are the constructors of `PBEKeySpecSpec`, `SecretKeySpecSpec` and
   // `X509EncodedKeySpecSpec` -- the last of which is the one a key factory actually sees, since
   // a public or private key is decoded from encoded key material.
   //
   // The read is three-valued. SATISFIED is silent. VIOLATED is positive evidence about this
   // spec -- an entry exists and is not what the clause demands, which for this predicate means
   // a `PBEKeySpec` whose `clearPassword()` was observed, since that is the one place the rule
   // set negates it -- and draws the constraint code. NOT_OBSERVED means no entry at all: no
   // construction of the spec was ever seen, which on this platform is as often a limit of what
   // the weaving reaches as a misuse. A spec that carries REPORTED_UPSTREAM was already reported
   // by the specification that watched its construction, so this site is looking at a refusal
   // upstream and not at a gap in instrumentation reach; that branch is taken ahead of the plain
   // not-observed one and reports under its own code.
   //
   // The read sits in the body and not in a `condition(...)` guard: a guard compiles to an early
   // return ahead of both the body and the transition, so a call over an unobserved key spec
   // would leave the automaton in the state before it and the next call would be reported as a
   // wrong call sequence instead of as the unsatisfied REQUIRES it is.
   //
   // ENSURES `generatedPrivkey[privateKey] after GenPriv`: the private key was produced by a
   // call the instrumentation observed. It is written here in the body and not in a handler,
   // because the clause names the key this call returned and a handler receives no event
   // arguments. Its readers are the `init` events of `SignatureSpec`, `KeyAgreementSpec` and
   // `CipherSpec`, the constructor of `KeyPairSpec`, and the origin check `KeySpec.mop` makes
   // before it bridges a key's encoding. The write is on the conforming branch only.
   //
   // Whichever report this body makes, the key this call returns is marked REPORTED_UPSTREAM in
   // turn, so its own consumers report it as refused upstream rather than as not observed.
   event genPrivate after(KeySpec keySpec, KeyFactory f) returning(PrivateKey privateKey):
     call(public PrivateKey KeyFactory.generatePrivate(KeySpec)) &&
     args(keySpec) && target(f) {
       boolean conforms = true;
       boolean reported = false;
       PredicateVerdict specced = PredicateStore.instance().validateAny(Property.SPECCED_KEY, keySpec);
       if (specced == PredicateVerdict.VIOLATED) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyFactorySpec", "" + __LOC,
               "v=1 code=KEYFACTORY-CONSTR-00 ev=" + __EVENTNAME + " obj=KeyFactory val='" + q(algorithm) + "' exp='" + q(expectedSpeccedKey) + "' msg='the key spec carries a specification predicate the rule does not admit'"));
           reported = true;
       }
       else if (specced == PredicateVerdict.NOT_OBSERVED && PredicateStore.instance().validateAny(Property.REPORTED_UPSTREAM, keySpec) == PredicateVerdict.SATISFIED) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyFactorySpec", "" + __LOC,
               "v=1 code=KEYFACTORY-NOBS-02 ev=" + __EVENTNAME + " obj=KeyFactory val='" + q(algorithm) + "' exp='" + q(expectedSpeccedKey) + "' msg='the key spec was already reported when it was constructed'" + Evidence.keysFor(keySpec)));
           reported = true;
       }
       else if (specced == PredicateVerdict.NOT_OBSERVED) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyFactorySpec", "" + __LOC,
               "v=1 code=KEYFACTORY-NOBS-00 ev=" + __EVENTNAME + " obj=KeyFactory val='" + q(algorithm) + "' exp='" + q(expectedSpeccedKey) + "' msg='no construction of the key spec was observed'" + Evidence.keysFor(keySpec)));
           reported = true;
       }
       if (conforms) {
           PredicateStore.instance().ensure(Property.GENERATED_PRIVATE_KEY, privateKey);
       }
       if (reported) {
           PredicateStore.instance().ensure(Property.REPORTED_UPSTREAM, privateKey);
       }
   }

   // `GenPubl`: `gpu1: publicKey = generatePublic(keySpec)`, the whole of that label, and the
   // twin of the event above. Two sites realise the one REQUIRES clause, so each carries its own
   // pair of codes: a report has to say which of the two calls it is about.
   //
   // REQUIRES `speccedKey[keySpec, _]`: the key spec was constructed by a call the
   // instrumentation observed and the rule admitted. Read with `validateAny`, because the
   // clause's second position is anonymous and a valued read would answer VIOLATED for every
   // conforming spec. SATISFIED is silent; VIOLATED is positive evidence about this spec and
   // draws the constraint code; NOT_OBSERVED means no construction of it was ever seen, and is
   // split by the REPORTED_UPSTREAM mark, which says the spec's own producer already reported it
   // so that this site reports a refusal upstream rather than a gap in instrumentation reach.
   // The read sits in the body and not in a `condition(...)` guard: a guard compiles to an early
   // return ahead of both the body and the transition, so the next call would be reported as a
   // wrong call sequence instead of as the unsatisfied REQUIRES this one is.
   //
   // ENSURES `generatedPubkey[publicKey] after GenPubl`: the public key was produced by a call
   // the instrumentation observed. Written in the body, because the clause names the returned
   // key and a handler receives no event arguments, and on the conforming branch only. Its
   // readers are the constructor events of `TrustAnchorSpec` and `KeyPairSpec`, the `init` of
   // `SignatureSpec` and of `CipherSpec`, the `doPhase` of `KeyAgreementSpec`, and the origin
   // check `KeySpec.mop` makes before it bridges a key's encoding. The returned key carries the
   // REPORTED_UPSTREAM mark when this body reported.
   event genPublic after(KeySpec keySpec, KeyFactory f) returning(PublicKey publicKey):
     call(public PublicKey KeyFactory.generatePublic(KeySpec)) &&
     args(keySpec) && target(f) {
       boolean conforms = true;
       boolean reported = false;
       PredicateVerdict specced = PredicateStore.instance().validateAny(Property.SPECCED_KEY, keySpec);
       if (specced == PredicateVerdict.VIOLATED) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyFactorySpec", "" + __LOC,
               "v=1 code=KEYFACTORY-CONSTR-01 ev=" + __EVENTNAME + " obj=KeyFactory val='" + q(algorithm) + "' exp='" + q(expectedSpeccedKey) + "' msg='the key spec carries a specification predicate the rule does not admit'"));
           reported = true;
       }
       else if (specced == PredicateVerdict.NOT_OBSERVED && PredicateStore.instance().validateAny(Property.REPORTED_UPSTREAM, keySpec) == PredicateVerdict.SATISFIED) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyFactorySpec", "" + __LOC,
               "v=1 code=KEYFACTORY-NOBS-03 ev=" + __EVENTNAME + " obj=KeyFactory val='" + q(algorithm) + "' exp='" + q(expectedSpeccedKey) + "' msg='the key spec was already reported when it was constructed'" + Evidence.keysFor(keySpec)));
           reported = true;
       }
       else if (specced == PredicateVerdict.NOT_OBSERVED) {
           conforms = false;
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "KeyFactorySpec", "" + __LOC,
               "v=1 code=KEYFACTORY-NOBS-01 ev=" + __EVENTNAME + " obj=KeyFactory val='" + q(algorithm) + "' exp='" + q(expectedSpeccedKey) + "' msg='no construction of the key spec was observed'" + Evidence.keysFor(keySpec)));
           reported = true;
       }
       if (conforms) {
           PredicateStore.instance().ensure(Property.GENERATED_PUBLIC_KEY, publicKey);
       }
       if (reported) {
           PredicateStore.instance().ensure(Property.REPORTED_UPSTREAM, publicKey);
       }
   }

   // The rule's ORDER, `Get, (GenPriv | GenPubl)*`. The `*` is the rule's: a factory may
   // generate any number of keys, or none, so the state the `Get` leads to accepts on its own.
   // The `@fail` handler below can fire -- a generating call on a factory whose `getInstance`
   // this specification did not see reaches it -- and its two branches are two different claims
   // about the failure, each with its own code in `codes.csv`.
   ere : get (genPrivate | genPublic)*

   @fail {
      if (!creationObserved) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyFactorySpec", "" + __LOC,
              "v=1 code=KEYFACTORY-ORDER-01 ev=" + __EVENTNAME + " obj=KeyFactory val='' exp='' msg='the observed call sequence is not one KeyFactorySpec accepts, and no getInstance of this KeyFactory was observed'"));
      }
      else {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "KeyFactorySpec", "" + __LOC,
              "v=1 code=KEYFACTORY-ORDER-00 ev=" + __EVENTNAME + " obj=KeyFactory val='' exp='' msg='the observed call sequence is not one KeyFactorySpec accepts'"));
      }
      obtained = null;
      __RESET;
   }

   // ENSURES `generatedKeyFactory[this, algorithm] after Get`: the KeyFactory was obtained for
   // the algorithm recorded with it. The state `Get` leads to is the accepting state of a
   // `Get, (...)*` ordering, so the clause's acceptance point and the accepting state are the
   // same state, and `@match` is it.
   //
   // Both values are staged, because a handler receives no event arguments and runs after the
   // transition is decided: the `getInstance` event put the factory and the canonical algorithm
   // in fields. The null guard keeps the handler silent when nothing was staged -- `@fail`
   // clears the factory field, so a refused sequence leaves no write behind for the next run of
   // the handler.
   //
   // No rule this set transcribes REQUIRES `generatedKeyFactory`, so the entry this write makes
   // is read nowhere. It stands because the rule states the clause.
   @match {
      if (obtained != null) {
          PredicateStore.instance().ensure(Property.GENERATED_KEY_FACTORY, obtained, algorithm);
      }
   }

}
