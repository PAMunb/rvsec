package mop;

import javax.xml.crypto.dsig.spec.HMACParameterSpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.Property;

/**
 * HMACParameterSpecSpec
 *
 * A JavaMOP specification of the correct usage of the
 * javax.xml.crypto.dsig.spec.HMACParameterSpec
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/HMACParameterSpec.crysl
 */
HMACParameterSpecSpec(HMACParameterSpec hmacParameterSpec) {

   HMACParameterSpec spec;

   // Set by the creation event `c`. The generated `reset()` does not clear it, so every
   // failure of a monitor that saw no creation reports the `-ORDER-01` code in `@fail`.
   boolean creationObserved = false;

   event c after() returning(HMACParameterSpec s):
    call(public HMACParameterSpec.new(int)) {
      creationObserved = true;
      spec = s;
    }

   ere : c

   @fail {
      if (!creationObserved) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "HMACParameterSpecSpec", "" + __LOC,
              "v=1 code=HMACPARAMETERSPEC-ORDER-01 ev=" + __EVENTNAME + " obj=HMACParameterSpec val='' exp='' msg='the observed call sequence is not one HMACParameterSpecSpec accepts and no creation of the HMACParameterSpec was observed'"));
      }
      else {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "HMACParameterSpecSpec", "" + __LOC,
              "v=1 code=HMACPARAMETERSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=HMACParameterSpec val='' exp='' msg='the observed call sequence is not one HMACParameterSpecSpec accepts'"));
      }
      __RESET;
   }

   @match {
      PredicateStore.instance().ensure(Property.PREPARED_HMAC, spec);
   }

}