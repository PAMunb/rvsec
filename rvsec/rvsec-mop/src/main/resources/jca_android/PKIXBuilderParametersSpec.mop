package mop;

import java.security.KeyStore;
import java.security.cert.CertSelector;
import java.security.cert.PKIXBuilderParameters;
import java.util.Set;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * PKIXBuilderParameters
 *
 * A JavaMOP specification of the correct usage of the
 * java.security.cert.PKIXBuilderParameters.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/PKIXBuilderParameters.crysl
 */
PKIXBuilderParametersSpec(PKIXBuilderParameters s) {

   // Bound where the construction satisfied whatever the rule asks of it, which for `c2`
   // is nothing; see the note on that event.
   PKIXBuilderParameters spec;

   // The key-store constructor, the rule's `c1` (:9) and one alternative of its
   // `Con := c1 | c2`. api30 declares both overloads with these exact parameter lists.
   //
   // The rule's one live REQUIRES is `generatedKeyStore[keystore]` (:17), read here in the
   // body rather than in a `condition(...)` -- a guard would compile to
   // `if (!(guard)) return false;` ahead of the transition (INV-INS-133), and a failed
   // REQUIRES is not a typestate failure. Three-valued, with VIOLATED and NOT_OBSERVED
   // under different code families (INV-INS-143). The producer is `KeyStoreSpec.mop:185`.
   //
   // The rule states a second requirement and states it commented out:
   // `//generatedTrustAnchor[];` at :18, with no argument in its brackets. It is not wired,
   // and not because transcribing it would be hard: a clause the oracle disabled is a fact
   // about the oracle, and reviving it here would put this file ahead of the rule it
   // answers to. `TrustAnchorSpec` (2.12) writes `generatedTrustAnchor` all the same,
   // because its own rule ENSURES it; the predicate simply has no live consumer, which the
   // ledger records rather than repairs.
   event c1 after(KeyStore keystore, CertSelector targetConstraints) returning(PKIXBuilderParameters s):
     call(public PKIXBuilderParameters.new(KeyStore, CertSelector)) &&
     args(keystore, targetConstraints) {
       PredicateVerdict generated = PredicateStore.instance().validate(Property.GENERATED_KEY_STORE, keystore);
       if (generated == PredicateVerdict.VIOLATED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PKIXBuilderParametersSpec", "" + __LOC,
               "v=1 code=PKIXBUILDERPARAMETERS-CONSTR-00 ev=" + __EVENTNAME + " obj=PKIXBuilderParameters val='' exp='a key store the monitor observed being loaded' msg='the key store carries a generation predicate the rule does not admit'"));
       }
       else if (generated == PredicateVerdict.NOT_OBSERVED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PKIXBuilderParametersSpec", "" + __LOC,
               "v=1 code=PKIXBUILDERPARAMETERS-NOBS-00 ev=" + __EVENTNAME + " obj=PKIXBuilderParameters val='' exp='a key store the monitor observed being loaded' msg='no load of the key store was observed'"));
       }
       else {
           spec = s;
       }
   }

   // The trust-anchor constructor, the rule's `c2` (:10). It binds `trustAnchors`, and the
   // only clause of the rule that would read that object is the commented-out one at :18.
   // So there is nothing to check here and nothing to accuse, exactly as in the sibling
   // `PKIXParametersSpec.c2`, and for the same reason: the rule says so.
   event c2 after(Set trustAnchors, CertSelector targetConstraints) returning(PKIXBuilderParameters s):
     call(public PKIXBuilderParameters.new(Set, CertSelector)) &&
     args(trustAnchors, targetConstraints) {
       spec = s;
   }

   // `Con := c1 | c2` is the whole ORDER (:13-14), so the `@fail` handler cannot fire: the
   // transition row is {1, 2, 2} for both events and the monitor is keyed on the constructed
   // object, so no monitor ever sees a second event and state 2 is never entered. Written
   // because the generator and the `codes.csv` bijection expect it (precedent:
   // `GCMParameterSpecSpec.mop:134-146`).
   ere : c1 | c2

   @fail {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "PKIXBuilderParametersSpec", "" + __LOC,
          "v=1 code=PKIXBUILDERPARAMETERS-ORDER-00 ev=" + __EVENTNAME + " obj=PKIXBuilderParameters val='' exp='' msg='the observed call sequence is not one PKIXBuilderParametersSpec accepts'"));
      __RESET;
   }

   // `ENSURES generatedCertPathParameters[this]` (:21) carries no `after L`, so the
   // acceptance point is the accepting state, which in an `ere` is `@match` (INV-INS-134).
   // `spec` is bound by `c2` always and by `c1` only where the store's load was observed,
   // and `ensure` treats a null binding as a no-op.
   //
   // This is the second producer of the predicate; `PKIXParametersSpec` (2.10) is the
   // first, and `CertPathTrustManagerParameters.crysl:14` is the consumer both answer to.
   @match {
      PredicateStore.instance().ensure(Property.GENERATED_CERT_PATH_PARAMETERS, spec);
   }

}
