package mop;

import java.security.KeyStore;
import java.security.cert.CertSelector;
import java.security.cert.PKIXBuilderParameters;
import java.util.Set;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * PKIXBuilderParametersSpec
 *
 * Monitors java.security.cert.PKIXBuilderParameters against the CrySL rule
 * PKIXBuilderParameters.crysl.
 *
 * The rule's ORDER is `Con`, that is `c1: PKIXBuilderParameters(keystore, targetConstraints);` or
 * `c2: PKIXBuilderParameters(trustAnchors, targetConstraints);`. It states no CONSTRAINTS. Its
 * one live REQUIRES clause, `generatedKeyStore[keystore]`, binds the argument of `c1` alone and
 * is read in that event's body. Its one ENSURES clause, `generatedCertPathParameters[this]`, is
 * written at the accepting state and read by `CertPathTrustManagerParametersSpec` at its
 * constructor.
 *
 * Divergences from the rule and reach limits of this monitor:
 *
 * - The rule states a second requirement and states it commented out, `//generatedTrustAnchor[];`,
 *   with no argument in its brackets. It is not transcribed: a clause the rule disables
 *   constrains no trace. `TrustAnchorSpec` writes that predicate all the same, because its own
 *   rule ensures it, and nothing in this set reads it.
 * - Nothing is checked at the trust-anchor constructor, since the only clause that would read its
 *   argument is the commented-out one.
 * - The predicate is written only for a construction that satisfied the rule, so parameters built
 *   over a key store whose loading was not observed carry no mark and are read downstream as
 *   parameters whose own construction was not observed.
 * - The `@fail` handler cannot fire, because a monitor keyed on the constructed object never sees
 *   a second event.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/PKIXBuilderParameters.crysl
 */
PKIXBuilderParametersSpec(PKIXBuilderParameters s) {

   // Bound where the construction satisfied whatever the rule asks of it, which for `c2`
   // is nothing; see the note on that event.
   PKIXBuilderParameters spec;

   // Set by the two creation events, `c1` and `c2`, whatever they report, and never cleared:
   // the generated `reset()` restores the automaton state and leaves this field. `@fail` reads
   // it to choose between `PKIXBUILDERPARAMETERS-ORDER-01` (`creation-unobserved`) and the
   // wrong-sequence code.
   boolean creationObserved = false;

   // `Con` of PKIXBuilderParameters.crysl:
   // `c1: PKIXBuilderParameters(keystore, targetConstraints);`, the key-store constructor and one
   // alternative of `Con := c1 | c2`. The platform declares both overloads with these exact
   // parameter lists.
   //
   // REQUIRES of PKIXBuilderParameters.crysl: `generatedKeyStore[keystore];`. The predicate says
   // that the `KeyStore` was loaded by a call the instrumentation observed; its producer in this
   // set is `KeyStoreSpec`, which writes the mark at the acceptance point its `load` event leads
   // to.
   //
   // The read sits in the event body and not in a `condition(...)` guard: a guard compiles to an
   // early return ahead of both the body and the transition, so a construction over an unloaded
   // store would drop out of the automaton silently and a later call would be reported as a
   // wrong call sequence instead of as the unprepared key store it is. A failed REQUIRES is not a
   // typestate failure.
   //
   // The verdict is three-valued and the two accusing outcomes are different claims, reported
   // under different codes. VIOLATED is positive evidence about this store -- an entry exists
   // whose values differ, or the predicate was revoked by a `negate`. NOT_OBSERVED says only that
   // no entry exists: no `KeyStore.load` was ever seen for it, which happens when the loading ran
   // before the monitor attached or inside code the weaving does not reach, and is a reach limit
   // rather than a misuse. Only the SATISFIED branch stages the object, so parameters built over
   // a store whose loading was not observed carry no mark out of this specification.
   //
   // The rule states a second requirement and states it commented out, `//generatedTrustAnchor[];`,
   // with no argument in its brackets. It is not transcribed here, because a clause the rule
   // disables constrains no trace. `TrustAnchorSpec` writes that predicate all the same, since
   // its own rule ensures it, and no site of this set reads it.
   event c1 after(KeyStore keystore, CertSelector targetConstraints) returning(PKIXBuilderParameters s):
     call(public PKIXBuilderParameters.new(KeyStore, CertSelector)) &&
     args(keystore, targetConstraints) {
       creationObserved = true;
       PredicateVerdict generated = PredicateStore.instance().validate(Property.GENERATED_KEY_STORE, keystore);
       if (generated == PredicateVerdict.VIOLATED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PKIXBuilderParametersSpec", "" + __LOC,
               "v=1 code=PKIXBUILDERPARAMETERS-CONSTR-00 ev=" + __EVENTNAME + " obj=PKIXBuilderParameters val='' exp='a key store the monitor observed being loaded' msg='the key store carries a generation predicate the rule does not admit'"));
       }
       else if (generated == PredicateVerdict.NOT_OBSERVED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PKIXBuilderParametersSpec", "" + __LOC,
               "v=1 code=PKIXBUILDERPARAMETERS-NOBS-00 ev=" + __EVENTNAME + " obj=PKIXBuilderParameters val='' exp='a key store the monitor observed being loaded' msg='no load of the key store was observed'" + Evidence.keysFor(keystore)));
       }
       else {
           spec = s;
       }
   }

   // `Con` of PKIXBuilderParameters.crysl:
   // `c2: PKIXBuilderParameters(trustAnchors, targetConstraints);`, the trust-anchor constructor
   // and the other alternative of `Con := c1 | c2`. It binds `trustAnchors`, and the only clause
   // of the rule that would read that object is the commented-out `//generatedTrustAnchor[];`.
   // So there is nothing to check here and nothing to accuse, and the object is staged
   // unconditionally: the rule says so, exactly as it does at the sibling constructor of
   // `PKIXParametersSpec`.
   event c2 after(Set trustAnchors, CertSelector targetConstraints) returning(PKIXBuilderParameters s):
     call(public PKIXBuilderParameters.new(Set, CertSelector)) &&
     args(trustAnchors, targetConstraints) {
       creationObserved = true;
       spec = s;
   }

   // `Con := c1 | c2` is the whole ORDER, so the `@fail` handler below cannot fire: each trace
   // has one symbol, and the monitor is keyed on the constructed object, so no monitor ever sees
   // a second event. It is written because the generator expects a handler and because the codes
   // it names are registered in `codes.csv`.
   ere : c1 | c2

   @fail {
      if (!creationObserved) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "PKIXBuilderParametersSpec", "" + __LOC,
             "v=1 code=PKIXBUILDERPARAMETERS-ORDER-01 ev=" + __EVENTNAME + " obj=PKIXBuilderParameters val='' exp='' msg='the observed call sequence is not one PKIXBuilderParametersSpec accepts and no creation of the parameters was observed'"));
      }
      else {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "PKIXBuilderParametersSpec", "" + __LOC,
             "v=1 code=PKIXBUILDERPARAMETERS-ORDER-00 ev=" + __EVENTNAME + " obj=PKIXBuilderParameters val='' exp='' msg='the observed call sequence is not one PKIXBuilderParametersSpec accepts'"));
      }
      __RESET;
   }

   // ENSURES of PKIXBuilderParameters.crysl: `generatedCertPathParameters[this];`. The predicate
   // says that the PKIX parameters were built over a key store the instrumentation observed
   // being loaded. The clause carries no `after L`, so its acceptance point is the accepting
   // state, which in a specification written as an `ere` is this handler: it fires whenever the
   // trace so far is a word of the expression.
   //
   // The object travels here in a field because a handler receives no event arguments and runs
   // after the transition has been decided. `spec` is staged by `c2` always and by `c1` only
   // where the store's loading was observed, and `ensure` treats a null binding as a no-op, so
   // parameters built over an unobserved store are not marked.
   //
   // This is the predicate's second producer in this set; `PKIXParametersSpec` is the other, and
   // `CertPathTrustManagerParametersSpec` is the consumer both answer to.
   @match {
      PredicateStore.instance().ensure(Property.GENERATED_CERT_PATH_PARAMETERS, spec);
   }

}
