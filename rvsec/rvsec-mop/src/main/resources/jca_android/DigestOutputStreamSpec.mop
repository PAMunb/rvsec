package mop;

import java.io.OutputStream;
import java.security.DigestOutputStream;
import java.security.MessageDigest;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * DigestOutputStreamSpec
 *
 * Monitors java.security.DigestOutputStream against the CrySL rule DigestOutputStream.crysl.
 *
 * The rule's ORDER is `Con, Write+, Close`: the stream is constructed over a
 * java.io.OutputStream and a java.security.MessageDigest, written to at least once, and closed.
 * Its one FORBIDDEN entry is `on(boolean)`, which this specification reports wherever it
 * occurs. Of its three array-bounds CONSTRAINTS -- `length[data] >= offset + len`,
 * `offset >= 0` and `len > 0` -- only `len > 0` carries a code here; the `w2` event below
 * says why the other two do not.
 *
 * It REQUIRES `generatedMessageDigest[digest]`, read at the constructor, and ENSURES
 * `digestedOutputStream[stream, digest]`, written at the state `close()` leads to. No rule of
 * this set requires `digestedOutputStream`, so that write records a fact nothing consumes.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/DigestOutputStream.crysl
 */
DigestOutputStreamSpec(DigestOutputStream s) {

   // The envelope's quoting rule: a null value is the empty string, a single quote is escaped
   // so it cannot close the field early, and the value is capped so a pathological argument
   // cannot push the record past the logcat payload limit.
   private String q(String str) {
       if (str == null) {
           return "";
       }
       String value = str.length() > 512 ? str.substring(0, 512) : str;
       return value.replace("'", "\\'");
   }

   // Staged by `c1` on the conforming branch, for the acceptance-point write, which sees no
   // event parameter of its own.
   OutputStream wrapped = null;
   MessageDigest digester = null;

   // The `exp=` field of both reports the constructor can draw, held in one place so the two
   // sites cannot drift apart.
   String expectedGeneratedMessageDigest =
       "a MessageDigest this instrumentation observed being obtained";

   // Set by the creation event `c1`. The generated `reset()` does not clear it, so every
   // failure of a monitor that saw no creation reports the `-ORDER-01` code in `@fail`.
   boolean creationObserved = false;

   // `Con` of DigestOutputStream.crysl: `c1: DigestOutputStream(stream, digest)`, the rule's only
   // constructor event and the site of its one REQUIRES.
   //
   // REQUIRES `generatedMessageDigest[digest]`: the MessageDigest was obtained for an algorithm
   // the rule admits. The read is three-valued and each accusing outcome carries its own code,
   // registered in `codes.csv`. SATISFIED binds the two staging fields and reports nothing.
   // VIOLATED is positive evidence -- an entry for this digest exists and does not match what
   // the clause demands -- and draws the constraint code. NOT_OBSERVED means the store holds no
   // entry for this digest at all: its `getInstance` ran where the weaving does not reach, or
   // before the monitor attached, so what the report says is that no obtaining of this digest
   // was observed, not that the program misused one. The two reach the envelope under different
   // codes for exactly that reason.
   //
   // The producing end is `MessageDigestSpec`, whose `g1`, `g2` and `g3` events write the
   // predicate in their bodies at the three `getInstance` overloads -- and only when the
   // algorithm is one their list admits, so a digest that specification refused never arrives
   // here carrying the mark.
   //
   // The two staging fields are bound on the conforming branch only, so a stream built over a
   // digest nobody watched does not go on to claim it digested anything.
   event c1 after(OutputStream stream, MessageDigest digest) returning(DigestOutputStream s):
     call(public DigestOutputStream.new(OutputStream, MessageDigest)) &&
     args(stream, digest) {
       creationObserved = true;
       PredicateVerdict generated = PredicateStore.instance().validate(Property.GENERATED_MESSAGE_DIGEST, digest);
       if (generated == PredicateVerdict.VIOLATED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "DigestOutputStreamSpec", "" + __LOC,
               "v=1 code=DIGESTOUTPUTSTREAM-CONSTR-00 ev=" + __EVENTNAME + " obj=DigestOutputStream val='' exp='" + q(expectedGeneratedMessageDigest) + "' msg='the message digest carries a generation predicate the rule does not admit'"));
       }
       else if (generated == PredicateVerdict.NOT_OBSERVED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "DigestOutputStreamSpec", "" + __LOC,
               "v=1 code=DIGESTOUTPUTSTREAM-NOBS-00 ev=" + __EVENTNAME + " obj=DigestOutputStream val='' exp='" + q(expectedGeneratedMessageDigest) + "' msg='no obtaining of the message digest was observed'" + Evidence.keysFor(digest)));
       }
       else {
           wrapped = stream;
           digester = digest;
       }
   }

   // `Write` of DigestOutputStream.crysl: `r1: write(specifiedByte)`, the single-byte overload.
   // The rule states no CONSTRAINTS over `specifiedByte`, so the body is empty and the event
   // exists to carry the transition the ORDER asks for.
   event w1 after(int specifiedByte, DigestOutputStream s):
     call(public void DigestOutputStream.write(int)) &&
     args(specifiedByte) && target(s) {
   }

   // `Write` of DigestOutputStream.crysl: `r2: write(data, offset, len)`, the overload the
   // rule's three array-bounds CONSTRAINTS speak about -- `length[data] >= offset + len`,
   // `offset >= 0` and `len > 0`.
   //
   // Only `len > 0` carries a code, and the other two are checked here by nothing. The reason
   // is that the platform refuses them first: `DigestOutputStream.write(b, off, len)` writes to
   // the wrapped stream before it updates the digest, and `OutputStream.write(byte[], int,
   // int)` throws `IndexOutOfBoundsException` when `off < 0`, when `len < 0` or when
   // `off + len > b.length`. This is a plain `after` advice, which the weaver compiles as
   // after-finally, so the body does run on the throwing call -- but a call that violated
   // `offset >= 0` or `length[data] >= offset + len` has already been refused by the platform,
   // and a code for either would accuse a program of what the platform does not let it do.
   //
   // `len > 0` is the one with a code, because a violation of it survives the platform:
   // `write(b, off, 0)` returns without throwing, and a call with `len < 0` throws and still
   // reaches the `len <= 0` branch below. The code is registered in `codes.csv`.
   event w2 after(byte[] data, int offset, int len, DigestOutputStream s):
     call(public void DigestOutputStream.write(byte[], int, int)) &&
     args(data, offset, len) && target(s) {
       if (len <= 0) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "DigestOutputStreamSpec", "" + __LOC,
               "v=1 code=DIGESTOUTPUTSTREAM-CONSTR-01 ev=" + __EVENTNAME + " obj=DigestOutputStream val='" + len + "' exp='a length the expert DigestOutputStream.crysl admits' msg='the write length is not one the rule admits'"));
       }
   }

   // `Close` of DigestOutputStream.crysl: `cl1: close()`, the rule's whole `Close`. It carries
   // no clause, so the body is empty; what the event does is take the transition into the
   // accepting state, which is where the rule's ENSURES is written.
   //
   // `DigestOutputStream` does not DECLARE `close()`: it inherits it from
   // `java.io.FilterOutputStream`. The pointcut names the subtype anyway, and that is
   // what the compilers emit rather than an assumption -- javac emits the call site's
   // static receiver type as the invoke owner, so `dos.close()` on a variable declared
   // `DigestOutputStream` compiles to
   // `invokevirtual java/security/DigestOutputStream.close:()V`, which is what both the
   // AspectJ matcher and the DEX matcher read. A pointcut on `FilterOutputStream.close()`
   // would instead match every filtered stream in the program.
   event cl1 after(DigestOutputStream s):
     call(public void DigestOutputStream.close()) &&
     target(s) {
   }

   // FORBIDDEN of DigestOutputStream.crysl: `on(boolean)`. The event accuses in its body and
   // moves the automaton nowhere -- it self-loops at every state of the `fsm` below. A
   // forbidden call is forbidden wherever it appears, so giving it a position in the ordering
   // would say the opposite of what FORBIDDEN says: it would make the call part of some
   // accepted sequence and make its absence a failure. Self-looping is what an `fsm` can spell
   // and an `ere` cannot, which is why this specification is written as an `fsm`.
   event on after(boolean flag, DigestOutputStream s):
     call(public void DigestOutputStream.on(boolean)) &&
     args(flag) && target(s) {
       ErrorCollector.instance().addError(new ErrorDescription(ErrorType.ForbiddenMethod, "DigestOutputStreamSpec", "" + __LOC,
           "v=1 code=DIGESTOUTPUTSTREAM-FORB-00 ev=" + __EVENTNAME + " obj=DigestOutputStream val='" + flag + "' exp='no call at all' msg='DigestOutputStream.on(boolean) is forbidden by the expert DigestOutputStream.crysl'"));
   }

   // The rule's ORDER, `Con, Write+, Close`, with the forbidden call self-looping at every
   // state. The `+` means what it looks like here: both `w1` and `w2` stand for a labelled
   // `Write` of the rule, so neither can be taken as an empty move, and a stream closed with
   // no write between construction and `close()` fails.
   fsm :
     start [
       c1 -> opened
       on -> start
     ]
     opened [
       w1 -> writing
       w2 -> writing
       on -> opened
     ]
     writing [
       w1 -> writing
       w2 -> writing
       cl1 -> closed
       on -> writing
     ]
     closed [
       on -> closed
     ]

   alias match = closed

   // Reached whenever the observed sequence is not a word of the `fsm` above. The two codes
   // are registered in `codes.csv` and the `creationObserved` field is what tells them apart: a
   // stream whose constructor no event of this specification saw is reported as an unobserved
   // creation rather than as a sequence the program got wrong. The staging fields are cleared
   // here so a refused sequence leaves no value for the next run of the handler.
   @fail {
      if (!creationObserved) {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "DigestOutputStreamSpec", "" + __LOC,
              "v=1 code=DIGESTOUTPUTSTREAM-ORDER-01 ev=" + __EVENTNAME + " obj=DigestOutputStream val='' exp='' msg='the observed call sequence is not one DigestOutputStreamSpec accepts and no creation of the DigestOutputStream was observed'"));
      }
      else {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "DigestOutputStreamSpec", "" + __LOC,
              "v=1 code=DIGESTOUTPUTSTREAM-ORDER-00 ev=" + __EVENTNAME + " obj=DigestOutputStream val='' exp='' msg='the observed call sequence is not one DigestOutputStreamSpec accepts'"));
      }
      wrapped = null;
      digester = null;
      __RESET;
   }

   // ENSURES `digestedOutputStream[stream, digest]`. The clause carries no `after L`, so its
   // acceptance point is an accepting state of the ORDER -- here the state a `close()` leads
   // to, `closed`, which `alias match` names. The write establishes that the stream was written
   // through a digest the instrumentation observed.
   //
   // It reads the two fields the constructor staged, because a handler receives no event
   // arguments and runs after the transition is decided: the wrapped stream and the digest are
   // only visible at `c1`. Both are cleared after the write, so one construction yields one
   // marking.
   //
   // No rule of this set REQUIRES `digestedOutputStream`, so nothing reads what is written
   // here; the write stands because the rule states it.
   @match {
      if (wrapped != null && digester != null) {
          PredicateStore.instance().ensure(Property.DIGESTED_OUTPUT_STREAM, wrapped, digester);
          wrapped = null;
          digester = null;
      }
   }

}
