package mop;

import java.security.SecureRandom;
import java.util.stream.IntStream;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.ExecutionContext;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * SecureRandomSpec
 *
 * A JavaMOP specification of the correct usage of the
 * java.security.SecureRandom class.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/SecureRandom.crysl
 */
SecureRandomSpec(SecureRandom r) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    SecureRandom sr;

    // the expected algorithms for SecureRandom
    List<String> algorithms = Arrays.asList("SHA1PRNG");

    // this event captures the following event in the original CrySL specification.
    //  - c1: SecureRandom();
    event c1 after() returning(SecureRandom r):
      call(public SecureRandom.new()) {
        sr = r;
    }

    // this event captures the following event in the original CrySL specification.
    // - c2: SecureRandom(byte[]);
    //
    // One event over the constructor, where there used to be two split by the sign
    // of a guard. The negated twin `c3` matched the same call and was absent from
    // the automaton, and the generator gives an absent event a row that moves every
    // state to `fail`: a seed nobody had randomised was reported as a wrong call
    // sequence. Neither half accused anything of its own -- both only rebound `sr`
    // -- so removing the guard changes no reported constraint and removes the
    // spurious ordering report. The rule's `randomized[seed]` REQUIRES is a real
    // clause and is wired, with its own accuser, at task 5.5.
    event c2 after(byte[] seed) returning(SecureRandom r):
      call(public SecureRandom.new(byte[])) &&
      args(seed) {
         sr = r;
    }


    // this event captures the following event in the original CrySL specification.
    //  - g1: getInstance(algorithm);
    event g1 after(String alg) returning(SecureRandom r):
      call(public static SecureRandom SecureRandom.getInstance(String))
      && args(alg)
      && condition(ConscryptAliasTable.matches("SecureRandom", alg, algorithms)) {
       sr = r;
    }

    // this event captures the following event in the original CrySL specification.
    //  - g2: getInstance(algorithm, provider);
    event g2 after(String alg) returning(SecureRandom r):
      call(public static SecureRandom SecureRandom.getInstance(String, ..))
      && args(alg, *)
      && condition(ConscryptAliasTable.matches("SecureRandom", alg, algorithms)) {
       sr = r;
    }

    // CrySL gI: getInstanceStrong() event
    event g3 after() returning(SecureRandom r):
      call(public static SecureRandom SecureRandom.getInstanceStrong()) {
      sr = r;
    }

    // getInstance with an invalid algorithm.
    event g4 after(String alg) returning(SecureRandom r):
      call(public static SecureRandom SecureRandom.getInstance(String, ..))
      && args(alg)
      && condition(!ConscryptAliasTable.matches("SecureRandom", alg, algorithms))
    {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SecureRandomSpec", "" + __LOC,
            "v=1 code=SECURERANDOM-ALG-00 ev=" + __EVENTNAME + " obj=SecureRandom val='" + q(alg) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + alg + "'"));
    }

    event setSeed1 after(SecureRandom r):
      call(public void SecureRandom.setSeed(long)) &&
      target(r) {  }

    // One event over `setSeed(byte[])`, with the accusation moved into the body.
    // The negated twin `setSeed3` matched the same call and named no state, so a
    // seed nobody had randomised drew two reports: its own `UnsatisfiedConstraint`,
    // which is the one the rule states, and an `InvalidSequenceOfMethodCalls` about
    // an ordering that never modelled the call. The check is the same and reports
    // the same code from the same clause; what leaves is the second report and the
    // guard that suppressed the transition.
    event setSeed2 after(byte[] seed, SecureRandom r):
      call(public void SecureRandom.setSeed(byte[]))  &&
      args(seed) &&
      target(r) {
        if (!ExecutionContext.instance().validate(Property.RANDOMIZED, seed)) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecureRandomSpec", "" + __LOC,
                "v=1 code=SECURERANDOM-CONSTR-00 ev=" + __EVENTNAME + " obj=SecureRandom val='' exp='a randomized byte[]' msg='setSeed() expects a byte array observed to come from a randomized source'"));
        }
    }

    event genSeed after(SecureRandom r) returning(byte[] seed):
      call(public byte[] SecureRandom.generateSeed(int))
      && target(r) {
        ExecutionContext.instance().setProperty(Property.RANDOMIZED, seed);
    }

//TODO randIntInRange eh RANDOMIZED ou eh o retorno do nextInt ???
    event next1 before(SecureRandom r, int randIntInRange):
      call(public int SecureRandom.nextInt(int))
      && args(randIntInRange)
      && target(r) {
         ExecutionContext.instance().setProperty(Property.RANDOMIZED, randIntInRange);
    }

    event next2 before(SecureRandom r, byte[] bytes):
      call(public void SecureRandom.nextBytes(byte[]))
      && args(bytes)
      && target(r) {
         ExecutionContext.instance().setProperty(Property.RANDOMIZED, bytes);
    }

    event next3 after(SecureRandom r) returning(int randInt) :
      call(public int SecureRandom.nextInt())
      && target(r) {
         ExecutionContext.instance().setProperty(Property.RANDOMIZED, randInt);
    }

     event ints after(SecureRandom r) returning(IntStream stream):
       call(public IntStream SecureRandom.ints(..))
       && target(r) {
          ExecutionContext.instance().setProperty(Property.RANDOMIZED, stream);
     }

    // `g4` is absorbed rather than fused: it accuses an algorithm the rule's
    // CONSTRAINTS reject, which is a report of its own and not the negation of
    // another event's guard. It sits in the automaton as a benign self-loop at
    // every state where a `getInstance` call is legal -- which is all of them --
    // so the rejected algorithm is accused once, by the constraint that rejects it,
    // instead of twice. The rule's ORDER has no symbol for a call it turns down, so
    // `order_alphabet_map.csv` records `g4` ORDER-unmapped and G-ORDER erases it
    // from both languages before comparing.
    fsm :
      start [
         c1 -> init
         c2 -> init
         g1 -> init
         g2 -> init
         g3 -> init
         g4 -> start
      ]
      init [
         c1       -> init
         g4       -> init
         genSeed  -> end
         setSeed1 -> end
         setSeed2 -> end
         next1    -> end
         next2    -> end
         next3    -> end
         ints     -> end
      ]
      end [
         g4       -> end
         genSeed  -> end
         setSeed1 -> end
         setSeed2 -> end
         next1    -> end
         next3    -> end
         ints     -> end
      ]

    alias match1 = init

    @fail {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SecureRandomSpec", "" + __LOC,
          "v=1 code=SECURERANDOM-ORDER-00 ev=" + __EVENTNAME + " obj=SecureRandom val='' exp='' msg='the observed call sequence is not one SecureRandomSpec accepts'"));
      __RESET;
    }

    @match1 {
        ExecutionContext.instance().setObjectAsInAcceptingState(sr);
        ExecutionContext.instance().setProperty(Property.RANDOMIZED, sr);
    }
}