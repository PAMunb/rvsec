package mop;

import java.security.SecureRandom;
import java.util.stream.IntStream;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * SecureRandomSpec
 *
 * A JavaMOP specification of the correct usage of the
 * java.security.SecureRandom class.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/SecureRandom.crysl
 */
SecureRandomSpec(SecureRandom r) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

    SecureRandom sr;

    // the expected algorithms for SecureRandom
    // D-15: the six entries of SecureRandom.crysl. Five of them name providers Android does
    // not ship, so no application can obtain them and no verdict depends on them -- inert,
    // not removable. Dropping an entry from an expert-validated list because the local
    // platform lacks it is the unvalidated narrowing this re-anchoring exists to undo.
    List<String> algorithms = Arrays.asList("SHA1PRNG", "Windows-PRNG", "NativePRNG",
        "NativePRNGBlocking", "NativePRNGNonBlocking", "PKCS11");

    // SecureRandom.crysl ensures `randomized` over five objects (:49-53): the generator
    // itself `after Ins`, the seed `generateSeed(int)` returns `after gS`, the array
    // `nextBytes(byte[])` fills `after nB`, and the two ints `nextInt()` and
    // `nextInt(int)` return, `after nI` and `after nIR`. This file has events for the
    // first three; the two int clauses are the delta task 11.2 measured and task 11.5
    // owns. Every clause carries an `after L`, so each is ensured at the state its own
    // aggregate leads to -- and Ins leads to one state while the Ends reach another, so
    // this file has two
    // acceptance points and the second one needs the object to travel: a handler is
    // generated as a no-argument method and sees no event parameter. The event body
    // stages the object here and the handler that runs immediately after the
    // transition writes it and clears the field.
    //
    // Staging rather than writing in the body is the whole point of the placement.
    // An event body runs *before* the transition is decided (measured in the
    // generated monitor at task 4.1), so a write there marks an array for a call
    // sequence the automaton is about to reject -- and this file has such sequences:
    // `getInstance("NativePRNG"); nextBytes(iv)` never reaches a state where
    // `nextBytes` is legal, and the seed it produced is not one the rule accepts.
    byte[] stagedGeneratedSeed = null;
    byte[] stagedNextBytes = null;

    // this event captures the following event in the original CrySL specification.
    //  - c1: SecureRandom();
    event c1 after() returning(SecureRandom r):
      call(public SecureRandom.new()) {
        sr = r;
    }

    // this event captures the following event in the original CrySL specification.
    // - c2: SecureRandom(byte[]);
    //
    // One event over the constructor, where there used to be two split by the sign
    // of a guard. The negated twin `c3` matched the same call and was absent from
    // the automaton, and the generator gives an absent event a row that moves every
    // state to `fail`: a seed nobody had randomised was reported as a wrong call
    // sequence. Neither half accused anything of its own -- both only rebound `sr`
    // -- so removing the guard changes no reported constraint and removes the
    // spurious ordering report.
    //
    // This is the constructor's half of `randomized[seed]` (SecureRandom.crysl:45,
    // ledger clause #33), the self-chain: the rule binds `seed` in two events, `s1:
    // setSeed(seed)` and `c2: SecureRandom(seed)`, and task 3.1 wired `setSeed2`'s half
    // and named this one as 5.5's in as many words. One clause, two binding sites, one
    // accuser at each -- the shape `IvParameterSpec.c1/c2` and
    // `PBEParameterSpecSpec.c1/c2` already carry, and not a second accuser of one site.
    //
    // The producing site is another SecureRandom's `@match2` write over `generateSeed`
    // or `nextBytes`, so what this read asks is whether the array seeding this generator
    // came out of one the instrumentation watched. `new SecureRandom(sr.generateSeed(32))`
    // composes -- measured -- and answers SATISFIED; a literal seed answers NOT_OBSERVED,
    // which is the reach limit stated as such and not as a wrong call sequence.
    event c2 after(byte[] seed) returning(SecureRandom r):
      call(public SecureRandom.new(byte[])) &&
      args(seed) {
         sr = r;
         PredicateVerdict randomisedSeed = PredicateStore.instance().validate(Property.RANDOMIZED, seed);
         if (randomisedSeed == PredicateVerdict.VIOLATED) {
             ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecureRandomSpec", "" + __LOC,
                 "v=1 code=SECURERANDOM-CONSTR-01 ev=" + __EVENTNAME + " obj=SecureRandom val='' exp='a randomized byte[]' msg='the byte array given to the constructor carries a randomization predicate the rule does not admit'"));
         }
         else if (randomisedSeed == PredicateVerdict.NOT_OBSERVED) {
             ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecureRandomSpec", "" + __LOC,
                 "v=1 code=SECURERANDOM-NOBS-01 ev=" + __EVENTNAME + " obj=SecureRandom val='' exp='a randomized byte[]' msg='the constructor expects a byte array observed to come from a randomized source'"));
         }
    }


    // this event captures the following event in the original CrySL specification.
    //  - g1: getInstance(algorithm);
    event g1 after(String alg) returning(SecureRandom r):
      call(public static SecureRandom SecureRandom.getInstance(String))
      && args(alg)
      && condition(ConscryptAliasTable.matches("SecureRandom", alg, algorithms)) {
       sr = r;
    }

    // this event captures the following event in the original CrySL specification.
    //  - g2: getInstance(algorithm, provider);
    event g2 after(String alg) returning(SecureRandom r):
      call(public static SecureRandom SecureRandom.getInstance(String, ..))
      && args(alg, *)
      && condition(ConscryptAliasTable.matches("SecureRandom", alg, algorithms)) {
       sr = r;
    }

    // CrySL gI: getInstanceStrong() event
    event g3 after() returning(SecureRandom r):
      call(public static SecureRandom SecureRandom.getInstanceStrong()) {
      sr = r;
    }

    // getInstance with an invalid algorithm.
    event g4 after(String alg) returning(SecureRandom r):
      call(public static SecureRandom SecureRandom.getInstance(String, ..))
      && args(alg)
      && condition(!ConscryptAliasTable.matches("SecureRandom", alg, algorithms))
    {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SecureRandomSpec", "" + __LOC,
            "v=1 code=SECURERANDOM-ALG-00 ev=" + __EVENTNAME + " obj=SecureRandom val='" + q(alg) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + alg + "'"));
    }

    // The rule's `s2: setSeed(lSeed)` (SecureRandom.crysl:26), and the site of
    // `randomized[lSeed]` (:46, ledger clause #51). The clause is RECORDED HERE AND NOT
    // READ, by the researcher's decision of 2026-08-26 (task 11.5(d)), and the ledger row
    // moved with it: `wireable` -> `vacuous`.
    //
    // The disposition is derived, not assumed, and either half of the derivation is
    // enough on its own.
    //
    // By type: swept over the 49 rules of the oracle, `randomized` is ENSURED five times
    // and never over a `long` -- `randomized[this] after Ins` over the SecureRandom
    // itself, `[genSeed]` and `[bytes]` over `byte[]`, `[randInt]` and `[randIntInRange]`
    // over `int` (SecureRandom.crysl:49-53). No producer the catalogue has could ever
    // mark the argument this event binds.
    //
    // By substrate: `PredicateStore` keys the bound object by identity, and a `long`
    // reaches an advice boxed. Measured on Temurin 21, the `Long` cache spans -128..127
    // exactly as `Integer`'s does, so the boxing is wrong in both directions -- outside
    // the range every call boxes a fresh object no write can have named, and inside it
    // two unrelated `setSeed(5L)` calls share one object, so a mark made for either would
    // answer for the other. It is the Integer-cache measurement of the earlier groups,
    // re-derived over `Long` rather than carried over.
    //
    // So a read placed here could answer NOT_OBSERVED and nothing else: an accuser with
    // no path to a true report, which is the class group 3 removed. The event keeps its
    // empty body and its place in the automaton -- it is the rule's `s2` and the ORDER
    // needs the symbol; what it does not gain is a site.
    //
    // The sibling clause `randomized[seed]` (:45) is a different row and IS read, twice:
    // at `c2` and at `setSeed2` below, both over `byte[]`, where identity holds.
    event setSeed1 after(SecureRandom r):
      call(public void SecureRandom.setSeed(long)) &&
      target(r) {  }

    // One event over `setSeed(byte[])`, with the accusation moved into the body.
    // The negated twin `setSeed3` matched the same call and named no state, so a
    // seed nobody had randomised drew two reports: its own `UnsatisfiedConstraint`,
    // which is the one the rule states, and an `InvalidSequenceOfMethodCalls` about
    // an ordering that never modelled the call. The check is the same and reports
    // the same code from the same clause; what leaves is the second report and the
    // guard that suppressed the transition.
    //
    // This is the read of `randomized[seed]` (SecureRandom.crysl:45, REQUIRES), and
    // it is the half of that clause `setSeed(byte[])` carries -- the rule binds
    // `seed` in two events, `s1: setSeed(seed)` and `c2: SecureRandom(seed)`, and
    // the constructor's half is wired at task 5.5 with the rest of the `randomized`
    // hub.
    //
    // The verdict is three-valued because the two accusing outcomes are different
    // claims. VIOLATED is positive evidence: this array carries a randomisation
    // predicate that was withdrawn. NOT_OBSERVED says only that no randomised source
    // of the array was ever observed, which on Android is as often a reach limit of
    // the instrumentation as it is a misuse. The seed's message already said the
    // second thing ("expects a byte array observed to come from a randomized
    // source") while its code said the first; the split makes the code say what the
    // message always meant.
    event setSeed2 after(byte[] seed, SecureRandom r):
      call(public void SecureRandom.setSeed(byte[]))  &&
      args(seed) &&
      target(r) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, seed);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecureRandomSpec", "" + __LOC,
                "v=1 code=SECURERANDOM-CONSTR-00 ev=" + __EVENTNAME + " obj=SecureRandom val='' exp='a randomized byte[]' msg='the byte array given to setSeed() carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SecureRandomSpec", "" + __LOC,
                "v=1 code=SECURERANDOM-NOBS-00 ev=" + __EVENTNAME + " obj=SecureRandom val='' exp='a randomized byte[]' msg='setSeed() expects a byte array observed to come from a randomized source'"));
        }
    }

    // `randomized[genSeed] after gS` (SecureRandom.crysl:50, ENSURES) over the array
    // `gS: genSeed = generateSeed(num)` returns. The clause carries an `after L`, so its
    // acceptance point is the state `gS` leads to -- which is the accepting state the Ends
    // reach, so the write belongs to `@match2` either way (INV-INS-134). The generated rule
    // left the clause unqualified and this comment used to say so; the site is the same and
    // the route to it is not.
    event genSeed after(SecureRandom r) returning(byte[] seed):
      call(public byte[] SecureRandom.generateSeed(int))
      && target(r) {
        stagedGeneratedSeed = seed;
    }

    // The rule's fourth ENSURES clause is `randomized[numB]`, over the argument of
    // `ne: next(numB)`. `next(int)` is protected in java.util.Random, so no
    // application calls it, and this file used to answer the clause with two stand-ins
    // whose relation to it the specification never settled: `next1` marked the
    // *argument* of `nextInt(int)`, `next3` the *return* of `nextInt()`.
    // `order_alphabet_map.csv:79,81` already decided the ORDER half of that question at
    // task 2.8 -- both rows are ORDER-unmapped, because pairing either with `ne` would
    // be an inference about which call the oracle meant, and INV-INS-138 forbids
    // inferring one.
    //
    // Both writes are gone. A write that translates no clause is deleted rather than
    // recorded, and neither could have carried a predicate anywhere in any case: the
    // store keys the bound object by identity and an `int` is autoboxed at the call, so
    // a predicate over a boxed primitive survives to a later read only inside the
    // `Integer` cache (-128..127), where equal small values genuinely are one object.
    // The two events stay -- they are in the automaton, and removing them would make
    // the calls unmodelled rather than unmarked, which is the disposition `ints` below
    // and `CipherSpec.wkb1` already carry.
    //
    event next1 before(SecureRandom r, int randIntInRange):
      call(public int SecureRandom.nextInt(int))
      && args(randIntInRange)
      && target(r) {
    }

    // `randomized[bytes] after nB` (SecureRandom.crysl:51, ENSURES) over the array
    // `nB: nextBytes(bytes)` fills -- the producer half of the IV chain, and the site
    // task 4.4 named when it declared its own F2 window: the reads of
    // `IvParameterSpec.c1/c2` bind the same array by identity, so they stop
    // answering NOT_OBSERVED from here on.
    //
    // The advice stays `before`, as the seed had it. An identity-keyed store does
    // not care whether the array is already filled -- it is the same object on both
    // sides of the call -- so switching to `after` would change when the predicate
    // is written without changing what it says, which is not what a substrate
    // migration is for.
    event next2 before(SecureRandom r, byte[] bytes):
      call(public void SecureRandom.nextBytes(byte[]))
      && args(bytes)
      && target(r) {
         stagedNextBytes = bytes;
    }

    event next3 after(SecureRandom r) returning(int randInt) :
      call(public int SecureRandom.nextInt())
      && target(r) {
    }

    // SecureRandom.crysl declares no stream event at all, so this event
    // translates no clause and marks nothing: the write that stood here claimed
    // `randomized` over an IntStream on the strength of the method name alone. The
    // event stays -- it is in the automaton, and removing it would make the call
    // unmodelled rather than unmarked -- and this is the same disposition
    // `CipherSpec.wkb1` received at task 4.1, where `wrap` is declared by the rule
    // and named in no ENSURES clause.
    event ints after(SecureRandom r) returning(IntStream stream):
      call(public IntStream SecureRandom.ints(..))
      && target(r) {
    }

    // `g4` is absorbed rather than fused: it accuses an algorithm the rule's
    // CONSTRAINTS reject, which is a report of its own and not the negation of
    // another event's guard. It sits in the automaton as a benign self-loop at
    // every state where a `getInstance` call is legal -- which is all of them --
    // so the rejected algorithm is accused once, by the constraint that rejects it,
    // instead of twice. The rule's ORDER has no symbol for a call it turns down, so
    // `order_alphabet_map.csv` records `g4` ORDER-unmapped and G-ORDER erases it
    // from both languages before comparing.
    //
    // The `end` state carries `next2` because the rule's ORDER is `Ins, (Seed?, End*)*`
    // (SecureRandom.crysl:39) and `nB` is one of the Ends: `nextBytes(); nextBytes()` is a
    // sequence the rule accepts, and the omission of that one row accused the second call of a wrong
    // call sequence -- 12,400 events on the published campaign, 99.98 % of them
    // inside libraries. The remaining divergences of this automaton against the
    // ORDER (`c1 c1` at `init`, and the Seeds the `end` state still admits after an
    // End) are recorded, not repaired here; task 7.1 owns them.
    fsm :
      start [
         c1 -> init
         c2 -> init
         g1 -> init
         g2 -> init
         g3 -> init
         g4 -> start
      ]
      init [
         c1       -> init
         g4       -> init
         genSeed  -> end
         setSeed1 -> end
         setSeed2 -> end
         next1    -> end
         next2    -> end
         next3    -> end
         ints     -> end
      ]
      end [
         g4       -> end
         genSeed  -> end
         setSeed1 -> end
         setSeed2 -> end
         next1    -> end
         next2    -> end
         next3    -> end
         ints     -> end
      ]

    // The acceptance point of `randomized[this] after Ins`: an `after L` clause is
    // ensured at the states L leads to, and `Ins := Gets | Cons` leads here.
    alias match1 = init
    // The acceptance point of the two unqualified clauses, `randomized[genSeed]` and
    // `randomized[next]`. Both objects are bound by Ends events, which land here.
    alias match2 = end

    @fail {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SecureRandomSpec", "" + __LOC,
          "v=1 code=SECURERANDOM-ORDER-00 ev=" + __EVENTNAME + " obj=SecureRandom val='' exp='' msg='the observed call sequence is not one SecureRandomSpec accepts'"));
      stagedGeneratedSeed = null;
      stagedNextBytes = null;
      __RESET;
    }

    // What leaves this handler is the accepting-state bookkeeping that stood beside
    // the write: the new store does not offer it and the set has no reader of it
    // (INV-INS-147). `sr` is null on the one path that reaches `init` without
    // binding it -- `g4`, which only accuses -- and `ensure` treats a null binding as
    // a no-op, so no guard is needed here.
    @match1 {
        PredicateStore.instance().ensure(Property.RANDOMIZED, sr);
    }

    // A staged array is consumed by exactly one handler run or discarded by `@fail`,
    // so it is never written for a sequence the automaton did not accept. The
    // generated dispatcher recomputes the state categories after every event and
    // calls the handler whenever the category holds, so two `nextBytes` calls run
    // this handler twice, each with the array its own body staged.
    @match2 {
        if (stagedGeneratedSeed != null) {
            PredicateStore.instance().ensure(Property.RANDOMIZED, stagedGeneratedSeed);
            stagedGeneratedSeed = null;
        }
        if (stagedNextBytes != null) {
            PredicateStore.instance().ensure(Property.RANDOMIZED, stagedNextBytes);
            stagedNextBytes = null;
        }
    }
}
