package mop;

import java.util.Arrays;
import java.util.List;
import javax.crypto.spec.GCMParameterSpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * GCMParameterSpecSpec
 *
 * Monitors javax.crypto.spec.GCMParameterSpec against the CrySL rule GCMParameterSpec.crysl.
 * The rule's ORDER is `Con` alone, and `Con := c1 | c2`, so constructing the spec is the whole
 * call sequence this specification observes. At both constructors it enforces the CONSTRAINTS
 * clause `tagLen in {96, 104, 112, 120, 128};` and reads the one REQUIRES clause
 * `randomized[src];` over the nonce material, and at its acceptance point it writes the one
 * ENSURES clause `preparedGCM[this];`.
 *
 * Three CONSTRAINTS clauses of the rule have no site here, and each absence is behaviour:
 *
 *  - `length[src] >= offset + len;` and `offset >= 0;` cannot be reached. The four-argument
 *    constructor throws IllegalArgumentException for a negative offset and for a sum past the
 *    end of the array, and the events are `after ... returning` advice, so no call that breaks
 *    either clause ever reaches a body;
 *  - `len > 0;` can be reached -- the constructor rejects a negative length and admits a zero
 *    one -- and is left unchecked, so a zero-length nonce range is not reported.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/GCMParameterSpec.crysl
 */
GCMParameterSpecSpec(GCMParameterSpec s) {

   // The object the acceptance handler writes the predicate over, staged by whichever
   // constructor built it and only on its conforming branch.
   GCMParameterSpec spec;

   // The CONSTRAINTS clause `tagLen in {96, 104, 112, 120, 128};` of GCMParameterSpec.crysl,
   // transcribed.
   List<Integer> validLengths = Arrays.asList(96, 104, 112, 120, 128);

   // Set by the creation events `c1` and `c2`. The generated `reset()` does not clear it, so every
   // failure of a monitor that saw no creation reports the `-ORDER-01` code in `@fail`.
   boolean creationObserved = false;

   // `Con` of GCMParameterSpec.crysl: `c1: GCMParameterSpec(tagLen, src)`, the two-argument
   // constructor. Two clauses land in this body and neither of them guards the transition.
   //
   // A `condition(...)` guard compiles to `if (!(guard)) return false;` ahead of both the body
   // and the transition, so a construction that broke either clause would take no step, reach
   // no accepting state and be accused of nothing. Here that silence would cover the whole
   // specification rather than one event, because the ordering handler cannot make up for a
   // suppressed transition: with `Con` the entire ORDER, `@fail` is unreachable by
   // construction, as the comment on the `ere` below sets out.
   //
   // CONSTRAINTS `tagLen in {96, 104, 112, 120, 128};`: a tag length outside the list is
   // reported under this site's own code, registered in `codes.csv`. Keeping a value clause as
   // a `condition(...)` guard would be admissible in general and is declined here, because it
   // would leave the REQUIRES read below sitting behind a guard that suppresses the same
   // transition: the read would then not run at all on a construction with an unadmitted tag
   // length.
   //
   // REQUIRES `randomized[src];`: the nonce material came from a `SecureRandom` the
   // instrumentation observed -- the generator itself, or bytes it produced. The producing
   // site is the handler of `SecureRandomSpec` over the arrays its `generateSeed` and
   // `nextBytes` events stage. The read is three-valued, and the two accusing outcomes are
   // different claims. VIOLATED is positive evidence: the store holds an entry for this array
   // under this predicate that the clause does not admit. NOT_OBSERVED says only that the store
   // holds no entry for it at all, so no randomised source of it was ever seen -- on Android as
   // often a reach limit of the instrumentation as a misuse -- and it keeps a code of its own
   // for that reason.
   //
   // A construction either body reports on is marked `REPORTED_UPSTREAM`, so the consumer of
   // `PREPARED_GCM` (`IvChainJunction.use`) reports it as refused upstream rather than as not
   // observed. The source read here is not a consumer of that mark: no producer of `RANDOMIZED`
   // marks what it refuses, so NOT_OBSERVED keeps its own code.
   //
   // `spec` is bound only on the branch where nothing was reported, and that binding is what
   // carries the object to `@match`: the handler receives no event arguments, so the event that
   // saw the object has to stage it in a field.
   event c1 after(int tagLen, byte[] src) returning(GCMParameterSpec s):
    call(public GCMParameterSpec.new(int, byte[])) &&
    args(tagLen, src) {
       creationObserved = true;
       boolean conforms = true;
       if (!validLengths.contains(tagLen)) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "GCMParameterSpecSpec", "" + __LOC,
               "v=1 code=GCMPARAMETERSPEC-CONSTR-00 ev=" + __EVENTNAME + " obj=GCMParameterSpec val='" + tagLen + "' exp='a tag length the expert GCMParameterSpec.crysl admits' msg='the authentication tag length is not one the rule admits'"));
           conforms = false;
       }
       PredicateVerdict randomisedSource = PredicateStore.instance().validate(Property.RANDOMIZED, src);
       if (randomisedSource == PredicateVerdict.VIOLATED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "GCMParameterSpecSpec", "" + __LOC,
               "v=1 code=GCMPARAMETERSPEC-CONSTR-01 ev=" + __EVENTNAME + " obj=GCMParameterSpec val='' exp='a randomized byte[]' msg='the IV material carries a randomization predicate the rule does not admit'"));
           conforms = false;
       }
       else if (randomisedSource == PredicateVerdict.NOT_OBSERVED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "GCMParameterSpecSpec", "" + __LOC,
               "v=1 code=GCMPARAMETERSPEC-NOBS-00 ev=" + __EVENTNAME + " obj=GCMParameterSpec val='' exp='a randomized byte[]' msg='the IV material was not observed to come from a randomized source'" + Evidence.keysFor(src)));
           conforms = false;
       }
       if (conforms) {
           spec = s;
       }
       else {
           PredicateStore.instance().ensure(Property.REPORTED_UPSTREAM, s);
       }
    }

   // `Con` of GCMParameterSpec.crysl: `c2: GCMParameterSpec(tagLen, src, offset, len)`, the
   // other alternative of `Con := c1 | c2`. The body is `c1`'s over this overload's arguments
   // and reads the rule the same way -- the same CONSTRAINTS clause over `tagLen`, the same
   // REQUIRES predicate over `src` -- each with a code of its own, because a code names a site
   // and not a clause. Neither check guards the transition, for the reason `c1` sets out: a
   // `condition(...)` compiles to an early return ahead of the body and of the transition, and
   // with `Con` the whole ORDER a suppressed transition is a construction nothing reports on.
   //
   // The rule's three bounds clauses are over this overload's extra arguments and none of them
   // has a site in this body.
   //
   // `length[src] >= offset + len;` and `offset >= 0;` have no execution path to sit on. The
   // constructor throws IllegalArgumentException for a negative offset and for a sum past the
   // end of the array, and this is an `after ... returning` advice: `(128, iv, -1, 4)` and
   // `(128, iv, 0, 99)` both throw before any advice runs, so a body accusation for them could
   // never be emitted.
   //
   // `len > 0;` is different. The constructor rejects a negative length and admits a zero one,
   // so `new GCMParameterSpec(128, iv, 0, 0)` returns and an advice does see it. The clause is
   // left unchecked all the same: a zero-length nonce range takes the transition, is reported
   // by nothing here, and -- if the tag length and the source read pass -- is prepared like any
   // other.
   event c2 after(int tagLen, byte[] src, int offset, int len) returning(GCMParameterSpec s):
     call(public GCMParameterSpec.new(int, byte[], int, int)) &&
     args(tagLen, src, offset, len) {
        creationObserved = true;
        boolean conforms = true;
        if (!validLengths.contains(tagLen)) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "GCMParameterSpecSpec", "" + __LOC,
                "v=1 code=GCMPARAMETERSPEC-CONSTR-02 ev=" + __EVENTNAME + " obj=GCMParameterSpec val='" + tagLen + "' exp='a tag length the expert GCMParameterSpec.crysl admits' msg='the authentication tag length is not one the rule admits'"));
            conforms = false;
        }
        PredicateVerdict randomisedSource = PredicateStore.instance().validate(Property.RANDOMIZED, src);
        if (randomisedSource == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "GCMParameterSpecSpec", "" + __LOC,
                "v=1 code=GCMPARAMETERSPEC-CONSTR-03 ev=" + __EVENTNAME + " obj=GCMParameterSpec val='' exp='a randomized byte[]' msg='the IV material carries a randomization predicate the rule does not admit'"));
            conforms = false;
        }
        else if (randomisedSource == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "GCMParameterSpecSpec", "" + __LOC,
                "v=1 code=GCMPARAMETERSPEC-NOBS-01 ev=" + __EVENTNAME + " obj=GCMParameterSpec val='' exp='a randomized byte[]' msg='the IV material was not observed to come from a randomized source'" + Evidence.keysFor(src)));
            conforms = false;
        }
        if (conforms) {
            spec = s;
        }
        else {
            PredicateStore.instance().ensure(Property.REPORTED_UPSTREAM, s);
        }
     }

   // `Con` is the whole of the rule's ORDER, and `Con := c1 | c2`: constructing
   // a GCMParameterSpec is the entire ordering this specification observes. Two
   // consequences the rest of the file depends on. Neither the tag length nor the
   // source may govern a transition -- the first is a CONSTRAINTS clause and the
   // second a REQUIRES predicate, and both are accused in the event bodies above.
   // And the `@fail` handler below cannot fire: a single-symbol expression has no
   // second event to take, the transition row the generator derives is {1, 2, 2}
   // for both events, and the monitor is keyed on the constructed object, so no
   // monitor of this specification ever sees a second event and state 2 is never
   // entered. The handler is written all the same, because the generator expects
   // one and because every code it names belongs to a site the file declares.
   ere : c1 | c2

   @fail {
      if (!creationObserved) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "GCMParameterSpecSpec", "" + __LOC,
             "v=1 code=GCMPARAMETERSPEC-ORDER-01 ev=" + __EVENTNAME + " obj=GCMParameterSpec val='' exp='' msg='the observed call sequence is not one GCMParameterSpecSpec accepts and no creation of the GCMParameterSpec was observed'"));
      }
      else {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "GCMParameterSpecSpec", "" + __LOC,
             "v=1 code=GCMPARAMETERSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=GCMParameterSpec val='' exp='' msg='the observed call sequence is not one GCMParameterSpecSpec accepts'"));
      }
      __RESET;
   }

   // ENSURES `preparedGCM[this];`: the GCMParameterSpec carries a tag length and
   // a nonce the rule admits, and its nonce came from a source the instrumentation
   // observed. The rule states the clause without an `after L` qualification, so
   // its acceptance point is the accepting state itself, which in an `ere` is
   // exactly what `@match` names. The monitor field is what carries the object
   // here: a handler sees no event arguments and runs after the transition is
   // decided, and the field is bound only by the conforming branch of either
   // constructor, so a construction that broke a clause reaches this handler with
   // nothing bound and `ensure` treats a null binding as a no-op.
   //
   // The write has a reader: `IvChainJunction` reads it at `Cipher.init`, for the
   // REQUIRES clause `mode(transformation) in {"GCM"} => preparedGCM[paramSpec];`
   // of Cipher.crysl.
   @match {
      PredicateStore.instance().ensure(Property.PREPARED_GCM, spec);
   }

}
