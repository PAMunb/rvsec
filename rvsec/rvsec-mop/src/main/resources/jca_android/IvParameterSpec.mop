package mop;

import javax.crypto.spec.IvParameterSpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * IvParameterSpec
 *
 * A JavaMOP specification of the correct usage of the
 * javax.crypto.spec.IvParameterSpec.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/IvParameterSpec.crysl
 */
IvParameterSpecSpec(IvParameterSpec s) {

    IvParameterSpec spec;

    // One event over `IvParameterSpec(byte[])`, where there used to be two split by
    // the sign of a guard. The negated twin `c3` matched the same call with the same
    // `args(iv)` and named no state in the `ere`, so it was one of the 17 orphan
    // accusers this group removes (INV-INS-135). Its body did carry an accusation --
    // IVPARAMETERSPEC-CONSTR-00, the rule's `randomized[iv]` REQUIRES read backwards
    // -- but that accusation is not a report of its own: it is the exact negation of
    // this event's guard, which is what makes the pair a twin and not an absorption
    // candidate. Fusing keeps the report and drops the split.
    //
    // What the split cost is the transition, and a second report. The guard
    // suppressed `c1` for precisely the calls `c3` accused, so an IV nobody had
    // randomised built an IvParameterSpec the automaton never saw -- and `c3`'s own
    // transition row sends every state to the fail state, so the same call also drew
    // an IVPARAMETERSPEC-ORDER-00 about an ordering the rule accepts. Measured
    // against the pre-image: two reports become one
    // (data/gh105/evidence/f1-IvParameterSpec-report-count.md). Read in the body, the
    // same predicate accuses about what it saw instead of deciding whether the call
    // happened.
    //
    // The read of `randomized[iv]` (IvParameterSpec.cryptsl:28) lives in this body and
    // not in `condition(...)`, for the reason the fusion above already paid for once:
    // a condition compiles to `if (!(guard)) return false;` ahead of both the body and
    // the transition. A failed REQUIRES is not a typestate failure -- the transition
    // is taken either way and the clause accuses on its own (INV-INS-133).
    //
    // The verdict is three-valued and the two accusing outcomes are told apart in the
    // report, because they are different claims. VIOLATED is positive evidence: the
    // array carries a randomisation predicate that was withdrawn. NOT_OBSERVED says
    // only that no randomised source of this array was ever observed, which on Android
    // is as often a reach limit of the instrumentation as it is a misuse. Folding the
    // two into one code would make the second unreadable as what it is.
    //
    // The write stays where the guard put it: `spec` is bound only when the IV is
    // observed randomised, because `@match` turns `spec` into `preparedIV[this]` and
    // CrySL ensures a predicate only for a use that satisfied the rule. NOT_OBSERVED
    // therefore does not prepare. That is the literal reading of the boolean this
    // replaces; the alternative -- an unobserved randomisation preparing anyway, so a
    // reach limit costs one report here instead of cascading into a second one
    // downstream -- has nothing to be measured against yet, because no specification
    // of the set reads PREPARED_IV. Whoever gives it a reader through the store owns
    // that question.
    event c1 after(byte[] iv) returning(IvParameterSpec s):
      call(public IvParameterSpec.new(byte[])) &&
      args(iv) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, iv);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvParameterSpecSpec", "" + __LOC,
                "v=1 code=IVPARAMETERSPEC-CONSTR-00 ev=" + __EVENTNAME + " obj=IvParameterSpec val='' exp='a randomized byte[]' msg='the iv given to IvParameterSpec(byte[]) carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvParameterSpecSpec", "" + __LOC,
                "v=1 code=IVPARAMETERSPEC-NOBS-00 ev=" + __EVENTNAME + " obj=IvParameterSpec val='' exp='a randomized byte[]' msg='no randomized source of the iv given to IvParameterSpec(byte[]) was observed'"));
        }
        else {
            spec = s;
        }
    }

    // The same fusion over the three-argument constructor, with one difference the
    // census calls out: `c4` was not the exact complement of `c2`. `c2`'s guard was a
    // conjunction of four things -- the `randomized[iv]` read and the three
    // offset/length conditions -- and `c4` negated only the read. So the two events
    // did not partition the calls: an IV that was randomised but whose offset and
    // length did not fit matched neither, and the constructor passed unobserved. The
    // fused body therefore keeps both checks rather than assuming complementarity,
    // the read accusing and the offset/length half guarding the write.
    //
    // The offset/length half cannot be false here, which is why keeping it costs
    // nothing: this is an `after ... returning` advice, and the constructor rejects
    // each of the three conditions with an exception before it can return
    // (`offset < 0`, `len < 0`, `iv.length - offset < len`; JDK 21
    // java.base/javax/crypto/spec/IvParameterSpec.java:75-91). It is kept because
    // dropping it would change what the specification claims about the constructor,
    // which is not what a structural fusion is for. api30's IvParameterSpec rule
    // states no CONSTRAINTS at all, so nothing in the oracle stands behind these
    // three either way.
    //
    // The read is the same clause as `c1`'s, at the same arity, over the same array:
    // one predicate, two constructors that bind it. It gets codes of its own because a
    // code names a site and not a clause -- `codes.csv` is keyed by event and file
    // line, and the report has to say which constructor it is about.
    event c2 after(byte[] iv, int offset, int len) returning(IvParameterSpec s):
      call(public IvParameterSpec.new(byte[], int, int)) &&
      args(iv, offset, len) {
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, iv);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvParameterSpecSpec", "" + __LOC,
                "v=1 code=IVPARAMETERSPEC-CONSTR-01 ev=" + __EVENTNAME + " obj=IvParameterSpec val='' exp='a randomized byte[]' msg='the iv given to IvParameterSpec(byte[], int, int) carries a randomization predicate the rule does not admit'"));
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvParameterSpecSpec", "" + __LOC,
                "v=1 code=IVPARAMETERSPEC-NOBS-01 ev=" + __EVENTNAME + " obj=IvParameterSpec val='' exp='a randomized byte[]' msg='no randomized source of the iv given to IvParameterSpec(byte[], int, int) was observed'"));
        }
        else if (offset >= 0 && len >= 0 && iv.length >= offset + len) {
            spec = s;
        }
    }

    ere : c1 | c2

    @fail {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "IvParameterSpecSpec", "" + __LOC,
          "v=1 code=IVPARAMETERSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=IvParameterSpec val='' exp='' msg='the observed call sequence is not one IvParameterSpecSpec accepts'"));
      __RESET;
    }

    // `preparedIV[this]` (IvParameterSpec.cryptsl:33) carries no `after L`
    // qualification, so the rule's acceptance point is the accepting state and the
    // write belongs in this handler (INV-INS-134) -- which is where it already sat.
    // What leaves is the accepting-state bookkeeping that stood beside it: the new
    // store does not offer it, and the set has no reader of it (INV-INS-147).
    //
    // `spec` is null in exactly the cases where the read did not answer SATISFIED, and
    // `ensure` treats a null binding as a no-op, so the unprepared constructor needs no
    // guard here.
    @match {
      PredicateStore.instance().ensure(Property.PREPARED_IV, spec);
    }

}
