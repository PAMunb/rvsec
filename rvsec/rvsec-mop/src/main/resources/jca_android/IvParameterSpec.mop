package mop;

import javax.crypto.spec.IvParameterSpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * IvParameterSpecSpec
 *
 * Monitors javax.crypto.spec.IvParameterSpec against the CrySL rule IvParameterSpec.crysl.
 * The rule's ORDER is `Con` alone, and `Con := c1 | c2`, so constructing the spec is the whole
 * call sequence this specification observes. At both constructors it reads the one REQUIRES
 * clause `randomized[iv];` over the IV bytes, and at its acceptance point it writes the one
 * ENSURES clause `preparedIV[this];` -- but only for a construction whose read answered
 * SATISFIED, so an IV of unobserved origin produces no preparation.
 *
 * Of the rule's three CONSTRAINTS clauses only one carries a report, and that is behaviour:
 *
 *  - `offset >= 0;` and `length[iv] >= offset + len;` are conditions the constructor rejects
 *    with an exception before it can return, and the events are `after ... returning` advice,
 *    so no call that breaks either ever reaches a body. The two conjuncts are kept, uncoded, as
 *    the guard over the predicate write;
 *  - `len > 0;` is the one a program can break and still return -- the constructor admits a
 *    zero length -- and it has a branch and a code of its own at the three-argument
 *    constructor.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/IvParameterSpec.crysl
 */
IvParameterSpecSpec(IvParameterSpec s) {

    // The object the acceptance handler writes the predicate over, staged by whichever
    // constructor built it and only on its conforming branch.
    IvParameterSpec spec;

    // Set by the creation events `c1` and `c2`. The generated `reset()` does not clear it, so every
    // failure of a monitor that saw no creation reports the `-ORDER-01` code in `@fail`.
    boolean creationObserved = false;

    // `Con` of IvParameterSpec.crysl: `c1: IvParameterSpec(iv)`, the one-argument constructor
    // and one alternative of `Con := c1 | c2`.
    //
    // REQUIRES `randomized[iv];`: the IV bytes came from a `SecureRandom` the instrumentation
    // observed -- the generator itself, or bytes it produced. The producing site is the handler
    // of `SecureRandomSpec` over the arrays its `generateSeed` and `nextBytes` events stage.
    //
    // The read lives in this body and not in a `condition(...)` guard: a condition compiles to
    // `if (!(guard)) return false;` ahead of both the body and the transition, so an IV nobody
    // had randomised would build an IvParameterSpec the automaton never saw, and -- since
    // `Con` is the whole ORDER -- the construction would be accused of nothing at all. A failed
    // REQUIRES is not a typestate failure: the transition is taken either way and the clause
    // accuses on its own.
    //
    // The verdict is three-valued and the two accusing outcomes are told apart in the
    // report, because they are different claims. VIOLATED is positive evidence: the store
    // holds an entry for this array under this predicate that the clause does not admit.
    // NOT_OBSERVED says only that the store holds no entry for it at all, so no randomised
    // source of this array was ever observed, which on Android is as often a reach limit of the
    // instrumentation as it is a misuse. Folding the two into one code would make the second
    // unreadable as what it is.
    //
    // `spec` is bound only when the read answered SATISFIED, because `@match` turns `spec` into
    // `preparedIV[this]` and CrySL ensures a predicate only for a use that satisfied the rule.
    // NOT_OBSERVED therefore does not prepare, and the two sites that read `preparedIV` --
    // `AlgorithmParametersSpec` at `init` and `IvChainJunction` at `Cipher.init` -- see an
    // unprepared spec, so one reach limit is reported twice: here, and again downstream.
    //
    // A construction this body reports on is marked `REPORTED_UPSTREAM`, so the consumer of
    // `PREPARED_IV` (`IvChainJunction.use`) reports it as refused upstream rather than as not
    // observed. The read of `randomized[iv]` here is not a consumer of that mark: no producer of
    // `RANDOMIZED` marks what it refuses, so NOT_OBSERVED keeps its own code.
    event c1 after(byte[] iv) returning(IvParameterSpec s):
      call(public IvParameterSpec.new(byte[])) &&
      args(iv) {
        creationObserved = true;
        boolean reported = false;
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, iv);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvParameterSpecSpec", "" + __LOC,
                "v=1 code=IVPARAMETERSPEC-CONSTR-00 ev=" + __EVENTNAME + " obj=IvParameterSpec val='' exp='a randomized byte[]' msg='the iv given to IvParameterSpec(byte[]) carries a randomization predicate the rule does not admit'"));
            reported = true;
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvParameterSpecSpec", "" + __LOC,
                "v=1 code=IVPARAMETERSPEC-NOBS-00 ev=" + __EVENTNAME + " obj=IvParameterSpec val='' exp='a randomized byte[]' msg='no randomized source of the iv given to IvParameterSpec(byte[]) was observed'" + Evidence.keysFor(iv)));
            reported = true;
        }
        else {
            spec = s;
        }
        if (reported) {
            PredicateStore.instance().ensure(Property.REPORTED_UPSTREAM, s);
        }
    }

    // `Con` of IvParameterSpec.crysl: `c2: IvParameterSpec(iv, offset, len)`, the other
    // alternative of `Con := c1 | c2`.
    //
    // REQUIRES `randomized[iv];` -- the same clause as `c1`'s, at the same arity, over the same
    // array: one predicate, two constructors that bind it, read the same three-valued way. It
    // gets codes of its own because a code names a site and not a clause; `codes.csv` is keyed
    // by event and file line, and the report has to say which constructor it is about.
    //
    // The rule's three bounds clauses are over this overload's arguments, and only one of them
    // can be broken by a call this advice sees.
    //
    // `offset >= 0;` and `length[iv] >= offset + len;` appear as the two conjuncts of the last
    // branch and carry no code. This is an `after ... returning` advice, and the constructor
    // rejects both conditions with an exception before it can return (`offset < 0`,
    // `iv.length - offset < len`), so neither conjunct can be false here. They are kept because
    // they are the two clauses verbatim and because they are what guards the predicate write,
    // and they stay uncoded because a code with no reachable emission would accuse a program
    // the platform already forbids.
    //
    // `len > 0;` is the one clause of the three a program can break and still return: the
    // constructor rejects a negative length and admits `len == 0`, so a zero-length IV would
    // otherwise pass the guard and be prepared. It has its own branch and its own code for that
    // reason, written over `len <= 0` and reached only at zero.
    event c2 after(byte[] iv, int offset, int len) returning(IvParameterSpec s):
      call(public IvParameterSpec.new(byte[], int, int)) &&
      args(iv, offset, len) {
        creationObserved = true;
        boolean reported = false;
        PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, iv);
        if (randomised == PredicateVerdict.VIOLATED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvParameterSpecSpec", "" + __LOC,
                "v=1 code=IVPARAMETERSPEC-CONSTR-01 ev=" + __EVENTNAME + " obj=IvParameterSpec val='' exp='a randomized byte[]' msg='the iv given to IvParameterSpec(byte[], int, int) carries a randomization predicate the rule does not admit'"));
            reported = true;
        }
        else if (randomised == PredicateVerdict.NOT_OBSERVED) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvParameterSpecSpec", "" + __LOC,
                "v=1 code=IVPARAMETERSPEC-NOBS-01 ev=" + __EVENTNAME + " obj=IvParameterSpec val='' exp='a randomized byte[]' msg='no randomized source of the iv given to IvParameterSpec(byte[], int, int) was observed'" + Evidence.keysFor(iv)));
            reported = true;
        }
        else if (len <= 0) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "IvParameterSpecSpec", "" + __LOC,
                "v=1 code=IVPARAMETERSPEC-CONSTR-02 ev=" + __EVENTNAME + " obj=IvParameterSpec val='" + len + "' exp='a length greater than zero' msg='the iv length given to IvParameterSpec(byte[], int, int) is not greater than zero'"));
            reported = true;
        }
        else if (offset >= 0 && iv.length >= offset + len) {
            spec = s;
        }
        if (reported) {
            PredicateStore.instance().ensure(Property.REPORTED_UPSTREAM, s);
        }
    }

    // `Con` is the whole of the rule's ORDER, and `Con := c1 | c2`: constructing an
    // IvParameterSpec is the entire ordering this specification observes, so neither the IV's
    // origin nor its bounds may govern a transition -- they are accused in the event bodies
    // above. The `@fail` handler below cannot fire either: a single-symbol expression has no
    // second event to take, and the monitor is keyed on the constructed object, so no monitor
    // of this specification ever sees a second event. It is written all the same, because the
    // generator expects a handler and because every code it names belongs to a site the file
    // declares.
    ere : c1 | c2

    @fail {
      if (!creationObserved) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "IvParameterSpecSpec", "" + __LOC,
             "v=1 code=IVPARAMETERSPEC-ORDER-01 ev=" + __EVENTNAME + " obj=IvParameterSpec val='' exp='' msg='the observed call sequence is not one IvParameterSpecSpec accepts and no creation of the IvParameterSpec was observed'"));
      }
      else {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "IvParameterSpecSpec", "" + __LOC,
             "v=1 code=IVPARAMETERSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=IvParameterSpec val='' exp='' msg='the observed call sequence is not one IvParameterSpecSpec accepts'"));
      }
      __RESET;
    }

    // ENSURES `preparedIV[this];`: the IvParameterSpec was built from bytes that came from a
    // source the instrumentation observed. The clause carries no `after L` qualification, so
    // the rule's acceptance point is the accepting state, which in an `ere` is what `@match`
    // names. A handler receives no event arguments and runs after the transition is decided, so
    // the constructor that saw the object is what staged it in `spec`.
    //
    // `spec` is null in exactly the cases where the read did not answer SATISFIED, and
    // `ensure` treats a null binding as a no-op, so the unprepared constructor needs no
    // guard here.
    //
    // Two sites read this predicate: `AlgorithmParametersSpec` at its `init` event, for the
    // clause `algorithm in {"AES"} => preparedIV[paramSpec];` of AlgorithmParameters.crysl, and
    // `IvChainJunction` at `Cipher.init`, for the clause
    // `mode(transformation) in {"CBC", "PCBC", "CTR", "CTS", "CFB", "OFB"} && encmode == 1 =>
    // preparedIV[paramSpec];` of Cipher.crysl.
    @match {
      PredicateStore.instance().ensure(Property.PREPARED_IV, spec);
    }

}
