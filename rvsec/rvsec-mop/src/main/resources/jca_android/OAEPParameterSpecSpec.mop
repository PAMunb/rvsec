package mop;

import java.security.spec.AlgorithmParameterSpec;
import java.util.Arrays;
import java.util.List;
import javax.crypto.spec.OAEPParameterSpec;
import javax.crypto.spec.PSource;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * OAEPParameterSpecSpec
 *
 * Monitors javax.crypto.spec.OAEPParameterSpec against the CrySL rule OAEPParameterSpec.crysl.
 * The rule's ORDER is `Con` alone, and `Con := c1`, the four-argument constructor, so building
 * the spec is the whole call sequence this specification observes. In that constructor's body
 * it enforces the two CONSTRAINTS clauses `mdName in {"SHA-256", "SHA-384", "SHA-512"};` and
 * `mgfName in {"MGF1"};`, and reads the one REQUIRES clause `preparedMGF1[mgfSpec, mdName];`.
 * At its acceptance point it writes the one ENSURES clause `preparedOAEP[this];`.
 *
 * One reach limit of the monitor, stated as behaviour. The pointcut sees a constructor the
 * application calls and nothing else, so a mask-generation spec that arrives as one of
 * `MGF1ParameterSpec`'s static constants -- objects the platform builds inside itself, where
 * nothing is instrumented -- carries no predicate at all: the constructor event that would have
 * written one never fires for it. The REQUIRES read then answers NOT_OBSERVED, and this
 * specification says the preparation was not observed rather than accusing the program of a
 * mismatch.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/OAEPParameterSpec.crysl
 */
OAEPParameterSpecSpec(OAEPParameterSpec s) {

   // The envelope's quoting rule: a null value is the empty string, a single
   // quote is escaped so it cannot close the field early, and the value is capped so a
   // pathological argument cannot push the record past the logcat payload limit.
   private String q(String s) {
       if (s == null) {
           return "";
       }
       String value = s.length() > 512 ? s.substring(0, 512) : s;
       return value.replace("'", "\\'");
   }

   // The CONSTRAINTS clause `mdName in {"SHA-256", "SHA-384", "SHA-512"};` of
   // OAEPParameterSpec.crysl, transcribed. The rule also declares a fifth object,
   // `java.lang.String alg`, which no event, constraint, requirement or ensures clause of the
   // rule names -- an anomaly with no transcription consequence, mentioned here so a reader
   // comparing the two files does not go looking for the clause that reads it.
   List<String> digests = Arrays.asList("SHA-256", "SHA-384", "SHA-512");

   // The CONSTRAINTS clause `mgfName in {"MGF1"};` of OAEPParameterSpec.crysl, transcribed.
   List<String> maskFunctions = Arrays.asList("MGF1");

   // Bound only on the conforming branch, which is what carries the object to `@match`.
   OAEPParameterSpec spec;

   // Set by the one creation event, `c1`, whatever it reports, and never cleared: the
   // generated `reset()` restores the automaton state and leaves this field. `@fail` reads it
   // to choose between `OAEPPARAMETERSPEC-ORDER-01` (`creation-unobserved`) and the
   // wrong-sequence code.
   boolean creationObserved = false;

   // `Con` of OAEPParameterSpec.crysl: `c1: OAEPParameterSpec(mdName, mgfName, mgfSpec, pSrc)`,
   // the rule's one event and the whole of its ORDER. The platform declares exactly this
   // constructor; the class's own `DEFAULT` static constant is built inside the platform and
   // never reaches this pointcut.
   //
   // Three clauses land in this body and none of them guards the transition. A
   // `condition(...)` compiles to `if (!(guard)) return false;` ahead of the body and the
   // transition, so a spec built on MD5, or on a mask function nobody prepared, would take no
   // transition and be accused of nothing. They accumulate rather than short-circuit, so a
   // construction that broke two clauses is told about two.
   //
   // CONSTRAINTS `mdName in {"SHA-256", "SHA-384", "SHA-512"};` and `mgfName in {"MGF1"};`, the
   // two value clauses, compared through `ConscryptAliasTable.matches` -- the set's one
   // normalisation rule, which resolves a pinned provider alias for the service and then folds
   // case. For the digest the table also resolves genuine Conscrypt aliases (`SHA256`, the
   // OID); for the mask function it has no rows under this label, so the call degrades to
   // case-insensitive comparison, which is all `MGF1` needs.
   //
   // REQUIRES `preparedMGF1[mgfSpec, mdName];`: the MGF1ParameterSpec names a digest the rule
   // admits, and carries that digest with it. The clause names both positions, so the read is
   // a comparison of two digest names and not an existence check: the value asked with is this
   // OAEP spec's own digest, canonicalised the same way the producer canonicalises what it
   // writes, and the store compares `String` positions after lowercasing and nothing else. The
   // producing site is the handler of `MGF1ParameterSpecSpec`, over the object its constructor
   // event stages.
   //
   // The read is three-valued and the two accusing outcomes go under different codes, both
   // registered in `codes.csv`. VIOLATED is positive evidence: the store holds an entry for
   // this mask spec under this predicate and its digest name is a different one, which is
   // exactly the disagreement the clause's second place exists to catch. NOT_OBSERVED means
   // the store holds no entry for the object at all, so nothing about it was ever recorded
   // under this predicate.
   //
   // NOT_OBSERVED is the monitor's reach limit here and not a misuse, and it has a particular
   // cause worth naming: the mask spec may be one of `MGF1ParameterSpec`'s static constants
   // (`SHA256` and its siblings), which the platform builds inside itself, where nothing is
   // instrumented. The constructor event of `MGF1ParameterSpecSpec` never fires for such an
   // object, so it carries no predicate, and this read answers NOT_OBSERVED rather than
   // accusing a program that did nothing wrong.
   event c1 after(String mdName, String mgfName, AlgorithmParameterSpec mgfSpec, PSource pSrc) returning(OAEPParameterSpec s):
     call(public OAEPParameterSpec.new(String, String, AlgorithmParameterSpec, PSource)) &&
     args(mdName, mgfName, mgfSpec, pSrc) {
       creationObserved = true;
       boolean conforms = true;
       if (!ConscryptAliasTable.matches("MessageDigest", mdName, digests)) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "OAEPParameterSpecSpec", "" + __LOC,
               "v=1 code=OAEPPARAMETERSPEC-ALG-00 ev=" + __EVENTNAME + " obj=OAEPParameterSpec val='" + q(mdName) + "' exp='" + q(String.join(",", digests)) + "' msg='the oaep digest is not one the rule admits'"));
           conforms = false;
       }
       if (!ConscryptAliasTable.matches("OAEPParameterSpec", mgfName, maskFunctions)) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "OAEPParameterSpecSpec", "" + __LOC,
               "v=1 code=OAEPPARAMETERSPEC-ALG-01 ev=" + __EVENTNAME + " obj=OAEPParameterSpec val='" + q(mgfName) + "' exp='" + q(String.join(",", maskFunctions)) + "' msg='the mask generation function is not one the rule admits'"));
           conforms = false;
       }
       PredicateVerdict preparedMask = PredicateStore.instance().validate(Property.PREPARED_MGF1, mgfSpec,
           ConscryptAliasTable.canonical("MessageDigest", mdName));
       if (preparedMask == PredicateVerdict.VIOLATED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "OAEPParameterSpecSpec", "" + __LOC,
               "v=1 code=OAEPPARAMETERSPEC-CONSTR-00 ev=" + __EVENTNAME + " obj=OAEPParameterSpec val='" + q(mdName) + "' exp='a mask generation function prepared for the same digest' msg='the mask generation parameters were prepared for a different digest'"));
           conforms = false;
       }
       else if (preparedMask == PredicateVerdict.NOT_OBSERVED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "OAEPParameterSpecSpec", "" + __LOC,
               "v=1 code=OAEPPARAMETERSPEC-NOBS-00 ev=" + __EVENTNAME + " obj=OAEPParameterSpec val='" + q(mdName) + "' exp='a mask generation function prepared for the same digest' msg='no preparation of the mask generation parameters was observed'" + Evidence.keysFor(mgfSpec)));
           conforms = false;
       }
       if (conforms) {
           spec = s;
       }
   }

   // `Con := c1` is the whole ORDER, so the `@fail` handler below cannot fire: a single-symbol
   // expression has no second event to take, the transition row the generator derives is
   // {1, 2, 2}, and the monitor is keyed on the constructed object, so no monitor ever sees a
   // second event and state 2 is never entered. It is written all the same, because the
   // generator expects a handler and because every code it names belongs to a site the file
   // declares.
   ere : c1

   @fail {
      if (!creationObserved) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "OAEPParameterSpecSpec", "" + __LOC,
             "v=1 code=OAEPPARAMETERSPEC-ORDER-01 ev=" + __EVENTNAME + " obj=OAEPParameterSpec val='' exp='' msg='the observed call sequence is not one OAEPParameterSpecSpec accepts and no creation of the parameters was observed'"));
      }
      else {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "OAEPParameterSpecSpec", "" + __LOC,
             "v=1 code=OAEPPARAMETERSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=OAEPParameterSpec val='' exp='' msg='the observed call sequence is not one OAEPParameterSpecSpec accepts'"));
      }
      __RESET;
   }

   // ENSURES `preparedOAEP[this];`: the OAEPParameterSpec names a digest and mask function the
   // rule admits. The clause carries no `after L`, so the acceptance point is the accepting
   // state, which in an `ere` is `@match`. A handler receives no event arguments and runs after
   // the transition is decided, so the constructor is what stages the object; `spec` is bound
   // only by its conforming branch, and `ensure` treats a null binding as a no-op.
   //
   // Two rules require this predicate and they are not in the same state.
   // `AlgorithmParameters.crysl` requires it under `algorithm in {"OAEP"} =>
   // preparedOAEP[paramSpec];`, and `AlgorithmParametersSpec` reads it at its `init` event, so
   // this write has a live consumer. `Cipher.crysl` requires it under
   // `mode(transformation) in {"OAEPWithMD5AndMGF1Padding", "OAEPWithSHA-224AndMGF1Padding",
   // "OAEPWithSHA-256AndMGF1Padding", "OAEPWithSHA-384AndMGF1Padding",
   // "OAEPWithSHA-512AndMGF1Padding"} => preparedOAEP[paramSpec];`, whose antecedent tests the
   // operation mode against five strings the same rule classifies as paddings; no
   // transformation can make it true, so the clause constrains no trace and no specification
   // of this set reads it.
   @match {
      PredicateStore.instance().ensure(Property.PREPARED_OAEP, spec);
   }

}
