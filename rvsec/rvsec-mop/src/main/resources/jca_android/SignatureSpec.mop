package mop;

import java.security.Signature;
import java.security.PrivateKey;
import java.security.PublicKey;
import java.security.SecureRandom;
import java.security.cert.Certificate;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * SignatureSpec
 *
 * A JavaMOP specification of the correct usage of the
 * java.security.Signature class.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/Signature.crysl
 */
SignatureSpec(Signature s) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

       List<String> algorithms = Arrays.asList("NONEwithRSA", "SHA1withDSA", "SHA224withECDSA", "MD5withRSA",
            "SHA256withDSA", "SHA384withRSA/PSS", "DSAwithSHA1", "SHA384withRSA", "SHA512withRSA/PSS",
            "SHA1withRSA/PSS", "SHA512withRSA", "SHA1withRSA", "NONEwithDSA", "SHA256withRSA/PSS",
            "SHA224withRSA/PSS", "SHA256withRSA", "DSA", "SHA224withRSA", "SHA224withDSA", "DSS",
            "SHA1withECDSA", "SHA256withECDSA", "SHA384withECDSA", "SHA512withECDSA");
       String currentAlgorithmInstance = "";

       String expectedPrivateKey = "a private key produced by one of the generators the rule names";

       String expectedPublicKey = "a public key produced by one of the generators the rule names";

       // api30 Signature.cryptsl states four ENSURES clauses over two objects: the
       // signature `Signs` produces and the signature `Verifies` was given. Neither is
       // reachable from a handler -- a handler sees no event parameter -- so each event
       // stages what its clause names and the acceptance handler consumes it. The field
       // is cleared when consumed, so a call whose event did not fire leaves no marking
       // behind for the next one.
       byte[] stagedSigned = null;
       byte[] stagedVerified = null;

       // One event over `getInstance(String)`, where there used to be two split by
       // the sign of a guard. The negated twin `g3` matched the same call with the
       // same `args(alg)` and named no state in the `ere`, and the generator gives an
       // event absent from the automaton a transition row that moves every state to
       // the fail state: a signature built with an algorithm the rule rejects was
       // reported as a wrong call sequence, and the `initSign`/`initVerify` that
       // followed it was reported again, because `g3`'s failing transition had taken
       // the `@fail` path, which `__RESET`s the monitor to the start state, where no
       // init event is declared.
       //
       // The api30 rule orders `Gets, ((InitSigns+, ...)+ | (InitVerifies+, ...)+)`
       // with `Gets := g1 | g2` and states the algorithm under CONSTRAINTS, so the
       // algorithm must not govern the transition: `getInstance` is a `Gets` whatever
       // it was asked for. Dropping the guard lets the rejected signature reach the
       // init events like any other, where the four `i1`-`i4` bodies accuse it
       // exactly once, with SIGNATURE-ALG-00 through SIGNATURE-ALG-03. `g3`'s body
       // accused nothing of its own -- it only rebound `currentAlgorithmInstance` --
       // so nothing it reported is lost.
       //
       // Residue, recorded and not repaired (divergence_record.csv): a `getInstance`
       // whose algorithm the rule rejects and which is never initialised is now
       // accused by nothing, because the accusation lives in the init bodies. The
       // two-argument `g2` still carries the guard this event lost, and with it the
       // same suppression, for the same reason -- it is not an orphan, so no task of
       // this group reaches it. Both are behavioural changes, deliberately deferred.
       event g1 after(String alg) returning(Signature s):
         call(public static Signature Signature.getInstance(String)) &&
         args(alg) {
           currentAlgorithmInstance = alg;
       }

       event g2 after(String alg, String provider) returning(Signature s):
         call(public static Signature Signature.getInstance(String, String)) &&
         args(alg, provider) &&
         condition(ConscryptAliasTable.matches("Signature", alg, algorithms)) {
           currentAlgorithmInstance = alg;
       }

       // api30 Signature states two REQUIRES clauses and this file read neither until
       // this pass: `generatedPrivkey[priv]` (Signature.cryptsl:80, ledger #34) over the
       // key `initSign` is given, and `generatedPubkey[pub]` (:82, ledger #35) over the
       // key `initVerify` is given. They are the rule's own clauses -- not `generatedKey`,
       // which api30's Signature never mentions -- so a secret key has no business
       // answering them, and the three reads below name the two key-half predicates only.
       //
       // Three sites for two clauses, because the rule binds `priv` in both `i1` and `i2`
       // and `pub` in `i4`. `i3` reads nothing: it binds a `Certificate`, which is the
       // rule's `cert`, and api30 states no clause over it -- the public half inside a
       // certificate is never handed to this call as a `PublicKey`, so there is no object
       // here the clause is about. That asymmetry is the oracle's and is recorded, not
       // repaired.
       //
       // The reads are in the bodies, never in `condition(...)`: a guard would suppress
       // the transition and turn "this key's origin was not observed" into a
       // wrong-call-sequence report about a program whose sequence the rule accepts
       // (INV-INS-133). Each carries its own pair of codes, VIOLATED and NOT_OBSERVED
       // apart, because the first is positive evidence and the second is as often a reach
       // limit of the instrumentation as it is a misuse.
       //
       // Measured before the reads were written: the chain composes end to end.
       // `KeyPairGenerator.getInstance("RSA").generateKeyPair()`, then `getPrivate()` into
       // `initSign` and `getPublic()` into `initVerify`, signs and verifies on Temurin 21,
       // and the producer is `KeyPairSpec.gpu`/`gpr`, which mark the halves by identity in
       // the event body -- the placement that makes them reachable for a pair the program
       // did not construct itself. `KeyStoreSpec` is the second producer of the private
       // half, wired in this same commit.
       //
       // The corpus had no trace that could measure this: all seven Signature traces pass
       // `null` to `initSign`/`initVerify`, and a null bound object reads NOT_OBSERVED. The
       // three traces this pass adds are what separate the verdicts.
       event i1 before(PrivateKey privateKey, Signature s):
         call(public void Signature.initSign(PrivateKey)) &&
         args(privateKey) &&
         target(s) {
           if (!ConscryptAliasTable.matches("Signature", s.getAlgorithm(), algorithms)) {
              ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SignatureSpec", "" + __LOC,
                  "v=1 code=SIGNATURE-ALG-00 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + s.getAlgorithm() + "'"));
           }
           PredicateVerdict origin = PredicateStore.instance().validate(Property.GENERATED_PRIVATE_KEY, privateKey);
           if (origin == PredicateVerdict.VIOLATED) {
              ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                  "v=1 code=SIGNATURE-CONSTR-00 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPrivateKey) + "' msg='the private key given to initSign carries a key-origin predicate the rule does not admit'"));
           }
           else if (origin == PredicateVerdict.NOT_OBSERVED) {
              ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                  "v=1 code=SIGNATURE-NOBS-00 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPrivateKey) + "' msg='no generator of the private key given to initSign was observed'"));
           }
        }

       event i2 before(PrivateKey privateKey, SecureRandom random, Signature s):
         call(public void Signature.initSign(PrivateKey, SecureRandom)) &&
         args(privateKey, random) &&
         target(s) {
              if (!ConscryptAliasTable.matches("Signature", s.getAlgorithm(), algorithms)) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-ALG-01 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + s.getAlgorithm() + "'"));
        }
              PredicateVerdict origin = PredicateStore.instance().validate(Property.GENERATED_PRIVATE_KEY, privateKey);
              if (origin == PredicateVerdict.VIOLATED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-CONSTR-01 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPrivateKey) + "' msg='the private key given to initSign carries a key-origin predicate the rule does not admit'"));
        }
              else if (origin == PredicateVerdict.NOT_OBSERVED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-NOBS-01 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPrivateKey) + "' msg='no generator of the private key given to initSign was observed'"));
        }
        }

       event i3 before(Certificate cert, Signature s):
         call(public void Signature.initVerify(Certificate)) &&
         args(cert) &&
         target(s) {
           if (!ConscryptAliasTable.matches("Signature", s.getAlgorithm(), algorithms)) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-ALG-02 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + s.getAlgorithm() + "'"));
        }
        }

       event i4 before(PublicKey key, Signature s):
         call(public void Signature.initVerify(PublicKey)) &&
         args(key) &&
         target(s) {
              if (!ConscryptAliasTable.matches("Signature", s.getAlgorithm(), algorithms)) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-ALG-03 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + s.getAlgorithm() + "'"));
        }
              PredicateVerdict origin = PredicateStore.instance().validate(Property.GENERATED_PUBLIC_KEY, key);
              if (origin == PredicateVerdict.VIOLATED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-CONSTR-02 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPublicKey) + "' msg='the public key given to initVerify carries a key-origin predicate the rule does not admit'"));
        }
              else if (origin == PredicateVerdict.NOT_OBSERVED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-NOBS-02 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPublicKey) + "' msg='no generator of the public key given to initVerify was observed'"));
        }
        }

       event update before(Signature s):
         call(public void Signature.update(..)) &&
         target(s) {

        }

       // `signed[out, inpb] after Signs` (Signature.cryptsl:87, with :89 and :91 naming
       // the same `out` against the other two input shapes). The clause carries an
       // `after L`, so its acceptance point is the states `Signs` leads to; read off the
       // generated monitor, `s1` and `s2` both land in state 1 and the match category is
       // `nextstate == 1 || nextstate == 4`, so those states are inside the accepting set
       // and `@match` is the acceptance point for this clause as well as for `verified`.
       //
       // The clause is two-place -- the signature and the input it was computed over --
       // and this site writes one place. The arity stays where the seed had it and the
       // reason is recorded in `predicate_graph.csv`: no rule of api30 requires `signed`,
       // so there is no consumer whose arity this write has to meet, and raising it alone
       // would be a claim about a chain that does not exist.
       event s1 after(Signature s) returning(byte[] output):
         call(public byte[] Signature.sign()) &&
         target(s) {
           stagedSigned = output;
       }


       event s2 after(byte[] output, int offset, int len, Signature s):
         call(public int Signature.sign(byte[], int, int)) &&
         args(output, offset, len) &&
         target(s) {
           stagedSigned = output;
       }

       // `verified[sign]` (Signature.cryptsl:93). The clause names the *signature the
       // call was given*, and the seed wrote the *boolean the call returned* -- a
       // divergence repaired here rather than recorded, because the two are measurably
       // different objects and one of them is not about this program at all: an
       // identity-keyed store handed `Boolean.TRUE` marks the JVM-wide cached instance,
       // so `validate(VERIFIED, <any other true>)` answers SATISFIED. Measured, the
       // repair costs nothing either way -- no rule of api30 requires `verified`, so
       // both forms are read by nobody -- and what it buys is that the site is the
       // literal transcription of the clause and its omission record has one thing to
       // say instead of two.
       //
       // The clause carries no `after L`, so its acceptance point is the accepting state,
       // which in an `ere` is what `@match` names (INV-INS-134).
       event v1 after(byte[] sign, Signature s) returning(boolean signed):
         call(public boolean Signature.verify(byte[])) &&
         args(sign) &&
         target(s) {
           stagedVerified = sign;
       }


       event v2 after(byte[] sign, int offset, int len, Signature s) returning(boolean signed):
         call(public boolean Signature.verify(byte[], int, int)) &&
         args(sign, offset, len) &&
         target(s) {
            stagedVerified = sign;
       }

       // Both ENSURES objects are consumed at the accepting state, and neither predicate
       // has a reader: `signed` and `verified` appear in the api30 oracle only here, as
       // this rule's own ENSURES, so they are two of the dead ends this change disposes
       // of by recording the omission rather than by fabricating a consumer
       // (INV-INS-137). What leaves the handlers besides is the accepting-state
       // bookkeeping: the new store does not offer it and the set never read it back
       // (INV-INS-147), which is also why the `Signature signature` field is gone -- that
       // call was the only thing that read it.
       ere: (g1 | g2) ( ((i1 | i2)+ (update+ (s1 | s2)+)+)+ | ((i3 | i4)+ (update* (v1 | v2)+)+)+ )

       @fail {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SignatureSpec", "" + __LOC,
              "v=1 code=SIGNATURE-ORDER-00 ev=" + __EVENTNAME + " obj=Signature val='' exp='' msg='the observed call sequence is not one SignatureSpec accepts'"));
          stagedSigned = null;
          stagedVerified = null;
          __RESET;
       }

       @match {
          if (stagedSigned != null) {
              PredicateStore.instance().ensure(Property.SIGNED, stagedSigned);
              stagedSigned = null;
          }
          if (stagedVerified != null) {
              PredicateStore.instance().ensure(Property.VERIFIED, stagedVerified);
              stagedVerified = null;
          }
       }

}
