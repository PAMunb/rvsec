package mop;

import java.security.Signature;
import java.security.PrivateKey;
import java.security.PublicKey;
import java.security.SecureRandom;
import java.security.cert.Certificate;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * SignatureSpec
 *
 * Monitors java.security.Signature against the CrySL rule Signature.crysl.
 *
 * The rule's ORDER is `Get, ((InitSign+, (Update+, Sign+)+ )+ | (InitVerify+, (Update*,
 * Verify+)+ )+ )`: a signature is obtained from `getInstance` and then used either for
 * signing or for verifying, never for both. Update calls are required before a signature and
 * optional before a verification. Every other call sequence is reported as a wrong call
 * sequence.
 *
 * The CONSTRAINTS clause it enforces is the algorithm allow-list, checked at each of the four
 * init events against the algorithm the instance reports, and carried as a guard on the
 * two-argument creation event.
 *
 * It reads two REQUIRES clauses: `generatedPrivkey[privateKey]` at the two `initSign`
 * overloads and `generatedPubkey[publicKey]` at `initVerify(PublicKey)`. It ENSURES the
 * rule's three `signed` clauses -- `signed[output, inputByte] after Sign;`,
 * `signed[output, input] after Sign;` and `signed[output, inputByteBuffer] after Sign;`,
 * which name one output against three input shapes -- and `verified[verified, sign] after
 * Verify;`, all written at the acceptance point from values the events stage in fields.
 *
 * Reach limit of both reads: NOT_OBSERVED means the store holds nothing about the key, which
 * happens as often because the key was built where the instrumentation does not reach -- a
 * key store the weaving does not enter, a provider's own code -- as because the program
 * misused the API, so that outcome carries its own code. A `null` key reads NOT_OBSERVED
 * likewise, because the monitor runs inside the application under test and never throws.
 *
 * Reach limits and divergences from the rule.
 *
 * - The three length clauses of the rule's CONSTRAINTS section -- `length[input] >= offset +
 *   len;`, `offset >= 0;` and `len > 0;` -- have no site. The `update` event fuses the four
 *   update overloads into one pointcut that binds no argument, and the `sign` and `verify`
 *   overloads that name a range bind it without checking it.
 * - `initVerify(Certificate)` reads no key-origin predicate. The rule's public-key clause
 *   names `publicKey`, which that call does not pass, and the rule states no clause over its
 *   `cert`, so a verification set up from a certificate has its key origin unchecked.
 * - The one-argument `getInstance` carries no allow-list guard, so a signature obtained
 *   through it with an algorithm the rule refuses and never initialised draws no algorithm
 *   report: that report lives in the init bodies.
 * - Neither predicate this specification writes has a reader. No rule of the set requires
 *   `signed` or `verified`, so both writes record a fact that nothing consumes.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/Signature.crysl
 */
SignatureSpec(Signature s) {
    // The report envelope's quoting rule: a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

       // CONSTRAINTS of Signature.crysl: `algorithm in {"SHA256withRSA", "SHA256withECDSA",
       // "SHA256withDSA", "SHA384withRSA", "SHA512withRSA", "SHA384withECDSA",
       // "SHA512withECDSA"};`, transcribed entry for entry -- an alias never enters the list
       // it resolves against, so a name such as `SHA256withRSAEncryption` is absent here and
       // is admitted by resolution instead.
       //
       // A value reaches an entry of this list through `ConscryptAliasTable.matches`, which
       // every site below calls. It folds case on both sides and compares the name twice:
       // as the program spelled it, and as the alias rows the table carries for the
       // `Signature` service resolve it. So a spelling that differs only in case matches, and
       // so does a composite OID the platform registers for the same algorithm, such as
       // `1.2.840.113549.1.1.11`. A name whose row resolves to an algorithm the clause does
       // not list -- the rows landing on `MD5withRSA`, `SHA1withRSA` and their relatives --
       // matches nothing and is reported, which is the direction that matters: the report
       // reaches the call however the weak algorithm was spelled.
       List<String> algorithms = Arrays.asList("SHA256withRSA", "SHA256withECDSA", "SHA256withDSA",
            "SHA384withRSA", "SHA512withRSA", "SHA384withECDSA", "SHA512withECDSA");

       // The `exp=` text of the private-key reports at `i1` and `i2`, in one place so the two
       // sites say the same thing about the same clause.
       String expectedPrivateKey = "a private key produced by one of the generators the rule names";

       // The `exp=` text of the public-key reports at `i4`, kept beside its private-key twin
       // so the two clauses of the rule's REQUIRES section read alike in a report.
       String expectedPublicKey = "a public key produced by one of the generators the rule names";

       // The rule's ENSURES clauses name the signature `Sign` produces and the signature
       // `Verify` was given, and both are written at the acceptance point. A handler receives
       // no event arguments and runs after the transition is decided, so it can see neither
       // the array a call returned nor the array a call was passed: each event stages what
       // its clause names in one of these fields and the acceptance handler reads the field
       // and writes the predicate. The field is cleared when consumed, and `@fail` discards
       // it, so a staged value is written by exactly one handler run or thrown away, never
       // written for a sequence the automaton refused.
       byte[] stagedSigned = null;
       byte[] stagedVerified = null;

       // Set by `g1`, `g2` and `g3` and read by `@fail` (SIGNATURE-ORDER-01). The generated
       // `reset()` clears the state and not this field.
       boolean creationObserved = false;

       // Set by the refused creation `g3` and never cleared. `@fail` reads it to report a failure
       // of a signature whose two-argument `getInstance` asked for an algorithm the rule refuses
       // under the `creation-refused` code (SIGNATURE-ORDER-02): the `ere` admits no use of such
       // a signature, so its ordering failure is the consequence of the refusal and not an order
       // the program chose. The one-argument `g1` accepts every algorithm and does not set it.
       // The generated `reset()` clears the state and not this field.
       boolean creationRefused = false;

       // `g1: getInstance(algorithm);` of Signature.crysl, one alternative of
       // `Get := g1 | g2`, over the one-argument overload. It records that a creation was
       // seen and applies no guard: the rule states the algorithm under CONSTRAINTS and not
       // in its ORDER, so `getInstance` is a `Get` whatever it was asked for, and the
       // algorithm is reported at the four init events instead, each under a code of its own
       // registered in `codes.csv`.
       //
       // That placement is what keeps the two findings apart. An event matching this call
       // under a negated guard would name no state of the `ere`, and the generator gives an
       // event absent from the automaton a transition row that moves every state to the fail
       // state: a signature built with an algorithm the rule refuses would be reported as a
       // wrong call sequence, and the `initSign` or `initVerify` that followed would be
       // reported again, because the failing transition takes the `@fail` path, which
       // `__RESET`s the monitor to the start state, where no init event is declared.
       //
       // Behaviour that follows: a `getInstance(String)` whose algorithm the rule refuses and
       // which is never initialised draws no algorithm report, because that report lives in
       // the init bodies.
       event g1 after(String alg) returning(Signature s):
         call(public static Signature Signature.getInstance(String)) &&
         args(alg) {
           creationObserved = true;
       }

       // `g2: getInstance(algorithm, _);` of Signature.crysl, the other alternative of `Get`.
       // `Object+` covers both two-argument `getInstance` overloads the platform declares --
       // `(String, String)` for the provider's name and `(String, Provider)` for the object --
       // in one pointcut, so no second event is spent on the same label; an object obtained
       // through an overload the pointcut did not cover would reach its next event with the
       // monitor at the start state, where every row is `fail`. It is `Object+` and not `..`
       // on purpose: the trace harness's resolver walks the declared parameter types of a
       // `call(...)` signature and stops at the first wildcard, so a wildcard here would make
       // every `getInstance` fit this pointcut, while `Object+` keeps the arity known and the
       // second position typed.
       //
       // This event carries the CONSTRAINTS allow-list as a `condition(...)` guard, so it
       // takes the transition only for an algorithm the clause admits. A guard compiles to an
       // early return ahead of both the body and the transition, and it is tolerable here
       // only because the refused branch is not dropped: `g3` below matches the same call
       // under the negated guard, so no creation falls out of the automaton unseen.
       event g2 after(String alg, Object provider) returning(Signature s):
         call(public static Signature Signature.getInstance(String, Object+)) &&
         args(alg, provider) &&
         condition(ConscryptAliasTable.matches("Signature", alg, algorithms)) {
           creationObserved = true;
       }

       // The refused twin of `g2`: the two-argument `getInstance` with `g2`'s pointcut and `args`,
       // under the negated allow-list guard. A false `condition(...)` runs no body, so without
       // this event a refused algorithm requested with a provider matches no event, and the first
       // use of the signature reads `creation-unobserved` although its creation ran in woven code.
       // The body only records the creation: it reports nothing and writes no field another event
       // reads. In the `ere` it is the Kleene prefix `g3*` before `(g1 | g2)`, so after it every
       // use of the signature fails at the same event it fails at when no creation event fires.
       // No reported site changes; only the code `@fail` chooses does, which is
       // `creation-refused`.
       event g3 after(String alg, Object provider) returning(Signature s):
         call(public static Signature Signature.getInstance(String, Object+)) &&
         args(alg, provider) &&
         condition(!ConscryptAliasTable.matches("Signature", alg, algorithms)) {
           creationObserved = true;
           creationRefused = true;
       }

       // `i1: initSign(privateKey);` of Signature.crysl, one alternative of
       // `InitSign := i1 | i2`.
       //
       // CONSTRAINTS, the algorithm allow-list, is checked here against the algorithm the
       // instance reports, because the one-argument creation event applies no guard. Both
       // this check and the predicate read sit in the event body and not in a
       // `condition(...)` guard: a guard compiles to an early return ahead of both the body
       // and the transition, so a signature built with a refused algorithm, or initialised
       // with a key of unknown origin, would leave the automaton in the state before
       // `initSign` and the next call would be reported as a wrong call sequence instead of
       // as the misuse it is.
       //
       // REQUIRES `generatedPrivkey[privateKey]`: the private key was produced by a call the
       // instrumentation observed. It is the rule's own clause and not `generatedKey`, which
       // this rule never names, so a secret key has no business answering it. SATISFIED is
       // silent and the call conforms. VIOLATED is positive evidence about this key -- a
       // producing call was observed and what it established is not what the clause demands
       // -- and draws this site's constraint code. NOT_OBSERVED means nothing about the key
       // was ever recorded: it was built where the instrumentation does not reach, or it is
       // `null`, over which the store answers NOT_OBSERVED rather than throwing inside the
       // application under test. That is a reach limit as often as it is a misuse, so it
       // draws a code of its own. The producers inside this set are `KeyPairSpec`, at the
       // call that hands out the private half of a generated pair, `KeyFactorySpec`, at its
       // `generatePrivate` event, and `KeyStoreSpec`, at its acceptance point when the
       // retrieved key is a `PrivateKey`.
       event i1 before(PrivateKey privateKey, Signature s):
         call(public void Signature.initSign(PrivateKey)) &&
         args(privateKey) &&
         target(s) {
           if (!ConscryptAliasTable.matches("Signature", s.getAlgorithm(), algorithms)) {
              ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SignatureSpec", "" + __LOC,
                  "v=1 code=SIGNATURE-ALG-00 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + s.getAlgorithm() + "'"));
           }
           PredicateVerdict origin = PredicateStore.instance().validate(Property.GENERATED_PRIVATE_KEY, privateKey);
           if (origin == PredicateVerdict.VIOLATED) {
              ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                  "v=1 code=SIGNATURE-CONSTR-00 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPrivateKey) + "' msg='the private key given to initSign carries a key-origin predicate the rule does not admit'"));
           }
           else if (origin == PredicateVerdict.NOT_OBSERVED) {
              ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                  "v=1 code=SIGNATURE-NOBS-00 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPrivateKey) + "' msg='no generator of the private key given to initSign was observed'" + Evidence.keysFor(privateKey)));
           }
        }

       // `i2: initSign(privateKey, _);` of Signature.crysl, the other alternative of
       // `InitSign`, over the overload that also takes a `SecureRandom`. The rule leaves that
       // position anonymous and states no clause over it, so the argument is bound only to
       // match the overload and the body says nothing about it.
       //
       // The same two checks as at `i1`, each under a code of its own because a code names a
       // site and not a clause: CONSTRAINTS, the algorithm allow-list, against the algorithm
       // the instance reports; and REQUIRES `generatedPrivkey[privateKey]` -- the private key
       // was produced by a call the instrumentation observed. SATISFIED is silent, VIOLATED
       // is positive evidence about the key, and NOT_OBSERVED means nothing about it was
       // recorded, which is the reach limit of the weaving as often as it is a misuse. Both
       // sit in the body and not in a `condition(...)` guard, for the reason `i1` states.
       event i2 before(PrivateKey privateKey, SecureRandom random, Signature s):
         call(public void Signature.initSign(PrivateKey, SecureRandom)) &&
         args(privateKey, random) &&
         target(s) {
              if (!ConscryptAliasTable.matches("Signature", s.getAlgorithm(), algorithms)) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-ALG-01 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + s.getAlgorithm() + "'"));
        }
              PredicateVerdict origin = PredicateStore.instance().validate(Property.GENERATED_PRIVATE_KEY, privateKey);
              if (origin == PredicateVerdict.VIOLATED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-CONSTR-01 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPrivateKey) + "' msg='the private key given to initSign carries a key-origin predicate the rule does not admit'"));
        }
              else if (origin == PredicateVerdict.NOT_OBSERVED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-NOBS-01 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPrivateKey) + "' msg='no generator of the private key given to initSign was observed'" + Evidence.keysFor(privateKey)));
        }
        }

       // `i3: initVerify(cert);` of Signature.crysl, one alternative of
       // `InitVerify := i3 | i4`.
       //
       // CONSTRAINTS, the algorithm allow-list, is checked here as at the other init events,
       // in the body and not in a `condition(...)` guard.
       //
       // No predicate is read. The rule's `generatedPubkey[publicKey]` names `publicKey`,
       // which this call does not pass, and the rule states no clause over its `cert`, so
       // there is no object here a clause is about: a verification set up from a certificate
       // has its key origin unchecked.
       event i3 before(Certificate cert, Signature s):
         call(public void Signature.initVerify(Certificate)) &&
         args(cert) &&
         target(s) {
           if (!ConscryptAliasTable.matches("Signature", s.getAlgorithm(), algorithms)) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-ALG-02 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + s.getAlgorithm() + "'"));
        }
        }

       // `i4: initVerify(publicKey);` of Signature.crysl, the other alternative of
       // `InitVerify`, and the one site of REQUIRES `generatedPubkey[publicKey]`.
       //
       // CONSTRAINTS, the algorithm allow-list, is checked here as at the other init events.
       // Both it and the predicate read sit in the body and not in a `condition(...)` guard:
       // a guard compiles to an early return ahead of both the body and the transition, so
       // the offending call would leave the automaton in the state before `initVerify` and
       // the next call would be reported as a wrong call sequence instead of as the misuse it
       // is.
       //
       // REQUIRES `generatedPubkey[publicKey]`: the public key was produced by a call the
       // instrumentation observed. SATISFIED is silent and the call conforms. VIOLATED is
       // positive evidence about this key and draws this site's constraint code.
       // NOT_OBSERVED means nothing about the key was ever recorded -- it was decoded where
       // the instrumentation does not reach, or it is `null`, over which the store answers
       // NOT_OBSERVED rather than throwing -- which is a reach limit as often as it is a
       // misuse, so it draws a code of its own. The producers inside this set are
       // `KeyFactorySpec`, at its `generatePublic` event, and `KeyPairSpec`, at the call that
       // hands out the public half of a generated pair.
       //
       // The NOT_OBSERVED branch first asks for `REPORTED_UPSTREAM` over the same key: the
       // object's producer already reported it, so a later site that finds no predicate for
       // it is looking at a refusal upstream and not at a gap in instrumentation reach. A key
       // that carries the mark -- one a key factory already refused -- therefore draws the
       // upstream-refused code instead of the not-observed one. Both codes are registered in
       // `codes.csv`.
       event i4 before(PublicKey key, Signature s):
         call(public void Signature.initVerify(PublicKey)) &&
         args(key) &&
         target(s) {
              if (!ConscryptAliasTable.matches("Signature", s.getAlgorithm(), algorithms)) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeAlgorithm, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-ALG-03 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(String.join(",", algorithms)) + "' msg='expecting one of " + String.join(",", algorithms) + " but found " + s.getAlgorithm() + "'"));
        }
              PredicateVerdict origin = PredicateStore.instance().validate(Property.GENERATED_PUBLIC_KEY, key);
              if (origin == PredicateVerdict.VIOLATED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-CONSTR-02 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPublicKey) + "' msg='the public key given to initVerify carries a key-origin predicate the rule does not admit'"));
        }
              else if (origin == PredicateVerdict.NOT_OBSERVED && PredicateStore.instance().validateAny(Property.REPORTED_UPSTREAM, key) == PredicateVerdict.SATISFIED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-NOBS-03 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPublicKey) + "' msg='the public key given to initVerify was already reported upstream'" + Evidence.keysFor(key)));
        }
              else if (origin == PredicateVerdict.NOT_OBSERVED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SignatureSpec", "" + __LOC,
                   "v=1 code=SIGNATURE-NOBS-02 ev=" + __EVENTNAME + " obj=Signature val='" + q(s.getAlgorithm()) + "' exp='" + q(expectedPublicKey) + "' msg='no generator of the public key given to initVerify was observed'" + Evidence.keysFor(key)));
        }
        }

       // `Update := u1 | u2 | u3 | u4` of Signature.crysl -- `update(input)`,
       // `update(inputByte)`, `update(input, offset, len)` and `update(inputByteBuffer)` --
       // fused into one event by a pointcut that matches every `update` overload, which makes
       // one letter of the automaton for all four. The rule's ORDER treats the four alike, so
       // the fusion costs it nothing.
       //
       // The pointcut binds no argument and the body is empty, so the rule's three length
       // clauses -- `length[input] >= offset + len;`, `offset >= 0;` and `len > 0;` -- have
       // no site: this specification does not check them, here or anywhere else.
       event update before(Signature s):
         call(public void Signature.update(..)) &&
         target(s) {

        }

       // `s1: output = sign();` of Signature.crysl, one alternative of `Sign := s1 | s2`, and
       // a staging site for ENSURES `signed[output, inputByte] after Sign` together with its
       // two twins, `signed[output, input] after Sign` and
       // `signed[output, inputByteBuffer] after Sign`, which name the same `output` against
       // the other two input shapes.
       //
       // The clause carries an `after L`, so its acceptance point is the state the `Sign`
       // events lead to, which is inside this specification's accepting set and is where
       // `@match` runs. The array cannot be written from there directly: a handler receives
       // no event arguments and runs after the transition is decided, so this event stages
       // the array the call returned in a field and the handler writes the predicate from it.
       //
       // The clause names two places -- the signature and the input it was computed over --
       // and this site records one: the bytes are a signature a monitored `Signature`
       // produced. No rule of the set requires `signed`, so the write has no reader and there
       // is no consumer whose second place it would have to meet.
       event s1 after(Signature s) returning(byte[] output):
         call(public byte[] Signature.sign()) &&
         target(s) {
           stagedSigned = output;
       }


       // `s2: sign(output, offset, len);` of Signature.crysl, the other alternative of
       // `Sign`, over the overload that writes into a caller-supplied array. It stages that
       // array for the same ENSURES and for the same reason `s1` states: the handler that
       // writes the predicate sees no event argument of its own. The `offset` and `len` are
       // bound to match the overload, and the rule's clauses over them are not checked here.
       event s2 after(byte[] output, int offset, int len, Signature s):
         call(public int Signature.sign(byte[], int, int)) &&
         args(output, offset, len) &&
         target(s) {
           stagedSigned = output;
       }

       // `v1: verified = verify(sign);` of Signature.crysl, one alternative of
       // `Verify := v1 | v2`, and a staging site for ENSURES
       // `verified[verified, sign] after Verify`.
       //
       // The clause names two places -- the boolean the call returned and the signature it
       // was given -- and this site records the signature: a monitored `Signature` verified
       // these signature bytes. The boolean cannot carry the mark, because the store keys
       // entries by object identity: handing it the boxed `true` would mark the instance the
       // whole JVM caches, and a read over any other `true` would then answer SATISFIED for
       // an object this program never verified.
       //
       // The clause's acceptance point is the state the `Verify` events lead to, which is
       // inside the accepting set and is where `@match` runs. The array reaches the handler
       // through a field because a handler receives no event arguments and runs after the
       // transition is decided. No rule of the set requires `verified`, so the write has no
       // reader.
       event v1 after(byte[] sign, Signature s) returning(boolean signed):
         call(public boolean Signature.verify(byte[])) &&
         args(sign) &&
         target(s) {
           stagedVerified = sign;
       }


       // `v2: verified = verify(sign, offset, len);` of Signature.crysl, the other
       // alternative of `Verify`, over the overload that names a range inside the signature
       // array. It stages the same array for the same ENSURES and for the same reason `v1`
       // states. The `offset` and `len` are bound to match the overload, and the rule's
       // clauses over them are not checked here.
       event v2 after(byte[] sign, int offset, int len, Signature s) returning(boolean signed):
         call(public boolean Signature.verify(byte[], int, int)) &&
         args(sign, offset, len) &&
         target(s) {
            stagedVerified = sign;
       }

       // The rule's ORDER: `Get, ((InitSign+, (Update+, Sign+)+ )+ | (InitVerify+, (Update*,
       // Verify+)+ )+ )`. A signature is obtained once and then used for signing or for
       // verifying, never for both; update calls are required before a signature and optional
       // before a verification, exactly as the rule writes it.
       //
       // The leading `g3*` is the refused two-argument creation, which takes no other
       // position in the language: after it, every use of the signature fails at the same
       // event it would fail at if no creation event had fired at all, and `@fail` reports it
       // under the creation-refused code rather than the creation-unobserved one.
       ere: g3* (g1 | g2) ( ((i1 | i2)+ (update+ (s1 | s2)+)+)+ | ((i3 | i4)+ (update* (v1 | v2)+)+)+ )

       // Reached whenever the automaton cannot take the next event from the state it is in.
       // Three codes, all registered in `codes.csv`: the plain wrong-call-sequence code; one
       // for a signature whose `getInstance` was never seen, which is a reach limit of the
       // instrumentation and not a misuse; and one for a signature whose two-argument
       // creation this specification refused, whose ordering failure is the consequence of
       // that refusal and not an order the program chose. Both staged arrays are discarded,
       // so no predicate is written for a sequence the automaton refused, and `__RESET`
       // returns the monitor to the start state.
       @fail {
          if (!creationObserved) {
              ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SignatureSpec", "" + __LOC,
                  "v=1 code=SIGNATURE-ORDER-01 ev=" + __EVENTNAME + " obj=Signature val='' exp='' msg='the observed call sequence is not one SignatureSpec accepts, and no getInstance of this Signature was observed'"));
          }
          else if (creationRefused) {
              ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SignatureSpec", "" + __LOC,
                  "v=1 code=SIGNATURE-ORDER-02 ev=" + __EVENTNAME + " obj=Signature val='' exp='' msg='the observed call sequence is not one SignatureSpec accepts, after a creation the specification refused'"));
          }
          else {
              ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SignatureSpec", "" + __LOC,
                  "v=1 code=SIGNATURE-ORDER-00 ev=" + __EVENTNAME + " obj=Signature val='' exp='' msg='the observed call sequence is not one SignatureSpec accepts'"));
          }
          stagedSigned = null;
          stagedVerified = null;
          __RESET;
       }

       // The acceptance point of both ENSURES clauses. `signed` is written over the array a
       // `sign` event staged -- the bytes are a signature a monitored `Signature` produced --
       // and `verified` over the array a `verify` event staged -- a monitored `Signature`
       // verified these signature bytes. Each field is cleared as it is consumed, so a
       // handler run writes only what its own event staged; the generated dispatcher
       // recomputes the state categories after every event and calls this handler whenever
       // the category holds, so it can run several times in one trace.
       //
       // Neither predicate has a reader: no rule of the set requires `signed` or `verified`,
       // so both writes record a fact that nothing consumes, and a reader of this
       // specification must not take them for checks.
       @match {
          if (stagedSigned != null) {
              PredicateStore.instance().ensure(Property.SIGNED, stagedSigned);
              stagedSigned = null;
          }
          if (stagedVerified != null) {
              PredicateStore.instance().ensure(Property.VERIFIED, stagedVerified);
              stagedVerified = null;
          }
       }

}
