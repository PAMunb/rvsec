package mop;

import javax.crypto.spec.PBEKeySpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * PBEKeySpecSpec
 *
 * Monitors javax.crypto.spec.PBEKeySpec against the CrySL rule PBEKeySpec.crysl.
 *
 * The rule's ORDER is `Con, ClearPass`: construct the key spec with
 * `PBEKeySpec(password, salt, iterationCount, keyLength)`, then clear the password. The rule
 * FORBIDS the two shorter constructors -- `PBEKeySpec(char[]) => Con` and
 * `PBEKeySpec(char[],byte[],int) => Con` -- and this specification declares an event for each,
 * so that such a call is reported where it happens. It checks the CONSTRAINTS clause
 * `iterationCount >= 10000`, REQUIRES `randomized[salt]`, ENSURES
 * `speccedKey[this, keyLength] after Con`, and NEGATES `speccedKey[this, _] after ClearPass`,
 * which is the one predicate negation in this set.
 *
 * Two CONSTRAINTS clauses are not checked, and cannot be from an `after ... returning` advice
 * over a constructor: `neverTypeOf[password, java.lang.String]` and `notHardCoded[password]`
 * are claims about where the `char[]` came from in the program text, which a monitor that sees
 * one call and its arguments has no way to decide.
 *
 * Reach limit of the ordering: absorbing a forbidden constructor into the automaton silences
 * the ordering report at the forbidden call itself, but not at the obligatory call that
 * follows it. A program that builds a PBEKeySpec with `PBEKeySpec(char[])` and then calls
 * `clearPassword()` draws an ordering report on top of the forbidden-method one, under the
 * code that says the creation was one this specification refused.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/PBEKeySpec.crysl
 */
PBEKeySpecSpec(PBEKeySpec s) {

        // Set by the creation events `f1`, `f2` and `c1`. The generated `reset()` does not clear
        // it, so every failure of a monitor that saw no creation reports the `-ORDER-01` code in
        // `@fail`.
        boolean creationObserved = false;

        // Set by the forbidden creations `f1` and `f2` and never cleared. `@fail` reads it to
        // report a failure of a spec built by a constructor the rule forbids under the `-ORDER-02`
        // code (`creation-refused`): the ordering has no opening for such a spec, so its failure
        // is the consequence of the FORB report the constructor already drew. The generated
        // `reset()` does not clear it.
        boolean creationRefused = false;

        // `f1` and `f2` are the rule's two FORBIDDEN entries, each given an event of its own:
        // each accuses a constructor the rule turns down outright, which is a report in its own
        // right and not the negation of another event's guard. They enter the automaton through
        // the Kleene groups of the `ere` below, at every position, because the ordering has
        // nothing to say about a call the rule refuses. An event left outside the automaton
        // carries an all-`fail` transition row, so one forbidden construction anywhere in a
        // program would push every live PBEKeySpec monitor into `fail`, accusing objects that
        // had done nothing wrong.
        //
        // Both bind the specification parameter, like `c1` below: on a `call` to a constructor
        // the returned value is the object being built, so `returning(PBEKeySpec s)` names the
        // very spec the event accuses. Without it the events name no `PBEKeySpec`, the generator
        // hands them the parameterless map, and each body runs once on the root monitor and once
        // on every live monitor of the specification -- a set-wide broadcast where the rule
        // accuses one construction. What the binding buys is per-object trace semantics; the
        // `ErrorCollector` deduplicates on the site, so it does not change how many rows a
        // program draws.
        //
        // FORBIDDEN `PBEKeySpec(char[]) => Con`: the one-argument constructor, which supplies
        // neither salt nor iteration count. It is reported under the forbidden-method code
        // registered in `codes.csv` for this site, and it sets `creationRefused`, which `@fail`
        // reads so that the ordering failure such a construction leads to says the creation was
        // one this specification refused.
        event f1 after(char[] password) returning(PBEKeySpec s):
          call (public PBEKeySpec.new(char[])) &&
          args(password) {
            creationObserved = true;
            creationRefused = true;
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.ForbiddenMethod, "PBEKeySpecSpec", "" + __LOC,
                "v=1 code=PBEKEYSPEC-FORB-00 ev=" + __EVENTNAME + " obj=PBEKeySpec val='' exp='PBEKeySpec(char[], byte[], int, int)' msg='PBEKeySpec(char[]) is forbidden by the expert PBEKeySpec.crysl'"));
        }

        // FORBIDDEN `PBEKeySpec(char[],byte[],int) => Con`: the three-argument constructor,
        // which supplies salt and iteration count but no key length. Reported under a code of
        // its own, because a code names a site, and like `f1` it sets `creationRefused`.
        event f2 after(char[] password, byte[] salt, int keyLength) returning(PBEKeySpec s):
          call (public PBEKeySpec.new(char[], byte[], int)) &&
          args(password, salt, keyLength) {
            creationObserved = true;
            creationRefused = true;
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.ForbiddenMethod, "PBEKeySpecSpec", "" + __LOC,
                "v=1 code=PBEKEYSPEC-FORB-01 ev=" + __EVENTNAME + " obj=PBEKeySpec val='' exp='PBEKeySpec(char[], byte[], int, int)' msg='PBEKeySpec(char[], byte[], int) is forbidden by the expert PBEKeySpec.crysl'"));
        }

        // `Con`: `c1: PBEKeySpec(password, salt, iterationCount, keyLength)`, the rule's one
        // admitted constructor and the opening of its ORDER.
        //
        // CONSTRAINTS `iterationCount >= 10000`, checked first in the body. A lower count draws
        // the constraint code registered in `codes.csv` for this site and clears `conforms`. The
        // rule's other two CONSTRAINTS clauses, `neverTypeOf[password, java.lang.String]` and
        // `notHardCoded[password]`, are claims about where the password array came from in the
        // program text, which an advice over one call cannot decide; they are not checked here.
        //
        // REQUIRES `randomized[salt]`: the object came from a SecureRandom the instrumentation
        // observed -- the generator itself, or bytes it produced. The read is three-valued.
        // SATISFIED is silent. VIOLATED is positive evidence about this array -- an entry exists
        // and is not what the clause demands -- and draws the constraint code. NOT_OBSERVED
        // means no entry at all: no randomised source of the array was ever seen, which on this
        // platform is as often a limit of what the weaving reaches as a misuse, so it draws a
        // code of its own. The array is compared by identity, so only the very array a monitored
        // SecureRandom filled carries the mark; a copy of it does not. The clause is about the
        // salt alone -- the rule requires nothing of the password.
        //
        // Both checks sit in the event body and not in a `condition(...)` guard: a guard
        // compiles to an early return ahead of both the body and the transition, so a
        // construction with a low count or an unwatched salt would leave the automaton in the
        // state before the constructor, and the `clearPassword()` that followed would be
        // reported as a wrong call sequence instead of as the misuse the construction was.
        //
        // ENSURES `speccedKey[this, keyLength] after Con`: the key spec was constructed by a
        // call the instrumentation observed and the rule admitted, and the value place carries
        // the key length the rule names. The clause is qualified `after Con`, so it holds at the
        // state `Con` leads to. This specification is stated as an `ere`, and the ERE notation
        // generates exactly one alias, `match`, over the accepting states -- which here is the
        // state after `clearPassword()`, where the rule negates the predicate rather than
        // establishing it. So the write is made in this body, at the event the clause names, and
        // made only where every clause held.
        //
        // A construction this body reports on is marked REPORTED_UPSTREAM instead: the object's
        // producer already reported it, so a later site that finds no predicate for it is
        // looking at a refusal upstream and not at a gap in instrumentation reach. The readers
        // of `speccedKey` -- `generateSecret` in `SecretKeyFactorySpec`, and `generatePrivate`
        // and `generatePublic` in `KeyFactorySpec` -- consume that mark and report such a spec
        // as refused upstream rather than as not observed. The salt read here is not a consumer
        // of the mark: no producer of `randomized` marks what it refuses, so NOT_OBSERVED keeps
        // its own code.
        event c1 after(char[] password, byte[] salt, int iterationCount, int keyLength) returning(PBEKeySpec s):
          call(public PBEKeySpec.new(char[], byte[], int, int)) &&
          args(password, salt, iterationCount, keyLength) {
           creationObserved = true;
           boolean conforms = true;
           if (iterationCount < 10000) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEKeySpecSpec", ""  + __LOC,
                   "v=1 code=PBEKEYSPEC-CONSTR-00 ev=" + __EVENTNAME + " obj=PBEKeySpec val='" + iterationCount + "' exp='>= 10000' msg='the third argument should be >= 10000'"));
               conforms = false;
           }
           // REQUIRES `randomized[salt]`, read here in the body: VIOLATED is positive evidence
           // about the array, NOT_OBSERVED says only that no randomised source of it was ever
           // seen, and the two draw different codes.
           PredicateVerdict randomisedSalt = PredicateStore.instance().validate(Property.RANDOMIZED, salt);
           if (randomisedSalt == PredicateVerdict.VIOLATED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEKeySpecSpec", "" + __LOC,
                   "v=1 code=PBEKEYSPEC-CONSTR-02 ev=" + __EVENTNAME + " obj=PBEKeySpec val='' exp='a randomized byte[]' msg='the second argument carries a randomization predicate the rule does not admit'"));
               conforms = false;
           }
           else if (randomisedSalt == PredicateVerdict.NOT_OBSERVED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEKeySpecSpec", "" + __LOC,
                   "v=1 code=PBEKEYSPEC-NOBS-01 ev=" + __EVENTNAME + " obj=PBEKeySpec val='' exp='a randomized byte[]' msg='the second argument was not observed to come from a randomized source'" + Evidence.keysFor(salt)));
               conforms = false;
           }
           if (conforms) {
               PredicateStore.instance().ensure(Property.SPECCED_KEY, s, keyLength);
           }
           else {
               PredicateStore.instance().ensure(Property.REPORTED_UPSTREAM, s);
           }
        }

        // `ClearPass`: `cp1: clearPassword()`, the second half of the rule's ORDER.
        //
        // NEGATES `speccedKey[this, _] after ClearPass` -- the one predicate negation in this
        // set. The store remembers the negation instead of forgetting the entry, so a later
        // read of a cleared spec answers VIOLATED and not NOT_OBSERVED: the store positively
        // knows the predicate does not hold, which is what the clause states. The negation is
        // written in the body because the clause names this event, and the object it names is
        // the monitored spec, which the event binds.
        //
        // The readers that see it are `generateSecret` in `SecretKeyFactorySpec`, whose rule
        // REQUIRES `speccedKey[keySpec, _]`, and `generatePrivate` and `generatePublic` in
        // `KeyFactorySpec`, whose rule requires the same of the spec it decodes. A spec whose
        // password was cleared and which is then handed to one of them is therefore accused under
        // the verdict for a predicate the store saw negated, not under the one for a predicate it
        // never saw.
        event c2 after(PBEKeySpec s):
	      call(public void PBEKeySpec.clearPassword()) &&
          target(s) {
            PredicateStore.instance().negate(Property.SPECCED_KEY, s);
        }

        // `ORDER Con, ClearPass`, with the two forbidden constructors absorbed into the Kleene
        // groups: a call the rule refuses outright is reported by its own event and left
        // otherwise free in the ordering, because the ordering has nothing to say about it.
        //
        // Reach limit, stated as behaviour: absorbing a forbidden constructor silences the
        // ordering report at the forbidden call itself, but not at the obligatory call that
        // follows it. A program that builds a PBEKeySpec with `PBEKeySpec(char[])` and then
        // calls `clearPassword()` still reaches `c2` from a state where `c1` never happened, and
        // still draws an ordering report on top of the forbidden-method one the constructor
        // already earned, under the code that says the creation was refused -- `f1` set
        // `creationRefused`. Silencing it would mean modelling `f1` as an alternative opening of
        // the ordering, which is the opposite of what FORBIDDEN says.
        ere : (f1 | f2)* c1 (f1 | f2)* c2 (f1 | f2)*

        // Unlike the constructor-only specifications of this set, this handler can fire: the
        // ordering has two obligatory events, so a spec whose password is cleared without a
        // construction having been observed, or one constructed twice, reaches it. The three
        // branches are three different claims about the same failure -- no creation observed at
        // all, a creation this specification refused, or a plain wrong call sequence -- and each
        // carries its own code in `codes.csv`.
        @fail {
          if (!creationObserved) {
             ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "PBEKeySpecSpec", "" + __LOC,
                 "v=1 code=PBEKEYSPEC-ORDER-01 ev=" + __EVENTNAME + " obj=PBEKeySpec val='' exp='' msg='the observed call sequence is not one PBEKeySpecSpec accepts and no creation of the PBEKeySpec was observed'"));
          }
          else if (creationRefused) {
             ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "PBEKeySpecSpec", "" + __LOC,
                 "v=1 code=PBEKEYSPEC-ORDER-02 ev=" + __EVENTNAME + " obj=PBEKeySpec val='' exp='' msg='the observed call sequence is not one PBEKeySpecSpec accepts, after a creation the specification refused'"));
          }
          else {
             ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "PBEKeySpecSpec", "" + __LOC,
                 "v=1 code=PBEKEYSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=PBEKeySpec val='' exp='' msg='the observed call sequence is not one PBEKeySpecSpec accepts'"));
          }
          __RESET;
        }


}
