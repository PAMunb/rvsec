package mop;

import javax.crypto.spec.PBEKeySpec;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * PBEKeySpecSpec
 *
 * A JavaMOP specification of the correct usage of the
 * javax.crypto.spec.PBEKeySpec
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/PBEKeySpec.crysl
 */
PBEKeySpecSpec(PBEKeySpec s) {

        // `f1` and `f2` are absorbed, not fused: each accuses a constructor the
        // rule FORBIDS outright, which is a report of its own and not the negation
        // of another event's guard. They enter the automaton through the Kleene
        // groups of the `ere` below, at every position, because the ordering has
        // nothing to say about a call the rule turns down.
        //
        // Absorbing them matters more here than the noise argument alone suggests.
        // Left outside the automaton they carried an all-`fail` transition row, so one
        // forbidden construction anywhere in a program pushed *every* live PBEKeySpec
        // monitor into `fail`, accusing objects that had done nothing wrong.
        //
        // Both bind the specification parameter, like `c1` below: on a `call` to a
        // constructor the returned value is the object being built, so
        // `returning(PBEKeySpec s)` names the very spec the event accuses. Without it
        // the events named no `PBEKeySpec`, the generator handed them the parameterless
        // map (`PBEKeySpecSpec__Map`, `stateTransitionedSet.event_f1`) and each ran its
        // body once on the root monitor and once on every live monitor of the
        // specification -- a set-wide broadcast where the rule accuses one construction.
        // The `ErrorCollector` dedups on (spec, code, event, class, method, location),
        // so the copies collapsed to one row and the fan-out never showed in the record;
        // what the binding buys is per-object trace semantics, not fewer reports.
        event f1 after(char[] password) returning(PBEKeySpec s):
          call (public PBEKeySpec.new(char[])) &&
          args(password) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.ForbiddenMethod, "PBEKeySpecSpec", "" + __LOC,
                "v=1 code=PBEKEYSPEC-FORB-00 ev=" + __EVENTNAME + " obj=PBEKeySpec val='' exp='PBEKeySpec(char[], byte[], int, int)' msg='PBEKeySpec(char[]) is forbidden by api30 PBEKeySpec.cryptsl'"));
        }

        event f2 after(char[] password, byte[] salt, int keyLength) returning(PBEKeySpec s):
          call (public PBEKeySpec.new(char[], byte[], int)) &&
          args(password, salt, keyLength) {
            ErrorCollector.instance().addError(new ErrorDescription(ErrorType.ForbiddenMethod, "PBEKeySpecSpec", "" + __LOC,
                "v=1 code=PBEKEYSPEC-FORB-01 ev=" + __EVENTNAME + " obj=PBEKeySpec val='' exp='PBEKeySpec(char[], byte[], int, int)' msg='PBEKeySpec(char[], byte[], int) is forbidden by api30 PBEKeySpec.cryptsl'"));
        }

        // One event over `PBEKeySpec(char[], byte[], int, int)`, where there used to
        // be four. `err1`, `err2` and `err3` matched the same call with the same
        // `args`, each negating one conjunct of this event's guard, and none of them
        // named a state in the `ere`. They are three of the 17 orphan accusers, and
        // they fuse into one arrow (INV-INS-135) rather than being absorbed as three
        // more events: four events matching one construction would take four
        // transitions.
        //
        // The guard was a conjunction and the negations were per-conjunct, so the
        // fused body decomposes the same way -- three independent tests, one report
        // per violated clause, which is what the three orphans emitted between them.
        // What leaves is the ordering noise: each orphan sat outside the automaton
        // with an all-`fail` transition row, so a construction that broke all three
        // clauses drew three PBEKEYSPEC-ORDER-00 on top of the three constraint
        // reports, and the `clearPassword()` that followed drew a fourth, because the
        // failing `c1` had never moved the monitor off `start`.
        //
        // Two of those three tests were predicate reads, and a predicate read carries a
        // three-valued verdict, because the two accusing outcomes are different claims:
        // VIOLATED is positive evidence that the array carries a randomisation predicate
        // that was withdrawn, while NOT_OBSERVED says only that no randomised source of
        // it was ever seen -- on Android as often a reach limit of the instrumentation as
        // a misuse. Both messages already said the second thing; the split makes the
        // code say what the message always meant.
        //
        // Two tests are left, and the middle clause is the one that went. It read
        // `randomized[password]` and translated no clause of the rule: api30 REQUIRES
        // `randomized[salt]` and says nothing about the password, whose only CONSTRAINTS
        // clause is `neverTypeOf(password, java.lang.String)` -- a different claim. It
        // was the standing allow-list finding against `err2`, and the fusion moved the
        // accusation without repairing it. Task 5.4 removed it, on the measurement the
        // block above the surviving read states in full: over the whole set nothing
        // ENSURES `randomized` over a `char[]`, so the read could only ever answer
        // NOT_OBSERVED, and it accused every construction of a PBEKeySpec, the
        // conforming ones included. Its two codes, PBEKEYSPEC-CONSTR-01 and
        // PBEKEYSPEC-NOBS-00, left `codes.csv` with it, and the siblings kept their
        // numbers because a code is an identifier in measurements already published.
        // What survives here is the salt read, three-valued for the reason above.
        //
        // Where the write lands, and why it stays here (INV-INS-134's recorded
        // reason). api30 qualifies the clause -- `speccedKey[this, keylength] after
        // c1` -- so the acceptance point is the state `c1` leads to. This file states
        // its automaton as an `ere`, and the ERE plugin generates exactly one alias,
        // `match`, over the accepting states: here that is the state after `c2`, which
        // is where the rule NEGATES the predicate rather than ensuring it. Naming the
        // post-`c1` state needs the `fsm` notation, and making it a `match` alias
        // would also make the specification accept `c1` alone -- a sequence the rule's
        // `ORDER c1, cP` rejects, measured against the gate's own DFA. Measured on the
        // other side: no constructible program makes this transition fail for the
        // object it binds, because the constructor returns a fresh object each call
        // and `f1`/`f2` are loops, so the body and the state after it coincide on
        // every trace. The write stays here with this reason recorded in
        // predicate_graph.csv, at the rule's arity: the object and the key length.
        event c1 after(char[] password, byte[] salt, int iterationCount, int keyLength) returning(PBEKeySpec s):
          call(public PBEKeySpec.new(char[], byte[], int, int)) &&
          args(password, salt, iterationCount, keyLength) {
           boolean conforms = true;
           if (iterationCount < 10000) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEKeySpecSpec", ""  + __LOC,
                   "v=1 code=PBEKEYSPEC-CONSTR-00 ev=" + __EVENTNAME + " obj=PBEKeySpec val='" + iterationCount + "' exp='>= 10000' msg='the third argument should be >= 10000'"));
               conforms = false;
           }
           // The read of `randomized[password]` that stood here is gone, and what it was
           // is worth stating because it was the file's loudest report. api30 REQUIRES
           // `randomized[salt]` and nothing about the password -- its only CONSTRAINTS
           // clause about it is `neverTypeOf(password, java.lang.String)`, a different
           // claim -- so the read translated no clause. Measured against the oracle and
           // against the set: `randomized` is ENSURED over four objects only
           // (`this` at SecureRandom, `genSeed`, `next`, `numB`), none of them a
           // `char[]`, and none of the set's six writes of RANDOMIZED binds one either.
           // The read could therefore answer only NOT_OBSERVED, on every program, so
           // PBEKEYSPEC-NOBS-00 fired at every construction of a PBEKeySpec, the
           // conforming ones included -- and, because it cleared `conforms`, the
           // `speccedKey` write below never ran at all. It was a false accuser of the
           // shape the change is here to remove, not a reach limit
           // (researcher decision, 2026-08-22).
           //
           // The two codes it emitted, PBEKEYSPEC-CONSTR-01 and PBEKEYSPEC-NOBS-00,
           // leave `codes.csv` with it. The siblings that outlive them keep their
           // numbers: a code is an identifier in measurements already published, and
           // renumbering CONSTR-02 and NOBS-01 down would rewrite what the gh104
           // campaign reported about a site that did not change.
           PredicateVerdict randomisedSalt = PredicateStore.instance().validate(Property.RANDOMIZED, salt);
           if (randomisedSalt == PredicateVerdict.VIOLATED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEKeySpecSpec", "" + __LOC,
                   "v=1 code=PBEKEYSPEC-CONSTR-02 ev=" + __EVENTNAME + " obj=PBEKeySpec val='' exp='a randomized byte[]' msg='the second argument carries a randomization predicate the rule does not admit'"));
               conforms = false;
           }
           else if (randomisedSalt == PredicateVerdict.NOT_OBSERVED) {
               ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PBEKeySpecSpec", "" + __LOC,
                   "v=1 code=PBEKEYSPEC-NOBS-01 ev=" + __EVENTNAME + " obj=PBEKeySpec val='' exp='a randomized byte[]' msg='the second argument was not observed to come from a randomized source'"));
               conforms = false;
           }
           if (conforms) {
               PredicateStore.instance().ensure(Property.SPECCED_KEY, s, keyLength);
           }
        }

        // The one real NEGATES clause of the set: `speccedKey[this, _] after cP`, at
        // the event the rule names. It reaches the new substrate here rather than in
        // its own later task, because the write it withdraws is in this file and moved
        // in this pass: a translation split across two tasks would leave the predicate
        // ensured on one substrate and withdrawn from the other, so the withdrawal
        // would be a no-op in between (researcher, 2026-08-21). The store remembers
        // the withdrawal instead of forgetting the entry, so a later read of a cleared
        // spec answers VIOLATED rather than NOT_OBSERVED -- which is what the clause
        // states. Nothing reads SPECCED_KEY in any set today, so the difference is
        // recorded rather than measured.
        //
        // Why nothing reads it, written down here because this is where the predicate
        // is produced. api30 states `speccedKey[keySpec, _]` as the one REQUIRES of
        // `SecretKeyFactory`, and that rule has no `.mop` in this set -- ledger clause
        // #31, `unmonitored-consumer`, recorded at task 5.10. Both of the oracle's
        // producers of the predicate are here (`PBEKeySpec` in this file and
        // `SecretKeySpec`, which deliberately does not write it, SecretKeySpecSpec.mop),
        // and neither has anywhere to send it. No consumer is fabricated to give the
        // write a reader, and the write stays because deleting a faithful translation of
        // a clause the oracle states would be the fabrication running the other way.
        event c2 after(PBEKeySpec s):
	      call(public void PBEKeySpec.clearPassword()) &&
          target(s) {
            PredicateStore.instance().negate(Property.SPECCED_KEY, s);
        }

        // The Kleene groups are where `f1` and `f2` are absorbed. Erased before the
        // G-ORDER comparison (they are ORDER-unmapped in order_alphabet_map.csv),
        // this is still the rule's `ORDER c1, cP`.
        //
        // Residue, recorded and not repaired: absorbing a forbidden constructor by a
        // Kleene group silences the ordering report at the forbidden call itself, but
        // not the obligatory call that follows it. A program that builds a PBEKeySpec
        // with `PBEKeySpec(char[])` and then calls `clearPassword()` still reaches
        // `c2` from a state where `c1` never happened, and still draws
        // PBEKEYSPEC-ORDER-00 on top of the PBEKEYSPEC-FORB-00 the constructor
        // already earned. Silencing that would mean modelling `f1` as an alternative
        // opening of the ordering, which is the opposite of what FORBIDDEN says.
        ere : (f1 | f2)* c1 (f1 | f2)* c2 (f1 | f2)*

        @fail {
          ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "PBEKeySpecSpec", "" + __LOC,
              "v=1 code=PBEKEYSPEC-ORDER-00 ev=" + __EVENTNAME + " obj=PBEKeySpec val='' exp='' msg='the observed call sequence is not one PBEKeySpecSpec accepts'"));
          __RESET;
        }

        // The `@match` handler that stood here held nothing but the accepting-state
        // bookkeeping the new substrate does not offer and the set never read
        // (INV-INS-147), and the `spec` field existed only to carry the object into
        // it. Both go: the write the rule does ask for names the object the event
        // already binds.

}
