package mop;

import javax.net.ssl.SSLContext;
import javax.net.ssl.SSLEngine;
import javax.net.ssl.KeyManager;
import javax.net.ssl.TrustManager;
import java.security.SecureRandom;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * SSLContextSpec
 *
 * A JavaMOP specification of the correct usage of the
 * javax.net.ssl.SSLContext class.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/SSLContext.crysl
 */
SSLContextSpec(SSLContext ctx) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

   // D-15: SSLContext.crysl states `protocol in {"TLSv1.2", "TLSv1.3"}` (the frozen jca
   // spells them upper-case; comparison folds case). `TLS` is the single platform-value
   // entry: Conscrypt binds SSLContext.TLS to the TLSv1.2/TLSv1.3 implementation
   // (OpenSSLProvider.java:81), so an app asking for it provably gets a protocol the expert
   // clause admits. `SSL` is NOT here -- Conscrypt binds it to the same implementation
   // (:80), but through a `put`, not an Alg.Alias, and asking a provider for "SSL" is the
   // misuse the rule is about (behavioural row in divergence_record.csv).
   List<String> protocols = Arrays.asList("TLSV1.2", "TLSV1.3", "TLS");
   String currentProtocol = "";

   SSLContext context;

   // `generatedSSLEngine[eng]` is over the engine the call returns, which a handler
   // cannot reach -- a handler sees no event parameter -- so the event stages it and the
   // acceptance handler consumes it, clearing the field. The `SSLEngine engine` field the
   // seed declared beside this one is gone: nothing ever assigned it.
   SSLEngine stagedEngine = null;

   String expectedGeneratedKeyManagers = "a KeyManager[] an observed KeyManagerFactory returned";

   String expectedGeneratedTrustManagers = "a TrustManager[] an observed TrustManagerFactory returned";

   // The third clause's `exp=`. It names the producer the way its siblings do, and the
   // producer here is the RANDOMIZED hub: SecureRandomSpec writes the predicate over the
   // generator itself at its own acceptance point, so what satisfies this read is a
   // SecureRandom whose construction or getInstance this instrumentation observed.
   String expectedRandomized = "a SecureRandom this instrumentation observed being created";

   // One event over `getInstance(String)`, where there used to be two split by the
   // sign of a guard. The negated twin `unsafe_protocol` matched the same call with
   // the same `args(protocol)` and named no state, and the generator gives an event
   // absent from the automaton a transition row that moves every state to `fail`: a
   // context built for a protocol the rule rejects was reported as a wrong call
   // sequence, and the `init` that followed it was reported again, because
   // `unsafe_protocol`'s failing transition had taken the `@fail` path -- which
   // `__RESET`s the monitor to `start`, where `init` is not declared.
   //
   // It was worse than a second report about one context. `unsafe_protocol` bound no
   // `SSLContext`: it was `after(String protocol)` with no `returning` and no
   // `target`, so the generator dispatched it to the whole monitor set rather than
   // to an instance, and one rejected protocol anywhere in the program pushed every
   // live SSLContextSpec monitor to `fail`.
   //
   // The rule orders `Get, Init, Engine?` (SSLContext.crysl:26) with `Get := g1 | g2` and states
   // the protocol under CONSTRAINTS, so the protocol must not govern the transition:
   // `getInstance` is a `Gets` whatever it was asked for. Dropping the guard lets the
   // rejected context reach `end` like any other, where the `init` body accuses it
   // exactly once, with SSLCONTEXT-PROTO-00. `unsafe_protocol`'s body accused nothing
   // of its own -- it only rebound `currentProtocol` -- so nothing it reported is
   // lost.
   //
   // The two-argument `g2` below lost the same guard, for the same reason and with the
   // same effect. It kept the guard when `g1` lost it only because it is not an orphan
   // and the group that repaired `g1` reached only orphans. What the guard cost is a doubled
   // report, and the harness measured it rather than the comment guessing: with the condition
   // false the dispatcher still runs `FindOrCreateEntry`, so the object holds a monitor at
   // state 0 and `init[0]` is `fail` -- while the `init` body runs anyway and accuses the
   // protocol. Side A of the pair therefore raised SSLCONTEXT-ORDER-00 *and*
   // SSLCONTEXT-PROTO-00 for one rejected context; side B raises PROTO-00 alone
   // (data/gh105/evidence/f6-SSLContextSpec-g2-guard.md).
   //
   // Residue, recorded and not repaired (divergence_record.csv): a `getInstance`
   // whose protocol the rule rejects and which is never `init`ed is now accused by
   // nothing, because the accusation lives in the `init` body. That holds for both
   // events now, and it is one behavioural residue, not two deferrals.
   // `getDefault()` is FORBIDDEN by the oracle (`SSLContext.crysl:10-11`) -- and it was
   // forbidden by the withdrawn generated rule too, so D-16 changes nothing here --
   // and until this event the set had no accuser for it, so
   // `SSLContext.getDefault().createSSLEngine()` was silence from end to end. The other
   // FORBIDDEN clause with a `.mop` in this set, `PBEKeySpec`'s two constructors, has been
   // accused since it was written; the asymmetry was an omission and not a decision, because it
   // appeared in no record of the project.
   //
   // The clause is `SSLContext.crysl:11`, the rule's one FORBIDDEN entry. The emitted string
   // names the rule and not the line, because `gh104_message_gate.py` reads a numeral in a
   // message as a value literal and compares it against the guard's (task 11.8).
   //
   // Both oracles write the clause as `getDefault() => Gets`, which reads the forbidden call as
   // filling the ORDER position the legitimate `getInstance` fills. This file does not model it
   // that way, and the reason is the one `PBEKeySpecSpec.mop:183-189` already wrote down for the
   // identical `PBEKeySpec(char[]) => Con`: making a forbidden call an alternative opening of
   // the ordering is the opposite of what FORBIDDEN says. So the event is a self-loop at every
   // state -- it accuses in its body and moves the automaton nowhere -- and the residue is the
   // same one that file records: the obligatory call that follows a forbidden one still reaches
   // its own state from a state that call never left, so `getDefault(); init(...)` draws
   // SSLCONTEXT-ORDER-00 on top of the SSLCONTEXT-FORB-00 the `getDefault` already earned.
   // Recorded, not repaired (divergence_record.csv).
   //
   // The self-loops are not decoration. An event absent from the automaton gets a transition
   // row that moves every state to `fail`, so declaring this event without them would trade the
   // false negative for an ordering false positive -- the defect tasks 3.2 and 3.6 spent a
   // group removing from this very file.
   // The body writes neither `context` nor `currentProtocol`, and that is not an omission: the
   // self-loop keeps this monitor wherever it already was, `@match1` is reachable only from
   // `end`, and no route from here arrives there -- a `getDefault()` context that is then
   // `init`ed goes `start -> fail`. Two writes no handler can read is exactly the bookkeeping
   // INV-INS-137 says to stop writing.
   event getDefault after() returning(SSLContext ctx):
    call(public static SSLContext SSLContext.getDefault()) {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.ForbiddenMethod, "SSLContextSpec", "" + __LOC,
          "v=1 code=SSLCONTEXT-FORB-00 ev=" + __EVENTNAME + " obj=SSLContext val='' exp='SSLContext.getInstance(String)' msg='SSLContext.getDefault() is forbidden by the expert SSLContext.crysl'"));
   }

   event g1 after(String protocol) returning(SSLContext ctx):
    call(public static SSLContext SSLContext.getInstance(String))
    && args(protocol) {
      context = ctx;
      currentProtocol = protocol;
    }

    // `Object+` covers both two-argument `getInstance` overloads the platform declares --
    // `(String, String)` for the provider's name and `(String, Provider)` for the object -- in
    // one pointcut, so no second event is spent on the same `Gets`. An object obtained through
    // the overload this pointcut used to miss reached its next event with the monitor at state
    // 0, where every row is `fail`. It is `Object+` and not `..` on purpose: the trace harness's
    // resolver walks the declared parameter types of a `call(...)` signature and stops at the
    // first wildcard (KeyManagerFactorySpec.mop:87-90), so a wildcard here would make every
    // `getInstance` fit this pointcut, while `Object+` keeps the arity known and the second
    // position typed. Precedent: `KeyGeneratorSpec.g2`.
    event g2 after(String protocol, Object provider) returning(SSLContext ctx):
      call(public static SSLContext SSLContext.getInstance(String, Object+)) &&
      args(protocol, provider) {
        context = ctx;
        currentProtocol = protocol;
    }

   // ALL THREE REQUIRES clauses of the oracle's SSLContext that name an argument of this
   // call, and the third arrived with the oracle: `generatedKeyManagers[km]`
   // (SSLContext.crysl:32, ledger clause #28), `generatedTrustManagers[tm]` (:33, clause
   // #29) and `randomized[random]` (:34, clause #47).
   //
   // The third carried `vacuous` until D-16 and the disposition FELL WITH THE SUBSTITUTION
   // OF ORACLE: it was an artefact of the generated rule, whose `Init` reads
   // `init(kms, tms, _)` -- the third position anonymous, so the variable the clause names
   // was bound by no event and the clause had no site. The oracle's
   // `i1: init(km, tm, random)` binds it. Task 11.5(b) opens the read, by the researcher's
   // decision of 2026-08-26, under the 9.B discipline: harness pair, divergence row,
   // go/no-go per clause.
   //
   // The rule declares one `init`, this file declares one event for it, and the signature is
   // written out in full, so binding all three arguments costs nothing the automaton can
   // see. The wildcard that stood in the third position of `args` is gone with the clause
   // that had no use for it; there is now no wildcard at all, which is strictly safer for
   // the trace harness's resolver than the trailing one it replaced.
   //
   // WHAT THIS READ ACCUSES, SAID PLAINLY, because it is the cost the decision weighed:
   // `init(km, tm, null)` is the documented way to ask for the platform's own SecureRandom,
   // and under the rule as written it does not satisfy `randomized[random]` -- a null is not
   // a random this instrumentation saw produced. Every trace of the corpus that reaches this
   // event passes `null` there, so every one of them gains a NOBS report. That is the same
   // reading the two sibling clauses already carry by the researcher's decision of
   // 2026-08-22 -- "the clause requires managers this instrumentation saw a factory produce,
   // and no argument is not one" -- and reading the third differently would make the file
   // answer to two rules at once. The NOBS code is what says "reach limit", and it says it
   // here for the same reason it says it there.
   //
   // The two array positions are declared as the reference array types the API declares, and
   // all three are passed to the store as the *bound* object rather than as a value. That is
   // what the store's bound-first signature is for: a `KeyManager[]` handed to a varargs tail
   // would be spread into one argument per element, and an empty array into no argument at
   // all, with nothing but a compiler note to say so.
   //
   // Measured on Temurin 21 before either read was written, because having a `.mop` at both
   // ends is necessary and not sufficient. The chain composes: a loaded PKCS12 store into
   // `KeyManagerFactory.init` and `TrustManagerFactory.init`, their
   // `getKeyManagers()`/`getTrustManagers()` into this `init`, all of it runs to completion.
   // And the platform does not already refuse what these clauses accuse -- `init(null, null,
   // null)` runs, and so does `init(null, trustEverything, sr)`, which is the trust-all manager
   // this rule exists to catch. Both factories allocate a fresh array on every call, so the
   // predicate travels with the array the call returned and with no copy of it; a program that
   // rebuilds the array reaches this read with nothing written, which is a reach limit and is
   // what the NOBS codes say.
   //
   // A null argument is read rather than exempted (researcher decision, 2026-08-22): the store
   // answers NOT_OBSERVED for it, and that is what the rule states -- the clause requires
   // managers this instrumentation saw a factory produce, and no argument is not one. Every
   // corpus trace of this specification calls `init(null, null, null)`, so this read is what
   // makes them say so out loud.
   //
   // VIOLATED has no program that produces it today for either predicate -- both are written at
   // arity 1 and withdrawn nowhere -- and both branches are written anyway, for the reason the
   // rest of the set records: a read that folded VIOLATED into NOT_OBSERVED would misreport a
   // withdrawn predicate as an unobserved one the day a NEGATES clause reaches it.
   event init after(KeyManager[] kms, TrustManager[] tms, SecureRandom random, SSLContext ctx):
     call(public void SSLContext.init(KeyManager[], TrustManager[], SecureRandom)) &&
     args(kms, tms, random) &&
     target(ctx) {
       if (!ConscryptAliasTable.matches("SSLContext", ctx.getProtocol(), protocols)) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeProtocol, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-PROTO-00 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(String.join(",", protocols)) + "' msg='expecting one of " + String.join(",", protocols) + " but found " + ctx.getProtocol() + "'"));
       }
       PredicateVerdict keyManagers = PredicateStore.instance().validate(Property.GENERATED_KEY_MANAGERS, kms);
       if (keyManagers == PredicateVerdict.VIOLATED) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-CONSTR-00 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedGeneratedKeyManagers) + "' msg='the KeyManager[] given to SSLContext.init carries a generation predicate the rule does not admit'"));
       }
       else if (keyManagers == PredicateVerdict.NOT_OBSERVED) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-NOBS-00 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedGeneratedKeyManagers) + "' msg='the KeyManager[] given to SSLContext.init was not observed coming from a KeyManagerFactory'"));
       }
       PredicateVerdict trustManagers = PredicateStore.instance().validate(Property.GENERATED_TRUST_MANAGER, tms);
       if (trustManagers == PredicateVerdict.VIOLATED) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-CONSTR-01 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedGeneratedTrustManagers) + "' msg='the TrustManager[] given to SSLContext.init carries a generation predicate the rule does not admit'"));
       }
       else if (trustManagers == PredicateVerdict.NOT_OBSERVED) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-NOBS-01 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedGeneratedTrustManagers) + "' msg='the TrustManager[] given to SSLContext.init was not observed coming from a TrustManagerFactory'"));
       }
       PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, random);
       if (randomised == PredicateVerdict.VIOLATED) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-CONSTR-02 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedRandomized) + "' msg='the SecureRandom given to SSLContext.init carries a randomization predicate the rule does not admit'"));
       }
       else if (randomised == PredicateVerdict.NOT_OBSERVED) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-NOBS-02 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedRandomized) + "' msg='the SecureRandom given to SSLContext.init was not observed coming from a randomized source'"));
       }
   }

   // The return type is the platform's, and it has to be: both weavers gate it exactly, so
   // while this pointcut declared `void` against android-30's `public final SSLEngine
   // createSSLEngine()` the advice was generated, sat in the monitor, and never fired. A
   // signature sweep of all 143 `call(...)` sites of the set found this to be the only
   // return-type mismatch, and 9.7's G-SIG is what keeps it the last one.
   //
   // Reviving the event is a behavioural change and was decided as one: the dispatcher runs
   // FindOrCreateEntry, so an `SSLContext` whose birth this set never observed gets a monitor
   // at state 0 here, and `engine[start]` is fail. The two births that were unobserved for no
   // good reason are closed first -- the `(String, Provider)` overload by 9.16 and the
   // `g2`-suppressed context by 9.17. The one that remains is `getDefault()`, which 9.9
   // accuses in its own right and which keeps the ordering report on top, by the decision
   // recorded at that event.
   //
   // `createSSLEngine()` before `init` reaches nothing: it raises IllegalStateException, and
   // an `after returning` advice does not run on a throw. So the `s1` row is unreachable in
   // practice and is left as the automaton reads the rule.
   event engine after(SSLContext ctx) returning(SSLEngine eng) :
     call(public SSLEngine SSLContext.createSSLEngine(..)) &&
     target(ctx) {
       stagedEngine = eng;
   }

  // The two ENSURES clauses of SSLContext.crysl name the same acceptance point.
  // `generatedSSLContext[this] after Init` (:37) carries an `after L`, and `Init` leads to
  // `end`; `generatedSSLEngine[eng] after Engine` (:38) carries one too, and `Engine` leads
  // to `end` as well -- which is what the alias below names. The generated rule left the
  // second unqualified and the acceptance point was the accepting state as such; under the
  // oracle both are `after L` clauses that name the same state, so the reading is the same
  // and the route to it is not. Read off the
  // generated monitor, `init` and `engine` both land in state 1 and the match category is
  // `nextstate == 1`, so both routes INV-INS-134 admits name `@match1`.
  //
  // Neither predicate has a reader: both appear in the oracle only here, as this rule's
  // own ENSURES, so they are two of the dead ends this change disposes of by recording
  // the omission rather than by fabricating a consumer (INV-INS-137).
  //
  // The context reaches the handler through the monitor field rather than through a
  // staged one, because `g1`/`g2` bind it and `end` is unreachable without them. What
  // leaves the two handlers is the accepting-state bookkeeping -- the new store does not
  // offer it and the set never read it back (INV-INS-147).
  //
  // The ordering divergence this automaton carries against the rule's `Gets, Init,
  // Engine?` -- the `end` state admits a second `engine`, which G-ORDER reports as
  // `g1 Init se1 se1` -- is one of the four open ones and belongs to task 7.1. This pass
  // does not touch the `fsm`.
  fsm:
    start [
      g1 -> s1
      g2 -> s1
      getDefault -> start
    ]
    s1 [
      init -> end
      getDefault -> s1
    ]
    end [
      engine -> end
      getDefault -> end
    ]

  alias match1 = end

  @fail {
    ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SSLContextSpec", "" + __LOC,
        "v=1 code=SSLCONTEXT-ORDER-00 ev=" + __EVENTNAME + " obj=SSLContext val='' exp='' msg='the observed call sequence is not one SSLContextSpec accepts'"));
    stagedEngine = null;
    __RESET;
  }

  @match1 {
     PredicateStore.instance().ensure(Property.GENERATE_SSL_CONTEXT, context);
     if (stagedEngine != null) {
         PredicateStore.instance().ensure(Property.GENERATE_SSL_ENGINE, stagedEngine);
         stagedEngine = null;
     }
  }
  
}
