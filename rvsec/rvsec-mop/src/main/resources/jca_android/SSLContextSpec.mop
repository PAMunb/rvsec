package mop;

import javax.net.ssl.SSLContext;
import javax.net.ssl.SSLEngine;
import javax.net.ssl.KeyManager;
import javax.net.ssl.TrustManager;
import java.security.SecureRandom;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * SSLContextSpec
 *
 * Monitors javax.net.ssl.SSLContext against the CrySL rule SSLContext.crysl.
 * The rule orders `Get, Init, Engine?`: a context is obtained through `getInstance`, then
 * initialised with `init(km, tm, random)`, and may then be asked for SSL engines. It states
 * one FORBIDDEN clause, `getDefault() => Get`; it constrains the protocol with
 * `protocol in {"TLSv1.2", "TLSv1.3"}`; it REQUIRES `generatedKeyManagers[km]`,
 * `generatedTrustManagers[tm]` and `randomized[random]` of the three arguments of `init`;
 * and it ENSURES `generatedSSLContext[this] after Init` and
 * `generatedSSLEngine[eng] after Engine`.
 *
 * Four behaviours of this specification depart from the rule as written.
 *
 * Beside the two names the protocol clause admits, the allow-list carries `TLS`, so a context
 * obtained with `getInstance("TLS")` is accepted here and refused by the clause as written.
 * `SSL` is not carried and is reported, although the platform binds both names to the same
 * implementation.
 *
 * The FORBIDDEN clause reads the forbidden call as filling the same ordering position as
 * `getInstance`. Here it fills none: `getDefault` accuses in its own body and moves the
 * automaton nowhere, so a context it returned has no opening in the ordering and the `init`
 * that follows draws an ordering report on top of the forbidden-call report.
 *
 * The rule's `Engine?` admits at most one `createSSLEngine`; the accepting state of this
 * automaton admits any number of them, so a trace of `getInstance`, `init` and two
 * `createSSLEngine` calls is accepted here and refused by the rule.
 *
 * The protocol clause is accused in the body of `init`, which is the one event that can
 * reach the context and its three required arguments together. A context obtained for a
 * protocol the rule rejects and never initialised therefore reaches no accusing site.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/SSLContext.crysl
 */
SSLContextSpec(SSLContext ctx) {
    // The report envelope's quoting rule: a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

   // CONSTRAINTS of SSLContext.crysl: `protocol in {"TLSv1.2", "TLSv1.3"}`, transcribed.
   // The comparison runs through `ConscryptAliasTable.matches`, which folds case, so the
   // spelling of the two protocol names carries no weight.
   //
   // `TLS` is admitted beside them, and it is admitted by being an entry of this list and by
   // nothing else: `ConscryptAliasTable` carries no row under the `SSLContext` service, so
   // `matches` resolves nothing here and the list is the whole of the decision. The entry is
   // there as behaviour of the platform -- Conscrypt binds the `SSLContext.TLS` service to the
   // same implementation that serves the two protocols the clause names, so an application that
   // asks for `TLS` obtains a context running a protocol the clause admits. Reporting it
   // would accuse the spelling the platform itself recommends.
   //
   // `SSL` is not in the list. Conscrypt binds that name to the same implementation as well,
   // yet asking a provider for `SSL` is the misuse the rule is about, and the clause does not
   // carry the name. So `SSLContext.getInstance("SSL")` is reported at `init` under
   // SSLCONTEXT-PROTO-00 and `SSLContext.getInstance("TLS")` is not, although the two
   // contexts speak the same protocols on the wire.
   List<String> protocols = Arrays.asList("TLSV1.2", "TLSV1.3", "TLS");

   SSLContext context;

   // ENSURES `generatedSSLEngine[eng] after Engine` is about the engine `createSSLEngine`
   // returned, and the acceptance handler cannot reach it: a handler receives no event
   // arguments and runs after the transition is decided. So the `engine` event puts the
   // returned object in this field and the handler writes the predicate over it and clears
   // the field, which is what keeps one engine from being written twice.
   SSLEngine stagedEngine = null;

   String expectedGeneratedKeyManagers = "a KeyManager[] an observed KeyManagerFactory returned";

   String expectedGeneratedTrustManagers = "a TrustManager[] an observed TrustManagerFactory returned";

   // The third clause's `exp=`. It names the producer the way its siblings do, and the
   // producer here is the RANDOMIZED hub: SecureRandomSpec writes the predicate over the
   // generator itself at its own acceptance point, so what satisfies this read is a
   // SecureRandom whose construction or getInstance this instrumentation observed.
   String expectedRandomized = "a SecureRandom this instrumentation observed being created";

   // Set by the creation events `getDefault`, `g1` and `g2`. `@fail` reads it to tell a call
   // sequence the rule refuses from a context whose creation this monitor never saw; the
   // generated `reset()` leaves user fields alone, so the fact survives a failure.
   boolean creationObserved = false;

   // Set by the forbidden creation `getDefault` and never cleared. `@fail` reads it to report a
   // failure of a context `getDefault()` returned under SSLCONTEXT-ORDER-02 (`creation-refused`):
   // the ordering has no opening for such a context, so its failure is the consequence of the
   // SSLCONTEXT-FORB-00 the call already drew. The generated `reset()` leaves it alone as well.
   boolean creationRefused = false;

   // FORBIDDEN of SSLContext.crysl: `getDefault() => Get`. This is the rule's one forbidden
   // method, and the call is accused in the body of this event under SSLCONTEXT-FORB-00, the
   // code registered in `codes.csv` for this site. It is the only site that accuses the call,
   // so `SSLContext.getDefault().createSSLEngine()` is reported here and nowhere else.
   //
   // The clause reads the forbidden call as filling the `Get` position of the ordering. This
   // specification does not model it that way, because making a forbidden call an alternative
   // opening of the ordering is the opposite of what FORBIDDEN states. The event is instead a
   // self-loop at every state: it accuses in its body and moves the automaton nowhere.
   //
   // The self-loops are not decoration. An event a state does not declare gets a transition
   // row to `fail`, so declaring this event without them would report every `getDefault` as a
   // wrong call sequence as well as a forbidden call. What the self-loops leave behind is that
   // the obligatory call which follows a forbidden one reaches its own state from a state the
   // call never left, so `getDefault(); init(...)` draws SSLCONTEXT-ORDER-02
   // (`creation-refused`) on top of the SSLCONTEXT-FORB-00 the `getDefault` already earned.
   //
   // The body writes no predicate and stages nothing, and that is not an omission: the
   // self-loop keeps the monitor wherever it already was, `@match1` is reachable only from
   // `end`, and no route from here arrives there -- a `getDefault()` context that is then
   // `init`ed goes `start -> fail`. The two fields it does set, `creationObserved` and
   // `creationRefused`, are the ones `@fail` reads, so that failure is reported as a sequence
   // following a creation this specification refuses rather than as a plain ordering failure.
   event getDefault after() returning(SSLContext ctx):
    call(public static SSLContext SSLContext.getDefault()) {
      creationObserved = true;
      creationRefused = true;
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.ForbiddenMethod, "SSLContextSpec", "" + __LOC,
          "v=1 code=SSLCONTEXT-FORB-00 ev=" + __EVENTNAME + " obj=SSLContext val='' exp='SSLContext.getInstance(String)' msg='SSLContext.getDefault() is forbidden by the expert SSLContext.crysl'"));
   }

   // `Get := g1 | g2` of SSLContext.crysl: `g1: getInstance(protocol)`, the one-argument
   // overload. The protocol is a CONSTRAINTS clause and not an ordering condition, so this
   // event carries no `condition(...)`: `getInstance` opens the ordering whatever it was
   // asked for. A guard here would compile to an early return ahead of both the body and the
   // transition, so a context built for a protocol the rule rejects would stay outside the
   // automaton and its `init` would then be reported as a wrong call sequence instead of as
   // the rejected protocol it is. The body records that a creation was observed and binds the
   // returned context for the acceptance handler, which receives no event arguments.
   event g1 after(String protocol) returning(SSLContext ctx):
    call(public static SSLContext SSLContext.getInstance(String))
    && args(protocol) {
      creationObserved = true;
      context = ctx;
    }

    // `Get := g1 | g2` of SSLContext.crysl: `g2: getInstance(protocol, _)`. `Object+` covers
    // both two-argument overloads the platform declares -- `(String, String)` for the
    // provider's name and `(String, Provider)` for the provider object -- in one pointcut, so
    // no second event is spent on the same `Get` and a context obtained through either of them
    // reaches its next event with a monitor that saw its creation. It is `Object+` and not
    // `..` on purpose: the trace harness's resolver walks the declared parameter types of a
    // `call(...)` signature and stops at the first wildcard, so a wildcard here would make
    // every `getInstance` fit this pointcut, while `Object+` keeps the arity known and the
    // second position typed.
    //
    // As at `g1`, the protocol governs no transition and no `condition(...)` guards this
    // event; it is accused in the body of `init`. The body records the creation and binds the
    // returned context for the acceptance handler.
    event g2 after(String protocol, Object provider) returning(SSLContext ctx):
      call(public static SSLContext SSLContext.getInstance(String, Object+)) &&
      args(protocol, provider) {
        creationObserved = true;
        context = ctx;
    }

   // `Init := i1` of SSLContext.crysl: `i1: init(km, tm, random)`. The rule declares one
   // `init` and this file declares one event for it, with all three arguments bound and no
   // wildcard, which is what lets this single site realise the rule's CONSTRAINTS clause and
   // all three of its REQUIRES clauses.
   //
   // Every check below sits in the event body and not in a `condition(...)` guard. A guard
   // compiles to an early return ahead of both the body and the transition, so a violating
   // call would leave the automaton in the state before `init` and the next call would be
   // reported as a wrong call sequence instead of as the misuse it is.
   //
   // The three arguments are handed to the store as the *bound* object and never as a value.
   // That is what the store's bound-first signature is for: a `KeyManager[]` passed into a
   // varargs tail would be spread into one argument per element, and an empty array into no
   // argument at all, with nothing but a compiler note to say so.
   //
   // CONSTRAINTS `protocol in {"TLSv1.2", "TLSv1.3"}`. The protocol is read back from the
   // context with `getProtocol()` and compared against the list above through
   // `ConscryptAliasTable.matches`; one outside the list is reported under
   // SSLCONTEXT-PROTO-00.
   //
   // REQUIRES `generatedKeyManagers[km]`: the array came out of a `KeyManagerFactory` the
   // instrumentation observed being initialised. SATISFIED produces no report. VIOLATED means
   // the store holds an entry for this very array whose values differ, or one `negate` has
   // revoked -- positive evidence that a producing call was seen and established something
   // else -- and is reported under SSLCONTEXT-CONSTR-00. NOT_OBSERVED means the store holds
   // nothing about the array at all, and it is split by what the argument is: a null is the
   // documented request for the platform's default key managers and is reported under
   // SSLCONTEXT-NOBS-03, any other unknown array under SSLCONTEXT-NOBS-00. The null is read
   // rather than exempted, because the clause asks for managers a factory was seen to produce
   // and no argument is not one. NOT_OBSERVED is kept apart from VIOLATED because an array
   // whose producing factory the weaving never reached is not a misuse; a `KeyManager[]` the
   // application rebuilt from issued managers lands there too, since key-manager arrays carry
   // no per-element mark.
   //
   // REQUIRES `generatedTrustManagers[tm]`: the array came out of a `TrustManagerFactory` the
   // instrumentation observed being initialised. The same three answers, with one refinement
   // and one more split. The refinement: each element is asked for the per-element mark that
   // `TrustManagerFactorySpec` writes over every manager it hands out -- the individual trust
   // manager was issued by a `TrustManagerFactory` the instrumentation observed -- and an
   // array the store has never seen is credited as SATISFIED when it is non-empty and every
   // element carries that mark, because the clause constrains the managers and an application
   // that copies an issued manager into a fresh array is passing exactly the manager the
   // factory issued. One unmarked element withholds the credit, which is what keeps an array
   // mixing an issued manager with one the application wrote from passing, and the credit
   // applies only to a NOT_OBSERVED answer, so it never turns a revoked array into a
   // satisfied one. The split: VIOLATED is reported under SSLCONTEXT-CONSTR-01; a null under
   // SSLCONTEXT-NOBS-04; an uncredited array holding an element whose class a loader other
   // than the platform's defined -- the application's own class, decided by the loader and not
   // by a package name -- under SSLCONTEXT-NOBS-05, where a trust-all manager lands and so
   // does one that delegates to an issued manager, the monitor being unable to tell them
   // apart; and any other unknown array under SSLCONTEXT-NOBS-01.
   //
   // REQUIRES `randomized[random]`: the object came from a `SecureRandom` the instrumentation
   // observed -- here the generator itself, which `SecureRandomSpec` marks at its own
   // acceptance point. SATISFIED produces no report; VIOLATED is reported under
   // SSLCONTEXT-CONSTR-02; NOT_OBSERVED under SSLCONTEXT-NOBS-06 when the argument is null,
   // which is the documented way to ask for the platform's own source of randomness, and
   // under SSLCONTEXT-NOBS-02 otherwise. The null is read for the same reason as the other
   // two: a null is not a `SecureRandom` this instrumentation saw produced.
   //
   // Every NOT_OBSERVED envelope carries the evidence of the bound argument, which for a
   // trust-manager array is the classes of its elements. VIOLATED has no program that produces
   // it today for any of the three predicates -- all are written at arity 1 and revoked
   // nowhere -- and the branch is written anyway: a read that folded VIOLATED into
   // NOT_OBSERVED would misreport a revoked predicate as an unobserved one the day a NEGATES
   // clause reaches it.
   event init after(KeyManager[] kms, TrustManager[] tms, SecureRandom random, SSLContext ctx):
     call(public void SSLContext.init(KeyManager[], TrustManager[], SecureRandom)) &&
     args(kms, tms, random) &&
     target(ctx) {
       if (!ConscryptAliasTable.matches("SSLContext", ctx.getProtocol(), protocols)) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeProtocol, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-PROTO-00 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(String.join(",", protocols)) + "' msg='expecting one of " + String.join(",", protocols) + " but found " + ctx.getProtocol() + "'"));
       }
       PredicateVerdict keyManagers = PredicateStore.instance().validate(Property.GENERATED_KEY_MANAGERS, kms);
       if (keyManagers == PredicateVerdict.VIOLATED) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-CONSTR-00 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedGeneratedKeyManagers) + "' msg='the KeyManager[] given to SSLContext.init carries a generation predicate the rule does not admit'"));
       }
       else if (keyManagers == PredicateVerdict.NOT_OBSERVED && kms == null) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-NOBS-03 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedGeneratedKeyManagers) + "' msg='a null KeyManager[] given to SSLContext.init requests the platform default key managers, which were not observed coming from a KeyManagerFactory'" + Evidence.keysFor(kms)));
       }
       else if (keyManagers == PredicateVerdict.NOT_OBSERVED) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-NOBS-00 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedGeneratedKeyManagers) + "' msg='the KeyManager[] given to SSLContext.init was not observed coming from a KeyManagerFactory'" + Evidence.keysFor(kms)));
       }
       PredicateVerdict trustManagers = PredicateStore.instance().validate(Property.GENERATED_TRUST_MANAGER, tms);
       boolean applicationManager = false;
       if (tms != null) {
        boolean everyManagerGenerated = tms.length > 0;
        for (TrustManager manager : tms) {
         everyManagerGenerated &= PredicateStore.instance().validate(Property.GENERATED_TRUST_MANAGERS, manager) == PredicateVerdict.SATISFIED;
         applicationManager |= Evidence.isApplicationDefined(manager, TrustManager.class);
        }
        if (trustManagers == PredicateVerdict.NOT_OBSERVED && everyManagerGenerated) {
         trustManagers = PredicateVerdict.SATISFIED;
        }
       }
       if (trustManagers == PredicateVerdict.VIOLATED) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-CONSTR-01 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedGeneratedTrustManagers) + "' msg='the TrustManager[] given to SSLContext.init carries a generation predicate the rule does not admit'"));
       }
       else if (trustManagers == PredicateVerdict.NOT_OBSERVED && tms == null) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-NOBS-04 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedGeneratedTrustManagers) + "' msg='a null TrustManager[] given to SSLContext.init requests the platform default trust managers, which were not observed coming from a TrustManagerFactory'" + Evidence.keysFor(tms)));
       }
       else if (trustManagers == PredicateVerdict.NOT_OBSERVED && applicationManager) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-NOBS-05 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedGeneratedTrustManagers) + "' msg='the TrustManager[] given to SSLContext.init holds a manager of a class the application defines and was not observed coming from a TrustManagerFactory'" + Evidence.keysFor(tms)));
       }
       else if (trustManagers == PredicateVerdict.NOT_OBSERVED) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-NOBS-01 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedGeneratedTrustManagers) + "' msg='the TrustManager[] given to SSLContext.init was not observed coming from a TrustManagerFactory'" + Evidence.keysFor(tms)));
       }
       PredicateVerdict randomised = PredicateStore.instance().validate(Property.RANDOMIZED, random);
       if (randomised == PredicateVerdict.VIOLATED) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-CONSTR-02 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedRandomized) + "' msg='the SecureRandom given to SSLContext.init carries a randomization predicate the rule does not admit'"));
       }
       else if (randomised == PredicateVerdict.NOT_OBSERVED && random == null) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-NOBS-06 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedRandomized) + "' msg='a null SecureRandom given to SSLContext.init requests the platform default random source, which was not observed being created'" + Evidence.keysFor(random)));
       }
       else if (randomised == PredicateVerdict.NOT_OBSERVED) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-NOBS-02 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(expectedRandomized) + "' msg='the SecureRandom given to SSLContext.init was not observed coming from a randomized source'" + Evidence.keysFor(random)));
       }
   }

   // `Engine := se1 | se2` of SSLContext.crysl: `se1: eng = createSSLEngine()` and
   // `se2: eng = createSSLEngine(_,_)`, both matched by this one pointcut over the varargs
   // signature. The declared return type is the platform's `SSLEngine` and it has to be: both
   // weavers match the return type of a `call(...)` signature exactly, so an advice declared
   // over a different one is generated, sits in the monitor and never fires.
   //
   // The rule states no clause about this call beyond its position in the ordering, so the
   // body only stages the returned engine for the acceptance handler, which receives no event
   // arguments; the predicate itself is written there.
   //
   // An `SSLContext` whose creation this monitor never saw reaches this event with a monitor
   // in its initial state, where `engine` is not declared, so the call is reported as a wrong
   // call sequence under the `creation-unobserved` code -- or, after `getDefault`, under the
   // `creation-refused` one. A `createSSLEngine` between `getInstance` and `init` would be
   // reported the same way, and that report is unreachable in practice: the call raises
   // IllegalStateException, and an `after returning` advice does not run on a throw. The
   // transition is left as the automaton reads the rule.
   event engine after(SSLContext ctx) returning(SSLEngine eng) :
     call(public SSLEngine SSLContext.createSSLEngine(..)) &&
     target(ctx) {
       stagedEngine = eng;
   }

  // The automaton transcribes the rule's ORDER, `Get, Init, Engine?`, with one departure: the
  // `end` state admits a second `engine`, where the rule's `?` admits at most one, so
  // `getInstance`, `init`, `createSSLEngine`, `createSSLEngine` is accepted here and refused
  // by the rule.
  //
  // `getDefault` is a self-loop at every state for the reason given at that event: a forbidden
  // call must not open or advance the ordering, and an event a state does not declare would
  // otherwise take the monitor to `fail`.
  //
  // Both ENSURES clauses of SSLContext.crysl name the same state of this automaton.
  // `generatedSSLContext[this] after Init` holds where `Init` leads, and
  // `generatedSSLEngine[eng] after Engine` where `Engine` leads; both are `end`, which is what
  // the alias below names, so one handler answers for both.
  fsm:
    start [
      g1 -> s1
      g2 -> s1
      getDefault -> start
    ]
    s1 [
      init -> end
      getDefault -> s1
    ]
    end [
      engine -> end
      getDefault -> end
    ]

  alias match1 = end

  // A monitor that never observed `getInstance` or `getDefault` reports every failure as
  // `creation-unobserved`: the context was created where this monitor cannot see, and after a
  // reset no creation event can arrive for it. A monitor whose creation was `getDefault` reports
  // every failure as `creation-refused`.
  @fail {
    if (!creationObserved) {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SSLContextSpec", "" + __LOC,
          "v=1 code=SSLCONTEXT-ORDER-01 ev=" + __EVENTNAME + " obj=SSLContext val='' exp='' msg='" + __EVENTNAME + "() before getInstance() or getDefault()'"));
    }
    else if (creationRefused) {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SSLContextSpec", "" + __LOC,
          "v=1 code=SSLCONTEXT-ORDER-02 ev=" + __EVENTNAME + " obj=SSLContext val='' exp='' msg='the observed call sequence is not one SSLContextSpec accepts, after a creation the specification refused'"));
    }
    else {
      ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SSLContextSpec", "" + __LOC,
          "v=1 code=SSLCONTEXT-ORDER-00 ev=" + __EVENTNAME + " obj=SSLContext val='' exp='' msg='the observed call sequence is not one SSLContextSpec accepts'"));
    }
    stagedEngine = null;
    __RESET;
  }

  // ENSURES `generatedSSLContext[this] after Init`: the `SSLContext` was initialised by a call
  // the instrumentation observed. The context reaches this handler through the monitor field
  // `context` rather than through a staged one, because `g1` and `g2` bind it and `end` is
  // unreachable without them; a handler receives no event arguments and runs after the
  // transition is decided, so it could not see the object otherwise.
  //
  // ENSURES `generatedSSLEngine[eng] after Engine`: the `SSLEngine` was produced or configured
  // by a call the instrumentation observed. It is written only when an `engine` event staged
  // one, since this same state is reached by an `init` alone, and the field is cleared after
  // the write so one engine is written once.
  //
  // No rule of the set REQUIRES either predicate, so both writes stand for coverage of the
  // rule and no reader consumes them.
  @match1 {
     PredicateStore.instance().ensure(Property.GENERATE_SSL_CONTEXT, context);
     if (stagedEngine != null) {
         PredicateStore.instance().ensure(Property.GENERATE_SSL_ENGINE, stagedEngine);
         stagedEngine = null;
     }
  }
  
}
