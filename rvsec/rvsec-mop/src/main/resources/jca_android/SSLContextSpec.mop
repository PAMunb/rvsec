package mop;

import javax.net.ssl.SSLContext;
import javax.net.ssl.SSLEngine;
import javax.net.ssl.KeyManager;
import javax.net.ssl.TrustManager;
import java.security.SecureRandom;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.ExecutionContext;
import br.unb.cic.mop.Property;
import br.unb.cic.mop.jca.util.ConscryptAliasTable;

/**
 * SSLContextSpec
 *
 * A JavaMOP specification of the correct usage of the
 * javax.net.ssl.SSLContext class.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/master/JavaCryptographicArchitecture/src/SSLContext.crysl
 */
SSLContextSpec(SSLContext ctx) {
    // The envelope's quoting rule (design D-3): a null value is the empty string,
    // a single quote is escaped so it cannot close the field early, and the value
    // is capped so a pathological argument cannot push the record past the
    // logcat payload limit.
    private String q(String s) {
        if (s == null) {
            return "";
        }
        String value = s.length() > 512 ? s.substring(0, 512) : s;
        return value.replace("'", "\\'");
    }

   List<String> protocols = Arrays.asList("Default", "TLSv1.2", "TLSv1.1", "SSL", "TLSv1", "TLS",
       "TLSv1.3");
   String currentProtocol = "";

   SSLContext context;

   SSLEngine engine;

   // One event over `getInstance(String)`, where there used to be two split by the
   // sign of a guard. The negated twin `unsafe_protocol` matched the same call with
   // the same `args(protocol)` and named no state, and the generator gives an event
   // absent from the automaton a transition row that moves every state to `fail`: a
   // context built for a protocol the rule rejects was reported as a wrong call
   // sequence, and the `init` that followed it was reported again, because
   // `unsafe_protocol`'s failing transition had taken the `@fail` path -- which
   // `__RESET`s the monitor to `start`, where `init` is not declared.
   //
   // It was worse than a second report about one context. `unsafe_protocol` bound no
   // `SSLContext`: it was `after(String protocol)` with no `returning` and no
   // `target`, so the generator dispatched it to the whole monitor set rather than
   // to an instance, and one rejected protocol anywhere in the program pushed every
   // live SSLContextSpec monitor to `fail`.
   //
   // The api30 rule orders `Gets, Init, Engine?` with `Gets := g1 | g2` and states
   // the protocol under CONSTRAINTS, so the protocol must not govern the transition:
   // `getInstance` is a `Gets` whatever it was asked for. Dropping the guard lets the
   // rejected context reach `end` like any other, where the `init` body accuses it
   // exactly once, with SSLCONTEXT-PROTO-00. `unsafe_protocol`'s body accused nothing
   // of its own -- it only rebound `currentProtocol` -- so nothing it reported is
   // lost.
   //
   // Residue, recorded and not repaired (divergence_record.csv): a `getInstance`
   // whose protocol the rule rejects and which is never `init`ed is now accused by
   // nothing, because the accusation lives in the `init` body. The two-argument `g2`
   // still carries the guard this event lost, and with it the same suppression, for
   // the same reason -- it is not an orphan, so no task of this group reaches it.
   // Both are behavioural changes, deliberately deferred.
   event g1 after(String protocol) returning(SSLContext ctx):
    call(public static SSLContext SSLContext.getInstance(String))
    && args(protocol) {
      context = ctx;
      currentProtocol = protocol;
    }

    event g2 after(String protocol, String provider) returning(SSLContext ctx):
      call(public static SSLContext SSLContext.getInstance(String, String)) &&
      args(protocol, provider) &&
      condition(ConscryptAliasTable.matches("SSLContext", protocol, protocols)) {
        context = ctx;
        currentProtocol = protocol;
    }

   event init after(SSLContext ctx):
     call(public void SSLContext.init(KeyManager[], TrustManager[], SecureRandom)) &&
     target(ctx) {
       if (!ConscryptAliasTable.matches("SSLContext", ctx.getProtocol(), protocols)) {
        ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsafeProtocol, "SSLContextSpec", "" + __LOC,
            "v=1 code=SSLCONTEXT-PROTO-00 ev=" + __EVENTNAME + " obj=SSLContext val='" + q(ctx.getProtocol()) + "' exp='" + q(String.join(",", protocols)) + "' msg='expecting one of " + String.join(",", protocols) + " but found " + ctx.getProtocol() + "'"));
       }
       ExecutionContext.instance().setProperty(Property.GENERATE_SSL_CONTEXT, context);
   }

   event engine after(SSLContext ctx) returning(SSLEngine eng) :
     call(public void SSLContext.createSSLEngine(..)) &&
     target(ctx) {
       ExecutionContext.instance().setProperty(Property.GENERATE_SSL_ENGINE, eng);
   }

  fsm:
    start [
      g1 -> s1
      g2 -> s1
    ]
    s1 [
      init -> end
    ]
    end [
      engine -> end
    ]

  alias match1 = end

  @fail {
    ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "SSLContextSpec", "" + __LOC,
        "v=1 code=SSLCONTEXT-ORDER-00 ev=" + __EVENTNAME + " obj=SSLContext val='' exp='' msg='the observed call sequence is not one SSLContextSpec accepts'"));
    ExecutionContext.instance().unsetObjectAsInAcceptingState(context);
    __RESET;
  }

  @match1 {
     ExecutionContext.instance().setObjectAsInAcceptingState(context);
  }
  
}
