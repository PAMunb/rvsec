package mop;

import java.security.KeyStore;
import java.security.cert.PKIXParameters;
import java.util.Set;

import br.unb.cic.mop.eh.*;
import br.unb.cic.mop.PredicateStore;
import br.unb.cic.mop.PredicateVerdict;
import br.unb.cic.mop.Property;

/**
 * PKIXParametersSpec
 *
 * Monitors java.security.cert.PKIXParameters against the CrySL rule PKIXParameters.crysl.
 *
 * The rule's ORDER is `Con`, that is `c1: PKIXParameters(keyStore);` or `c2: PKIXParameters(_);`.
 * It states no CONSTRAINTS. Its one REQUIRES clause, `generatedKeyStore[keyStore]`, binds the
 * argument of `c1` alone and is read in that event's body. Its one ENSURES clause,
 * `generatedCertPathParameters[this]`, is written at the accepting state and read by
 * `CertPathTrustManagerParametersSpec` at its constructor.
 *
 * Divergences from the rule and reach limits of this monitor:
 *
 * - The rule writes `c2` with an unnamed argument, so no clause of it reaches the trust-anchor
 *   constructor and this specification checks nothing there. Parameters built that way are
 *   prepared with nothing verified, and a `CertPathTrustManagerParameters` built over them is
 *   accused of nothing either.
 * - The predicate is written only for a construction that satisfied the rule, so parameters
 *   built over a key store whose loading was not observed carry no mark and are read downstream
 *   as parameters whose own construction was not observed.
 * - The `@fail` handler cannot fire, because a monitor keyed on the constructed object never
 *   sees a second event.
 *
 * @see https://github.com/CROSSINGTUD/Crypto-API-Rules/blob/6d844ab402229aaefa4c5e45bf080987b787624b/JavaCryptographicArchitecture/src/PKIXParameters.crysl
 */
PKIXParametersSpec(PKIXParameters s) {

   // Bound where the construction satisfied whatever the rule asks of it, which for `c2`
   // is nothing; see the note on that event.
   PKIXParameters spec;

   // Set by the two creation events, `c1` and `c2`, whatever they report, and never cleared:
   // the generated `reset()` restores the automaton state and leaves this field. `@fail` reads
   // it to choose between `PKIXPARAMETERS-ORDER-01` (`creation-unobserved`) and the
   // wrong-sequence code.
   boolean creationObserved = false;

   // `Con` of PKIXParameters.crysl: `c1: PKIXParameters(keyStore);`, the key-store constructor
   // and one alternative of `Con := c1 | c2`. The platform declares both overloads and both throw
   // on a bad argument, so an `after ... returning` advice sees only the constructions that
   // completed.
   //
   // REQUIRES of PKIXParameters.crysl: `generatedKeyStore[keyStore];`. The predicate says that
   // the `KeyStore` was loaded by a call the instrumentation observed; its producer in this set
   // is `KeyStoreSpec`, which writes the mark at the acceptance point its `load` event leads to.
   //
   // The read sits in the event body and not in a `condition(...)` guard: a guard compiles to an
   // early return ahead of both the body and the transition, so a construction over an unloaded
   // store would drop out of the automaton silently and a later call would be reported as a
   // wrong call sequence instead of as the unprepared key store it is. A failed REQUIRES is not
   // a typestate failure.
   //
   // The verdict is three-valued and the two accusing outcomes are different claims, reported
   // under different codes. VIOLATED is positive evidence about this store -- an entry exists
   // whose values differ, or the predicate was revoked by a `negate`. NOT_OBSERVED says only
   // that no entry exists: no `KeyStore.load` was ever seen for it, which happens when the
   // loading ran before the monitor attached or inside code the weaving does not reach, and is a
   // reach limit rather than a misuse.
   //
   // Only the SATISFIED branch stages the object, so parameters built over a store whose loading
   // was not observed carry no mark out of this specification.
   event c1 after(KeyStore keyStore) returning(PKIXParameters s):
     call(public PKIXParameters.new(KeyStore)) &&
     args(keyStore) {
       creationObserved = true;
       PredicateVerdict generated = PredicateStore.instance().validate(Property.GENERATED_KEY_STORE, keyStore);
       if (generated == PredicateVerdict.VIOLATED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PKIXParametersSpec", "" + __LOC,
               "v=1 code=PKIXPARAMETERS-CONSTR-00 ev=" + __EVENTNAME + " obj=PKIXParameters val='' exp='a key store the monitor observed being loaded' msg='the key store carries a generation predicate the rule does not admit'"));
       }
       else if (generated == PredicateVerdict.NOT_OBSERVED) {
           ErrorCollector.instance().addError(new ErrorDescription(ErrorType.UnsatisfiedConstraint, "PKIXParametersSpec", "" + __LOC,
               "v=1 code=PKIXPARAMETERS-NOBS-00 ev=" + __EVENTNAME + " obj=PKIXParameters val='' exp='a key store the monitor observed being loaded' msg='no load of the key store was observed'" + Evidence.keysFor(keyStore)));
       }
       else {
           spec = s;
       }
   }

   // `Con` of PKIXParameters.crysl: `c2: PKIXParameters(_);`, the trust-anchor constructor and
   // the other alternative of `Con := c1 | c2`. The rule leaves the argument unnamed, so its
   // REQUIRES clause over `keyStore` binds nothing here and constrains nothing: there is no read
   // in this body and no accusation, and that is the rule speaking rather than an omission. A
   // program that builds its parameters from a set of trust anchors it assembled by hand has
   // satisfied every clause this rule states.
   //
   // The consequence is worth naming because it is a hole a reader will look for: this overload
   // stages the object unconditionally, so `generatedCertPathParameters` is written with nothing
   // checked, and a `CertPathTrustManagerParameters` built over it is accused of nothing either.
   // Checking something here would mean reading a trust-anchor predicate over the members of the
   // set, and the clause that would ask for it is commented out in the rule that states it.
   event c2 after(Set trustAnchors) returning(PKIXParameters s):
     call(public PKIXParameters.new(Set)) &&
     args(trustAnchors) {
       creationObserved = true;
       spec = s;
   }

   // `Con := c1 | c2` is the whole ORDER, so the `@fail` handler below cannot fire: each trace
   // has one symbol, and the monitor is keyed on the constructed object, so no monitor ever sees
   // a second event. It is written because the generator expects a handler and because the codes
   // it names are registered in `codes.csv`.
   ere : c1 | c2

   @fail {
      if (!creationObserved) {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "PKIXParametersSpec", "" + __LOC,
             "v=1 code=PKIXPARAMETERS-ORDER-01 ev=" + __EVENTNAME + " obj=PKIXParameters val='' exp='' msg='the observed call sequence is not one PKIXParametersSpec accepts and no creation of the parameters was observed'"));
      }
      else {
         ErrorCollector.instance().addError(new ErrorDescription(ErrorType.InvalidSequenceOfMethodCalls, "PKIXParametersSpec", "" + __LOC,
             "v=1 code=PKIXPARAMETERS-ORDER-00 ev=" + __EVENTNAME + " obj=PKIXParameters val='' exp='' msg='the observed call sequence is not one PKIXParametersSpec accepts'"));
      }
      __RESET;
   }

   // ENSURES of PKIXParameters.crysl: `generatedCertPathParameters[this];`. The predicate says
   // that the PKIX parameters were built over a key store the instrumentation observed being
   // loaded. The clause carries no `after L`, so its acceptance point is the accepting state,
   // which in a specification written as an `ere` is this handler: it fires whenever the trace
   // so far is a word of the expression.
   //
   // The object travels here in a field because a handler receives no event arguments and runs
   // after the transition has been decided. `spec` is staged by `c2` always and by `c1` only
   // where the store's loading was observed, and `ensure` treats a null binding as a no-op, so
   // parameters built over an unobserved store are not marked.
   //
   // The consumer is `CertPathTrustManagerParametersSpec`, which reads this predicate over the
   // parameters handed to its constructor; `PKIXBuilderParametersSpec` is the predicate's second
   // producer in this set.
   @match {
      PredicateStore.instance().ensure(Property.GENERATED_CERT_PATH_PARAMETERS, spec);
   }

}
